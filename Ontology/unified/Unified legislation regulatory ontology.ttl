###  https://w3id.org/cco-gro/data#USA_UNIT_00206_action_9d3ff2
data:USA_UNIT_00206_action_9d3ff2 rdf:type owl:NamedIndividual ,
                                           owl:Thing ,
                                           cco:Action ;
                                  cco:hasActionExpression "The full formula uses the student's (and spouse's) assets and determines a contribution from assets. First, the student's (and spouse's) net worth is calculated by adding the following assets reported on the FAFSA form: cash, savings, checking, time deposits, and money market funds; net worth of investments (including real estate excluding primary residence, vacation homes, income producing property, trusts, stocks, bonds, derivatives, securities, mutual funds, tax shelters, and qualified education benefits); adjusted net worth of business and/or farm using Table C4. Second, the student's (and spouse's) discretionary net worth is calculated by subtracting the asset protection allowance from Table C5." ;
                                  rdfs:label "Calculate Contribution from Assets" ;
                                  prov:wasDerivedFrom data:USA_UNIT_00206 .


###  https://w3id.org/cco-gro/data#USA_UNIT_00206_condition_discretionary
data:USA_UNIT_00206_condition_discretionary rdf:type owl:NamedIndividual ,
                                                     owl:Thing ,
                                                     cco:Condition ;
                                            cco:hasConditionExpression "Discretionary net worth is calculated by subtracting the asset protection allowance (Table C5) from the net worth." ;
                                            rdfs:label "Discretionary Net Worth Step" ;
                                            prov:wasDerivedFrom data:USA_UNIT_00206 .


###  https://w3id.org/cco-gro/data#USA_UNIT_00206_condition_networth
data:USA_UNIT_00206_condition_networth rdf:type owl:NamedIndividual ,
                                                owl:Thing ,
                                                cco:Condition ;
                                       cco:hasConditionExpression "Net worth is calculated by adding cash, savings, checking, time deposits, money market funds, net worth of investments, and adjusted net worth of business/farm." ;
                                       rdfs:label "Net Worth Calculation Step" ;
                                       prov:wasDerivedFrom data:USA_UNIT_00206 .


