###  https://w3id.org/cco-gro/data#UK_UNIT_00545_condition_cef982
data:UK_UNIT_00545_condition_cef982 rdf:type owl:NamedIndividual ,
                                             owl:Thing ,
                                             cco:Condition ;
                                    cco:hasConditionExpression "Before any payment is claimed for and paid there is confirmation of eligibility for any additional payment and / or care leaver bursary. This includes (1) confirmation of age; (2) a signed letter or email confirmation from a local authority confirming the individual’s care leaver status (this does not require a particular format); or (3) evidence of an education, health and care (EHC) plan where the apprentice is aged between 19 and 24 years old (Local Authority confirmation does not require a particular format; main providers should assist the apprentice in obtaining confirmation where necessary)." ;
                                    rdfs:label "Pre-Payment Condition" ;
                                    prov:wasDerivedFrom data:UK_UNIT_00545 .


