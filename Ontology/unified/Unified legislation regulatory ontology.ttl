###  https://w3id.org/cco-gro/onto/ca#MutuallyExclusiveCourses
gro-ca:MutuallyExclusiveCourses rdf:type owl:Class ;
                                rdfs:subClassOf cco:Resource ;
                                rdfs:label "Mutually Exclusive Courses" ;
                                skos:definition "Courses that have a different course name and number but have the same content as another course. Students who are taking duplicate or mutually exclusive courses will not be granted credit for a second time and the duplicate course will not be counted when determining a student’s course load of study for StudentAid BC purposes." ;
                                prov:wasDerivedFrom data:CAN_UNIT_00844 .


