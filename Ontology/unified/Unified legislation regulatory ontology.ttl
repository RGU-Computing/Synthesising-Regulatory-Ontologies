                                                 prov:wasDerivedFrom data:AUS_UNIT_00539 .


gro-au:SpecifiedProvider rdfs:label "Specified Provider" ;
                         skos:definition "A provider specified in Schedule 3 of the Determination as eligible to offer approved courses." .


gro-ca:AdultUpgradingGrantPolicyManual rdfs:label "Adult Upgrading Grant Policy Manual" ;
                                       skos:definition "The Adult Upgrading Grant Policy and Procedures Manual, which contains the policy set out by the Province of British Columbia for determining student eligibility." .


gro-ca:ApplicationAndLoanPayments rdfs:label "Application and Loan Payments" ;
                                  skos:definition "The borrower's application and associated loan payments that are subject to hold and suspension." .


gro-ca:BorrowerSelectedForRAPVerification rdfs:label "Borrower Selected for RAP Verification" ;
                                          skos:definition "A borrower who has been selected for Repayment Assistance Plan (RAP) application verification." .


gro-ca:ParentalExpectedContribution rdfs:label "Parental Expected Contribution" ;
                                    skos:definition "A calculated financial resource representing the expected parental contribution for a single dependent student, based on the sponsor's income and assets when the sponsor is a parent." ,
                                                    "The expected financial contribution from parents, step-parents, sponsors, or legal guardians of single dependent students toward the student's education, calculated based on assessed financial ability." ;
                                    prov:wasDerivedFrom data:CAN_UNIT_00425 .


gro-ca:SpousalExpectedContribution rdfs:label "Spousal Expected Contribution" ;
                                   skos:closeMatch gro-us:ContributionFromAssets ,
                                                   gro-us:IncomeAllowanceCalculation ,
                                                   gro-us:ParentsContribution ,
                                                   gro-us:ParentsContributionFromAssets ,
                                                   gro-us:StudentContributionFromIncome ;
                                   skos:definition "A calculated amount representing the expected financial contribution from a spouse, based on spousal income, used in student assessment." ;
                                   prov:wasDerivedFrom data:CAN_UNIT_00429 .


