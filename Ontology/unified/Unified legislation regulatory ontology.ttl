###  https://www.w3id.org/cco/cco#hasApplicabilityEnd
cco:hasApplicabilityEnd rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf cco:hasApplicabilityEnd ;
                        rdf:type owl:FunctionalProperty ;
                        rdfs:domain owl:Thing ,
                                    cco:Norm ,
                                    [ rdf:type owl:Restriction ;
