                                              owl:Thing ,
                                              cco:Condition ;
                                     cco:hasConditionExpression "Use Table C4: Business/Farm Net Worth Adjustment and Table C5: Asset Protection Allowance from the 2025-26 Student Aid Index (SAI) and Pell Grant Eligibility Guide." ;
                                     rdfs:label "Reference Tables Requirement" ;
                                     prov:wasDerivedFrom data:USA_UNIT_00206 .


