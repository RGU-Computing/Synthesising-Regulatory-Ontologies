###  https://w3id.org/cco-gro/onto/uk#EmployerProvider
gro-uk:EmployerProvider rdf:type owl:Class ;
                        rdfs:subClassOf cco:Agent ,
                                        cco:Organisation ,
                                        cco:Role ;
                        rdfs:label "Employer Provider" ,
                                   "Employer-Provider" ,
                                   "Employer-provider" ;
                        skos:definition "An employer-provider is a levy-paying organisation that is on the ‘employer-provider’ route of the Apprenticeship Provider and Assessment Register (APAR)." ,
                                        "An organisation that acts as an employer-provider, required to hold but not publish subcontracting information." ,
                                        "An organisation that acts as both an employer and a training provider for apprentices." ,
                                        "An organisation that acts as both the employer of an apprentice and the provider of their training." ,
                                        "An organisation that both employs an apprentice and provides their training." ,
                                        "An organisation that provides apprenticeship training and employs the apprentice." ,
                                        "We use the term ‘employer-provider’ where the funding rule only applies to a levy-paying organisation that is listed on the employer-provider route of the APAR. Employer-providers can only deliver apprenticeship training to their own staff or those of a connected company or charity and must do so on an actual cost basis (see paragraph 102)." ;
                        prov:wasDerivedFrom data:UK_UNIT_00023 ,
                                            data:UK_UNIT_01200 .


