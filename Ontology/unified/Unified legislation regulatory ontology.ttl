###  https://w3id.org/cco-gro/onto/au#GapFee
gro-au:GapFee rdf:type owl:Class ;
              rdfs:subClassOf cco:Resource ;
              rdfs:label "Gap Fee" ;
              skos:definition "A fee representing the gap between tuition fees and other funding" ,
                              "A tuition fee for a course includes the maximum amount covered by a VET Student Loan and the remaining tuition cost not covered by the loan – the ‘gap fee’. As it’s part of the tuition fee, the gap fee can’t include fees for non-tuition services such as items and equipment that become the student’s physical property and are not consumed in the course (for example, maps, charts or textbooks)." ;
              prov:wasDerivedFrom data:AUS_UNIT_00165 .


