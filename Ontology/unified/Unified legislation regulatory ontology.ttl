                                                  rdfs:subClassOf cco:Resource ;
                                                  rdfs:label "Field Trip and Placement Funding" ;
                                                  skos:definition "Funding allocated for actual costs of field trips, practicums, and clinical placements that are essential elements of an educational program." .


