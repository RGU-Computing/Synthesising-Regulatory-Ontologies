###  https://w3id.org/cco-gro/onto/ca#Guardian
gro-ca:Guardian rdf:type owl:Class ;
                rdfs:subClassOf cco:Role ;
                rdfs:label "Guardian" ;
                skos:definition "A person who is charged with the legal right and duty of care for a ward due to the ward’s inability (due to age, or mental or physical inability) to care for himself or herself." ;
                prov:wasDerivedFrom data:CAN_UNIT_00835 .


###  https://w3id.org/cco-gro/onto/ca#ICBCRegulations
gro-ca:ICBCRegulations rdf:type owl:Class ;
                       rdfs:subClassOf cco:Regulation ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cco:specifiesNorm ;
                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cco:Norm
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cco:hasValidityStart ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:date
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cco:hasValidityEnd ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:date
                                       ] ;
                       rdfs:label "ICBC Regulations" ;
                       skos:definition "Regulations issued by the Insurance Corporation of British Columbia." ;
                       prov:wasDerivedFrom data:CAN_UNIT_00022 .


