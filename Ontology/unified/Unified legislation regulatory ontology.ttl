###  https://w3id.org/cco-gro/onto/ca#ExpectedContribution
gro-ca:ExpectedContribution rdf:type owl:Class ;
                            rdfs:subClassOf gro:FinancialNeedAssessmentInputPattern ,
                                            cco:Resource ;
                            rdfs:label "Expected Contribution" ;
                            skos:closeMatch gro-us:ContributionFromAssets ,
                                            gro-us:ParentsContribution ,
                                            gro-us:ParentsContributionFromAssets ,
                                            gro-us:StudentContributionFromIncome ;
                            skos:definition "A financial contribution from a student, parent, step-parent, sponsor, legal guardian or spouse to assist with the cost of the student’s program of study. The contribution is automatically assessed during the student need assessment process." ;
                            prov:wasDerivedFrom data:CAN_UNIT_00832 .


###  https://w3id.org/cco-gro/onto/ca#ExpectedContributionFromNeedBasedBursaries
gro-ca:ExpectedContributionFromNeedBasedBursaries rdf:type owl:Class ;
                                                  rdfs:subClassOf cco:Resource ;
                                                  rdfs:label "Expected Contribution from Need-Based Bursaries" ;
                                                  skos:definition "The expected contribution from need-based bursaries, where the eligibility criteria are based on need, but the funding is not targeted for a specific element of the costs of living or education. The expected contribution is equivalent to the assessed actual amount, less an exemption of $1,800 per program year for both merit-based scholarships and need-based bursaries combined. Any amount of scholarship/bursary funding above $1,800 is considered income and is assessed at 100%." .


###  https://w3id.org/cco-gro/onto/ca#FamilyIncome
gro-ca:FamilyIncome rdf:type owl:Class ;
                    rdfs:subClassOf gro:FinancialNeedAssessmentInputPattern ,
                                    cco:Resource ;
                    rdfs:label "Family Income" ;
                    skos:closeMatch gro-us:FamilySize ,
                                    gro-us:IncomeAllowanceCalculation ,
                                    gro-us:ParentsAvailableIncome ;
                    skos:definition "family income is defined as the student’s parent(s)/guardian(s)/sponsor(s) income (as reported on line 15000 [total income] of each parent(s)/guardian(s)/sponsor(s) previous year’s T1 General Income Tax and Benefit Return), or international equivalent." ,
                                    "family income is defined as the sum of student’s income and spouse’s/common-law partner’s income (as reported on both the student’s and spouse’s/common-law partner’s line 15000 [total income] of their respective previous year’s T1 General Income Tax and Benefit Return), or international equivalent." ;
                    prov:wasDerivedFrom data:CAN_UNIT_00410 ,
                                        data:CAN_UNIT_00411 .


###  https://w3id.org/cco-gro/onto/ca#FamilySize
gro-ca:FamilySize rdf:type owl:Class ;
                  rdfs:subClassOf cco:Resource ;
                  rdfs:label "Family Size" ;
                  skos:definition "Family size includes all children 18 years of age and under, all children aged 19 and over who are full-time dependent students, children with disabilities aged 19 and over, elderly relatives who are fully supported by the parent(s) and declared on the T1 General Income Tax and Benefit Return, and foster children where foster parent income is claimed on Appendix 1." ;
                  prov:wasDerivedFrom data:CAN_UNIT_00434 .


###  https://w3id.org/cco-gro/onto/ca#FederalFixedStudentContribution
