gro-uk:Employer rdfs:label "Employer" ;
                skos:definition "A person or organization that employs people, in this context the employer of an apprentice." ,
                                "A person or organization that employs people." ,
                                "A role for entities that employ individuals and may receive financial assistance." ,
                                "A role for entities that employ individuals and may receive payments or confirmations." ,
                                "An employer of an apprentice." ,
                                "An employer organisation responsible for making a new reservation if the original expires before the apprentice starts." ,
                                "An organisation that employs an apprentice and is party to an apprenticeship agreement." ,
                                "An organisation that employs an apprentice and is party to the training plan." ,
                                "An organisation that employs an apprentice and participates in the apprenticeship programme." ,
                                "An organisation that employs an apprentice and supports their training." ,
                                "An organisation that employs an apprentice." ,
                                "An organisation that employs apprentices and is responsible for ensuring apprenticeship compliance." ,
                                "An organisation that employs apprentices and is responsible for paying their wages." ,
                                "An organisation that employs apprentices." ,
                                "An organisation that employs individuals and enters into agreements with providers." ,
                                "An organisation that employs individuals and enters into contracts for services." ,
                                "An organisation that employs individuals and participates in training arrangements." ,
                                "An organisation that employs individuals, including as an apprenticeship employer." ,
                                "The employer responsible for the apprenticeship, who must pay the difference when the overall price exceeds the funding band maximum." ,
                                "The role of an organisation or person employing an apprentice." .


gro-uk:EmployerProviderRole rdfs:label "Employer-Provider Role" ;
                            skos:definition "The role of a subcontractor acting as an employer-provider for apprenticeship training" ,
                                            "The role of an entity that operates as both an employer and a training provider." .


gro-uk:EmployerRole rdfs:label "Employer Role" ;
                    skos:definition "The role of an employer as defined by UK apprenticeship funding rules." ,
                                    "The role of an employer as defined in UK employment regulations." ,
                                    "The role of an employer as defined in the UK apprenticeship funding context." ,
                                    "The role of an employer as defined in the UK apprenticeship regulatory context." ,
                                    "The role of an employer as defined in the context of UK apprenticeship regulations." ,
                                    "The role of an employer as referenced in UK regulatory provisions." ,
                                    "The role of an employer in the context of UK apprenticeship funding regulations." ,
