###  https://w3id.org/cco-gro/data#USA_UNIT_00184
data:USA_UNIT_00184 rdf:type owl:NamedIndividual ,
                             prov:Entity ;
                    rdfs:label "Source: USA-UNIT-00184" .


###  https://w3id.org/cco-gro/data#USA_UNIT_00184_action_57e6aa
data:USA_UNIT_00184_action_57e6aa rdf:type owl:NamedIndividual ,
                                           cco:Action ;
                                  rdfs:label "Calculate Parents' Contribution" ;
                                  prov:wasDerivedFrom data:USA_UNIT_00184 ;
                                  cco:hasActionExpression "The parents' contribution from assets is calculated by multiplying discretionary net worth by the conversion rate of 12%, and if negative, it is set to zero. The parents' available income and contribution from assets are added together to determine the parents' adjusted available income. The total parents' contribution from adjusted available income is calculated from the amounts and rates in Table A5, where rates increase from 22% to 47% as adjusted available income increases." .


###  https://w3id.org/cco-gro/data#USA_UNIT_00184_condition_71eba7
