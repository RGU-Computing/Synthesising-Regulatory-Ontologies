###  https://w3id.org/cco-gro/data#USA_UNIT_00186_object_9900ec
data:USA_UNIT_00186_object_9900ec rdf:type owl:NamedIndividual ,
                                           cco:Resource ;
                                  rdfs:label "Student Total Income" ;
                                  skos:definition "The sum of the student's taxed and untaxed income, as reported on a U.S. tax return." ;
                                  prov:wasDerivedFrom data:USA_UNIT_00186 .


###  https://w3id.org/cco-gro/data#USA_UNIT_00186_subject_f18612
data:USA_UNIT_00186_subject_f18612 rdf:type owl:NamedIndividual ,
                                            gro-us:StudentAvailableIncome ;
                                   rdfs:label "Student Available Income" ;
                                   skos:definition "The student's available income is calculated by subtracting certain allowances from the student's total income. These allowances account for certain nondiscretionary expenses, such as taxes and basic living expenses. Once a minimum level of support has been offset for those expenses, the formula assumes that the remaining income is available for discretionary purposes, including paying for a postsecondary education. The student's available income is the sum of the taxable and untaxed income, minus amounts reported in the income but excluded from the formula (offsets and allowances)." ;
                                   prov:wasDerivedFrom data:USA_UNIT_00186 .


###  https://w3id.org/cco-gro/data#USA_UNIT_00188
data:USA_UNIT_00188 rdf:type owl:NamedIndividual ,
                             prov:Entity ;
                    rdfs:label "Source: USA-UNIT-00188" .


###  https://w3id.org/cco-gro/data#USA_UNIT_00188_calculation_rule
data:USA_UNIT_00188_calculation_rule rdf:type owl:NamedIndividual ,
                                              cco:Condition ;
                                     rdfs:label "Student Income Calculation Rule" ;
                                     skos:definition "The student's total income is decreased by the sum of income offsets (taxable college grant and scholarship aid, education credits, Federal Work-Study) and reduced by the sum of income allowances (U.S. income tax paid, payroll tax allowance, income protection allowance, allowance for parents' negative adjusted available income)." ;
                                     prov:wasDerivedFrom data:USA_UNIT_00188 ;
                                     cco:hasConditionExpression "Student's total income = Student's total income - (Student's taxable college grant and scholarship aid + Student's education credits + Student's Federal Work-Study) - (U.S. income tax paid + Student's payroll tax allowance + Income protection allowance + Allowance for parents' negative adjusted available income)" .


###  https://w3id.org/cco-gro/data#USA_UNIT_00188_income_allowances_condition
data:USA_UNIT_00188_income_allowances_condition rdf:type owl:NamedIndividual ,
                                                         cco:Condition ;
