                       rdfs:subClassOf cco:Resource ;
                       rdfs:label "Student Aid Index" ;
                       skos:definition "The Student Aid Index (SAI) is a calculated value representing a student's financial need for postsecondary education, determined by adding available income and contribution from assets, then applying progressive rates from Table C6 (22% to 47%) as adjusted available income increases." ;
                       prov:wasDerivedFrom data:USA_UNIT_00208 .


