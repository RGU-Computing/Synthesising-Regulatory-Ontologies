###  https://w3id.org/cco-gro/onto/us#ParentsAvailableIncome
gro-us:ParentsAvailableIncome rdf:type owl:Class ;
                              rdfs:subClassOf cco:Resource ;
                              rdfs:label "Parents' Available Income" ;
                              skos:definition "Parents' available income is calculated by subtracting certain allowances from the parents' total income. These allowances account for certain nondiscretionary expenses, such as taxes and basic living expenses. Once a minimum level of support has been offset for those expenses, the formula assumes that the remaining income is available for discretionary purposes, including paying for a postsecondary education. The available income can be a negative number." ;
                              prov:wasDerivedFrom data:USA_UNIT_00179 .


