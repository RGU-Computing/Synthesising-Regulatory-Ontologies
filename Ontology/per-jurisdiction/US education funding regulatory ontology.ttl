                                                     cco:Condition ;
                                            rdfs:label "Discretionary Net Worth Step" ;
                                            prov:wasDerivedFrom data:USA_UNIT_00206 ;
                                            cco:hasConditionExpression "Discretionary net worth is calculated by subtracting the asset protection allowance (Table C5) from the net worth." .


