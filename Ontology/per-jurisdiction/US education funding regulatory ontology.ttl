                                              cco:Condition ;
                                     rdfs:label "Negative Contribution from Assets" ;
                                     prov:wasDerivedFrom data:USA_UNIT_00184 ;
                                     cco:hasConditionExpression "If the contribution from assets is negative, it is set to zero." .


###  https://w3id.org/cco-gro/data#USA_UNIT_00184_norm_afc253
data:USA_UNIT_00184_norm_afc253 rdf:type owl:NamedIndividual ;
                                rdfs:label "Parents' Contribution Calculation Rule" ;
                                skos:definition "Structural calculation rule defining how the parents' contribution is computed, including the 12% conversion rate, the addition of available income, and the application of Table A5 rates (22% to 47%), with a condition that negative asset contributions are set to zero." ;
                                prov:wasDerivedFrom data:USA_UNIT_00184 ;
                                cco:appliesUnder data:USA_UNIT_00184_condition_71eba7 ;
                                cco:hasAction data:USA_UNIT_00184_action_57e6aa ;
                                cco:hasObject data:USA_UNIT_00184_object_f000b7 .


