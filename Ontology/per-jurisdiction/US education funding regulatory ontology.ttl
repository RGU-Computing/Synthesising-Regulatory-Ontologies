@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix gro: <https://w3id.org/cco-gro/onto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix data: <https://w3id.org/cco-gro/data#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix gro-us: <https://w3id.org/cco-gro/onto/us#> .
@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology ;
   rdfs:label "US education funding regulatory ontology"
 ] .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/prov#wasDerivedFrom
prov:wasDerivedFrom rdf:type owl:AnnotationProperty .


###  https://w3id.org/cco-gro/onto#hasSubject
gro:hasSubject rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#appliesToRole
cco:appliesToRole rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#appliesUnder
cco:appliesUnder rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasAction
cco:hasAction rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasActionExpression
cco:hasActionExpression rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasCondition
cco:hasCondition rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasConditionExpression
cco:hasConditionExpression rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasException
cco:hasException rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasObject
cco:hasObject rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasStartTime
cco:hasStartTime rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#holdsRole
cco:holdsRole rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#issues
cco:issues rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#modifiesNorm
cco:modifiesNorm rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#specifiesNorm
cco:specifiesNorm rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/ns/prov#Entity
prov:Entity rdf:type owl:Class .


###  https://w3id.org/cco-gro/onto#AgreementGovernanceObligation
gro:AgreementGovernanceObligation rdf:type owl:Class ;
                                  rdfs:subClassOf cco:Obligation ;
                                  rdfs:label "Agreement Governance Obligation" ;
                                  skos:definition "An obligation to establish, maintain, and comply with formal agreements, including documentation, signing, and adherence to agreed terms." .


###  https://w3id.org/cco-gro/onto#ApprenticeshipComplianceObligation
gro:ApprenticeshipComplianceObligation rdf:type owl:Class ;
                                       rdfs:subClassOf cco:Obligation ;
                                       rdfs:label "Apprenticeship Compliance Obligation" ;
                                       skos:definition "An obligation to comply with procedural, financial, and documentation requirements related to the establishment, execution, and funding of apprenticeship programs." .


###  https://w3id.org/cco-gro/onto#ApprenticeshipFundingMisuseProhibition
gro:ApprenticeshipFundingMisuseProhibition rdf:type owl:Class ;
                                           rdfs:subClassOf cco:Prohibition ;
                                           rdfs:label "Prohibition on Misuse of Apprenticeship Funding" ;
                                           skos:definition "A regulatory norm that prohibits the improper use of funds, rates, or incentives designated for apprenticeship programs." .


###  https://w3id.org/cco-gro/onto#ApprenticeshipSupportAndProgressionPermission
gro:ApprenticeshipSupportAndProgressionPermission rdf:type owl:Class ;
                                                  rdfs:subClassOf cco:Permission ;
                                                  rdfs:label "Apprenticeship Support and Progression Permission" ;
                                                  skos:definition "A permission that allows for the funding, support, training, and progression of apprentices through various stages of their apprenticeship journey." .


###  https://w3id.org/cco-gro/onto#AssessmentProcessObligation
gro:AssessmentProcessObligation rdf:type owl:Class ;
                                rdfs:subClassOf cco:Obligation ;
                                rdfs:label "Assessment Process Obligation" ;
                                skos:definition "An obligation to carry out, manage, and maintain various stages and components of an assessment process, including development, execution, independence, documentation, and alignment." .


###  https://w3id.org/cco-gro/onto#ConfirmationAndComplianceObligation
gro:ConfirmationAndComplianceObligation rdf:type owl:Class ;
                                        rdfs:subClassOf cco:Obligation ;
                                        rdfs:label "Confirmation and Compliance Obligation" ;
                                        skos:definition "An obligation to confirm approvals, complete required declarations, and comply with post-approval or statutory requirements." .


###  https://w3id.org/cco-gro/onto#DiscretionaryAuthorityPermission
gro:DiscretionaryAuthorityPermission rdf:type owl:Class ;
                                     rdfs:subClassOf cco:Permission ;
                                     rdfs:label "Discretionary Authority Permission" ;
                                     skos:definition "A permission norm that grants entities the authority to exercise judgment in considering factors, making determinations, or taking actions within a regulatory framework." .


###  https://w3id.org/cco-gro/onto#EligibilityAndRequirementsObligation
gro:EligibilityAndRequirementsObligation rdf:type owl:Class ;
                                         rdfs:subClassOf cco:Obligation ;
                                         rdfs:label "Eligibility and Requirements Obligation" ;
                                         skos:definition "An obligation to meet, verify, or maintain eligibility criteria and regulatory or programmatic requirements." .


###  https://w3id.org/cco-gro/onto#EligibilityBasedFinancialAndEnrollmentPermission
gro:EligibilityBasedFinancialAndEnrollmentPermission rdf:type owl:Class ;
                                                     rdfs:subClassOf cco:Permission ;
                                                     rdfs:label "Eligibility-Based Financial and Enrollment Permission" ;
                                                     skos:definition "A permission that grants students access to financial assistance, enrollment benefits, or academic status changes based on demonstrated eligibility criteria." .


###  https://w3id.org/cco-gro/onto#EvidenceManagementObligation
gro:EvidenceManagementObligation rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Obligation ;
                                 rdfs:label "Evidence Management Obligation" ;
                                 skos:definition "An obligation to manage, retain, provide, document, or possess evidence in accordance with regulatory requirements." .


###  https://w3id.org/cco-gro/onto#FeeManagementObligation
gro:FeeManagementObligation rdf:type owl:Class ;
                            rdfs:subClassOf cco:Obligation ;
                            rdfs:label "Fee Management Obligation" ;
                            skos:definition "An obligation to manage, disclose, structure, and apply fees in a transparent, reasonable, and systematic manner." .


###  https://w3id.org/cco-gro/onto#FundingAccessAndAllocationPermission
gro:FundingAccessAndAllocationPermission rdf:type owl:Class ;
                                         rdfs:subClassOf cco:Permission ;
                                         rdfs:label "Funding Access and Allocation Permission" ;
                                         skos:definition "A permission that authorizes access to, allocation of, or claims against funding resources for educational, assistive, or support purposes." .


###  https://w3id.org/cco-gro/onto#FundingEligibilityAndDisbursementObligation
gro:FundingEligibilityAndDisbursementObligation rdf:type owl:Class ;
                                                rdfs:subClassOf cco:Obligation ;
                                                rdfs:label "Funding Eligibility and Disbursement Obligation" ;
                                                skos:definition "An obligation to assess, confirm, and manage eligibility for funding, followed by the proper disbursement or claiming of funds, including direct retention or payment to providers and subcontractors." .


###  https://w3id.org/cco-gro/onto#InformationDisclosureObligation
gro:InformationDisclosureObligation rdf:type owl:Class ;
                                    rdfs:subClassOf cco:Obligation ;
                                    rdfs:label "Information Disclosure Obligation" ;
                                    skos:definition "An obligation to provide specified educational information to students or stakeholders before or during enrolment and throughout the course lifecycle." .


###  https://w3id.org/cco-gro/onto#LoanAndEnrolmentMisconductProhibition
gro:LoanAndEnrolmentMisconductProhibition rdf:type owl:Class ;
                                          rdfs:subClassOf cco:Prohibition ;
                                          rdfs:label "Prohibition of Misconduct in Loan and Enrolment Practices" ;
                                          skos:definition "A prohibition on actions involving improper financial demands, loan misrepresentation, unauthorized payment or borrowing, and misleading suggestions related to enrolment or assistance eligibility." .


###  https://w3id.org/cco-gro/onto#NoticeAndProcedureObligation
gro:NoticeAndProcedureObligation rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Obligation ;
                                 rdfs:label "Notice and Procedure Obligation" ;
                                 skos:definition "An obligation to provide formal notices and maintain established procedures in regulatory or administrative processes." .


###  https://w3id.org/cco-gro/onto#PaymentObligation
gro:PaymentObligation rdf:type owl:Class ;
                      rdfs:subClassOf cco:Obligation ;
                      rdfs:label "Payment Obligation" ;
                      skos:definition "An obligation to make, manage, or arrange payments or repayments under specified conditions." .


###  https://w3id.org/cco-gro/onto#ProviderComplianceObligation
gro:ProviderComplianceObligation rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Obligation ;
                                 rdfs:label "Provider Compliance Obligation" ;
                                 skos:definition "Obligations requiring entities to meet eligibility, maintain status, comply with regulations, and uphold transparency and procedural standards as approved providers." .


###  https://w3id.org/cco-gro/onto#RecreditAndReborrowPermission
gro:RecreditAndReborrowPermission rdf:type owl:Class ;
                                  rdfs:subClassOf cco:Permission ;
                                  rdfs:label "Recredit and Re-borrow Permission" ;
                                  skos:definition "Permission to recredit a HELP balance or re-borrow repaid amounts under specified conditions." .


###  https://w3id.org/cco-gro/onto#RegulatoryComplianceObligation
gro:RegulatoryComplianceObligation rdf:type owl:Class ;
                                   rdfs:subClassOf cco:Obligation ;
                                   rdfs:label "Regulatory Compliance Obligation" ;
                                   skos:definition "An obligation to adhere to specified legal, regulatory, or standard-based requirements, including ongoing adherence, information management, and rule referencing." .


###  https://w3id.org/cco-gro/onto#StudentAcademicAndFinancialComplianceObligation
gro:StudentAcademicAndFinancialComplianceObligation rdf:type owl:Class ;
                                                    rdfs:subClassOf cco:Obligation ;
                                                    rdfs:label "Student Academic and Financial Compliance Obligation" ;
                                                    skos:definition "An obligation requiring students to meet academic progress, enrollment, and financial responsibilities to maintain eligibility and compliance with educational funding and institutional requirements." .


###  https://w3id.org/cco-gro/onto#TrainingAndDeliveryObligation
gro:TrainingAndDeliveryObligation rdf:type owl:Class ;
                                  rdfs:subClassOf cco:Obligation ;
                                  rdfs:label "Training and Delivery Obligation" ;
                                  skos:definition "An obligation requiring providers to deliver, manage, and be accountable for training and learning activities, including assessment and off-the-job components." .


###  https://w3id.org/cco-gro/onto#TrainingDeliveryAndDocumentationObligation
gro:TrainingDeliveryAndDocumentationObligation rdf:type owl:Class ;
                                               rdfs:subClassOf cco:Obligation ;
                                               rdfs:label "Training Delivery and Documentation Obligation" ;
                                               skos:definition "An obligation to deliver, document, and maintain records of training activities, including off-the-job training, skill relevance, and planned parameters." .


###  https://w3id.org/cco-gro/onto#TuitionFeeChargingAndInclusionProhibition
gro:TuitionFeeChargingAndInclusionProhibition rdf:type owl:Class ;
                                              rdfs:subClassOf cco:Prohibition ;
                                              rdfs:label "Prohibition on Charging and Including Tuition Fees and Associated Costs" ;
                                              skos:definition "A prohibition on charging excessive, unnecessary, or unauthorized tuition fees and on including non-essential goods, services, or costs within tuition fees." .


###  https://w3id.org/cco-gro/onto#TuitionFeeManagementObligation
gro:TuitionFeeManagementObligation rdf:type owl:Class ;
                                   rdfs:subClassOf cco:Obligation ;
                                   rdfs:label "Tuition Fee Management Obligation" ;
                                   skos:definition "An obligation to manage tuition fees through setting, publishing, explaining, refunding, and disclosing related financial information." .


###  https://w3id.org/cco-gro/onto/us#AGIThreshold
gro-us:AGIThreshold rdf:type owl:Class ;
                    rdfs:subClassOf cco:Condition ;
                    rdfs:label "AGI Threshold" ;
                    skos:definition "A condition concerning adjusted gross income relative to poverty guidelines" .


###  https://w3id.org/cco-gro/onto/us#Application
gro-us:Application rdf:type owl:Class ;
                   rdfs:subClassOf cco:Resource ;
                   rdfs:label "Application" ;
                   skos:definition "An application form or submission containing information subject to verification." .


###  https://w3id.org/cco-gro/onto/us#AvailableIncome
gro-us:AvailableIncome rdf:type owl:Class ;
                       rdfs:subClassOf cco:Resource ;
                       rdfs:label "Available Income" ;
                       skos:definition "Student's (and Spouse's) available income, calculated by subtracting certain allowances from total income." ,
                                       "The student's (and spouse's) available income, calculated as the sum of taxable and untaxed income minus amounts reported in the income but excluded from the formula (offsets and allowances)." ,
                                       "The student's (and spouse's) available income, calculated by subtracting certain allowances from total income. It represents income available for discretionary purposes, including postsecondary education costs." ;
                       prov:wasDerivedFrom data:USA_UNIT_00193 ,
                                           data:USA_UNIT_00201 ,
                                           data:USA_UNIT_00202 .


###  https://w3id.org/cco-gro/onto/us#ChafeeVoucherEligibilityVerification
gro-us:ChafeeVoucherEligibilityVerification rdf:type owl:Class ;
                                            rdfs:subClassOf cco:Resource ;
                                            rdfs:label "Chafee Voucher Eligibility Verification" ;
                                            skos:definition "Verification of the student's eligibility for an education and training voucher under the John H. Chafee Foster Care Program under section 477 of the Social Security Act (42 U.S.C. 677) is a documented phone call or written statement from a financial aid administrator who documented the student's circumstance in the same or a prior award year." ;
                                            prov:wasDerivedFrom data:USA_UNIT_00060 .


###  https://w3id.org/cco-gro/onto/us#ConflictingInformation
gro-us:ConflictingInformation rdf:type owl:Class ;
                              rdfs:subClassOf cco:Resource ;
                              rdfs:label "Conflicting Information" ;
                              skos:definition "Information from any source that contradicts or is inconsistent with other data affecting a student's eligibility for federal student aid." .


###  https://w3id.org/cco-gro/onto/us#ConsentAndApproval
gro-us:ConsentAndApproval rdf:type owl:Class ;
                          rdfs:subClassOf cco:Resource ;
                          rdfs:label "Consent and Approval" ;
                          skos:definition "The consent and approval required to obtain tax information from the IRS for the FAFSA application." .


###  https://w3id.org/cco-gro/onto/us#ContributionFromAssets
gro-us:ContributionFromAssets rdf:type owl:Class ;
                              rdfs:subClassOf cco:Resource ;
                              rdfs:label "Contribution from Assets" ;
                              skos:definition "The calculated financial contribution derived from a student's (and spouse's) assets, as determined by the full formula using net worth, discretionary net worth, and asset protection allowance tables." ,
                                              "The student's contribution from assets, calculated by multiplying the student's net worth by the conversion rate of 20%, and if the contribution from assets is negative, it is set to zero." ,
                                              "The student's contribution from assets, determined by calculating net worth, subtracting the asset protection allowance, and multiplying by 20%." ;
                              prov:wasDerivedFrom data:USA_UNIT_00190 ,
                                                  data:USA_UNIT_00198 ,
                                                  data:USA_UNIT_00206 .


###  https://w3id.org/cco-gro/onto/us#Contributor
gro-us:Contributor rdf:type owl:Class ;
                   rdfs:subClassOf cco:Role ;
                   rdfs:label "Contributor" ;
                   skos:definition "Contributor refers to anyone who is required to provide information, consent, and approval, and a signature on the FAFSA form." ;
                   prov:wasDerivedFrom data:USA_UNIT_00043 .


###  https://w3id.org/cco-gro/onto/us#CostOfAttendanceComponent
gro-us:CostOfAttendanceComponent rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Resource ;
                                 rdfs:label "Cost of Attendance Component" ;
                                 skos:definition "Components of a student's cost of attendance or data determining a student's student aid index." .


###  https://w3id.org/cco-gro/onto/us#DefinedTerm
gro-us:DefinedTerm rdf:type owl:Class ;
                   rdfs:subClassOf cco:Resource ;
                   rdfs:label "Employer Education Benefits" ;
                   skos:definition "Employer education benefits count as other financial assistance (or reduce the cost of attendance) even if they aren't received until the end of the class(es) and are contingent on earning a minimum grade." ;
                   prov:wasDerivedFrom data:USA_UNIT_00092 .


###  https://w3id.org/cco-gro/onto/us#Department
gro-us:Department rdf:type owl:Class ;
                  rdfs:subClassOf cco:Organisation ;
                  rdfs:label "Department" ;
                  skos:definition "The Department referenced as the authority in the provision." ,
                                  "The U.S. Department of Education" .


###  https://w3id.org/cco-gro/onto/us#DependencyOverride
gro-us:DependencyOverride rdf:type owl:Class ;
                          rdfs:subClassOf cco:Resource ;
                          rdfs:label "Dependency Override" ;
                          skos:definition "A determination by a financial aid administrator that a student is independent despite not meeting the standard criteria, based on unusual circumstances." ,
                                          "A determination to override a student's dependency status from dependent to independent" .


###  https://w3id.org/cco-gro/onto/us#DependentStudent
gro-us:DependentStudent rdf:type owl:Class ;
                        rdfs:subClassOf cco:Role ;
                        rdfs:label "Dependent Student" ;
                        skos:definition "A student who is classified as a dependent for financial aid purposes under U.S. regulations." ;
                        prov:wasDerivedFrom data:USA_UNIT_00293 .


###  https://w3id.org/cco-gro/onto/us#DependentStudentWithoutParentalSupport
gro-us:DependentStudentWithoutParentalSupport rdf:type owl:Class ;
                                              rdfs:subClassOf cco:Role ;
                                              rdfs:label "Dependent Student Without Parental Support" ;
                                              skos:definition "A role held by dependent students whose parents refuse to support them financially or refuse to complete the FAFSA." .


###  https://w3id.org/cco-gro/onto/us#DirectLoanFunds
gro-us:DirectLoanFunds rdf:type owl:Class ;
                       rdfs:subClassOf cco:Resource ;
                       rdfs:label "Direct Loan Funds" ;
                       skos:definition "Funds provided under the Direct Loan program." .


###  https://w3id.org/cco-gro/onto/us#DirectUnsubsidizedAndPLUSLoans
gro-us:DirectUnsubsidizedAndPLUSLoans rdf:type owl:Class ;
                                      rdfs:subClassOf cco:Resource ;
                                      rdfs:label "Direct Unsubsidized and PLUS Loans" ;
                                      skos:definition "Federal student loans including Direct Unsubsidized Loans and Parent PLUS Loans." .


###  https://w3id.org/cco-gro/onto/us#DirectUnsubsidizedLoan
gro-us:DirectUnsubsidizedLoan rdf:type owl:Class ;
                              rdfs:subClassOf cco:Resource ;
                              rdfs:label "Direct Unsubsidized Loan" ;
                              skos:definition "A dependent level Direct Unsubsidized Loan available to students whose parents refuse to support them." ,
                                              "A federal student loan for which the borrower is responsible for all interest." .


###  https://w3id.org/cco-gro/onto/us#Document
gro-us:Document rdf:type owl:Class ;
                rdfs:subClassOf cco:Resource ;
                rdfs:label "Document" ;
                skos:definition "A written, printed, or electronic record that provides information or evidence." .


###  https://w3id.org/cco-gro/onto/us#Documentation
gro-us:Documentation rdf:type owl:Class ;
                     rdfs:subClassOf cco:Resource ;
                     rdfs:label "Documentation" ;
                     skos:definition "Documentation that may include various items such as interviews, court orders, or official documentation." .


###  https://w3id.org/cco-gro/onto/us#DocumentationItem
gro-us:DocumentationItem rdf:type owl:Class ;
                         rdfs:subClassOf cco:Resource ;
                         rdfs:label "Documentation Item" ;
                         skos:definition "An item that may be included in documentation, such as an interview record, court order, or official documentation." .


###  https://w3id.org/cco-gro/onto/us#EmploymentExpenseAllowance
gro-us:EmploymentExpenseAllowance rdf:type owl:Class ;
                                  rdfs:subClassOf cco:Resource ;
                                  rdfs:label "Employment Expense Allowance" ;
                                  skos:definition "A financial allowance for employment expenses, calculated as 35% of the student's (and spouse's) income earned from work or a maximum allowance, whichever is less, and never less than zero." ;
                                  prov:wasDerivedFrom data:USA_UNIT_00205 .


###  https://w3id.org/cco-gro/onto/us#FAA
gro-us:FAA rdf:type owl:Class ;
           rdfs:subClassOf cco:RegulatoryAuthorityRole ,
                           cco:Role ;
           rdfs:label "FAA Role" ,
                      "Financial Aid Administrator" ;
           skos:definition "A role responsible for reviewing and determining student financial aid eligibility." ,
                           "Financial Aid Administrator role as referenced in HEA regulations" .


###  https://w3id.org/cco-gro/onto/us#FAFSAApplication
gro-us:FAFSAApplication rdf:type owl:Class ;
                        rdfs:subClassOf cco:Resource ;
                        rdfs:label "FAFSA Application" ;
                        skos:definition "A Free Application for Federal Student Aid selected by the FAFSA Processing System for verification." ,
                                        "The Free Application for Federal Student Aid form used to determine eligibility for student financial aid in the United States." .


###  https://w3id.org/cco-gro/onto/us#FAFSAContributorRole
gro-us:FAFSAContributorRole rdf:type owl:Class ;
                            rdfs:subClassOf cco:Role ;
                            rdfs:label "FAFSA Contributor Role" ;
                            skos:definition "The role of a contributor to the FAFSA form who must provide consent for FTI access" .


###  https://w3id.org/cco-gro/onto/us#FAFSAForm
gro-us:FAFSAForm rdf:type owl:Class ;
                 rdfs:subClassOf cco:Resource ;
                 rdfs:label "FAFSA Form" ;
                 skos:definition "The Free Application for Federal Student Aid form used to determine eligibility for student financial aid." ,
                                 "The Free Application for Federal Student Aid form used to determine student financial aid eligibility." .


###  https://w3id.org/cco-gro/onto/us#FAFSAFormInformation
gro-us:FAFSAFormInformation rdf:type owl:Class ;
                            rdfs:subClassOf cco:Resource ;
                            rdfs:label "FAFSA Form Information" ;
                            skos:definition "Information contained in or related to the Free Application for Federal Student Aid (FAFSA) form." .


###  https://w3id.org/cco-gro/onto/us#FAFSAInformation
gro-us:FAFSAInformation rdf:type owl:Class ;
                        rdfs:subClassOf cco:Resource ;
                        rdfs:label "FAFSA Information" ;
                        skos:definition "Information submitted via the Free Application for Federal Student Aid (FAFSA) form." .


###  https://w3id.org/cco-gro/onto/us#FAFSAStudentRole
gro-us:FAFSAStudentRole rdf:type owl:Class ;
                        rdfs:subClassOf cco:Role ;
                        rdfs:label "FAFSA Student Role" ;
                        skos:definition "The role of a student who is an applicant for Title IV aid and must provide consent for FTI access" .


###  https://w3id.org/cco-gro/onto/us#FAFSASubmissionSummary
gro-us:FAFSASubmissionSummary rdf:type owl:Class ;
                              rdfs:subClassOf cco:Resource ;
                              rdfs:label "FAFSA Submission Summary" ;
                              skos:definition "A summary of the student's FAFSA submission processed by the Department" ,
                                              "A valid summary of a student's submitted FAFSA." .


###  https://w3id.org/cco-gro/onto/us#FSEOGFunds
gro-us:FSEOGFunds rdf:type owl:Class ;
                  rdfs:subClassOf cco:Resource ;
                  rdfs:label "FSEOG Funds" ;
                  skos:definition "Federal Supplemental Educational Opportunity Grant funds." .


###  https://w3id.org/cco-gro/onto/us#FTIAccessDisclosureUse
gro-us:FTIAccessDisclosureUse rdf:type owl:Class ;
                              rdfs:subClassOf cco:Resource ;
                              rdfs:label "FTI Access, Disclosure, and Use" ;
                              skos:definition "Federal Tax Information access, disclosure, and use in evaluating Title IV aid eligibility" .


###  https://w3id.org/cco-gro/onto/us#FamilySize
gro-us:FamilySize rdf:type owl:Class ;
                  rdfs:subClassOf cco:Resource ;
                  rdfs:label "Family Size" ;
                  skos:definition "The number of individuals considered part of a student's family for financial aid purposes." ,
                                  "The number of individuals counted in a student's household for financial aid calculation purposes." ;
                  prov:wasDerivedFrom data:USA_UNIT_00293 .


###  https://w3id.org/cco-gro/onto/us#FederalIncomeTaxReturn
gro-us:FederalIncomeTaxReturn rdf:type owl:Class ;
                              rdfs:subClassOf cco:Action ;
                              rdfs:label "Federal Income Tax Return Filing" ;
                              skos:definition "The action of filing a federal income tax return" .


###  https://w3id.org/cco-gro/onto/us#FinancialAid
gro-us:FinancialAid rdf:type owl:Class ;
                    rdfs:subClassOf cco:Resource ;
                    rdfs:label "Financial Aid" ;
                    skos:definition "Federal student aid funds that may be awarded and disbursed to eligible students." .


###  https://w3id.org/cco-gro/onto/us#FinancialAidAdministrator
gro-us:FinancialAidAdministrator rdf:type owl:Class ;
                                 rdfs:subClassOf cco:RegulatoryAuthorityRole ,
                                                 cco:Role ;
                                 rdfs:label "Financial Aid Administrator" ;
                                 skos:definition "A role held by an FAA who may use professional judgment to count a benefit." ,
                                                 "A role responsible for administering financial aid at an institution, including making dependency override determinations." ,
