@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix gro: <https://w3id.org/cco-gro/onto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix data: <https://w3id.org/cco-gro/data#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix gro-au: <https://w3id.org/cco-gro/onto/au#> .
@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology ;
   rdfs:label "" ,
              "Australians Education funding regulatory ontology"
 ] .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/prov#wasDerivedFrom
prov:wasDerivedFrom rdf:type owl:AnnotationProperty .


###  https://w3id.org/cco-gro/onto#hasSubject
gro:hasSubject rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#allocatedTo
cco:allocatedTo rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#appliesToRole
cco:appliesToRole rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#appliesUnder
cco:appliesUnder rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasAction
cco:hasAction rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasActionExpression
cco:hasActionExpression rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasCondition
cco:hasCondition rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasConditionExpression
cco:hasConditionExpression rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasException
cco:hasException rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasObject
cco:hasObject rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasStartTime
cco:hasStartTime rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#holdsRole
cco:holdsRole rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#issues
cco:issues rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#modifiesNorm
cco:modifiesNorm rdf:type owl:AnnotationProperty .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/ns/prov#Entity
prov:Entity rdf:type owl:Class .


###  https://w3id.org/cco-gro/onto#AgreementGovernanceObligation
gro:AgreementGovernanceObligation rdf:type owl:Class ;
                                  rdfs:subClassOf cco:Obligation ;
                                  rdfs:label "Agreement Governance Obligation" ;
                                  skos:definition "An obligation to establish, maintain, and comply with formal agreements, including documentation, signing, and adherence to agreed terms." .


###  https://w3id.org/cco-gro/onto#ApprenticeshipComplianceObligation
gro:ApprenticeshipComplianceObligation rdf:type owl:Class ;
                                       rdfs:subClassOf cco:Obligation ;
                                       rdfs:label "Apprenticeship Compliance Obligation" ;
                                       skos:definition "An obligation to comply with procedural, financial, and documentation requirements related to the establishment, execution, and funding of apprenticeship programs." .


###  https://w3id.org/cco-gro/onto#ApprenticeshipFundingMisuseProhibition
gro:ApprenticeshipFundingMisuseProhibition rdf:type owl:Class ;
                                           rdfs:subClassOf cco:Prohibition ;
                                           rdfs:label "Prohibition on Misuse of Apprenticeship Funding" ;
                                           skos:definition "A regulatory norm that prohibits the improper use of funds, rates, or incentives designated for apprenticeship programs." .


###  https://w3id.org/cco-gro/onto#ApprenticeshipSupportAndProgressionPermission
gro:ApprenticeshipSupportAndProgressionPermission rdf:type owl:Class ;
                                                  rdfs:subClassOf cco:Permission ;
                                                  rdfs:label "Apprenticeship Support and Progression Permission" ;
                                                  skos:definition "A permission that allows for the funding, support, training, and progression of apprentices through various stages of their apprenticeship journey." .


###  https://w3id.org/cco-gro/onto#AssessmentProcessObligation
gro:AssessmentProcessObligation rdf:type owl:Class ;
                                rdfs:subClassOf cco:Obligation ;
                                rdfs:label "Assessment Process Obligation" ;
                                skos:definition "An obligation to carry out, manage, and maintain various stages and components of an assessment process, including development, execution, independence, documentation, and alignment." .


###  https://w3id.org/cco-gro/onto#ConfirmationAndComplianceObligation
gro:ConfirmationAndComplianceObligation rdf:type owl:Class ;
                                        rdfs:subClassOf cco:Obligation ;
                                        rdfs:label "Confirmation and Compliance Obligation" ;
                                        skos:definition "An obligation to confirm approvals, complete required declarations, and comply with post-approval or statutory requirements." .


###  https://w3id.org/cco-gro/onto#DiscretionaryAuthorityPermission
gro:DiscretionaryAuthorityPermission rdf:type owl:Class ;
                                     rdfs:subClassOf cco:Permission ;
                                     rdfs:label "Discretionary Authority Permission" ;
                                     skos:definition "A permission norm that grants entities the authority to exercise judgment in considering factors, making determinations, or taking actions within a regulatory framework." .


###  https://w3id.org/cco-gro/onto#EligibilityAndRequirementsObligation
gro:EligibilityAndRequirementsObligation rdf:type owl:Class ;
                                         rdfs:subClassOf cco:Obligation ;
                                         rdfs:label "Eligibility and Requirements Obligation" ;
                                         skos:definition "An obligation to meet, verify, or maintain eligibility criteria and regulatory or programmatic requirements." .


###  https://w3id.org/cco-gro/onto#EligibilityBasedFinancialAndEnrollmentPermission
gro:EligibilityBasedFinancialAndEnrollmentPermission rdf:type owl:Class ;
                                                     rdfs:subClassOf cco:Permission ;
                                                     rdfs:label "Eligibility-Based Financial and Enrollment Permission" ;
                                                     skos:definition "A permission that grants students access to financial assistance, enrollment benefits, or academic status changes based on demonstrated eligibility criteria." .


###  https://w3id.org/cco-gro/onto#EvidenceManagementObligation
gro:EvidenceManagementObligation rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Obligation ;
                                 rdfs:label "Evidence Management Obligation" ;
                                 skos:definition "An obligation to manage, retain, provide, document, or possess evidence in accordance with regulatory requirements." .


###  https://w3id.org/cco-gro/onto#FeeManagementObligation
gro:FeeManagementObligation rdf:type owl:Class ;
                            rdfs:subClassOf cco:Obligation ;
                            rdfs:label "Fee Management Obligation" ;
                            skos:definition "An obligation to manage, disclose, structure, and apply fees in a transparent, reasonable, and systematic manner." .


###  https://w3id.org/cco-gro/onto#FundingAccessAndAllocationPermission
gro:FundingAccessAndAllocationPermission rdf:type owl:Class ;
                                         rdfs:subClassOf cco:Permission ;
                                         rdfs:label "Funding Access and Allocation Permission" ;
                                         skos:definition "A permission that authorizes access to, allocation of, or claims against funding resources for educational, assistive, or support purposes." .


###  https://w3id.org/cco-gro/onto#FundingEligibilityAndDisbursementObligation
gro:FundingEligibilityAndDisbursementObligation rdf:type owl:Class ;
                                                rdfs:subClassOf cco:Obligation ;
                                                rdfs:label "Funding Eligibility and Disbursement Obligation" ;
                                                skos:definition "An obligation to assess, confirm, and manage eligibility for funding, followed by the proper disbursement or claiming of funds, including direct retention or payment to providers and subcontractors." .


###  https://w3id.org/cco-gro/onto#InformationDisclosureObligation
gro:InformationDisclosureObligation rdf:type owl:Class ;
                                    rdfs:subClassOf cco:Obligation ;
                                    rdfs:label "Information Disclosure Obligation" ;
                                    skos:definition "An obligation to provide specified educational information to students or stakeholders before or during enrolment and throughout the course lifecycle." .


###  https://w3id.org/cco-gro/onto#LoanAndEnrolmentMisconductProhibition
gro:LoanAndEnrolmentMisconductProhibition rdf:type owl:Class ;
                                          rdfs:subClassOf cco:Prohibition ;
                                          rdfs:label "Prohibition of Misconduct in Loan and Enrolment Practices" ;
                                          skos:definition "A prohibition on actions involving improper financial demands, loan misrepresentation, unauthorized payment or borrowing, and misleading suggestions related to enrolment or assistance eligibility." .


###  https://w3id.org/cco-gro/onto#NoticeAndProcedureObligation
gro:NoticeAndProcedureObligation rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Obligation ;
                                 rdfs:label "Notice and Procedure Obligation" ;
                                 skos:definition "An obligation to provide formal notices and maintain established procedures in regulatory or administrative processes." .


###  https://w3id.org/cco-gro/onto#PaymentObligation
gro:PaymentObligation rdf:type owl:Class ;
                      rdfs:subClassOf cco:Obligation ;
                      rdfs:label "Payment Obligation" ;
                      skos:definition "An obligation to make, manage, or arrange payments or repayments under specified conditions." .


###  https://w3id.org/cco-gro/onto#ProviderComplianceObligation
gro:ProviderComplianceObligation rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Obligation ;
                                 rdfs:label "Provider Compliance Obligation" ;
                                 skos:definition "Obligations requiring entities to meet eligibility, maintain status, comply with regulations, and uphold transparency and procedural standards as approved providers." .


###  https://w3id.org/cco-gro/onto#RecreditAndReborrowPermission
gro:RecreditAndReborrowPermission rdf:type owl:Class ;
                                  rdfs:subClassOf cco:Permission ;
                                  rdfs:label "Recredit and Re-borrow Permission" ;
                                  skos:definition "Permission to recredit a HELP balance or re-borrow repaid amounts under specified conditions." .


###  https://w3id.org/cco-gro/onto#RegulatoryComplianceObligation
gro:RegulatoryComplianceObligation rdf:type owl:Class ;
                                   rdfs:subClassOf cco:Obligation ;
                                   rdfs:label "Regulatory Compliance Obligation" ;
                                   skos:definition "An obligation to adhere to specified legal, regulatory, or standard-based requirements, including ongoing adherence, information management, and rule referencing." .


###  https://w3id.org/cco-gro/onto#StudentAcademicAndFinancialComplianceObligation
gro:StudentAcademicAndFinancialComplianceObligation rdf:type owl:Class ;
                                                    rdfs:subClassOf cco:Obligation ;
                                                    rdfs:label "Student Academic and Financial Compliance Obligation" ;
                                                    skos:definition "An obligation requiring students to meet academic progress, enrollment, and financial responsibilities to maintain eligibility and compliance with educational funding and institutional requirements." .


###  https://w3id.org/cco-gro/onto#TrainingAndDeliveryObligation
gro:TrainingAndDeliveryObligation rdf:type owl:Class ;
                                  rdfs:subClassOf cco:Obligation ;
                                  rdfs:label "Training and Delivery Obligation" ;
                                  skos:definition "An obligation requiring providers to deliver, manage, and be accountable for training and learning activities, including assessment and off-the-job components." .


###  https://w3id.org/cco-gro/onto#TrainingDeliveryAndDocumentationObligation
gro:TrainingDeliveryAndDocumentationObligation rdf:type owl:Class ;
                                               rdfs:subClassOf cco:Obligation ;
                                               rdfs:label "Training Delivery and Documentation Obligation" ;
                                               skos:definition "An obligation to deliver, document, and maintain records of training activities, including off-the-job training, skill relevance, and planned parameters." .


###  https://w3id.org/cco-gro/onto#TuitionFeeChargingAndInclusionProhibition
gro:TuitionFeeChargingAndInclusionProhibition rdf:type owl:Class ;
                                              rdfs:subClassOf cco:Prohibition ;
                                              rdfs:label "Prohibition on Charging and Including Tuition Fees and Associated Costs" ;
                                              skos:definition "A prohibition on charging excessive, unnecessary, or unauthorized tuition fees and on including non-essential goods, services, or costs within tuition fees." .


###  https://w3id.org/cco-gro/onto#TuitionFeeManagementObligation
gro:TuitionFeeManagementObligation rdf:type owl:Class ;
                                   rdfs:subClassOf cco:Obligation ;
                                   rdfs:label "Tuition Fee Management Obligation" ;
                                   skos:definition "An obligation to manage tuition fees through setting, publishing, explaining, refunding, and disclosing related financial information." .


###  https://w3id.org/cco-gro/onto/au#ACCC
gro-au:ACCC rdf:type owl:Class ;
            rdfs:subClassOf cco:RegulatoryAuthorityAgent ;
            rdfs:label "ACCC" ;
            skos:definition "The Australian Competition and Consumer Commission, an independent Commonwealth statutory authority." .


###  https://w3id.org/cco-gro/onto/au#ACTACMember
gro-au:ACTACMember rdf:type owl:Class ;
                   rdfs:subClassOf cco:Role ;
                   rdfs:label "ACTAC Member" ;
                   skos:definition "A member of the Australasian Conference of Tertiary Admission Centres." .


###  https://w3id.org/cco-gro/onto/au#AQFQualification
gro-au:AQFQualification rdf:type owl:Class ;
                        rdfs:subClassOf cco:Resource ;
                        rdfs:label "AQF Qualification" ;
                        skos:definition "A qualification issued under the Australian Qualifications Framework or a predecessor framework." .


###  https://w3id.org/cco-gro/onto/au#ASQA
gro-au:ASQA rdf:type owl:Class ;
            rdfs:subClassOf cco:RegulatoryAuthorityAgent ;
            rdfs:label "ASQA" ;
            skos:definition "The Australian Skills Quality Authority, the national regulator for Australia's vocational education and training sector." .


###  https://w3id.org/cco-gro/onto/au#ATO
gro-au:ATO rdf:type owl:Class ;
           rdfs:subClassOf cco:RegulatoryAuthorityAgent ;
           rdfs:label "ATO" ;
           skos:definition "The Australian Taxation Office, the principal revenue collection agency of the Australian Government." .


###  https://w3id.org/cco-gro/onto/au#AcademicSuitabilityAssessment
gro-au:AcademicSuitabilityAssessment rdf:type owl:Class ;
                                     rdfs:subClassOf cco:Action ;
                                     rdfs:label "Academic Suitability Assessment" ;
                                     skos:definition "An assessment required to show that a student is academically suited to undertake a course." ,
                                                     "The process of determining whether a student is academically suited to undertake an approved course, including any tasks the student is required to complete for that purpose." .


###  https://w3id.org/cco-gro/onto/au#AcademicSuitabilityEvidence
gro-au:AcademicSuitabilityEvidence rdf:type owl:Class ;
                                   rdfs:subClassOf cco:Resource ;
                                   rdfs:label "Academic Suitability Evidence" ;
                                   skos:definition "Evidence required to show academic suitability, including qualifications, assessments, or overseas qualification letters." .


###  https://w3id.org/cco-gro/onto/au#AcademicallySuitable
gro-au:AcademicallySuitable rdf:type owl:Class ;
                            rdfs:subClassOf cco:Condition ;
                            rdfs:label "Academically Suitable" ;
                            skos:definition "Determining whether the student is academically suitable The course provider decides whether the student is academically suited to the course they're applying for. A student is academically suited to a course when:" ;
                            prov:wasDerivedFrom data:AUS_UNIT_00289 .


###  https://w3id.org/cco-gro/onto/au#AccessibleDefinedTerm
gro-au:AccessibleDefinedTerm rdf:type owl:Class ;
                             rdfs:subClassOf cco:Condition ;
                             rdfs:label "Accessible Defined Term" ;
                             skos:definition "accessible means you have informed the student the information or document is to be given using the system, and have authorised the student to use the system" ;
                             prov:wasDerivedFrom data:AUS_UNIT_00458 .


###  https://w3id.org/cco-gro/onto/au#AccompanyingPerson
gro-au:AccompanyingPerson rdf:type owl:Class ;
                          rdfs:subClassOf cco:Person ;
                          rdfs:label "Accompanying Person" ;
                          skos:definition "Another person who accompanies or assists a party" .


###  https://w3id.org/cco-gro/onto/au#AccreditedCourse
gro-au:AccreditedCourse rdf:type owl:Class ;
                        rdfs:subClassOf cco:Resource ;
                        rdfs:label "Accredited Course" ;
                        skos:definition "A course that has been accredited by the relevant Australian higher education authority." .


###  https://w3id.org/cco-gro/onto/au#AccumulatedDebtForCourse
gro-au:AccumulatedDebtForCourse rdf:type owl:Class ;
                                rdfs:subClassOf cco:Resource ;
                                rdfs:label "Accumulated Debt for Course" ;
                                skos:definition "Accumulated debt for course is an indicative cumulative debt amount accrued by the student for the VET course code, as reported by providers in TCSI. This amount may be adjusted when payment claims are validated. It may include both VET FEE-HELP and VSL accrued from 1 January 2017." ;
                                prov:wasDerivedFrom data:AUS_UNIT_00846 .


###  https://w3id.org/cco-gro/onto/au#ActualTotalTuitionFee
gro-au:ActualTotalTuitionFee rdf:type owl:Class ;
                             rdfs:subClassOf cco:Resource ;
                             rdfs:label "Actual Total Tuition Fee" ;
                             skos:definition "The actual total of the tuition fees for a course, which may exceed the estimate under certain conditions." .


###  https://w3id.org/cco-gro/onto/au#AdministrativeErrorCorrection
gro-au:AdministrativeErrorCorrection rdf:type owl:Class ;
                                     rdfs:subClassOf cco:Condition ;
                                     rdfs:label "Administrative Error Correction" ;
                                     skos:definition "A condition where a change is made to correct an administrative error." .


###  https://w3id.org/cco-gro/onto/au#AdministrativeReviewTribunal
gro-au:AdministrativeReviewTribunal rdf:type owl:Class ;
                                    rdfs:subClassOf cco:Organisation ,
                                                    cco:RegulatoryAuthorityRole ;
                                    rdfs:label "Administrative Review Tribunal" ;
                                    skos:definition "Amended Administrative Appeals Tribunal (AAT) to Administrative Review Tribunal (ART)" ,
                                                    "The Administrative Review Tribunal (ART) as an organisation that conducts reviews of decisions." ,
                                                    "The Administrative Review Tribunal, a body to which applications for review can be made." ,
                                                    "The Australian Administrative Review Tribunal that hears reviews of administrative decisions." ;
                                    prov:wasDerivedFrom data:AUS_UNIT_00970 .


###  https://w3id.org/cco-gro/onto/au#AdministrativeReviewTribunalAct2024Part10
gro-au:AdministrativeReviewTribunalAct2024Part10 rdf:type owl:Class ;
                                                 rdfs:subClassOf cco:Regulation ;
                                                 rdfs:label "Administrative Review Tribunal Act 2024 Part 10" ;
                                                 skos:definition "The Administrative Review Tribunal Act 2024 Part 10, which establishes the right to apply for review of decisions." ;
                                                 prov:wasDerivedFrom data:AUS_UNIT_00539 .


###  https://w3id.org/cco-gro/onto/au#AffectedPerson
gro-au:AffectedPerson rdf:type owl:Class ;
                      rdfs:subClassOf cco:Role ;
                      rdfs:label "Affected Person" ;
                      skos:definition "A person affected by a reviewable decision under Australian regulatory provisions." .


###  https://w3id.org/cco-gro/onto/au#AlternativeAccessResource
gro-au:AlternativeAccessResource rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Resource ;
                                 rdfs:label "Alternative Access Resource" ;
                                 skos:definition "Alternative forms of access to goods or services essential to the course, where the provider also provides readily available access in another form at no additional cost to students." .


###  https://w3id.org/cco-gro/onto/au#AnnualCharge
gro-au:AnnualCharge rdf:type owl:Class ;
                    rdfs:subClassOf cco:Resource ;
                    rdfs:label "Annual Charge" ;
                    skos:definition "A financial charge payable annually by approved providers under the VET Student Loans (Charges) Act 2016." .


###  https://w3id.org/cco-gro/onto/au#AppealProcess
gro-au:AppealProcess rdf:type owl:Class ;
                     rdfs:subClassOf cco:Resource ;
                     rdfs:label "Appeal Process" ;
                     skos:definition "A process for appealing a decision to an independent senior officer of the provider, or to an internal committee or unit with appropriate expertise." .


###  https://w3id.org/cco-gro/onto/au#Applicant
gro-au:Applicant rdf:type owl:Class ;
                 rdfs:subClassOf cco:Role ;
                 rdfs:label "Applicant" ;
                 skos:definition "An individual or organisation applying to become an approved provider under the relevant regulatory framework." .


###  https://w3id.org/cco-gro/onto/au#ApplicantRTO
gro-au:ApplicantRTO rdf:type owl:Class ;
                    rdfs:subClassOf cco:Organisation ;
                    rdfs:label "Applicant RTO" ;
                    skos:definition "A Registered Training Organisation that is applying for something under the regulatory framework." .


###  https://w3id.org/cco-gro/onto/au#ApplicantRole
gro-au:ApplicantRole rdf:type owl:Class ;
                     rdfs:subClassOf cco:Role ;
                     rdfs:label "Applicant Role" ;
                     skos:definition "The role of an individual or organisation applying for provider suitability." .


###  https://w3id.org/cco-gro/onto/au#ApplicationEnrolmentRecords
gro-au:ApplicationEnrolmentRecords rdf:type owl:Class ;
                                   rdfs:subClassOf cco:Resource ;
                                   rdfs:label "Application and Enrolment Records" ;
                                   skos:definition "Required records for the application and enrolment process as specified in part 45." .


###  https://w3id.org/cco-gro/onto/au#ApplicationFee
gro-au:ApplicationFee rdf:type owl:Class ;
                      rdfs:subClassOf cco:Resource ;
                      rdfs:label "Application Fee" ;
                      skos:definition "A fee payable upon application to become an approved provider, assisting with cost recovery for processing and assessment." ,
                                      "A fee required to be paid when submitting an application." .


###  https://w3id.org/cco-gro/onto/au#ApplicationFormSection
gro-au:ApplicationFormSection rdf:type owl:Class ;
                              rdfs:subClassOf cco:Resource ;
                              rdfs:label "Application Form Section" ;
                              skos:definition "A section of an application form that requests information relevant to suitability for approval as a VSL course provider." .


###  https://w3id.org/cco-gro/onto/au#ApplicationProcess
gro-au:ApplicationProcess rdf:type owl:Class ;
                          rdfs:subClassOf cco:Action ;
                          rdfs:label "Application Process" ;
                          skos:definition "A series of actions or steps taken in order to apply for something." .


###  https://w3id.org/cco-gro/onto/au#AppropriateRecords
gro-au:AppropriateRecords rdf:type owl:Class ;
                          rdfs:subClassOf cco:Resource ;
                          rdfs:label "Appropriate Records" ;
                          skos:definition "Records that are required to be kept in relation to the grievance procedure, as specified by the regulatory provision." .


###  https://w3id.org/cco-gro/onto/au#Approval
gro-au:Approval rdf:type owl:Class ;
                rdfs:subClassOf cco:Resource ;
                rdfs:label "Approval" ;
                skos:definition "The regulatory approval granted to a provider." .


###  https://w3id.org/cco-gro/onto/au#ApprovedCourseDelivererRole
gro-au:ApprovedCourseDelivererRole rdf:type owl:Class ;
                                   rdfs:subClassOf cco:Role ;
                                   rdfs:label "Approved Course Deliverer Role" ;
                                   skos:definition "A role held by a third party that is already an approved course deliverer under the relevant legislation." .


###  https://w3id.org/cco-gro/onto/au#ApprovedCourseProvider
gro-au:ApprovedCourseProvider rdf:type owl:Class ;
