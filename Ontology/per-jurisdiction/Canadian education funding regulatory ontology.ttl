                                     prov:wasDerivedFrom data:CAN_UNIT_00072 ;
                                     cco:hasCondition data:CAN_UNIT_00072_condition_exception ;
                                     cco:modifiesNorm data:CAN_UNIT_00072_norm_97b317 .


