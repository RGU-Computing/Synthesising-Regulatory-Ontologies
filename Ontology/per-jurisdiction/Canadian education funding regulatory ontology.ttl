data:CAN_UNIT_00432_action_03035d rdf:type owl:NamedIndividual ,
                                           cco:Action ;
                                  rdfs:label "Complete Appendix 1 Income Reporting" ;
                                  prov:wasDerivedFrom data:CAN_UNIT_00432 ;
                                  cco:hasActionExpression "Parent(s) living outside Canada are expected to complete Appendix 1 by indicating their income as reported on their previous year’s Canadian T1 General Income Tax and Benefit Return, and all out-of-country income from all sources as well as all Canadian and foreign assets." .


###  https://w3id.org/cco-gro/data#CAN_UNIT_00432_condition_59acf5
data:CAN_UNIT_00432_condition_59acf5 rdf:type owl:NamedIndividual ,
                                              cco:Condition ;
                                     rdfs:label "Unfiled Canadian Tax Return Condition" ;
                                     prov:wasDerivedFrom data:CAN_UNIT_00432 ;
                                     cco:hasConditionExpression "If the student’s parent(s) are living outside Canada and have not filed a Canadian T1 General Income Tax and Benefit Return for the previous year, the parents are expected to indicate their total income from all sources both inside and outside Canada. Total income includes, but is not limited to employment, pension investment, rental, RRSP, foster parent, net professional income, workers’ compensation, employment insurance and disability assistance as well as all Canadian and foreign assets. Income may be verified by the income tax returns and assessments issued for the same period by the jurisdiction in which the parent(s) is a deemed resident for tax purposes." .


