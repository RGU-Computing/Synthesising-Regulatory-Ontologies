###  https://w3id.org/cco-gro/onto/ca#MandatoryFees
gro-ca:MandatoryFees rdf:type owl:Class ;
                     rdfs:subClassOf cco:Resource ;
                     rdfs:label "Mandatory Fees" ;
                     skos:definition "Mandatory fees are costs associated with attending a post-secondary institution, or enrolment in certain programs (such as registration fee, student license, student association or Alma Mater Society fees, membership fees for overseeing bodies) and are required to be paid by all students in the institution/program. License exam fees (whether included in tuition or not) can be included in tuition if the license exam is mandatory and it is completed within the study period. Optional fees, fees that do not apply to all students and fees already included in the moderate standard of living allowance are not to be included." ;
                     prov:wasDerivedFrom data:CAN_UNIT_00108 .


