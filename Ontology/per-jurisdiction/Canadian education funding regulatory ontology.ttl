###  https://w3id.org/cco-gro/onto/ca#StudentFinancialAssistance
gro-ca:StudentFinancialAssistance rdf:type owl:Class ;
                                  rdfs:subClassOf cco:Resource ;
                                  rdfs:label "Student Financial Assistance" ;
                                  skos:definition "All forms of student financial assistance provided under Canadian regulations." ,
                                                  "B.C. student financial assistance funding." ,
                                                  "Federal and provincial student financial assistance that a student is eligible to receive from StudentAid BC." ,
                                                  "Financial aid provided to students to support their education-related expenses." ,
                                                  "Financial aid provided to students to support their education." ,
                                                  "Financial assistance available to eligible students under StudentAid BC programs." ,
                                                  "Financial assistance available to eligible students." ,
                                                  "Financial assistance available to students in Canada." ,
                                                  "Financial assistance available to students, limited by minimum and maximum interest free loan award amounts set by the Canada Student Financial Assistance Program and StudentAid BC, and based on federal and provincial need assessments and eligibility for non-repayable grants and bursaries." ,
                                                  "Financial assistance issued to students based on assessed need, capped by weeks-based maximum or allowable educational costs." ,
                                                  "Financial assistance provided to eligible students under Canadian regulations." ,
                                                  "Financial assistance provided to students for educational purposes." ,
                                                  "Financial assistance provided to students under Canadian regulations." ,
                                                  "Financial assistance provided to students under Canadian student loan programs." ,
                                                  "Financial assistance provided to students under StudentAid BC programs." ,
                                                  "Financial assistance provided to students under the Canada Student Financial Assistance program." ,
                                                  "Financial assistance provided to students, including loans and grants, by programs such as StudentAid BC or the Canada Student Financial Assistance Program." ,
                                                  "Financial assistance provided to students, such as StudentAid BC funding" ,
                                                  "Financial assistance provided to students, such as loans or grants." ,
                                                  "Financial assistance provided under StudentAid BC, calculated based on a student's financial need and considering standard cost of living and educational expenses." ,
                                                  "Full-time or part-time student financial assistance provided through StudentAid BC." ,
                                                  "Government-provided financial support for students, serving as a qualifying criterion for automatic bursary assessment." ,
                                                  "Loans or grants provided to students as financial assistance." ,
                                                  "Repayable and non-repayable student financial assistance available for eligible part-time students attending part-time studies in eligible full-time programs, determined as a function of the student’s total family income and family situation." ;
                                  prov:wasDerivedFrom data:CAN_UNIT_00438 .


