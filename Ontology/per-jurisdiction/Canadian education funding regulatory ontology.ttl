###  https://w3id.org/cco-gro/data#CAN_UNIT_00067_condition_eligibility
data:CAN_UNIT_00067_condition_eligibility rdf:type owl:NamedIndividual ,
                                                   cco:Condition ;
                                          rdfs:label "Eligibility Criteria Condition" ;
                                          prov:wasDerivedFrom data:CAN_UNIT_00067 ;
                                          cco:hasConditionExpression "The program must lead to a formal credential (degree, diploma, certificate or citation) issued by the governing body of the institution and be recognized by the appropriate authority that designated the institution. Institutions must also comply with all requirements of their regulating body. The institution must offer and deliver the program on a full-time basis at 100% of a full course load. The program must be at least 12 weeks in duration within a time frame of 15 weeks." .


