@prefix cco: <https://www.w3id.org/cco/cco#> .
@prefix gro: <https://w3id.org/cco-gro/onto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix data: <https://w3id.org/cco-gro/data#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix gro-ca: <https://w3id.org/cco-gro/onto/ca#> .
@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology ;
   rdfs:label "Canadian education funding regulaotry ontology"
 ] .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/prov#wasDerivedFrom
prov:wasDerivedFrom rdf:type owl:AnnotationProperty .


###  https://w3id.org/cco-gro/onto#hasSubject
gro:hasSubject rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#allocatedTo
cco:allocatedTo rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#appliesToRole
cco:appliesToRole rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#appliesUnder
cco:appliesUnder rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasAction
cco:hasAction rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasActionExpression
cco:hasActionExpression rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasCondition
cco:hasCondition rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasConditionExpression
cco:hasConditionExpression rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasException
cco:hasException rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasObject
cco:hasObject rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#hasStartTime
cco:hasStartTime rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#issues
cco:issues rdf:type owl:AnnotationProperty .


###  https://www.w3id.org/cco/cco#modifiesNorm
cco:modifiesNorm rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/ns/prov#Entity
prov:Entity rdf:type owl:Class .


###  https://w3id.org/cco-gro/onto#AgreementGovernanceObligation
gro:AgreementGovernanceObligation rdf:type owl:Class ;
                                  rdfs:subClassOf cco:Obligation ;
                                  rdfs:label "Agreement Governance Obligation" ;
                                  skos:definition "An obligation to establish, maintain, and comply with formal agreements, including documentation, signing, and adherence to agreed terms." .


###  https://w3id.org/cco-gro/onto#ApprenticeshipComplianceObligation
gro:ApprenticeshipComplianceObligation rdf:type owl:Class ;
                                       rdfs:subClassOf cco:Obligation ;
                                       rdfs:label "Apprenticeship Compliance Obligation" ;
                                       skos:definition "An obligation to comply with procedural, financial, and documentation requirements related to the establishment, execution, and funding of apprenticeship programs." .


###  https://w3id.org/cco-gro/onto#ApprenticeshipFundingMisuseProhibition
gro:ApprenticeshipFundingMisuseProhibition rdf:type owl:Class ;
                                           rdfs:subClassOf cco:Prohibition ;
                                           rdfs:label "Prohibition on Misuse of Apprenticeship Funding" ;
                                           skos:definition "A regulatory norm that prohibits the improper use of funds, rates, or incentives designated for apprenticeship programs." .


###  https://w3id.org/cco-gro/onto#ApprenticeshipSupportAndProgressionPermission
gro:ApprenticeshipSupportAndProgressionPermission rdf:type owl:Class ;
                                                  rdfs:subClassOf cco:Permission ;
                                                  rdfs:label "Apprenticeship Support and Progression Permission" ;
                                                  skos:definition "A permission that allows for the funding, support, training, and progression of apprentices through various stages of their apprenticeship journey." .


###  https://w3id.org/cco-gro/onto#AssessmentProcessObligation
gro:AssessmentProcessObligation rdf:type owl:Class ;
                                rdfs:subClassOf cco:Obligation ;
                                rdfs:label "Assessment Process Obligation" ;
                                skos:definition "An obligation to carry out, manage, and maintain various stages and components of an assessment process, including development, execution, independence, documentation, and alignment." .


###  https://w3id.org/cco-gro/onto#ConfirmationAndComplianceObligation
gro:ConfirmationAndComplianceObligation rdf:type owl:Class ;
                                        rdfs:subClassOf cco:Obligation ;
                                        rdfs:label "Confirmation and Compliance Obligation" ;
                                        skos:definition "An obligation to confirm approvals, complete required declarations, and comply with post-approval or statutory requirements." .


###  https://w3id.org/cco-gro/onto#DiscretionaryAuthorityPermission
gro:DiscretionaryAuthorityPermission rdf:type owl:Class ;
                                     rdfs:subClassOf cco:Permission ;
                                     rdfs:label "Discretionary Authority Permission" ;
                                     skos:definition "A permission norm that grants entities the authority to exercise judgment in considering factors, making determinations, or taking actions within a regulatory framework." .


###  https://w3id.org/cco-gro/onto#EligibilityAndRequirementsObligation
gro:EligibilityAndRequirementsObligation rdf:type owl:Class ;
                                         rdfs:subClassOf cco:Obligation ;
                                         rdfs:label "Eligibility and Requirements Obligation" ;
                                         skos:definition "An obligation to meet, verify, or maintain eligibility criteria and regulatory or programmatic requirements." .


###  https://w3id.org/cco-gro/onto#EligibilityBasedFinancialAndEnrollmentPermission
gro:EligibilityBasedFinancialAndEnrollmentPermission rdf:type owl:Class ;
                                                     rdfs:subClassOf cco:Permission ;
                                                     rdfs:label "Eligibility-Based Financial and Enrollment Permission" ;
                                                     skos:definition "A permission that grants students access to financial assistance, enrollment benefits, or academic status changes based on demonstrated eligibility criteria." .


###  https://w3id.org/cco-gro/onto#EvidenceManagementObligation
gro:EvidenceManagementObligation rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Obligation ;
                                 rdfs:label "Evidence Management Obligation" ;
                                 skos:definition "An obligation to manage, retain, provide, document, or possess evidence in accordance with regulatory requirements." .


###  https://w3id.org/cco-gro/onto#FeeManagementObligation
gro:FeeManagementObligation rdf:type owl:Class ;
                            rdfs:subClassOf cco:Obligation ;
                            rdfs:label "Fee Management Obligation" ;
                            skos:definition "An obligation to manage, disclose, structure, and apply fees in a transparent, reasonable, and systematic manner." .


###  https://w3id.org/cco-gro/onto#FundingAccessAndAllocationPermission
gro:FundingAccessAndAllocationPermission rdf:type owl:Class ;
                                         rdfs:subClassOf cco:Permission ;
                                         rdfs:label "Funding Access and Allocation Permission" ;
                                         skos:definition "A permission that authorizes access to, allocation of, or claims against funding resources for educational, assistive, or support purposes." .


###  https://w3id.org/cco-gro/onto#FundingEligibilityAndDisbursementObligation
gro:FundingEligibilityAndDisbursementObligation rdf:type owl:Class ;
                                                rdfs:subClassOf cco:Obligation ;
                                                rdfs:label "Funding Eligibility and Disbursement Obligation" ;
                                                skos:definition "An obligation to assess, confirm, and manage eligibility for funding, followed by the proper disbursement or claiming of funds, including direct retention or payment to providers and subcontractors." .


###  https://w3id.org/cco-gro/onto#InformationDisclosureObligation
gro:InformationDisclosureObligation rdf:type owl:Class ;
                                    rdfs:subClassOf cco:Obligation ;
                                    rdfs:label "Information Disclosure Obligation" ;
                                    skos:definition "An obligation to provide specified educational information to students or stakeholders before or during enrolment and throughout the course lifecycle." .


###  https://w3id.org/cco-gro/onto#LoanAndEnrolmentMisconductProhibition
gro:LoanAndEnrolmentMisconductProhibition rdf:type owl:Class ;
                                          rdfs:subClassOf cco:Prohibition ;
                                          rdfs:label "Prohibition of Misconduct in Loan and Enrolment Practices" ;
                                          skos:definition "A prohibition on actions involving improper financial demands, loan misrepresentation, unauthorized payment or borrowing, and misleading suggestions related to enrolment or assistance eligibility." .


###  https://w3id.org/cco-gro/onto#NoticeAndProcedureObligation
gro:NoticeAndProcedureObligation rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Obligation ;
                                 rdfs:label "Notice and Procedure Obligation" ;
                                 skos:definition "An obligation to provide formal notices and maintain established procedures in regulatory or administrative processes." .


###  https://w3id.org/cco-gro/onto#PaymentObligation
gro:PaymentObligation rdf:type owl:Class ;
                      rdfs:subClassOf cco:Obligation ;
                      rdfs:label "Payment Obligation" ;
                      skos:definition "An obligation to make, manage, or arrange payments or repayments under specified conditions." .


###  https://w3id.org/cco-gro/onto#ProviderComplianceObligation
gro:ProviderComplianceObligation rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Obligation ;
                                 rdfs:label "Provider Compliance Obligation" ;
                                 skos:definition "Obligations requiring entities to meet eligibility, maintain status, comply with regulations, and uphold transparency and procedural standards as approved providers." .


###  https://w3id.org/cco-gro/onto#RecreditAndReborrowPermission
gro:RecreditAndReborrowPermission rdf:type owl:Class ;
                                  rdfs:subClassOf cco:Permission ;
                                  rdfs:label "Recredit and Re-borrow Permission" ;
                                  skos:definition "Permission to recredit a HELP balance or re-borrow repaid amounts under specified conditions." .


###  https://w3id.org/cco-gro/onto#RegulatoryComplianceObligation
gro:RegulatoryComplianceObligation rdf:type owl:Class ;
                                   rdfs:subClassOf cco:Obligation ;
                                   rdfs:label "Regulatory Compliance Obligation" ;
                                   skos:definition "An obligation to adhere to specified legal, regulatory, or standard-based requirements, including ongoing adherence, information management, and rule referencing." .


###  https://w3id.org/cco-gro/onto#StudentAcademicAndFinancialComplianceObligation
gro:StudentAcademicAndFinancialComplianceObligation rdf:type owl:Class ;
                                                    rdfs:subClassOf cco:Obligation ;
                                                    rdfs:label "Student Academic and Financial Compliance Obligation" ;
                                                    skos:definition "An obligation requiring students to meet academic progress, enrollment, and financial responsibilities to maintain eligibility and compliance with educational funding and institutional requirements." .


###  https://w3id.org/cco-gro/onto#TrainingAndDeliveryObligation
gro:TrainingAndDeliveryObligation rdf:type owl:Class ;
                                  rdfs:subClassOf cco:Obligation ;
                                  rdfs:label "Training and Delivery Obligation" ;
                                  skos:definition "An obligation requiring providers to deliver, manage, and be accountable for training and learning activities, including assessment and off-the-job components." .


###  https://w3id.org/cco-gro/onto#TrainingDeliveryAndDocumentationObligation
gro:TrainingDeliveryAndDocumentationObligation rdf:type owl:Class ;
                                               rdfs:subClassOf cco:Obligation ;
                                               rdfs:label "Training Delivery and Documentation Obligation" ;
                                               skos:definition "An obligation to deliver, document, and maintain records of training activities, including off-the-job training, skill relevance, and planned parameters." .


###  https://w3id.org/cco-gro/onto#TuitionFeeChargingAndInclusionProhibition
gro:TuitionFeeChargingAndInclusionProhibition rdf:type owl:Class ;
                                              rdfs:subClassOf cco:Prohibition ;
                                              rdfs:label "Prohibition on Charging and Including Tuition Fees and Associated Costs" ;
                                              skos:definition "A prohibition on charging excessive, unnecessary, or unauthorized tuition fees and on including non-essential goods, services, or costs within tuition fees." .


###  https://w3id.org/cco-gro/onto#TuitionFeeManagementObligation
gro:TuitionFeeManagementObligation rdf:type owl:Class ;
                                   rdfs:subClassOf cco:Obligation ;
                                   rdfs:label "Tuition Fee Management Obligation" ;
                                   skos:definition "An obligation to manage tuition fees through setting, publishing, explaining, refunding, and disclosing related financial information." .


###  https://w3id.org/cco-gro/onto/ca#ABEStudent
gro-ca:ABEStudent rdf:type owl:Class ;
                  rdfs:subClassOf cco:Role ;
                  rdfs:label "ABE Student" ;
                  skos:definition "A student studying at the Adult Basic Education (ABE) level in British Columbia" .


###  https://w3id.org/cco-gro/onto/ca#APSD
gro-ca:APSD rdf:type owl:Class ;
            rdfs:subClassOf cco:Resource ;
            rdfs:label "APSD Funding" ;
            skos:definition "The Assistance Program for Students with Disabilities (APSD) helps students with disabilities cover the costs of exceptional education-related services and equipment." .


###  https://w3id.org/cco-gro/onto/ca#APSDApplicationForm
gro-ca:APSDApplicationForm rdf:type owl:Class ;
                           rdfs:subClassOf cco:Resource ;
                           rdfs:label "APSD Application Form" ;
                           skos:definition "The B.C. Assistance Program for Students with Disabilities application form" .


###  https://w3id.org/cco-gro/onto/ca#APSDProgramFunding
gro-ca:APSDProgramFunding rdf:type owl:Class ;
                          rdfs:subClassOf cco:Resource ;
                          rdfs:label "APSD Program Funding" ;
                          skos:definition "Funding provided under the Accessibility Program for Students with Disabilities (APSD) for assistive services and equipment." .


###  https://w3id.org/cco-gro/onto/ca#APSDStudentRole
gro-ca:APSDStudentRole rdf:type owl:Class ;
                       rdfs:subClassOf cco:Role ;
                       rdfs:label "APSD Student Role" ;
                       skos:definition "The role of a student eligible for the Accessibility Program for Students with Disabilities (APSD) funding in Canada." .


###  https://w3id.org/cco-gro/onto/ca#ASFProgram
gro-ca:ASFProgram rdf:type owl:Class ;
                  rdfs:subClassOf cco:Resource ;
                  rdfs:label "ASF Program" ;
                  skos:definition "A program under the Canada Student Financial Assistance framework for which students may apply." .


###  https://w3id.org/cco-gro/onto/ca#ASFProgramEligibility
gro-ca:ASFProgramEligibility rdf:type owl:Class ;
                             rdfs:subClassOf cco:Resource ;
                             rdfs:label "ASF Program Eligibility" ;
                             skos:definition "Eligibility for ASF programs covering all years of post-secondary studies, including those beyond the undergraduate level, conditional on meeting other student financial assistance eligibility criteria." ,
                                             "Eligibility for ASF programs covering all years of post-secondary studies, including those beyond the undergraduate level." .


###  https://w3id.org/cco-gro/onto/ca#ASFProgramFunding
gro-ca:ASFProgramFunding rdf:type owl:Class ;
                         rdfs:subClassOf cco:Resource ;
                         rdfs:label "ASF Program Funding" ;
                         skos:definition "Funding allocated under the Accessibility Supports Framework (ASF) programs, including grants for students with disabilities." .


###  https://w3id.org/cco-gro/onto/ca#AcademicYear
gro-ca:AcademicYear rdf:type owl:Class ;
                    rdfs:subClassOf cco:Condition ;
                    rdfs:label "Academic Year" ;
                    skos:definition "For the purpose of assessment of need, the academic year is defined by the post-secondary institution and is based on the study period for which student financial assistance is required that starts between August 1 of the current year and July 31 of the following year. The academic year is subject to a maximum length of 12 months (52 weeks) and may include multiple terms or semesters, including spring and/or summer sessions." ;
                    prov:wasDerivedFrom data:CAN_UNIT_00814 .


###  https://w3id.org/cco-gro/onto/ca#AccessibilityCoordinatorRole
gro-ca:AccessibilityCoordinatorRole rdf:type owl:Class ;
                                    rdfs:subClassOf cco:RegulatoryAuthorityRole ;
                                    rdfs:label "Accessibility Coordinator Role" ;
                                    skos:definition "The role of Accessibility Coordinator at a B.C. public post-secondary institution" .


###  https://w3id.org/cco-gro/onto/ca#AccessibilitySupportsFunding
gro-ca:AccessibilitySupportsFunding rdf:type owl:Class ;
                                    rdfs:subClassOf cco:Resource ;
                                    rdfs:label "Accessibility Supports Funding" ;
                                    skos:definition "Funding allocated under the Accessibility Supports Framework, including bursaries, assistive technology, and accessibility services for students and institutions based on need." .


###  https://w3id.org/cco-gro/onto/ca#AccessibleEducationAndTrainingCourses
gro-ca:AccessibleEducationAndTrainingCourses rdf:type owl:Class ;
                                             rdfs:subClassOf cco:Resource ;
                                             rdfs:label "Accessible Education and Training Courses" ;
                                             skos:definition "Accessible Education and Training (AET) Courses at the adult basic education level that are designed for individuals with permanent disabilities or combinations of learning difficulties." ;
                                             prov:wasDerivedFrom data:CAN_UNIT_00815 .


###  https://w3id.org/cco-gro/onto/ca#Accreditation
gro-ca:Accreditation rdf:type owl:Class ;
                     rdfs:subClassOf cco:Resource ;
                     rdfs:label "Accreditation" ;
                     skos:definition "Accreditation status of an international institution as verified by an approved accrediting body." ;
                     prov:wasDerivedFrom data:CAN_UNIT_00097 .


###  https://w3id.org/cco-gro/onto/ca#AdditionalFunds
gro-ca:AdditionalFunds rdf:type owl:Class ;
                       rdfs:subClassOf cco:Resource ;
                       rdfs:label "Additional Funds" ;
                       skos:definition "Supplementary financial resources provided for a study period extension." .


###  https://w3id.org/cco-gro/onto/ca#AdditionalWeeklyAllowance
gro-ca:AdditionalWeeklyAllowance rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Resource ;
                                 rdfs:label "Additional Weekly Allowance" ;
                                 skos:definition "An additional weekly allowance to assist with the costs of maintaining a separate residence for married or common-law students living away from the family home." .


###  https://w3id.org/cco-gro/onto/ca#AdhereToResponsibilitiesAction
gro-ca:AdhereToResponsibilitiesAction rdf:type owl:Class ;
                                      rdfs:subClassOf cco:Action ;
                                      rdfs:label "Adhere to Responsibilities" ;
                                      skos:definition "The action of complying with and fulfilling assigned responsibilities on an ongoing basis." .


###  https://w3id.org/cco-gro/onto/ca#AdministrativeMeasuresRestriction
gro-ca:AdministrativeMeasuresRestriction rdf:type owl:Class ;
                                         rdfs:subClassOf cco:Condition ;
                                         rdfs:label "Administrative Measures Restriction" ;
                                         skos:definition "A restriction imposed by administrative measures that limits a borrower's activities or status." .


###  https://w3id.org/cco-gro/onto/ca#AdultUpgradingGrant
gro-ca:AdultUpgradingGrant rdf:type owl:Class ;
                           rdfs:subClassOf cco:Resource ;
                           rdfs:label "Adult Upgrading Grant" ;
                           skos:definition "A funding allocation for students enrolled in adult upgrading programs, with amounts varying by program length." .


###  https://w3id.org/cco-gro/onto/ca#AdultUpgradingGrantPolicyManual
gro-ca:AdultUpgradingGrantPolicyManual rdf:type owl:Class ;
                                       rdfs:subClassOf cco:Resource ;
                                       rdfs:label "Adult Upgrading Grant Policy Manual" ;
                                       skos:definition "The Adult Upgrading Grant Policy and Procedures Manual, which contains the policy set out by the Province of British Columbia for determining student eligibility." .


###  https://w3id.org/cco-gro/onto/ca#AllowableCost
gro-ca:AllowableCost rdf:type owl:Class ;
                     rdfs:subClassOf cco:Resource ;
                     rdfs:label "Allowable Cost" ;
                     skos:definition "StudentAid BC considers specific allowable costs that will have a direct impact on the student during their study period. Many of the allowable costs include maximums (caps) set in federal and provincial policy." ;
                     prov:wasDerivedFrom data:CAN_UNIT_00385 .


###  https://w3id.org/cco-gro/onto/ca#AppealCommittee
gro-ca:AppealCommittee rdf:type owl:Class ;
                       rdfs:subClassOf cco:Organisation ;
                       rdfs:label "Appeal Committee" ;
                       skos:definition "A body that provides students with a fair and unbiased opportunity to have their appeal decision reconsidered." .


###  https://w3id.org/cco-gro/onto/ca#AppealDecision
gro-ca:AppealDecision rdf:type owl:Class ;
                      rdfs:subClassOf cco:Resource ;
                      rdfs:label "Appeal Decision" ;
                      skos:definition "A decision rendered on an appeal, communicated in writing to the institution." .


###  https://w3id.org/cco-gro/onto/ca#AppealDeniedAndEligible
gro-ca:AppealDeniedAndEligible rdf:type owl:Class ;
                               rdfs:subClassOf cco:Condition ;
                               rdfs:label "Appeal Denied and Eligible" ;
                               skos:definition "The condition where a student's appeal is denied and the appealed issue was included in the list of policy and criteria eligible for appeal." .


###  https://w3id.org/cco-gro/onto/ca#AppealProcess
gro-ca:AppealProcess rdf:type owl:Class ;
                     rdfs:subClassOf cco:Condition ;
                     rdfs:label "Appeal Process" ;
                     skos:definition "The condition during which an appeal is underway, triggering discretionary adjustments to student financial assistance." .


###  https://w3id.org/cco-gro/onto/ca#AppealRequestForm
gro-ca:AppealRequestForm rdf:type owl:Class ;
                         rdfs:subClassOf cco:Resource ;
                         rdfs:label "Appeal Request Form" ;
                         skos:definition "The appropriate form used by students to initiate an appeal." .


###  https://w3id.org/cco-gro/onto/ca#AppealStudent
gro-ca:AppealStudent rdf:type owl:Class ;
                     rdfs:subClassOf cco:Role ;
                     rdfs:label "Appeal (Student)" ;
                     skos:definition "An appeal is a formal request for a review of a student’s application assessment to take into account exceptional circumstances demonstrated or proven by the applicant, which may result in StudentAid BC setting aside standard program policy." ;
                     prov:wasDerivedFrom data:CAN_UNIT_00816 .


###  https://w3id.org/cco-gro/onto/ca#Appendix1
gro-ca:Appendix1 rdf:type owl:Class ;
                 rdfs:subClassOf cco:Resource ;
                 rdfs:label "Appendix 1" ;
                 skos:definition "A form used to report parental income and assets when parents live outside Canada." ;
                 prov:wasDerivedFrom data:CAN_UNIT_00432 .


###  https://w3id.org/cco-gro/onto/ca#Appendix3Form
gro-ca:Appendix3Form rdf:type owl:Class ;
                     rdfs:subClassOf cco:Resource ;
                     rdfs:label "Appendix 3 Form" ;
                     skos:definition "A form indicating the cost of tuition, books, and fees for a post-secondary institution." .


###  https://w3id.org/cco-gro/onto/ca#Appendix7
gro-ca:Appendix7 rdf:type owl:Class ;
                 rdfs:subClassOf cco:Resource ;
                 rdfs:label "Appendix 7" ;
                 skos:definition "A required documentation form for certain circumstance changes in Canadian student funding programs." .


###  https://w3id.org/cco-gro/onto/ca#Appendix8
gro-ca:Appendix8 rdf:type owl:Class ;
                 rdfs:subClassOf cco:Resource ;
                 rdfs:label "Appendix 8" ;
                 skos:definition "A form with supporting medical documentation." .


###  https://w3id.org/cco-gro/onto/ca#Appendix8DisabilityProgramsApplication
gro-ca:Appendix8DisabilityProgramsApplication rdf:type owl:Class ;
                                              rdfs:subClassOf cco:Resource ;
                                              rdfs:label "Appendix 8 - Disability Programs Application" ;
                                              skos:definition "The Appendix 8 form required for students applying for ASF disability programs." .


###  https://w3id.org/cco-gro/onto/ca#Applicant
gro-ca:Applicant rdf:type owl:Class ;
                 rdfs:subClassOf cco:Role ;
                 rdfs:label "Applicant" ;
                 skos:definition "A role representing an individual or entity that applies for something, such as reimbursement." .


###  https://w3id.org/cco-gro/onto/ca#ApplicantMultipleDisabilities
gro-ca:ApplicantMultipleDisabilities rdf:type owl:Class ;
                                     rdfs:subClassOf cco:Role ;
                                     rdfs:label "Applicant with Multiple Disabilities" ;
                                     skos:definition "An applicant being verified for multiple disabilities under Canadian regulations." ;
                                     prov:wasDerivedFrom data:CAN_UNIT_00318 .


###  https://w3id.org/cco-gro/onto/ca#Application
gro-ca:Application rdf:type owl:Class ;
                   rdfs:subClassOf cco:Resource ;
                   rdfs:label "Application" ;
                   skos:definition "An application for a regulatory program or benefit." .


###  https://w3id.org/cco-gro/onto/ca#ApplicationAndLoanPayments
gro-ca:ApplicationAndLoanPayments rdf:type owl:Class ;
                                  rdfs:subClassOf cco:Resource .


###  https://w3id.org/cco-gro/onto/ca#ApprenticeshipStudentRole
gro-ca:ApprenticeshipStudentRole rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Role ;
                                 rdfs:label "Apprenticeship Student Role" ;
                                 skos:definition "The role of a student who is an apprentice, as referenced in StudentAid BC eligibility rules." .


###  https://w3id.org/cco-gro/onto/ca#AssessedFinancialNeed
gro-ca:AssessedFinancialNeed rdf:type owl:Class ;
                             rdfs:subClassOf cco:Resource ;
                             rdfs:label "Assessed Financial Need" ;
                             skos:definition "The assessed financial need of a student, calculated as allowable costs minus contributions minus resources, which determines the amount of Canada-B.C. integrated student loan and grant funding a student is eligible to receive." ,
                                             "The calculated financial need of a student, determined by evaluating allowable costs against available resources as part of the StudentAid BC assessment process." ;
                             prov:wasDerivedFrom data:CAN_UNIT_00354 ,
                                                 data:CAN_UNIT_00357 .


###  https://w3id.org/cco-gro/onto/ca#AssessedNeed
gro-ca:AssessedNeed rdf:type owl:Class ;
                    rdfs:subClassOf cco:Resource ;
                    rdfs:label "Assessed Need" ;
                    skos:definition "Assessed need is used to determine the amount of federal and provincial student financial assistance that a student is eligible to receive from StudentAid BC." ,
                                    "The financial need assessment process considers costs and resources to determine assessed need. Total costs less total resources." ;
                    prov:wasDerivedFrom data:CAN_UNIT_00358 ,
