###  https://w3id.org/cco-gro/onto/uk#OffTheJobTraining
gro-uk:OffTheJobTraining rdf:type owl:Class ;
                         rdfs:subClassOf cco:Action ,
                                         cco:Resource ;
                         rdfs:label "Off-the-Job Training" ,
                                    "Off-the-job Training (OTJT)" ;
                         skos:definition "All required off-the-job training that enables an apprentice to reach full occupational competence against the standard." ,
                                         "Off-the-job training (OTJT) is defined as training which a) is delivering new knowledge, skills and behaviours, b) is directly relevant to the apprenticeship, c) is delivered in the apprentice’s normal working hours (but outside of their productive job role) and d) excludes ineligible activities such as standalone English and maths qualifications. The volume delivered must be based on the published minimum requirement for the standard, adjusted to account for evidenced prior learning that has been identified in the initial assessment of the apprentice." ,
                                         "Training delivered outside the apprentice's normal working duties to achieve occupational competence." ,
                                         "Training delivered outside the normal work environment as part of an apprenticeship." ,
                                         "Training delivered to an apprentice that is not part of their normal work duties, as defined by statutory requirements." ,
                                         "Training delivered to an apprentice that is not part of their normal working duties." ,
                                         "Training undertaken outside of normal working duties, delivering new skills relevant to an apprenticeship standard." ;
                         prov:wasDerivedFrom data:UK_UNIT_01211 .


