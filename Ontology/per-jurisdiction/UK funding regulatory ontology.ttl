###  http://www.w3.org/ns/prov#Entity
prov:Entity rdf:type owl:Class .


###  https://w3id.org/cco-gro/data#UK_UNIT_00225_object_36c7d0
data:UK_UNIT_00225_object_36c7d0 rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Resource .


###  https://w3id.org/cco-gro/data#UK_UNIT_00568_object_73d80c
data:UK_UNIT_00568_object_73d80c rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Resource .


###  https://w3id.org/cco-gro/data#UK_UNIT_00597_object_a8b8ea
data:UK_UNIT_00597_object_a8b8ea rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Resource .


###  https://w3id.org/cco-gro/onto#AgreementGovernanceObligation
gro:AgreementGovernanceObligation rdf:type owl:Class ;
                                  rdfs:subClassOf cco:Obligation ;
                                  rdfs:label "Agreement Governance Obligation" ;
                                  skos:definition "An obligation to establish, maintain, and comply with formal agreements, including documentation, signing, and adherence to agreed terms." .


###  https://w3id.org/cco-gro/onto#ApprenticeshipComplianceObligation
gro:ApprenticeshipComplianceObligation rdf:type owl:Class ;
                                       rdfs:subClassOf cco:Obligation ;
                                       rdfs:label "Apprenticeship Compliance Obligation" ;
                                       skos:definition "An obligation to comply with procedural, financial, and documentation requirements related to the establishment, execution, and funding of apprenticeship programs." .


###  https://w3id.org/cco-gro/onto#ApprenticeshipFundingMisuseProhibition
gro:ApprenticeshipFundingMisuseProhibition rdf:type owl:Class ;
                                           rdfs:subClassOf cco:Prohibition ;
                                           rdfs:label "Prohibition on Misuse of Apprenticeship Funding" ;
                                           skos:definition "A regulatory norm that prohibits the improper use of funds, rates, or incentives designated for apprenticeship programs." .


###  https://w3id.org/cco-gro/onto#ApprenticeshipSupportAndProgressionPermission
gro:ApprenticeshipSupportAndProgressionPermission rdf:type owl:Class ;
                                                  rdfs:subClassOf cco:Permission ;
                                                  rdfs:label "Apprenticeship Support and Progression Permission" ;
                                                  skos:definition "A permission that allows for the funding, support, training, and progression of apprentices through various stages of their apprenticeship journey." .


###  https://w3id.org/cco-gro/onto#AssessmentProcessObligation
gro:AssessmentProcessObligation rdf:type owl:Class ;
                                rdfs:subClassOf cco:Obligation ;
                                rdfs:label "Assessment Process Obligation" ;
                                skos:definition "An obligation to carry out, manage, and maintain various stages and components of an assessment process, including development, execution, independence, documentation, and alignment." .


###  https://w3id.org/cco-gro/onto#ConfirmationAndComplianceObligation
gro:ConfirmationAndComplianceObligation rdf:type owl:Class ;
                                        rdfs:subClassOf cco:Obligation ;
                                        rdfs:label "Confirmation and Compliance Obligation" ;
                                        skos:definition "An obligation to confirm approvals, complete required declarations, and comply with post-approval or statutory requirements." .


###  https://w3id.org/cco-gro/onto#DiscretionaryAuthorityPermission
gro:DiscretionaryAuthorityPermission rdf:type owl:Class ;
                                     rdfs:subClassOf cco:Permission ;
                                     rdfs:label "Discretionary Authority Permission" ;
                                     skos:definition "A permission norm that grants entities the authority to exercise judgment in considering factors, making determinations, or taking actions within a regulatory framework." .


###  https://w3id.org/cco-gro/onto#EligibilityAndRequirementsObligation
gro:EligibilityAndRequirementsObligation rdf:type owl:Class ;
                                         rdfs:subClassOf cco:Obligation ;
                                         rdfs:label "Eligibility and Requirements Obligation" ;
                                         skos:definition "An obligation to meet, verify, or maintain eligibility criteria and regulatory or programmatic requirements." .


###  https://w3id.org/cco-gro/onto#EligibilityBasedFinancialAndEnrollmentPermission
gro:EligibilityBasedFinancialAndEnrollmentPermission rdf:type owl:Class ;
                                                     rdfs:subClassOf cco:Permission ;
                                                     rdfs:label "Eligibility-Based Financial and Enrollment Permission" ;
                                                     skos:definition "A permission that grants students access to financial assistance, enrollment benefits, or academic status changes based on demonstrated eligibility criteria." .


###  https://w3id.org/cco-gro/onto#EvidenceManagementObligation
gro:EvidenceManagementObligation rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Obligation ;
                                 rdfs:label "Evidence Management Obligation" ;
                                 skos:definition "An obligation to manage, retain, provide, document, or possess evidence in accordance with regulatory requirements." .


###  https://w3id.org/cco-gro/onto#FeeManagementObligation
gro:FeeManagementObligation rdf:type owl:Class ;
                            rdfs:subClassOf cco:Obligation ;
                            rdfs:label "Fee Management Obligation" ;
                            skos:definition "An obligation to manage, disclose, structure, and apply fees in a transparent, reasonable, and systematic manner." .


###  https://w3id.org/cco-gro/onto#FundingAccessAndAllocationPermission
gro:FundingAccessAndAllocationPermission rdf:type owl:Class ;
                                         rdfs:subClassOf cco:Permission ;
                                         rdfs:label "Funding Access and Allocation Permission" ;
                                         skos:definition "A permission that authorizes access to, allocation of, or claims against funding resources for educational, assistive, or support purposes." .


###  https://w3id.org/cco-gro/onto#FundingEligibilityAndDisbursementObligation
gro:FundingEligibilityAndDisbursementObligation rdf:type owl:Class ;
                                                rdfs:subClassOf cco:Obligation ;
                                                rdfs:label "Funding Eligibility and Disbursement Obligation" ;
                                                skos:definition "An obligation to assess, confirm, and manage eligibility for funding, followed by the proper disbursement or claiming of funds, including direct retention or payment to providers and subcontractors." .


###  https://w3id.org/cco-gro/onto#InformationDisclosureObligation
gro:InformationDisclosureObligation rdf:type owl:Class ;
                                    rdfs:subClassOf cco:Obligation ;
                                    rdfs:label "Information Disclosure Obligation" ;
                                    skos:definition "An obligation to provide specified educational information to students or stakeholders before or during enrolment and throughout the course lifecycle." .


###  https://w3id.org/cco-gro/onto#LoanAndEnrolmentMisconductProhibition
gro:LoanAndEnrolmentMisconductProhibition rdf:type owl:Class ;
                                          rdfs:subClassOf cco:Prohibition ;
                                          rdfs:label "Prohibition of Misconduct in Loan and Enrolment Practices" ;
                                          skos:definition "A prohibition on actions involving improper financial demands, loan misrepresentation, unauthorized payment or borrowing, and misleading suggestions related to enrolment or assistance eligibility." .


###  https://w3id.org/cco-gro/onto#NoticeAndProcedureObligation
gro:NoticeAndProcedureObligation rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Obligation ;
                                 rdfs:label "Notice and Procedure Obligation" ;
                                 skos:definition "An obligation to provide formal notices and maintain established procedures in regulatory or administrative processes." .


###  https://w3id.org/cco-gro/onto#PaymentObligation
gro:PaymentObligation rdf:type owl:Class ;
                      rdfs:subClassOf cco:Obligation ;
                      rdfs:label "Payment Obligation" ;
                      skos:definition "An obligation to make, manage, or arrange payments or repayments under specified conditions." .


###  https://w3id.org/cco-gro/onto#ProviderComplianceObligation
gro:ProviderComplianceObligation rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Obligation ;
                                 rdfs:label "Provider Compliance Obligation" ;
                                 skos:definition "Obligations requiring entities to meet eligibility, maintain status, comply with regulations, and uphold transparency and procedural standards as approved providers." .


###  https://w3id.org/cco-gro/onto#RecreditAndReborrowPermission
gro:RecreditAndReborrowPermission rdf:type owl:Class ;
                                  rdfs:subClassOf cco:Permission ;
                                  rdfs:label "Recredit and Re-borrow Permission" ;
                                  skos:definition "Permission to recredit a HELP balance or re-borrow repaid amounts under specified conditions." .


###  https://w3id.org/cco-gro/onto#RegulatoryComplianceObligation
gro:RegulatoryComplianceObligation rdf:type owl:Class ;
                                   rdfs:subClassOf cco:Obligation ;
                                   rdfs:label "Regulatory Compliance Obligation" ;
                                   skos:definition "An obligation to adhere to specified legal, regulatory, or standard-based requirements, including ongoing adherence, information management, and rule referencing." .


###  https://w3id.org/cco-gro/onto#StudentAcademicAndFinancialComplianceObligation
gro:StudentAcademicAndFinancialComplianceObligation rdf:type owl:Class ;
                                                    rdfs:subClassOf cco:Obligation ;
                                                    rdfs:label "Student Academic and Financial Compliance Obligation" ;
                                                    skos:definition "An obligation requiring students to meet academic progress, enrollment, and financial responsibilities to maintain eligibility and compliance with educational funding and institutional requirements." .


###  https://w3id.org/cco-gro/onto#TrainingAndDeliveryObligation
gro:TrainingAndDeliveryObligation rdf:type owl:Class ;
                                  rdfs:subClassOf cco:Obligation ;
                                  rdfs:label "Training and Delivery Obligation" ;
                                  skos:definition "An obligation requiring providers to deliver, manage, and be accountable for training and learning activities, including assessment and off-the-job components." .


###  https://w3id.org/cco-gro/onto#TrainingDeliveryAndDocumentationObligation
gro:TrainingDeliveryAndDocumentationObligation rdf:type owl:Class ;
                                               rdfs:subClassOf cco:Obligation ;
                                               rdfs:label "Training Delivery and Documentation Obligation" ;
                                               skos:definition "An obligation to deliver, document, and maintain records of training activities, including off-the-job training, skill relevance, and planned parameters." .


###  https://w3id.org/cco-gro/onto#TuitionFeeChargingAndInclusionProhibition
gro:TuitionFeeChargingAndInclusionProhibition rdf:type owl:Class ;
                                              rdfs:subClassOf cco:Prohibition ;
                                              rdfs:label "Prohibition on Charging and Including Tuition Fees and Associated Costs" ;
                                              skos:definition "A prohibition on charging excessive, unnecessary, or unauthorized tuition fees and on including non-essential goods, services, or costs within tuition fees." .


###  https://w3id.org/cco-gro/onto#TuitionFeeManagementObligation
gro:TuitionFeeManagementObligation rdf:type owl:Class ;
                                   rdfs:subClassOf cco:Obligation ;
                                   rdfs:label "Tuition Fee Management Obligation" ;
                                   skos:definition "An obligation to manage tuition fees through setting, publishing, explaining, refunding, and disclosing related financial information." .


###  https://w3id.org/cco-gro/onto/uk#APAR
gro-uk:APAR rdf:type owl:Class ;
            rdfs:subClassOf cco:Resource ;
            rdfs:label "APAR" ;
            skos:definition "The published Approved Provider and Apprenticeship Register." .


###  https://w3id.org/cco-gro/onto/uk#AcceleratedApprenticeship
gro-uk:AcceleratedApprenticeship rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Resource ;
                                 rdfs:label "Accelerated Apprenticeship" ;
                                 skos:definition "An accelerated apprenticeship is where the apprentice’s planned duration is shorter (by at least 3 months) than the typical duration of the standard, based on prior learning." ;
                                 prov:wasDerivedFrom data:UK_UNIT_01187 .


###  https://w3id.org/cco-gro/onto/uk#ActiveLearning
gro-uk:ActiveLearning rdf:type owl:Class ;
                      rdfs:subClassOf cco:Action ,
                                      cco:Resource ;
                      rdfs:label "Active Learning" ;
                      skos:definition "Active learning for English and/or maths as part of an apprenticeship programme." ,
                                      "Learning activities carried out by an apprentice in line with a signed training plan, distinct from off-the-job training active learning." ,
                                      "The delivery of active learning for English and/or maths as described in the training plan." .


###  https://w3id.org/cco-gro/onto/uk#ActiveLearningRequirement
gro-uk:ActiveLearningRequirement rdf:type owl:Class ;
                                 rdfs:subClassOf cco:Condition ;
                                 rdfs:label "Active Learning Requirement" ;
                                 skos:definition "The requirement that delivery of English and maths must be in line with the active learning requirement." .


###  https://w3id.org/cco-gro/onto/uk#ActualCosts
gro-uk:ActualCosts rdf:type owl:Class ;
                   rdfs:subClassOf cco:Resource ;
                   rdfs:label "Actual Costs" ;
                   skos:definition "The actual costs incurred for delivery of apprenticeship services." .


###  https://w3id.org/cco-gro/onto/uk#AdditionalCosts
gro-uk:AdditionalCosts rdf:type owl:Class ;
                       rdfs:subClassOf cco:Resource ;
                       rdfs:label "Additional Costs" ;
                       skos:definition "Costs exceeding the funding band maximum for an apprenticeship." .


###  https://w3id.org/cco-gro/onto/uk#AdditionalLearningForResitExam
gro-uk:AdditionalLearningForResitExam rdf:type owl:Class ;
                                      rdfs:subClassOf cco:Resource ;
                                      rdfs:label "Additional Learning for Resit Exam" ;
                                      skos:definition "Additional learning required to re-sit an exam linked to either a mandatory qualification or an end-point assessment." ;
                                      prov:wasDerivedFrom data:UK_UNIT_00443 .


###  https://w3id.org/cco-gro/onto/uk#AdditionalPayment
gro-uk:AdditionalPayment rdf:type owl:Class ;
                         rdfs:subClassOf cco:Resource ;
                         rdfs:label "Additional Payment" ;
                         skos:definition "A funding payment that is due to be paid to an apprentice, but may be delayed under certain conditions." ,
                                         "A supplementary payment made to an employer beyond standard amounts." ,
                                         "An additional payment received as part of the two-year growth pilot." ,
                                         "Any additional payment and/or care leaver bursary claimed under the provision." .


###  https://w3id.org/cco-gro/onto/uk#AdvancedLearnerLoan
gro-uk:AdvancedLearnerLoan rdf:type owl:Class ;
                           rdfs:subClassOf cco:Resource ;
                           rdfs:label "Advanced Learner Loan" ;
                           skos:definition "Loans for individuals aged 19+ to provide financial support towards tuition costs. These loans are paid directly to the college or training organisation. These are not applicable to apprenticeships." ;
                           prov:wasDerivedFrom data:UK_UNIT_01188 .


###  https://w3id.org/cco-gro/onto/uk#Age16To18Role
gro-uk:Age16To18Role rdf:type owl:Class ;
                     rdfs:subClassOf cco:Role ;
                     rdfs:label "16 to 18-year-old Role" ;
                     skos:definition "A role held by individuals aged between 16 and 18 years" .


###  https://w3id.org/cco-gro/onto/uk#AgreedPrice
gro-uk:AgreedPrice rdf:type owl:Class ;
                   rdfs:subClassOf cco:Resource ;
                   rdfs:label "Agreed Price" ;
                   skos:definition "The agreed price that is entered into the ILR and the apprenticeship service" .


###  https://w3id.org/cco-gro/onto/uk#Agreement
gro-uk:Agreement rdf:type owl:Class ;
                 rdfs:subClassOf cco:Resource ;
                 rdfs:label "Agreement" ;
                 skos:definition "A contractual agreement between the provider and the regulatory authority for the provision of apprenticeship funded delivery." ,
                                 "A formal agreement document to be completed and signed by the provider, employer, and apprentice regarding KIT/SPLIT days for apprenticeship off-the-job training and/or assessment." ,
                                 "A formal arrangement or contract between parties, subject to revision or creation under changing circumstances." ,
                                 "A mutual arrangement between parties, such as an agreement to continue an apprenticeship with a new employer via a transfer of levy funds." ,
                                 "A written agreement entered into between a provider and an employer." .


###  https://w3id.org/cco-gro/onto/uk#AllParties
gro-uk:AllParties rdf:type owl:Class ;
                  rdfs:subClassOf cco:Agent ;
                  rdfs:label "All Parties" ;
                  skos:altLabel "All parties" ;
                  skos:definition "The collective group of all parties involved in the apprenticeship service price confirmation process." .


###  https://w3id.org/cco-gro/onto/uk#AlternativeDeliveryArrangement
gro-uk:AlternativeDeliveryArrangement rdf:type owl:Class ;
                                      rdfs:subClassOf cco:Resource ;
                                      rdfs:label "Alternative Delivery Arrangement" ;
                                      skos:definition "Alternative delivery arrangements made for each apprentice affected by a subcontractor's change of circumstances" .


###  https://w3id.org/cco-gro/onto/uk#AlternativeEnglishApprentice
gro-uk:AlternativeEnglishApprentice rdf:type owl:Class ;
                                    rdfs:subClassOf cco:Role ;
                                    rdfs:label "Alternative English Apprentice" ;
                                    skos:definition "An apprentice participating in an alternative English apprenticeship program, as referenced in the regulatory provision." .


###  https://w3id.org/cco-gro/onto/uk#AlternativeEnglishApprenticeship
gro-uk:AlternativeEnglishApprenticeship rdf:type owl:Class ;
                                        rdfs:subClassOf cco:Condition ,
                                                        cco:Resource ;
                                        rdfs:label "Alternative English Apprenticeship" ;
                                        skos:definition "A condition where the apprentice is enrolled on an alternative English apprenticeship programme." ,
                                                        "An apprenticeship programme in England that provides an alternative funding route for individuals not directly employed by an employer." ,
                                                        "An apprenticeship that is an alternative English apprenticeship" .


###  https://w3id.org/cco-gro/onto/uk#AlternativeFrequency
gro-uk:AlternativeFrequency rdf:type owl:Class ;
                            rdfs:subClassOf cco:Resource ;
                            rdfs:label "Alternative Frequency" ;
                            skos:definition "A review frequency that differs from the standard schedule, justified by an evidenced delivery reason." .


###  https://w3id.org/cco-gro/onto/uk#AnnexCResource
gro-uk:AnnexCResource rdf:type owl:Class ;
                      rdfs:subClassOf cco:Resource ;
                      rdfs:label "Annex C Resource" ,
                                 "Annex C: Off-the-job Training" ;
                      skos:definition "Annex C: Off-the-job training: minimum requirement for each apprenticeship standard, a regulatory document on GOV.UK." ,
                                      "Annex C: off-the-job training: minimum requirement for each apprenticeship standard" .


###  https://w3id.org/cco-gro/onto/uk#ApplicationAndSupportingEvidence
gro-uk:ApplicationAndSupportingEvidence rdf:type owl:Class ;
                                        rdfs:subClassOf cco:Resource ;
                                        rdfs:label "Application and Supporting Evidence" ;
                                        skos:definition "Documentation comprising the application and supporting evidence for an exceptional learning support claim." .


###  https://w3id.org/cco-gro/onto/uk#Apprentice
gro-uk:Apprentice rdf:type owl:Class ;
                  rdfs:subClassOf cco:Person ,
                                  cco:Role ;
                  rdfs:label "Apprentice" ;
                  skos:definition "A person undertaking an apprenticeship programme." ,
                                  "A person undertaking an apprenticeship who may be eligible for funding claims." ,
                                  "A person undertaking an apprenticeship." ,
                                  "A person who is learning a trade from a skilled employer, having agreed to work for a fixed period at low wages." ,
                                  "A person who is learning a trade from a skilled employer." ,
                                  "A person who is undertaking an apprenticeship programme." ,
                                  "A role of an individual who is learning a trade under an apprenticeship program." ,
                                  "An individual engaged in apprenticeship training, assessment, or end-point assessment." ,
                                  "An individual undertaking an apprenticeship program" ,
                                  "An individual undertaking an apprenticeship programme, including study of English and/or maths." ,
                                  "An individual undertaking an apprenticeship programme." ,
                                  "An individual undertaking an apprenticeship, combining work with study under a formal training agreement." ,
                                  "An individual undertaking an apprenticeship." ,
                                  "The role of an individual undertaking an apprenticeship." .


###  https://w3id.org/cco-gro/onto/uk#ApprenticeBursary
gro-uk:ApprenticeBursary rdf:type owl:Class ;
                         rdfs:subClassOf cco:Resource ;
                         rdfs:label "Apprentice Bursary" ;
                         skos:definition "A bursary of £3,000 available to eligible apprentices across apprenticeships." .


###  https://w3id.org/cco-gro/onto/uk#ApprenticeCertificate
gro-uk:ApprenticeCertificate rdf:type owl:Class ;
                             rdfs:subClassOf cco:Resource ;
                             rdfs:label "Apprentice Certificate" ;
                             skos:definition "A certificate awarded to an apprentice upon achieving a mandatory qualification." .


###  https://w3id.org/cco-gro/onto/uk#ApprenticeDetails
gro-uk:ApprenticeDetails rdf:type owl:Class ;
                         rdfs:subClassOf cco:Resource .


###  https://w3id.org/cco-gro/onto/uk#ApprenticeDevelopmentSummary
gro-uk:ApprenticeDevelopmentSummary rdf:type owl:Class ;
                                    rdfs:subClassOf cco:Resource ;
                                    rdfs:label "Apprentice Development Summary" ;
                                    skos:definition "A summary of the knowledge, skills and behaviours that the apprentice has developed and evidenced during their time on their foundation apprenticeship." ;
                                    prov:wasDerivedFrom data:UK_UNIT_00643 .


###  https://w3id.org/cco-gro/onto/uk#ApprenticeEnrolmentAdministration
gro-uk:ApprenticeEnrolmentAdministration rdf:type owl:Class ;
                                         rdfs:subClassOf cco:Resource ;
                                         rdfs:label "Apprentice Enrolment Administration" ;
                                         skos:definition "Administration related to the subsequent enrolment (onboarding) of the apprentice. This can include the collection of evidence to support the initial assessment, supporting the employer with their apprenticeship service account and completing the apprenticeship agreement; and developing and agreeing the training plan with the employer and apprentice." ;
                                         prov:wasDerivedFrom data:UK_UNIT_00435 .


###  https://w3id.org/cco-gro/onto/uk#ApprenticeInformation
