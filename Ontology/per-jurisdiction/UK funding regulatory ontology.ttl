                               prov:wasDerivedFrom data:UK_UNIT_00545 ;
                               cco:appliesUnder data:UK_UNIT_00545_condition_cef982 ;
                               cco:hasAction data:UK_UNIT_00545_action_9000af ;
                               cco:hasObject data:UK_UNIT_00545_object_2d6a85 .


