    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#CourseProviderRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Course Provider Role</rdfs:label>
        <skos:definition>The role of an approved course provider under the VET Student Loans program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#CourseRequirement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#CourseRequirement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#CourseCompletionConditionPattern"/>
