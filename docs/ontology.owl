    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FullCourseLoad -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FullCourseLoad">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Full Course Load</rdfs:label>
