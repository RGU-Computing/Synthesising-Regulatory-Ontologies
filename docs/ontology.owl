        <rdfs:label>Application</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#Application"/>
        <skos:definition>An application for a regulatory program or benefit.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ApplicationAndLoanPayments -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ApplicationAndLoanPayments">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ApprenticeshipStudentRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ApprenticeshipStudentRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Apprenticeship Student Role</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#EligibleApprenticeRole"/>
