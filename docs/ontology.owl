        <skos:definition>The role of an employer as defined in the UK apprenticeship funding context.</skos:definition>
        <skos:definition>The role of an employer as defined in the UK apprenticeship regulatory context.</skos:definition>
        <skos:definition>The role of an employer as defined in the context of UK apprenticeship regulations.</skos:definition>
        <skos:definition>The role of an employer as referenced in UK regulatory provisions.</skos:definition>
        <skos:definition>The role of an employer in the context of UK apprenticeship funding regulations.</skos:definition>
        <skos:definition>The role of an employer in the context of apprenticeship funding contributions.</skos:definition>
        <skos:definition>The role of an employer in the context of apprenticeship funding.</skos:definition>
        <skos:definition>The role of an employer in the context of apprenticeship progress reviews.</skos:definition>
        <skos:definition>The role of an employer in the context of apprenticeship service accounts.</skos:definition>
        <skos:definition>The role of an individual or entity that employs an apprentice under an apprenticeship agreement.</skos:definition>
        <skos:definition>The role of an organization that employs an apprentice and supports their on-the-job training.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00977"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cco-gro/onto/uk#ProviderRole">
        <rdfs:label>Provider Role</rdfs:label>
        <skos:definition>The role of a training provider in the context of apprenticeship service accounts.</skos:definition>
        <skos:definition>The role of a training provider in the context of apprenticeship standards.</skos:definition>
        <skos:definition>The role of an entity that provides apprenticeship programmes.</skos:definition>
        <skos:definition>The role of an organization responsible for delivering apprenticeship training.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cco-gro/onto/us#FinancialAidAdministrator">
        <rdfs:label>Financial Aid Administrator</rdfs:label>
        <skos:definition>A role held by an FAA who may use professional judgment to count a benefit.</skos:definition>
        <skos:definition>A role responsible for administering financial aid at an institution, including making dependency override determinations.</skos:definition>
        <skos:definition>A role responsible for administering financial aid programs, including making professional judgment decisions.</skos:definition>
        <skos:definition>A role responsible for processing student financial aid requests and determinations.</skos:definition>
    </rdf:Description>
    


