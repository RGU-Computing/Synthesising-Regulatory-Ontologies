    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#DecisionMaker">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Decision Maker</rdfs:label>
        <skos:definition>A role responsible for making decisions that may be subject to review.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#DefinedTerm -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#DefinedTerm">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Benefit Definition</rdfs:label>
        <rdfs:label>Word and Document Limits</rdfs:label>
        <skos:definition>There is a word limit to sections where a written response is required in the Application Form. There is no limit to the number of documents you can provide in support of your application.</skos:definition>
        <skos:definition>there is no immediate benefit to the person, as the person would still be required to complete the course to obtain the benefit; the benefits would not be a replacement for the course of study; the monetary value of the benefit is unlikely to induce a student to enrol in a course.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00064"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00640"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#DeliveryAspects -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#DeliveryAspects">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Delivery Aspects</rdfs:label>
        <skos:definition>The set of aspects for which the approved course provider must carry full responsibility, including adherence to the Act and Rules, quality and standards, teaching by qualified staff, adequate resources and facilities, and adequate measures to protect student welfare.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#DeliveryResponsibility -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#DeliveryResponsibility">
