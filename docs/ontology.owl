        <skos:definition>The maximum funding band amount from which the total price reduction is calculated.</skos:definition>
        <skos:definition>The maximum funding band for an apprenticeship, used as a reference for the assessment cost cap.</skos:definition>
        <skos:definition>The upper limit of funding allocated for an individual apprenticeship standard.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00112"/>
    </owl:Class>
    


