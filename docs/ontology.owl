        <rdfs:label>Education Funding</rdfs:label>
        <skos:definition>Education or education funding that is excluded from the &apos;no recourse to public funds&apos; condition.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EducationInspectionFramework -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EducationInspectionFramework">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Education Inspection Framework</rdfs:label>
        <skos:definition>Ofsted&apos;s framework for inspecting education providers, setting out the criteria and standards for assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ElectronicOrDigitalSignature -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ElectronicOrDigitalSignature">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Electronic or Digital Signature</rdfs:label>
        <skos:definition>An electronic or digital signature that is held by a provider and must be ensured non-refutable.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Eligibility -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Eligibility">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Eligibility</rdfs:label>
        <skos:definition>An individual&apos;s eligibility status for an apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EligibilityDeclarationOpportunity -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EligibilityDeclarationOpportunity">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Eligibility Declaration Opportunity</rdfs:label>
        <skos:definition>The opportunity for a learner to declare their eligibility for the care leavers&apos; bursary.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EligibleApprenticeRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EligibleApprenticeRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Eligible Apprentice</rdfs:label>
        <rdfs:label>Eligible Apprentice Role</rdfs:label>
        <skos:definition>A role held by an apprentice who meets the eligibility criteria for the care leavers&apos; bursary.</skos:definition>
        <skos:definition>The role of an apprentice who meets the eligibility criteria for the care leavers&apos; bursary.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EligibleCosts -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EligibleCosts">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Eligible Costs</rdfs:label>
        <skos:definition>The eligible costs of an apprenticeship that an apprentice should not be asked to financially contribute to.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EligibleTrainingCosts -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EligibleTrainingCosts">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Eligible Training Costs</rdfs:label>
        <skos:definition>The eligible costs of training, on-programme or end-point assessment, for which an apprentice must not be asked to contribute financially.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Employer -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Employer">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerAdditionalPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerAdditionalPayment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto/uk#Payment"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Employer Additional Payment</rdfs:label>
        <skos:definition>An additional payment made to an employer, specifically applicable when an apprentice is employed by a Flexi-Job Apprenticeship Agency.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerAgreement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerAgreement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RegulatoryAgreementPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Employer Agreement</rdfs:label>
        <skos:definition>A contractual or formal agreement between a main provider and an employer.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerAndProviderRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerAndProviderRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Employer and Provider Role</rdfs:label>
        <skos:definition>The combined role of employer and provider as referenced in UK regulatory provision UK-UNIT-01185.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerApprenticeshipProgramme -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerApprenticeshipProgramme">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Employer Apprenticeship Programme</rdfs:label>
        <skos:definition>All of the apprentices that a provider has been contracted to deliver training to, at that employer, irrespective of the occupational area, standard or level.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerApprenticeshipServiceAccount -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerApprenticeshipServiceAccount">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Employer Apprenticeship Service Account</rdfs:label>
        <skos:definition>The employer&apos;s apprenticeship service account, a digital resource for managing apprenticeships.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerCoInvestment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerCoInvestment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Employer Co-Investment</rdfs:label>
        <skos:definition>A funding allocation representing the employer&apos;s co-investment contribution for apprenticeships.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerCoInvestmentContribution -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerCoInvestmentContribution">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Employer Co-investment Contribution</rdfs:label>
        <skos:definition>A financial contribution from an employer towards the cost of an apprenticeship, as part of government-employer co-investment</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerCompetencyStatement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerCompetencyStatement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#SignedDeclarationPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Employer Competency Statement</rdfs:label>
        <skos:definition>A statement required from an employer attesting to the apprentice&apos;s competency.</skos:definition>
        <skos:definition>A statement required from an employer confirming the competency of an apprentice.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerDefinedTerm -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerDefinedTerm">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Employer</rdfs:label>
        <skos:definition>This can include a Flexi-Job Apprenticeship Agency (FJAA). This may also include a company or charity whose PAYE scheme the employer has connected to their apprenticeship service account. References to an ‘employer’ describe the whole organisation, not individual sites, locations, groups, or companies linked by directors.</skos:definition>
        <skos:definition>We use the term ‘employer’ to mean an organisation that has a contract of service and an apprenticeship agreement with an apprentice.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00032"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01199"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerIncentivePayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerIncentivePayment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Employer Incentive Payment</rdfs:label>
        <skos:definition>A payment generated when a foundation apprenticeship attracts an employer incentive, as identified on the Skills England website.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerMentoringCost -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerMentoringCost">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Employer Mentoring Cost</rdfs:label>
        <skos:definition>Costs of an employer supporting or mentoring an apprentice, where this is required by the standard and part of the agreed training plan.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerNonLevyPayer -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerNonLevyPayer">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Non-Levy Paying Employer</rdfs:label>
        <skos:definition>Employers who do not pay the apprenticeship levy, and levy paying employers with insufficient funds, as defined in UK apprenticeship funding regulations.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerOrProviderRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerOrProviderRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Employer or Provider Role</rdfs:label>
        <skos:definition>The role of an employer or provider in the context of the apprenticeship service.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerProvider -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerProvider">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Employer Provider</rdfs:label>
        <rdfs:label>Employer-Provider</rdfs:label>
        <rdfs:label>Employer-provider</rdfs:label>
        <skos:definition>An employer-provider is a levy-paying organisation that is on the ‘employer-provider’ route of the Apprenticeship Provider and Assessment Register (APAR).</skos:definition>
        <skos:definition>An organisation that acts as an employer-provider, required to hold but not publish subcontracting information.</skos:definition>
        <skos:definition>An organisation that acts as both an employer and a training provider for apprentices.</skos:definition>
        <skos:definition>An organisation that acts as both the employer of an apprentice and the provider of their training.</skos:definition>
        <skos:definition>An organisation that both employs an apprentice and provides their training.</skos:definition>
        <skos:definition>An organisation that provides apprenticeship training and employs the apprentice.</skos:definition>
        <skos:definition>We use the term ‘employer-provider’ where the funding rule only applies to a levy-paying organisation that is listed on the employer-provider route of the APAR. Employer-providers can only deliver apprenticeship training to their own staff or those of a connected company or charity and must do so on an actual cost basis (see paragraph 102).</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00023"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01200"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerProviderAgreement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerProviderAgreement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Employer-Provider Agreement</rdfs:label>
        <skos:definition>An agreement between the employer and provider that participation in a skills competition directly contributes to helping the apprentice achieve the apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerProviderOrganisation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerProviderOrganisation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Employer-Provider Organisation</rdfs:label>
        <skos:definition>An organisation that acts as both employer and training provider for apprentices.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerProviderPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerProviderPayment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Employer and Provider Payments</rdfs:label>
        <skos:definition>Payments made to an employer-provider in both the employer and provider capacities.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerProviderRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerProviderRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmployerStatement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerStatement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Employer Statement</rdfs:label>
        <skos:definition>A statement completed by the employer when actual training hours are less than the planned hours.</skos:definition>
        <skos:definition>A statement obtained from an employer regarding off-the-job training hours.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Employment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Employment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Employment</rdfs:label>
        <skos:definition>An employment relationship between an employer and an employee</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmploymentEvidence -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmploymentEvidence">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Employment Evidence</rdfs:label>
        <skos:definition>Evidence to confirm that the apprentice is employed by that employer, or a connected company or charity and this employment covers the full period of the apprenticeship, including the end-point assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmploymentStatusChange -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmploymentStatusChange">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Employment Status Change</rdfs:label>
        <skos:definition>A change in the employment status of an apprentice</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EmploymentStatusCondition -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EmploymentStatusCondition">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Employment Status Condition</rdfs:label>
        <skos:definition>A condition concerning the employment status of an individual, such as being employed or unemployed.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EndPointAssessment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EndPointAssessment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>End-Point Assessment</rdfs:label>
        <skos:definition>An end-point assessment for an apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EndPointAssessmentOrganisation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EndPointAssessmentOrganisation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>End-Point Assessment Organisation</rdfs:label>
        <rdfs:label>End-point Assessment Organisation</rdfs:label>
        <skos:definition>An independent organisation that providers can contract to carry out apprenticeship end-point assessments.</skos:definition>
        <skos:definition>An organisation approved to deliver end-point assessments for apprenticeships.</skos:definition>
        <skos:definition>An organisation conducting end-point assessments for apprenticeships.</skos:definition>
        <skos:definition>An organisation responsible for conducting end-point assessments for apprenticeships.</skos:definition>
        <skos:definition>An organisation responsible for conducting the end-point assessment of an apprenticeship.</skos:definition>
        <skos:definition>An organisation that conducts end-point assessments for apprenticeships.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01201"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EndPointAssessmentOrganisationDetails -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EndPointAssessmentOrganisationDetails">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>End-Point Assessment Organisation Details</rdfs:label>
        <skos:definition>Details of the end-point assessment organisation for an apprenticeship</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EndPointAssessmentOrganisationRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EndPointAssessmentOrganisationRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>End-Point Assessment Organisation Role</rdfs:label>
        <skos:definition>The role of an organisation responsible for conducting end-point assessments for apprenticeship standards.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EndPointAssessmentPrice -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EndPointAssessmentPrice">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>End-Point Assessment Price</rdfs:label>
        <skos:definition>The price agreed for the end-point assessment as entered into TNP2 on the ILR.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EndPointAssessmentProcess -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EndPointAssessmentProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#AssessmentProcessPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>End-Point Assessment Process</rdfs:label>
        <skos:definition>The end-point assessment process that apprentices must be prepared for and understand.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EndPointAssessmentRecord -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EndPointAssessmentRecord">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>End-Point Assessment Record</rdfs:label>
        <skos:definition>Records and evidence of completion of the end-point assessment, including signed statements and EPAO evidence.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EngageEPAOAction -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EngageEPAOAction">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Engage EPAO Action</rdfs:label>
        <skos:definition>The action of engaging an end-point assessment organisation.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EnglishAndMathsResource -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EnglishAndMathsResource">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>English and Maths Resource</rdfs:label>
        <skos:definition>The educational resource encompassing English and/or maths subjects.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EnglishMathsFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EnglishMathsFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>English and Maths Funding</rdfs:label>
        <skos:definition>A condition where funding for English and/or maths study is being accessed for an apprentice.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EnglishMathsMinimumRequirements -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EnglishMathsMinimumRequirements">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>English and Maths Minimum Requirements</rdfs:label>
        <skos:definition>The regular English and maths minimum requirements for DfE funding</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EnglishMathsRequirement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EnglishMathsRequirement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>English and Maths Requirement</rdfs:label>
        <skos:definition>The requirement to achieve the minimum required level in English and maths, which is not removed by the assessment outcome determination.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EnglishMathsTraining -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EnglishMathsTraining">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>English and Maths Training</rdfs:label>
        <skos:definition>Training in English and/or maths delivered as part of an apprenticeship training plan.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Evidence -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Evidence">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Evidence</rdfs:label>
        <skos:definition>Documentation or proof submitted to demonstrate compliance with a requirement.</skos:definition>
        <skos:definition>Documentation or records retained to demonstrate compliance with regulatory requirements.</skos:definition>
        <skos:definition>Effective and reliable evidence that providers must keep and make available, such as an Individualised Learner Record (ILR).</skos:definition>
        <skos:definition>Evidence that the provider is directly delivering apprenticeship training and/or on-programme assessment and maintaining the employer relationship.</skos:definition>
        <skos:definition>The available body of facts or information indicating whether a belief or proposition is true or valid.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EvidenceAction -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EvidenceAction">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Evidence Action</rdfs:label>
        <skos:definition>The act of providing or demonstrating evidence that certain conditions or requirements are met.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EvidenceOfAgreement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EvidenceOfAgreement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Evidence of Agreement</rdfs:label>
        <skos:definition>Evidence that the training plan was agreed by all parties prior to training delivery, including a signed plan by the end of the 42-day qualifying period if agreed virtually.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EvidenceOfDelivery -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EvidenceOfDelivery">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Evidence of Delivery</rdfs:label>
        <skos:definition>Evidence that English and maths delivery has taken place against the training plan.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EvidenceOfEligibility -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EvidenceOfEligibility">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Evidence of Eligibility</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#VerificationDocument"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#VerificationDocumentation"/>
        <skos:definition>Documentation or records that demonstrate an individual meets the eligibility criteria for funding.</skos:definition>
        <skos:definition>Evidence of an individual&apos;s eligibility that must be retained by the provider.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EvidenceOfEmploymentAndContractDuration -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EvidenceOfEmploymentAndContractDuration">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Evidence of Employment and Contract Duration</rdfs:label>
        <skos:definition>Documentation demonstrating that an apprentice is employed under a contract of sufficient length to complete the apprenticeship, including the end-point assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EvidenceOfPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EvidenceOfPayment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Evidence of Payment</rdfs:label>
        <skos:definition>Documentation proving that a payment has been made, such as a transaction record or confirmation.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EvidencePack -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EvidencePack">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Evidence Pack</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#VerificationDocument"/>
        <skos:definition>A collection of documents and materials assembled to demonstrate compliance or completion.</skos:definition>
        <skos:definition>A collection of documents and records maintained as evidence of compliance.</skos:definition>
        <skos:definition>A collection of evidence documents retained as part of the apprenticeship record.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EvidenceRequirement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EvidenceRequirement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Evidence Requirement</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#VerificationDocument"/>
        <skos:definition>A set of requirements that must be met to provide evidence for a claim.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EvidencedDeliveryReason -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EvidencedDeliveryReason">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Evidenced Delivery Reason</rdfs:label>
        <skos:definition>A condition where a documented reason, such as module length, justifies an alternative review frequency.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ExaminationsAndOtherTesting -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ExaminationsAndOtherTesting">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Examinations and Other Testing</rdfs:label>
        <skos:definition>Examinations and other testing, such as on-programme assessments (linked to a qualification) and mock testing (relating to the end-point assessment) are ineligible costs.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00497"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ExceptionalLearningSupport -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ExceptionalLearningSupport">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Exceptional Learning Support</rdfs:label>
        <skos:definition>Financial support for apprentices requiring substantial reasonable adjustments exceeding £19,000 in a funding year.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ExcessCostPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ExcessCostPayment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Excess Cost Payment</rdfs:label>
        <skos:definition>A funding allocation representing the employer&apos;s obligation to pay additional costs above the funding band maximum.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ExcessTraining -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ExcessTraining">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Excess Training</rdfs:label>
        <skos:definition>Any training (e.g. optional modules, educational trips, industry visits, expert speakers or trips to professional events), in excess of that required to pass the end-point assessment and achieve the apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ExemptionCase -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ExemptionCase">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Exemption Case</rdfs:label>
        <skos:definition>A formal submission requesting exemption from a regulatory requirement, as referenced in UK-UNIT-00834.</skos:definition>
        <skos:definition>A formal submission requesting exemption from the 25% subcontracting threshold for apprenticeship funding.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ExistingApprentice -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ExistingApprentice">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Existing Apprentice</rdfs:label>
        <skos:definition>An apprentice who started their apprenticeship in previous funding years and is currently enrolled in a standard.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ExternalAuditorReport -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ExternalAuditorReport">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>External Auditor Report</rdfs:label>
        <skos:definition>A report signed by an external auditor providing assurance on subcontractor management and control arrangements.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ExternalPlacementHostingFee -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ExternalPlacementHostingFee">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>External Placement Hosting Fee</rdfs:label>
        <skos:definition>Costs of hosting an external placement for the nursing associate apprenticeship, separate from delivery costs of training and on-programme assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#FJAA -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#FJAA">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>FJAA</rdfs:label>
        <skos:definition>A type of organisation referred to as FJAAs in the regulatory provision.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#FinalAdditionalPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#FinalAdditionalPayment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Final Additional Payment</rdfs:label>
        <skos:definition>A final additional payment for apprenticeship standards with a published typical duration of less than 12 months, and for foundation apprenticeships.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#FinancialInducement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#FinancialInducement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Financial Inducement</rdfs:label>
        <skos:definition>Financial inducements, or any other payment not authorised by the regulatory authority, in relation to any part of an apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#FinancialResource -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#FinancialResource">
