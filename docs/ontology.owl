    <rdf:Description rdf:about="https://w3id.org/cco-gro/onto/au#AdministrativeReviewTribunalAct2024Part10">
        <rdfs:label>Administrative Review Tribunal Act 2024 Part 10</rdfs:label>
        <skos:definition>The Administrative Review Tribunal Act 2024 Part 10, which establishes the right to apply for review of decisions.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00539"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cco-gro/onto/au#SpecifiedProvider">
        <rdfs:label>Specified Provider</rdfs:label>
        <skos:definition>A provider specified in Schedule 3 of the Determination as eligible to offer approved courses.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cco-gro/onto/ca#AdultUpgradingGrantPolicyManual">
        <rdfs:label>Adult Upgrading Grant Policy Manual</rdfs:label>
        <skos:definition>The Adult Upgrading Grant Policy and Procedures Manual, which contains the policy set out by the Province of British Columbia for determining student eligibility.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cco-gro/onto/ca#ApplicationAndLoanPayments">
        <rdfs:label>Application and Loan Payments</rdfs:label>
        <skos:definition>The borrower&apos;s application and associated loan payments that are subject to hold and suspension.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cco-gro/onto/ca#BorrowerSelectedForRAPVerification">
        <rdfs:label>Borrower Selected for RAP Verification</rdfs:label>
        <skos:definition>A borrower who has been selected for Repayment Assistance Plan (RAP) application verification.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cco-gro/onto/ca#ParentalExpectedContribution">
        <rdfs:label>Parental Expected Contribution</rdfs:label>
        <skos:definition>A calculated financial resource representing the expected parental contribution for a single dependent student, based on the sponsor&apos;s income and assets when the sponsor is a parent.</skos:definition>
        <skos:definition>The expected financial contribution from parents, step-parents, sponsors, or legal guardians of single dependent students toward the student&apos;s education, calculated based on assessed financial ability.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00425"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cco-gro/onto/ca#SpousalExpectedContribution">
        <rdfs:label>Spousal Expected Contribution</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#ContributionFromAssets"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#IncomeAllowanceCalculation"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#ParentsContribution"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#ParentsContributionFromAssets"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#StudentContributionFromIncome"/>
        <skos:definition>A calculated amount representing the expected financial contribution from a spouse, based on spousal income, used in student assessment.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00429"/>
    </rdf:Description>
