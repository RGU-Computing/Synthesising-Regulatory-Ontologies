        <rdfs:label>Enrolment Information</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#VerificationInformation"/>
        <skos:definition>Information about census days, tuition fees, withdrawal procedures, and other required procedures that must be provided to students prior to enrolment.</skos:definition>
    </owl:Class>
    


