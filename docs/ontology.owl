    <!-- http://www.w3.org/2002/07/owl#Thing -->


    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#Thing"/>
    


    <!-- http://www.w3.org/ns/prov#Entity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity"/>
    


    <!-- https://w3id.org/cco-gro/data#UK_UNIT_00225_object_36c7d0 -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/data#UK_UNIT_00225_object_36c7d0">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/data#UK_UNIT_00568_object_73d80c -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/data#UK_UNIT_00568_object_73d80c">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/data#UK_UNIT_00597_object_a8b8ea -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/data#UK_UNIT_00597_object_a8b8ea">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#AcademicEligibilityRequirementPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#AcademicEligibilityRequirementPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:comment>The name &apos;AcademicEligibilityRequirement&apos; captures the universal concept of academic suitability/standing requirements without jurisdiction-specific terms. It is a subclass of cco:Condition and retains only axioms applicable to both aligned classes, satisfying the pattern&apos;s constraints on neutrality and universal applicability.</rdfs:comment>
        <rdfs:label>Academic Eligibility Requirement</rdfs:label>
        <skos:definition>A condition that must be satisfied by a student to demonstrate they meet the academic criteria required for enrollment or continuation in an educational program, as determined by the institution.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#AcademicWithdrawalResourcePattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#AcademicWithdrawalResourcePattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>The name &apos;AcademicWithdrawalResource&apos; is jurisdiction-neutral, avoids program-specific terminology, and reflects the universal purpose of the classes as resources for recording withdrawal details. It satisfies the pattern&apos;s constraints by being a subclass of cco:Resource and ensuring all axioms apply universally across aligned jurisdictions.</rdfs:comment>
        <rdfs:label>Academic Withdrawal Resource</rdfs:label>
        <skos:definition>A resource used to document or confirm a student&apos;s withdrawal from a study period, including details such as the date, time, and specific units of study affected by the withdrawal.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#AgreementGovernanceObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#AgreementGovernanceObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Agreement Governance Obligation</rdfs:label>
        <skos:definition>An obligation to establish, maintain, and comply with formal agreements, including documentation, signing, and adherence to agreed terms.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#AncillaryFeePattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#AncillaryFeePattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>The term &apos;AncillaryFee&apos; captures the supplementary nature of these charges across jurisdictions. It avoids jurisdiction-specific terms while encompassing mandatory fees, non-tuition fees, and membership fees as subclasses. The name satisfies the pattern&apos;s constraints by being jurisdiction-neutral and a subclass of cco:Resource.</rdfs:comment>
        <rdfs:label>Ancillary Fee</rdfs:label>
        <skos:definition>A fee or charge associated with educational services or institutional requirements that is not directly related to tuition, academic assessments, or qualification awards.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#ApprenticeshipComplianceObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#ApprenticeshipComplianceObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Apprenticeship Compliance Obligation</rdfs:label>
        <skos:definition>An obligation to comply with procedural, financial, and documentation requirements related to the establishment, execution, and funding of apprenticeship programs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#ApprenticeshipFundingMisuseProhibition -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#ApprenticeshipFundingMisuseProhibition">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Prohibition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Prohibition on Misuse of Apprenticeship Funding</rdfs:label>
        <skos:definition>A regulatory norm that prohibits the improper use of funds, rates, or incentives designated for apprenticeship programs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#ApprenticeshipSupportAndProgressionPermission -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#ApprenticeshipSupportAndProgressionPermission">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Permission"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Apprenticeship Support and Progression Permission</rdfs:label>
        <skos:definition>A permission that allows for the funding, support, training, and progression of apprentices through various stages of their apprenticeship journey.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#AssessmentActionPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#AssessmentActionPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:comment>The name &apos;AssessmentAction&apos; is derived from the common functional purpose of evaluating competence across all jurisdictions. It maintains jurisdiction neutrality by avoiding program-specific terms and correctly positions as a subclass of cco:Action, satisfying the pattern&apos;s requirement to retain CCO hierarchy constraints.</rdfs:comment>
        <rdfs:label>Assessment Action</rdfs:label>
        <skos:definition>An action taken to evaluate an individual&apos;s knowledge, skills, or competence in an educational or training context.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#AssessmentProcessObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#AssessmentProcessObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Assessment Process Obligation</rdfs:label>
        <skos:definition>An obligation to carry out, manage, and maintain various stages and components of an assessment process, including development, execution, independence, documentation, and alignment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#AssessmentProcessPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#AssessmentProcessPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>The name &apos;AssessmentProcess&apos; is jurisdiction-neutral, avoiding any region-specific terminology while capturing the core concept of procedural evaluation shared by both aligned classes. It maintains compatibility with the cco:Resource supertype and satisfies all pattern constraints by focusing on the universal aspect of assessment procedures across jurisdictions.</rdfs:comment>
        <rdfs:label>Assessment Process</rdfs:label>
        <skos:definition>A structured procedure for conducting and documenting the evaluation of knowledge, skills, or competencies through standardized methods.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#CircumstanceConditionPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#CircumstanceConditionPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:comment>The name &apos;CircumstanceCondition&apos; captures the common element of &apos;circumstances&apos; across all aligned classes while maintaining jurisdiction neutrality. It is a subclass of cco:Condition as required, and the label/definition avoid jurisdiction-specific terms while reflecting the universal concept of conditions tied to exceptional or changing situations.</rdfs:comment>
        <rdfs:label>Circumstance Condition</rdfs:label>
        <skos:definition>A condition arising from specific circumstances that may affect eligibility or require adjustment in program requirements.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#ConfirmationAndComplianceObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#ConfirmationAndComplianceObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Confirmation and Compliance Obligation</rdfs:label>
        <skos:definition>An obligation to confirm approvals, complete required declarations, and comply with post-approval or statutory requirements.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#CourseCompletionConditionPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#CourseCompletionConditionPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:comment>The name &apos;CourseCompletionCondition&apos; combines the universal concepts of &apos;course completion&apos; (from gro-au:CourseRequirement) and &apos;condition&apos; (from the CCO supertype). It avoids jurisdiction-specific terms while capturing the shared purpose of both classes as requirements for academic completion. The definition explicitly covers both requirement fulfillment and completion verification across jurisdictions.</rdfs:comment>
        <rdfs:label>Course Completion Condition</rdfs:label>
        <skos:definition>A condition that must be satisfied for the successful completion of an educational program or study period, encompassing both requirements to be met and verification of completion criteria.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#DiscretionaryAuthorityPermission -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#DiscretionaryAuthorityPermission">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Permission"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Discretionary Authority Permission</rdfs:label>
        <skos:definition>A permission norm that grants entities the authority to exercise judgment in considering factors, making determinations, or taking actions within a regulatory framework.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#EducationalLoanDebtPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#EducationalLoanDebtPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>The name &apos;EducationalLoanDebt&apos; avoids jurisdiction-specific terms while clearly indicating the universal concept of debt from education-related loans. It satisfies the pattern by being a subclass of cco:Resource and ensuring all axioms apply universally across aligned jurisdictions.</rdfs:comment>
        <rdfs:label>Educational Loan Debt</rdfs:label>
        <skos:definition>A financial obligation arising from a loan specifically designated to fund educational pursuits, representing the amount owed by a borrower to a lending institution or government program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#EducationalOrganizationPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#EducationalOrganizationPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:comment>The name &apos;EducationalOrganization&apos; is jurisdiction-neutral, CamelCase, and accurately reflects the universal role of entities in the cluster across education systems. It satisfies the CCO superclass constraint and avoids domain-specific properties not universally applicable.</rdfs:comment>
        <rdfs:label>Educational Organization</rdfs:label>
        <skos:definition>An organization involved in providing educational programs, qualifications, or training, and may be responsible for administrative functions related to student enrollment, funding, or eligibility.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#EducationalPeriodPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#EducationalPeriodPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>The name &apos;EducationalPeriod&apos; combines the core concepts of &apos;fee period&apos; and &apos;study period&apos; while remaining jurisdiction-neutral. It satisfies the pattern by being a subclass of cco:Resource, avoiding jurisdiction-specific terms, and capturing the universal concept of a time-bound educational financial framework.</rdfs:comment>
        <rdfs:label>Educational Period</rdfs:label>
        <skos:definition>A designated time period associated with an educational program, used for determining financial obligations or support.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#EducationalProgramPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#EducationalProgramPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>Manually identified theme from decomposition of 120-member transitive cluster into 7 semantically coherent sub-themes after manual review.</rdfs:comment>
        <rdfs:label>Educational Program</rdfs:label>
        <skos:definition>A structured course of study or training program offered by an educational provider.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#EligibilityAndRequirementsObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#EligibilityAndRequirementsObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Eligibility and Requirements Obligation</rdfs:label>
        <skos:definition>An obligation to meet, verify, or maintain eligibility criteria and regulatory or programmatic requirements.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#EligibilityAssessmentPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#EligibilityAssessmentPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:comment>The name &apos;EligibilityAssessment&apos; is jurisdiction-neutral, reflecting the universal purpose of evaluating eligibility across all aligned classes. It avoids jurisdiction-specific terms while capturing the core function shared by Assessment, Formal Assessment, and Initial Assessment under the cco:Action hierarchy.</rdfs:comment>
        <rdfs:label>Eligibility Assessment</rdfs:label>
        <skos:definition>A structured evaluation process used to determine an individual&apos;s eligibility for a program, service, or funding based on predefined criteria.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#EligibilityBasedFinancialAndEnrollmentPermission -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#EligibilityBasedFinancialAndEnrollmentPermission">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Permission"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Eligibility-Based Financial and Enrollment Permission</rdfs:label>
        <skos:definition>A permission that grants students access to financial assistance, enrollment benefits, or academic status changes based on demonstrated eligibility criteria.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#EligibilityVerificationRolePattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#EligibilityVerificationRolePattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:comment>The name &apos;EligibilityVerificationRole&apos; avoids jurisdiction-specific terms while capturing the universal function of verifying student status across aligned jurisdictions. It maintains compatibility with the cco:Role supertype and ensures all axioms apply consistently to both subclasses.</rdfs:comment>
        <rdfs:label>Eligibility Verification Role</rdfs:label>
        <skos:definition>A role responsible for verifying a student&apos;s eligibility or enrollment status to ensure compliance with institutional or program requirements.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#EnrollmentActionPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#EnrollmentActionPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:comment>The name &apos;EnrollmentAction&apos; is jurisdiction-neutral, CamelCase, and captures the universal concept of actions impacting student enrollment status. It satisfies the pattern by avoiding jurisdiction-specific terms and ensuring all subclasses are functionally equivalent under the shared CCO supertype &apos;Action&apos;.</rdfs:comment>
        <rdfs:label>Enrollment Action</rdfs:label>
        <skos:definition>An action that affects a student&apos;s enrollment status in an educational institution, including processes such as enrolling, withdrawing, or applying for leave.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#EnrolmentActionPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#EnrolmentActionPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:comment>The name &apos;EnrolmentAction&apos; captures the common functional purpose of both aligned classes while avoiding jurisdiction-specific terminology. It maintains compatibility with the cco:Action supertype and satisfies the requirement that all axioms hold universally across jurisdictions.</rdfs:comment>
        <rdfs:label>Enrolment Action</rdfs:label>
        <skos:definition>An action involving the confirmation or reporting of a student&apos;s participation in an educational program, regardless of jurisdiction-specific implementation details.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#EvidenceManagementObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#EvidenceManagementObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Evidence Management Obligation</rdfs:label>
        <skos:definition>An obligation to manage, retain, provide, document, or possess evidence in accordance with regulatory requirements.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>Manually identified theme from decomposition of 120-member transitive cluster into 7 semantically coherent sub-themes after manual review.</rdfs:comment>
        <rdfs:label>Evidentiary Document</rdfs:label>
        <skos:definition>A document, record, or information resource serving as evidence or documentation in regulatory or eligibility contexts.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#ExcludedCostPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#ExcludedCostPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>The name &apos;ExcludedCost&apos; is jurisdiction-neutral, captures the universal concept of costs barred from claims, and maintains the CCO hierarchy by subclassing cco:Resource. It avoids domain-specific terms while satisfying cross-jurisdictional applicability.</rdfs:comment>
        <rdfs:label>Excluded Cost</rdfs:label>
        <skos:definition>A cost that is explicitly excluded from being claimed or included under a regulatory scheme due to lack of necessity, relevance, or explicit exclusion criteria.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#FeeManagementObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#FeeManagementObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Fee Management Obligation</rdfs:label>
        <skos:definition>An obligation to manage, disclose, structure, and apply fees in a transparent, reasonable, and systematic manner.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#FeePolicyDocumentPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#FeePolicyDocumentPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>The name &apos;FeePolicyDocument&apos; avoids jurisdiction-specific terms while capturing the core function of both aligned classes as structured documents governing fee-related obligations. It satisfies the pattern by being a subclass of cco:Resource and maintaining jurisdiction-neutral semantics across all aligned instances.</rdfs:comment>
        <rdfs:label>Fee Policy Document</rdfs:label>
        <skos:definition>A formal document outlining the structure, calculation, and payment requirements for educational fees charged by an institution.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#FinancialAidAdministratorRolePattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#FinancialAidAdministratorRolePattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:comment>The name &apos;FinancialAidAdministratorRole&apos; combines the common functional domain (&apos;FinancialAid&apos;) with the role type (&apos;AdministratorRole&apos;), avoiding jurisdiction-specific terms while maintaining alignment with the CCO:Role supertype. It satisfies the pattern by ensuring universal applicability across jurisdictions and adheres to the constraint of not introducing new root classes above CCO.</rdfs:comment>
        <rdfs:label>Financial Aid Administrator Role</rdfs:label>
        <skos:definition>A role responsible for administering financial aid programs, including making eligibility determinations and ensuring compliance with relevant regulations.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#FinancialAidResourcePattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>Manually identified theme from decomposition of 120-member transitive cluster into 7 semantically coherent sub-themes after manual review.</rdfs:comment>
        <rdfs:label>Financial Aid Resource</rdfs:label>
        <skos:definition>A monetary or financial resource representing aid, funding, loans, grants, bursaries, or scholarships allocated to support students or educational programs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#FinancialNeedAssessmentInputPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#FinancialNeedAssessmentInputPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>Manually named — large transitive cluster (13 members) identified as semantically coherent shared concept after manual review.</rdfs:comment>
        <rdfs:label>Financial Need Assessment Input</rdfs:label>
        <skos:definition>A financial resource or computed value used as input to assess a student&apos;s eligibility for financial aid, encompassing income, contributions, expected contributions, and family financial circumstances.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#FunctionalImpairmentPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#FunctionalImpairmentPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:comment>The term &apos;FunctionalImpairment&apos; captures the common essence of both aligned classes while avoiding jurisdiction-specific terminology. It satisfies the pattern requirements by maintaining compatibility with the cco:Role supertype and ensuring all axioms apply universally across jurisdictions.</rdfs:comment>
        <rdfs:label>Functional Impairment</rdfs:label>
        <skos:definition>A condition involving physical, mental, intellectual, cognitive, or sensory limitations that substantially affects an individual&apos;s ability to perform everyday activities or engage in learning processes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#FundingAccessAndAllocationPermission -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#FundingAccessAndAllocationPermission">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Permission"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Funding Access and Allocation Permission</rdfs:label>
        <skos:definition>A permission that authorizes access to, allocation of, or claims against funding resources for educational, assistive, or support purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#FundingApplicationPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#FundingApplicationPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>Manually identified theme from decomposition of 120-member transitive cluster into 7 semantically coherent sub-themes after manual review.</rdfs:comment>
        <rdfs:label>Funding Application</rdfs:label>
        <skos:definition>A formal application or submission for student financial assistance, loan rehabilitation, or other funding programs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#FundingEligibilityAndDisbursementObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#FundingEligibilityAndDisbursementObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Funding Eligibility and Disbursement Obligation</rdfs:label>
        <skos:definition>An obligation to assess, confirm, and manage eligibility for funding, followed by the proper disbursement or claiming of funds, including direct retention or payment to providers and subcontractors.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#GovernmentOrganizationPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#GovernmentOrganizationPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:comment>The name &apos;GovernmentOrganization&apos; is jurisdiction-neutral, avoids specific program references, and aligns with the confirmed CCO supertype &apos;Organisation&apos;. It universally captures the shared concept of governmental entities across jurisdictions while adhering to the pattern&apos;s constraints.</rdfs:comment>
        <rdfs:label>Government Organization</rdfs:label>
        <skos:definition>An organization that is part of the government structure, such as a department, agency, or regulatory authority.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#InformationDisclosureObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#InformationDisclosureObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Information Disclosure Obligation</rdfs:label>
        <skos:definition>An obligation to provide specified educational information to students or stakeholders before or during enrolment and throughout the course lifecycle.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#JurisdictionalRegulatorPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#JurisdictionalRegulatorPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#Agent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                        <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Manually named due to persistent LLM empty responses across multiple retries.</rdfs:comment>
        <rdfs:label>Jurisdictional Regulator</rdfs:label>
        <skos:definition>An agent representing a regulatory authority at the jurisdiction level, responsible for overseeing compliance with regulatory frameworks.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#LearnerInformationRecordPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#LearnerInformationRecordPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>The name &apos;LearnerInformationRecord&apos; avoids jurisdiction-specific terms while capturing the core purpose of storing structured learner data across contexts. It satisfies the pattern by aligning with the cco:Resource hierarchy and ensuring all axioms apply universally to the cluster members&apos; shared functionality.</rdfs:comment>
        <rdfs:label>Learner Information Record</rdfs:label>
        <skos:definition>A data record containing learner-specific information used by educational institutions for administrative, assessment, or protection-related purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#LearningPausePattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#LearningPausePattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>The name &apos;LearningPause&apos; is jurisdiction-neutral, combining the universal concepts of &apos;learning&apos; and &apos;pause&apos; present in both aligned classes. It avoids jurisdiction-specific terms while accurately reflecting the shared functional equivalence of temporary interruptions in educational engagement across systems.</rdfs:comment>
        <rdfs:label>Learning Pause</rdfs:label>
        <skos:definition>A period during which an individual&apos;s learning or study activities are formally paused, typically subject to specific duration limits and exceptions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#LoanAdjustmentResourcePattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#LoanAdjustmentResourcePattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>The name &apos;LoanAdjustmentResource&apos; is CamelCase, jurisdiction-neutral, and reflects the universal concept of loan amount modifications across aligned classes. It satisfies CCO hierarchy constraints by subclassing cco:Resource and avoids domain/range violations by focusing on shared adjustment mechanics rather than jurisdiction-specific programs.</rdfs:comment>
        <rdfs:label>Loan Adjustment Resource</rdfs:label>
        <skos:definition>A resource representing an adjustment to a loan amount based on eligibility reassessment or changes in funding parameters, converted from grant excess or increased caps.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#LoanAndEnrolmentMisconductProhibition -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#LoanAndEnrolmentMisconductProhibition">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Prohibition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Prohibition of Misconduct in Loan and Enrolment Practices</rdfs:label>
        <skos:definition>A prohibition on actions involving improper financial demands, loan misrepresentation, unauthorized payment or borrowing, and misleading suggestions related to enrolment or assistance eligibility.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#NoticeAndProcedureObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#NoticeAndProcedureObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Notice and Procedure Obligation</rdfs:label>
        <skos:definition>An obligation to provide formal notices and maintain established procedures in regulatory or administrative processes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#OrganizationalExecutiveRolePattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#OrganizationalExecutiveRolePattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:comment>The name &apos;OrganizationalExecutiveRole&apos; combines jurisdiction-neutral terms (&apos;Organizational&apos; and &apos;Executive&apos;) to reflect the universal concept of a high-level role responsible for organizational governance or management. It satisfies the pattern&apos;s constraints by avoiding jurisdiction-specific vocabulary, maintaining subclassing under cco:Role, and ensuring axioms on the shared class apply universally across aligned jurisdictions.</rdfs:comment>
        <rdfs:label>Organizational Executive Role</rdfs:label>
        <skos:definition>A role held by an individual who is responsible for the overall governance or executive management of an organization, as defined by applicable legal or regulatory frameworks.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#PaymentObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#PaymentObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Payment Obligation</rdfs:label>
        <skos:definition>An obligation to make, manage, or arrange payments or repayments under specified conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#PostCredentialTrainingPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#PostCredentialTrainingPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>The name &apos;PostCredentialTraining&apos; combines the concept of training occurring after initial credentialing (from gro-ca:PostCredentialTrainingPeriod) with the general training purpose (from gro-uk:RepeatedTraining and gro-uk:Learning). It avoids jurisdiction-specific terms, maintains compatibility with the cco:Resource hierarchy, and satisfies universal applicability across all aligned classes.</rdfs:comment>
        <rdfs:label>Post-Credential Training</rdfs:label>
        <skos:definition>Training required after obtaining a formal credential to meet the accreditation or licensing requirements of a regulated profession, including repeated training, apprenticeship learning, or structured post-credential development periods.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#ProviderComplianceObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#ProviderComplianceObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Provider Compliance Obligation</rdfs:label>
        <skos:definition>Obligations requiring entities to meet eligibility, maintain status, comply with regulations, and uphold transparency and procedural standards as approved providers.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#RecreditAndReborrowPermission -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#RecreditAndReborrowPermission">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Permission"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Recredit and Re-borrow Permission</rdfs:label>
        <skos:definition>Permission to recredit a HELP balance or re-borrow repaid amounts under specified conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#RegulatoryAgreementPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#RegulatoryAgreementPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>Manually identified theme from decomposition of 120-member transitive cluster into 7 semantically coherent sub-themes after manual review.</rdfs:comment>
        <rdfs:label>Regulatory Agreement</rdfs:label>
        <skos:definition>A contractual or formal agreement between regulated parties such as providers, employers, or institutions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#RegulatoryComplianceObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#RegulatoryComplianceObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Regulatory Compliance Obligation</rdfs:label>
        <skos:definition>An obligation to adhere to specified legal, regulatory, or standard-based requirements, including ongoing adherence, information management, and rule referencing.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#RegulatoryDecisionPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#RegulatoryDecisionPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>Manually identified theme from decomposition of 120-member transitive cluster into 7 semantically coherent sub-themes after manual review.</rdfs:comment>
        <rdfs:label>Regulatory Decision</rdfs:label>
        <skos:definition>A formal determination, approval, assessment, or decision issued by a regulatory authority or process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#RegulatoryOfficialPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#RegulatoryOfficialPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:comment>Manually named due to persistent LLM empty responses across multiple retries.</rdfs:comment>
        <rdfs:label>Regulatory Official</rdfs:label>
        <skos:definition>A role held by an individual or organisation exercising regulatory authority, encompassing regulators, secretaries, and other officials with oversight responsibilities.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#RepaymentActionPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#RepaymentActionPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:comment>The name &apos;RepaymentAction&apos; is jurisdiction-neutral, capturing the universal concept of returning funds across all aligned classes. It satisfies the pattern&apos;s criteria by avoiding jurisdiction-specific terms, maintaining compatibility with the cco:Action supertype, and ensuring all axioms apply universally to repayment scenarios regardless of context.</rdfs:comment>
        <rdfs:label>Repayment Action</rdfs:label>
        <skos:definition>An action involving the return of funds that were overpaid, borrowed, or received in error, encompassing scenarios such as loan repayments, overpayment corrections, and reimbursement requests.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#SignedDeclarationPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#SignedDeclarationPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>Manually identified theme from decomposition of 120-member transitive cluster into 7 semantically coherent sub-themes after manual review.</rdfs:comment>
        <rdfs:label>Signed Declaration</rdfs:label>
        <skos:definition>A signed document or statement attesting to facts or confirming information for regulatory purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#StudentAcademicAndFinancialComplianceObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#StudentAcademicAndFinancialComplianceObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Student Academic and Financial Compliance Obligation</rdfs:label>
        <skos:definition>An obligation requiring students to meet academic progress, enrollment, and financial responsibilities to maintain eligibility and compliance with educational funding and institutional requirements.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#StudentAidModificationConditionPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#StudentAidModificationConditionPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:comment>The name &apos;StudentAidModificationCondition&apos; avoids jurisdiction-specific terms while capturing the universal concept of a condition affecting financial aid. It satisfies the pattern by maintaining compatibility with the cco:Condition supertype and ensuring all axioms apply universally to both withdrawal/deferral and appeal scenarios.</rdfs:comment>
        <rdfs:label>Student Aid Modification Condition</rdfs:label>
        <skos:definition>A condition that triggers a change in a student&apos;s financial aid status due to enrollment adjustments or administrative review processes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#StudentEnrollmentPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#StudentEnrollmentPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>The name &apos;StudentEnrollment&apos; is jurisdiction-neutral, combining the core concepts of &apos;Course Load&apos; and &apos;Student Enrolment&apos; while avoiding region-specific terminology. It maintains compatibility with the cco:Resource supertype and ensures all axioms apply universally across aligned jurisdictions.</rdfs:comment>
        <rdfs:label>Student Enrollment</rdfs:label>
        <skos:definition>The formal registration of a student in one or more academic courses or programs during a specified period, representing their participation status and course commitments.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#StudentGrievanceMechanismPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#StudentGrievanceMechanismPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>The name &apos;StudentGrievanceMechanism&apos; combines the universal concept of student-initiated dispute resolution (&apos;Grievance&apos;) with the neutral term &apos;Mechanism&apos; to encompass both procedural and form-based implementations. It avoids jurisdiction-specific terms while maintaining alignment with the CCO:Resource hierarchy and satisfying cross-jurisdictional axiom constraints.</rdfs:comment>
        <rdfs:label>Student Grievance Mechanism</rdfs:label>
        <skos:definition>A formal process or form used by students to initiate or resolve complaints or appeals regarding academic or administrative matters within an educational institution.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#StudentProceduralResourcePattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#StudentProceduralResourcePattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>The name &apos;StudentProceduralResource&apos; combines the universal scope (&apos;Student&apos;), the functional purpose (&apos;Procedural&apos;), and the CCO hierarchy (&apos;Resource&apos;). It avoids jurisdiction-specific terms while capturing the common theme of structured processes or information required of students, satisfying all pattern constraints and review criteria.</rdfs:comment>
        <rdfs:label>Student Procedural Resource</rdfs:label>
        <skos:definition>A resource representing processes, procedures, or information required for student compliance with enrollment, verification, or documentation requirements across educational contexts.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#StudentRolePattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#StudentRolePattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:comment>Manually named — large transitive cluster (41 members) identified as semantically coherent shared concept after manual review.</rdfs:comment>
        <rdfs:label>Student Role</rdfs:label>
        <skos:definition>A role held by an individual enrolled in or applying for an educational program, encompassing variations in dependency status, enrollment status, and program-specific eligibility across jurisdictions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#StudentWithdrawalManagementPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#StudentWithdrawalManagementPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>The name &apos;StudentWithdrawalManagement&apos; is jurisdiction-neutral, combining the core concepts of withdrawal processes (gro-au) and refund policies (gro-ca). It satisfies the pattern by avoiding jurisdiction-specific terms, maintaining compatibility with the cco:Resource supertype, and ensuring all axioms apply universally to both aligned classes.</rdfs:comment>
        <rdfs:label>Student Withdrawal Management</rdfs:label>
        <skos:definition>A framework or set of procedures established by educational institutions to manage student withdrawals, including processes for deferral and refund policies.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#TaxRegulatoryAuthorityAgentPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#TaxRegulatoryAuthorityAgentPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#Agent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                        <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The name &apos;TaxRegulatoryAuthorityAgent&apos; reflects the universal function of tax administration and enforcement shared by the aligned classes (IRS, ATO) while maintaining jurisdiction neutrality. It directly extends the confirmed CCO supertype &apos;RegulatoryAuthorityAgent&apos; and avoids any jurisdiction-specific terminology.</rdfs:comment>
        <rdfs:label>Tax Regulatory Authority Agent</rdfs:label>
        <skos:definition>A regulatory authority agent responsible for tax collection, administration, and enforcement of tax-related laws within a jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#TotalProgramCostPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#TotalProgramCostPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:comment>The name &apos;TotalProgramCost&apos; is jurisdiction-neutral, avoiding specific terms like &apos;tuition&apos; or &apos;training&apos; while capturing the universal concept of aggregated program expenses. It satisfies the pattern by being a subclass of cco:Resource and ensuring all axioms apply universally across aligned jurisdictions.</rdfs:comment>
        <rdfs:label>Total Program Cost</rdfs:label>
        <skos:definition>The total cost of an educational or training program, including tuition, training, and any associated assessments or fees incurred to date.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#TrainingAndDeliveryObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#TrainingAndDeliveryObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Training and Delivery Obligation</rdfs:label>
        <skos:definition>An obligation requiring providers to deliver, manage, and be accountable for training and learning activities, including assessment and off-the-job components.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#TrainingDeliveryAndDocumentationObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#TrainingDeliveryAndDocumentationObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Training Delivery and Documentation Obligation</rdfs:label>
        <skos:definition>An obligation to deliver, document, and maintain records of training activities, including off-the-job training, skill relevance, and planned parameters.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#TrainingProviderOrEmployerPattern -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#TrainingProviderOrEmployerPattern">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:comment>The name &apos;TrainingProviderOrEmployer&apos; captures the dual role of entities across jurisdictions as either training service providers or employers involved in training partnerships. It avoids jurisdiction-specific terms and aligns with the confirmed CCO supertype &apos;Organisation&apos;, satisfying all pattern constraints.</rdfs:comment>
        <rdfs:label>Training Provider or Employer</rdfs:label>
        <skos:definition>An organization that either provides training services or is an employer engaged in training arrangements with educational institutions or training providers.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#TuitionFeeChargingAndInclusionProhibition -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#TuitionFeeChargingAndInclusionProhibition">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Prohibition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Prohibition on Charging and Including Tuition Fees and Associated Costs</rdfs:label>
        <skos:definition>A prohibition on charging excessive, unnecessary, or unauthorized tuition fees and on including non-essential goods, services, or costs within tuition fees.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto#TuitionFeeManagementObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto#TuitionFeeManagementObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Tuition Fee Management Obligation</rdfs:label>
        <skos:definition>An obligation to manage tuition fees through setting, publishing, explaining, refunding, and disclosing related financial information.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ACCC -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ACCC">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#Agent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                        <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>ACCC</rdfs:label>
        <skos:definition>The Australian Competition and Consumer Commission, an independent Commonwealth statutory authority.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ACTACMember -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ACTACMember">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>ACTAC Member</rdfs:label>
        <skos:definition>A member of the Australasian Conference of Tertiary Admission Centres.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#AQFQualification -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#AQFQualification">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>AQF Qualification</rdfs:label>
        <skos:definition>A qualification issued under the Australian Qualifications Framework or a predecessor framework.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ASQA -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ASQA">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#Agent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                        <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>ASQA</rdfs:label>
        <skos:definition>The Australian Skills Quality Authority, the national regulator for Australia&apos;s vocational education and training sector.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ATO -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ATO">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#TaxRegulatoryAuthorityAgentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#Agent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                        <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>ATO</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#IRS"/>
        <skos:definition>The Australian Taxation Office, the principal revenue collection agency of the Australian Government.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#AcademicSuitabilityAssessment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#AcademicSuitabilityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#AssessmentActionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Academic Suitability Assessment</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#AssessmentAction"/>
        <skos:definition>An assessment required to show that a student is academically suited to undertake a course.</skos:definition>
        <skos:definition>The process of determining whether a student is academically suited to undertake an approved course, including any tasks the student is required to complete for that purpose.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#AcademicSuitabilityEvidence -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#AcademicSuitabilityEvidence">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Academic Suitability Evidence</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#ApplicationAndSupportingEvidence"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#SufficientEvidence"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#WrittenEvidence"/>
        <skos:definition>Evidence required to show academic suitability, including qualifications, assessments, or overseas qualification letters.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#AcademicallySuitable -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#AcademicallySuitable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#AcademicEligibilityRequirementPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Academically Suitable</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/ca#ScholasticStandingRequirement"/>
        <skos:definition>Determining whether the student is academically suitable The course provider decides whether the student is academically suited to the course they&apos;re applying for. A student is academically suited to a course when:</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00289"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#AccessibleDefinedTerm -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#AccessibleDefinedTerm">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Accessible Defined Term</rdfs:label>
        <skos:definition>accessible means you have informed the student the information or document is to be given using the system, and have authorised the student to use the system</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00458"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#AccompanyingPerson -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#AccompanyingPerson">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Person"/>
        <rdfs:label>Accompanying Person</rdfs:label>
        <skos:definition>Another person who accompanies or assists a party</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#AccreditedCourse -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#AccreditedCourse">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Accredited Course</rdfs:label>
        <skos:definition>A course that has been accredited by the relevant Australian higher education authority.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#AccumulatedDebtForCourse -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#AccumulatedDebtForCourse">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Accumulated Debt for Course</rdfs:label>
        <skos:definition>Accumulated debt for course is an indicative cumulative debt amount accrued by the student for the VET course code, as reported by providers in TCSI. This amount may be adjusted when payment claims are validated. It may include both VET FEE-HELP and VSL accrued from 1 January 2017.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00846"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ActualTotalTuitionFee -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ActualTotalTuitionFee">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#TotalProgramCostPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Actual Total Tuition Fee</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#TrainingCost"/>
        <skos:definition>The actual total of the tuition fees for a course, which may exceed the estimate under certain conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#AdministrativeErrorCorrection -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#AdministrativeErrorCorrection">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Administrative Error Correction</rdfs:label>
        <skos:definition>A condition where a change is made to correct an administrative error.</skos:definition>
    </owl:Class>
    


