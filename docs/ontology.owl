        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#GraduateProfessionalStudentRole"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#StudentRole"/>
        <skos:definition>The role of a student who is an apprentice, as referenced in StudentAid BC eligibility rules.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#AssessedFinancialNeed -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#AssessedFinancialNeed">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Assessed Financial Need</rdfs:label>
        <skos:definition>The assessed financial need of a student, calculated as allowable costs minus contributions minus resources, which determines the amount of Canada-B.C. integrated student loan and grant funding a student is eligible to receive.</skos:definition>
        <skos:definition>The calculated financial need of a student, determined by evaluating allowable costs against available resources as part of the StudentAid BC assessment process.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00354"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00357"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#AssessedNeed -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#AssessedNeed">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Assessed Need</rdfs:label>
        <skos:definition>Assessed need is used to determine the amount of federal and provincial student financial assistance that a student is eligible to receive from StudentAid BC.</skos:definition>
        <skos:definition>The financial need assessment process considers costs and resources to determine assessed need. Total costs less total resources.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00358"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00438"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Assessment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Assessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EligibilityAssessmentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Assessment</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#FormalAssessment"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#InitialAssessment"/>
        <skos:definition>An assessment conducted to determine eligibility or functional limitations.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#AssessmentCostReimbursement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#AssessmentCostReimbursement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Assessment Cost Reimbursement</rdfs:label>
