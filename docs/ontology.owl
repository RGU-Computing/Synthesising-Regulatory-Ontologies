    <!-- https://w3id.org/cco-gro/onto/ca#IncarceratedOrWarrantedStudentRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#IncarceratedOrWarrantedStudentRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Incarcerated or Warranted Student Role</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DependentStudentWithoutParentalSupport"/>
        <skos:definition>A role held by a student who is incarcerated or has an outstanding warrant for arrest, as defined in the Canada Student Financial Assistance Act.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#IncomeAssistanceRecipient -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#IncomeAssistanceRecipient">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Income Assistance Recipient</rdfs:label>
        <skos:definition>A person who receives income assistance under the B.C. Employment and Assistance Act.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#IndependentStudent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#IndependentStudent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Independent Student</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DependentStudent"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#Student"/>
        <skos:definition>An independent student applying for part-time funding who will be categorized as independent single, married/common-law, or single parent depending on which criteria are met.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Institution -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Institution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EducationalOrganizationPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Institution</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#School"/>
        <skos:definition>An educational institution that offers programs eligible for student financial assistance.</skos:definition>
        <skos:definition>An institution subject to regulatory compliance obligations under Canadian law.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#InstitutionLocation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#InstitutionLocation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Institution Location</rdfs:label>
        <skos:definition>Any location of a post-secondary institution other than the main campus, but under the same corporate structure as the main campus</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00838"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#InstitutionOfficial -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#InstitutionOfficial">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Institution Official</rdfs:label>
        <skos:definition>An official of an institution who may be designated as an Eligibility Signing Officer.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#InstitutionRisk -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#InstitutionRisk">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Institution Risk</rdfs:label>
        <skos:definition>Institution risk is defined according to the following three risk zones: Green (good) Above the national average, Yellow (average) Within one standard deviation below the national average, Red (poor) Below one standard deviation from the national average.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00057"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#InstitutionRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#InstitutionRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Institution Role</rdfs:label>
        <skos:definition>The role of an educational institution eligible to receive adaptive technology loans under PILAT.</skos:definition>
        <skos:definition>The role of an educational institution in the context of student financial assistance.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#InstitutionalTransferForm -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#InstitutionalTransferForm">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Institutional Transfer Form</rdfs:label>
        <skos:definition>A form required for students transferring between campuses of the same institution.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#InstructionalHours -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#InstructionalHours">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Instructional Hours</rdfs:label>
        <skos:definition>The time spent in a classroom or other learning environment where both student and instructor are present.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00841"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#IntegratedStudentLoan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#IntegratedStudentLoan">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Canada-B.C. Integrated Student Loan</rdfs:label>
        <skos:definition>A financial resource representing a Canada-B.C. integrated student loan disbursed on or after August 1, 2000.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#InternationalExchangePolicy -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#InternationalExchangePolicy">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>International Exchange Policy</rdfs:label>
        <skos:definition>An international exchange policy held by a home post-secondary institution.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00097"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#InternationalExchangeStudent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#InternationalExchangeStudent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>International Exchange Student</rdfs:label>
        <skos:definition>A student classified by their post-secondary institution as being on an international exchange.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#LateContinuation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#LateContinuation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Late Continuation</rdfs:label>
        <skos:definition>Late continuation occurs when less than six months have elapsed between a full-time borrower’s previously confirmed PSED and subsequent PSCD during their current period of studies, but the Confirmation of Enrolment is received after more than six months have elapsed.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00577"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#LearningForFutureGrant -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#LearningForFutureGrant">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Learning for Future Grant</rdfs:label>
        <skos:definition>An annual grant of $3,500 per program year to assist with additional education related costs not covered by the Provincial Tuition Waiver Program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#LeaveExtension -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#LeaveExtension">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Leave Extension</rdfs:label>
        <skos:definition>The action of extending a medical or parental leave period by a borrower.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#LeavePeriod -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#LeavePeriod">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Leave Period</rdfs:label>
        <skos:definition>A period during which a borrower is not required to make payments or attend studies, subject to eligibility rules.</skos:definition>
        <skos:definition>A period of medical or parental leave granted to a borrower, which may be extended under certain conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#LegalGuardian -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#LegalGuardian">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Legal Guardian</rdfs:label>
        <skos:definition>A legal guardian is a person who has the legal authority, and duty, to care for another person.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00842"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#LegislativeAuthorityProgram -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#LegislativeAuthorityProgram">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Legislative Authority Program</rdfs:label>
        <skos:definition>Offering programs within legislative authority</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#LivingAllowance -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#LivingAllowance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Living Allowance</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#FinancialResource"/>
        <skos:definition>A financial resource allocated to cover living expenses.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Loan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Loan">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Loan</rdfs:label>
        <skos:definition>A loan resulting from the conversion of a grant overaward.</skos:definition>
        <skos:definition>Financial assistance provided to a student that must be repaid.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#LoanFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#LoanFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Loan Funding</rdfs:label>
        <skos:definition>Financial resources provided as a loan to a student.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#LoanYear -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#LoanYear">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Loan Year</rdfs:label>
        <skos:definition>Loan Year means the period beginning August 1, in any year, and ending on July 31, the following year.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00843"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#LowMiddleIncomeLearner -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#LowMiddleIncomeLearner">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Low and Middle-Income Learner</rdfs:label>
        <skos:definition>A learner who qualifies as low or middle-income for the purposes of the B.C. Access Grant.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#MandatoryFees -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#MandatoryFees">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#AncillaryFeePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Mandatory Fees</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#StudentMembershipFee"/>
        <skos:definition>Mandatory fees are costs associated with attending a post-secondary institution, or enrolment in certain programs (such as registration fee, student license, student association or Alma Mater Society fees, membership fees for overseeing bodies) and are required to be paid by all students in the institution/program. License exam fees (whether included in tuition or not) can be included in tuition if the license exam is mandatory and it is completed within the study period. Optional fees, fees that do not apply to all students and fees already included in the moderate standard of living allowance are not to be included.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00108"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#MandatoryOrientation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#MandatoryOrientation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Mandatory Orientation</rdfs:label>
        <skos:definition>A mandatory orientation period for international exchange programs, included in the period of study for assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#MarriedOrCommonLawStudentLivingAway -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#MarriedOrCommonLawStudentLivingAway">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Married/Common-Law Student Living Away</rdfs:label>
        <skos:definition>A married student or common-law student who needs to live away from the usual family home in a different city to pursue their studies.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#MasterStudentFinancialAssistanceAgreement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#MasterStudentFinancialAssistanceAgreement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Master Student Financial Assistance Agreement</rdfs:label>
        <skos:definition>The Master Student Financial Assistance Agreement (MSFAA) is a legal document that governs the rights and responsibilities, with respect to the financial assistance the student will receive from B.C. and the Government of Canada.</skos:definition>
        <skos:definition>When a student is approved for full-time funding, the Province of British Columbia and the student enter into a legal agreement that provides the legal framework for the funds to be disbursed to the student.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00179"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00566"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#MedicalOrParentalLeave -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#MedicalOrParentalLeave">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Medical or Parental Leave</rdfs:label>
        <skos:definition>A leave from Canada-B.C. integrated student loan repayment obligations granted for medical or parental reasons.</skos:definition>
        <skos:definition>A leave from student loan repayment obligations due to a medical or parental event</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#MedicalOrParentalLeaveApplication -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#MedicalOrParentalLeaveApplication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EnrollmentActionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Medical or Parental Leave Application</rdfs:label>
        <skos:definition>The act of applying for medical or parental leave while enrolled in studies.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#MinimumAwardAmount -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#MinimumAwardAmount">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Minimum Award Amount</rdfs:label>
        <skos:definition>The minimum award amount that can be disbursed, inclusive of Canada Student Loan, B.C. Student Loan and federal and provincial grants and bursaries, is $100 per study period.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Ministry -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Ministry">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#Agent"/>
