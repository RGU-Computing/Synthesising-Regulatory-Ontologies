    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#Commonwealth -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#Commonwealth">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#Agent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                        <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Commonwealth</rdfs:label>
        <rdfs:label>Commonwealth of Australia</rdfs:label>
        <skos:definition>The Commonwealth of Australia acting as a regulatory authority.</skos:definition>
        <skos:definition>The Commonwealth of Australia as a governmental body.</skos:definition>
        <skos:definition>The federal government of Australia.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#CommonwealthAssistanceNotice -->


