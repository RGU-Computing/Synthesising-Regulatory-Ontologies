        <rdfs:label>International Student Role</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/ca#DependentStudent"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DependentStudentWithoutParentalSupport"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#FAFSAStudentRole"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#GraduateProfessionalStudentRole"/>
        <skos:definition>The role of a student who is an international student and clearly not eligible for VET Student Loans.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#IssuedEmailAddressNotPersonal -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#IssuedEmailAddressNotPersonal">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Issued Email Address Exclusion</rdfs:label>
        <skos:definition>An email address you have issued to the student is not considered the student’s personal email address.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00452"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#KeyLegislation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#KeyLegislation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Key Legislation</rdfs:label>
        <skos:definition>Key Commonwealth and state and territory legislation as referenced in Appendix A.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#LargeProviderCondition -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#LargeProviderCondition">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Large Provider Condition</rdfs:label>
        <skos:definition>A condition that applies when an approved course provider has more than 1,000 enrolments in a financial year.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#LearnerProtectionInformation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#LearnerProtectionInformation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#LearnerInformationRecordPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Learner Protection Information</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#IndividualisedLearnerRecord"/>
        <skos:definition>Information that relates to ensuring each learner is properly informed and protected.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#LevyPart -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#LevyPart">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Levy Part</rdfs:label>
        <skos:definition>A portion of the levy that is calculated using a provider&apos;s validated data from previous years to reflect actual enrolments and risk.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ListedCourseProvider -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ListedCourseProvider">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#TrainingProviderOrEmployerPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Listed Course Provider</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#ProviderOrEmployer"/>
        <skos:definition>A registered training organisation that is a Table A or Table B provider under HESA, a TAFE established under state or territory legislation, or a training organisation owned by the Commonwealth, state, or territory, or a body specified in the Rules.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#Loan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#Loan">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Loan</rdfs:label>
        <skos:definition>A financial resource representing a loan that can be accessed by a student for tuition fees.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#LoanAmount -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#LoanAmount">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Loan Amount</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#MaximumFundingAmount"/>
        <skos:definition>A financial resource representing a previously paid loan amount under the VET Student Loans program.</skos:definition>
        <skos:definition>A loan amount payable to a provider under the relevant scheme.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#LoanAmountRepayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#LoanAmountRepayment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RepaymentActionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Loan Amount Repayment</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#RepayOverPayment"/>
        <skos:definition>The action of repaying a loan amount that was used to pay tuition fees for a student&apos;s course.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#LoanCap -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#LoanCap">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Loan Cap</rdfs:label>
        <skos:definition>A loan cap is the maximum amount a student can borrow as a VET Student Loan for a course.</skos:definition>
        <skos:definition>A monetary limit on the amount that can be loaned under a student loan program.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00334"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#LoanCapAmount -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#LoanCapAmount">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Loan Cap Amount</rdfs:label>
        <skos:definition>The relevant loan cap amount for a course, determined as the indexed amount in the year of study.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00336"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#LoanPaymentProcess -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#LoanPaymentProcess">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Loan Payment Process</rdfs:label>
        <skos:definition>The process by which the Secretary pays loan amounts to the provider.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#MakingARepresentation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#MakingARepresentation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Making a Representation</rdfs:label>
        <skos:definition>&apos;Making a representation&apos; means you&apos;ve used words or actions to state or suggest something.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00581"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#MarketingMaterial -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#MarketingMaterial">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Marketing Material</rdfs:label>
        <skos:definition>Marketing and promotional material relating to approved courses.</skos:definition>
        <skos:definition>Promotional content used to advertise or inform about products, services, or entities.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#MarketingMerchandise -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#MarketingMerchandise">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Marketing Merchandise</rdfs:label>
        <skos:definition>Promotional items offered by an approved course provider, subject to a per-person value limit.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#MaximumTuitionFee -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#MaximumTuitionFee">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Maximum Tuition Fee</rdfs:label>
        <skos:definition>The maximum tuition fees mentioned in the marketing of a course, serving as an upper bound for estimates.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#MedicalCircumstances -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#MedicalCircumstances">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#CircumstanceConditionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Medical Circumstances</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/ca#ExceptionalCircumstance"/>
        <skos:definition>medical circumstances – for example, where the student’s medical condition has changed so much that they’re unable to continue studying</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00527"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#MeritBasedDecisionProcedure -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#MeritBasedDecisionProcedure">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Merit-Based Decision Procedure</rdfs:label>
        <skos:definition>Open, fair and transparent procedures that are reasonably believed to be based on merit for making decisions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#NVR_Act -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#NVR_Act">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Regulation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#specifiesNorm"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://www.w3id.org/cco/cco#Norm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasValidityStart"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasValidityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>NVR Act</rdfs:label>
        <skos:definition>The National Vocational Education and Training Regulator Act referenced in the provision, including sections 103-110.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#NoDisadvantageToStudents -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#NoDisadvantageToStudents">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>No Disadvantage to Students</rdfs:label>
        <skos:definition>A condition where a change does not disadvantage students enrolled in or seeking to enrol in a course.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#NoEnrolmentCondition -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#NoEnrolmentCondition">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>No Enrolment Condition</rdfs:label>
        <skos:definition>A condition that applies when an approved course provider has no enrolments in a financial year.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#NonSubsidisedStudentRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#NonSubsidisedStudentRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Non-Subsidised Student Role</rdfs:label>
        <skos:definition>The role of a student whose course is not subsidised by a state or territory government.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#NonTuitionFee -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#NonTuitionFee">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#AncillaryFeePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Non-Tuition Fee</rdfs:label>
        <rdfs:label>Non-tuition Fee</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/ca#MandatoryFees"/>
        <skos:definition>Any fees other than tuition fees that are payable for the course.</skos:definition>
        <skos:definition>Non-tuition fees are any fees not directly related to academic suitability assessments, enrolment, tuition, examinations, or awarding qualifications.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00138"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#NonTuitionFees -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#NonTuitionFees">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#AncillaryFeePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Non-Tuition Fees</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/ca#MandatoryFees"/>
        <skos:definition>Fees other than tuition fees that may be charged to students.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#NoticeOfDefault -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#NoticeOfDefault">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Notice of Default</rdfs:label>
        <skos:definition>A notice of default or other information required to be given under section 66C of the Act.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#NoticeOfReviewRights -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#NoticeOfReviewRights">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Notice of Review Rights</rdfs:label>
        <skos:definition>A document that informs a student of their rights to seek review of a decision, along with the reasons for the decision or reconsideration.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#OngoingRequirementsAndConditions -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#OngoingRequirementsAndConditions">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Ongoing Requirements and Conditions</rdfs:label>
        <skos:definition>The set of ongoing requirements and conditions of approval that an approved provider must meet.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#OnlineCourseLogin -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#OnlineCourseLogin">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Online Course Login</rdfs:label>
        <skos:definition>An occasion on which a student logs into an online course platform.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#OnlineEnquiryForm -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#OnlineEnquiryForm">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Online Enquiry Form</rdfs:label>
        <skos:definition>The online enquiry form on Provider Enquiries used as a submission channel for written notices.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#OutcomeRTOStandards -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#OutcomeRTOStandards">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Regulation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#specifiesNorm"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://www.w3id.org/cco/cco#Norm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasValidityStart"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasValidityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Outcome RTO Standards</rdfs:label>
        <skos:definition>The Outcome RTO Standards referenced in the provision, including standards 1.1, 1.3, 1.4, 1.5 and 1.6.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#OverpaymentAmount -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#OverpaymentAmount">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Overpayment Amount</rdfs:label>
        <skos:definition>An amount equal to any amount that was paid to a provider but was not payable, such as erroneous payments or payments based on false information.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ParticularInformation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ParticularInformation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Particular Information</rdfs:label>
        <skos:definition>Specific information required to be provided to students before enrolment as mandated by regulation.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#PartyToProcedure -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#PartyToProcedure">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Party to Procedure</rdfs:label>
        <skos:definition>A party to this stage of the procedure</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#PenaltyUnit -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#PenaltyUnit">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Penalty Unit</rdfs:label>
        <skos:definition>A monetary penalty unit as defined under Australian law.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#PeriodOfApproval -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#PeriodOfApproval">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Period of Approval</rdfs:label>
        <skos:definition>The period for which a provider is approved will be specified in the approval notice. The period of approval is not more than 7 years.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00071"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#PeriodicReport -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#PeriodicReport">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Periodic Report</rdfs:label>
        <skos:definition>A periodic report on VSL students required by the VSL Tuition Protection Director.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#Person -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#Person">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Person"/>
        <rdfs:label>Person</rdfs:label>
        <skos:definition>A natural person under Australian law.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#PersonalInformation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#PersonalInformation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Personal Information</rdfs:label>
        <skos:definition>Information or an opinion about an identified individual, or an individual who is reasonably identifiable, as defined in the Privacy Act 1988.</skos:definition>
        <skos:definition>Personal information obtained or generated by a VET officer or disclosed under section 95.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#PreEnrolmentInformation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#PreEnrolmentInformation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Pre-Enrolment Information</rdfs:label>
        <skos:definition>Information about course fees, census days, and provider processes that must be given to students before enrolment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#PreviousGovernmentFundedVET -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#PreviousGovernmentFundedVET">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Previous Government-Funded VET</rdfs:label>
        <skos:definition>Previous vocational education and training for which the Commonwealth, a state or territory provided funding.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#PrivacyAct1988 -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#PrivacyAct1988">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Regulation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#specifiesNorm"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://www.w3id.org/cco/cco#Norm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasValidityStart"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasValidityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Privacy Act 1988</rdfs:label>
        <skos:definition>The Australian Privacy Act 1988, which regulates the handling of personal information by Australian government agencies and organisations.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ProcedureSet -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ProcedureSet">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Procedure Set</rdfs:label>
        <skos:definition>A set of procedures for determining academic suitability, publishing fee information, and clarifying the VSL application process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ProcessesAndProcedures -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ProcessesAndProcedures">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Processes and Procedures</rdfs:label>
        <skos:definition>A set of documented processes and procedures required to be published by an approved course provider.</skos:definition>
        <skos:definition>Documented processes and procedures for student withdrawal and enrolment cancellation in an approved course.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ProgressionForm -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ProgressionForm">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Progression Form</rdfs:label>
        <skos:definition>A form used to record a student&apos;s withdrawal, deferral, or recommencement of study for VET Student Loans purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#Provider -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#Provider">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EducationalOrganizationPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Provider</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#School"/>
        <skos:definition>An education provider receiving Commonwealth payments and responsible for recovering outstanding tuition fees.</skos:definition>
        <skos:definition>An educational provider that delivers courses to enrolled students.</skos:definition>
        <skos:definition>An entity that provides courses and may be eligible to offer VET Student Loans.</skos:definition>
        <skos:definition>An entity that provides educational services and is subject to regulatory provisions under Australian law.</skos:definition>
        <skos:definition>An entity that provides educational services under the Act.</skos:definition>
        <skos:definition>An entity that provides educational services under the VET Student Loans program.</skos:definition>
        <skos:definition>An entity that provides services or goods under the regulatory framework.</skos:definition>
        <skos:definition>An organisation that may be approved under the regulatory scheme.</skos:definition>
        <skos:definition>An organisation that provides VET Student Loans under the Act.</skos:definition>
        <skos:definition>An organisation that provides courses and may be subject to VET Student Loan regulations.</skos:definition>
        <skos:definition>An organisation that provides education services under the VET Student Loans program.</skos:definition>
        <skos:definition>An organisation that provides educational courses under the Act.</skos:definition>
        <skos:definition>An organisation that provides educational courses under the VET Student Loans program.</skos:definition>
        <skos:definition>An organisation that provides educational services under the Act.</skos:definition>
        <skos:definition>An organisation that provides educational services under the VET Student Loans program.</skos:definition>
        <skos:definition>An organisation that provides educational services under the relevant regulatory framework.</skos:definition>
        <skos:definition>An organisation that provides services under the Act.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ProviderFeeLimit -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ProviderFeeLimit">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Provider Fee Limit</rdfs:label>
        <skos:definition>A financial limit on the total amount of loans a provider may offer, as specified in approval documentation.</skos:definition>
        <skos:definition>A funding allocation cap limiting the total amount of VSL payments a provider can receive in a year or other period.</skos:definition>
        <skos:definition>A limit on the fees that an approved course provider can charge for a course under the VET Student Loans program.</skos:definition>
        <skos:definition>A limit on the fees that an approved course provider may charge.</skos:definition>
        <skos:definition>A provider fee limit is a maximum dollar amount for VET Student Loans that can be paid to a provider for a particular period for approved VSL courses.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00072"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00075"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ProviderFeeLimitExcessLoanAmount -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ProviderFeeLimitExcessLoanAmount">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Excess Loan Amount</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/ca#Overaward"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#MaximumFundingAmount"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#ProviderAdditionalPayment"/>
        <skos:definition>Any loan amount that exceeds the provider fee limit for an approved course provider</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ProviderLegislativeObligations -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ProviderLegislativeObligations">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Provider Legislative Obligations</rdfs:label>
        <skos:definition>The set of legislative obligations that an approved course provider must comply with under Australian law.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ProviderOrganisation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ProviderOrganisation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Provider Organisation Role</rdfs:label>
        <skos:definition>The role of an organisation that is subject to provider legislative obligations.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ProviderPaymentReport -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ProviderPaymentReport">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Provider Payment Report</rdfs:label>
        <skos:definition>A report detailing provider payments, available in HITS, containing eligibility assessment outcomes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ProviderSuitabilityRequirements -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ProviderSuitabilityRequirements">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Provider Suitability Requirements</rdfs:label>
        <skos:definition>The set of requirements that an applicant must meet to be considered suitable as an approved provider.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#RPLFee -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#RPLFee">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>RPL Fee</rdfs:label>
        <skos:definition>A fee for Recognition of Prior Learning covered by VET Student Loans and other tuition fees.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ReadingMaterial -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ReadingMaterial">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Reading Material</rdfs:label>
        <skos:definition>Reading material, such as anthologies of required readings, provided these texts are also made readily available free of charge.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ReconsiderationOfDecision -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ReconsiderationOfDecision">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RegulatoryDecisionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Reconsideration of Decision</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/ca#AppealDecision"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#Review"/>
        <skos:definition>The process or outcome of reviewing a previous decision, as requested by an affected party.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ReconsiderationRequest -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ReconsiderationRequest">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Reconsideration Request</rdfs:label>
        <skos:definition>An action whereby a person formally requests a review of a decision by someone not involved in the original decision-making process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#Record -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#Record">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Record</rdfs:label>
        <skos:definition>A document or set of documents that must be retained as evidence of compliance or activity.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#RecreditedAmount -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#RecreditedAmount">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Recredited Amount</rdfs:label>
        <skos:definition>The amount the Secretary recredits, which must equal the loan amount used to pay tuition fees for the student for the relevant part of the course.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00510"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#RecreditingProcessesAndProcedures -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#RecreditingProcessesAndProcedures">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Re-crediting Processes and Procedures</rdfs:label>
        <skos:definition>Processes and procedures for explaining the re-crediting of students&apos; HELP balances, as required by Rules s 89.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#RegisteredHigherEducationProvider -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#RegisteredHigherEducationProvider">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Registered Higher Education Provider</rdfs:label>
        <skos:definition>A role held by a person or organisation that is registered as a higher education provider under Australian law.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#RegisteredTrainingOrganisation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#RegisteredTrainingOrganisation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Registered Training Organisation</rdfs:label>
        <skos:definition>An organisation registered as a training provider under the applicable Australian regulatory scheme.</skos:definition>
        <skos:definition>An organisation registered to provide vocational education and training in Australia.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00009"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#RegulatoryAuthority -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#RegulatoryAuthority">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RegulatoryOfficialPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Regulatory Authority</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#Regulator"/>
        <skos:definition>The authority responsible for administering and enforcing the Act and Rules.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#RegulatoryAuthorityAgent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#RegulatoryAuthorityAgent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#JurisdictionalRegulatorPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#Agent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                        <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Regulatory Authority Agent</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/ca#RegulatoryAuthorityAgent"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#RegulatoryAuthorityAgent"/>
        <skos:definition>An agent acting as a regulatory authority within the Australian jurisdiction.</skos:definition>
        <skos:definition>An agent that acts as a regulatory authority within the Australian jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#RegulatoryAuthorityRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#RegulatoryAuthorityRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RegulatoryOfficialPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Regulatory Authority Role</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#Regulator"/>
        <skos:definition>A role held by an agent that exercises regulatory authority under Australian law.</skos:definition>
        <skos:definition>A role held by an agent that exercises regulatory authority within the Australian jurisdiction.</skos:definition>
        <skos:definition>A role held by an agent that grants regulatory authority within the Australian jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ReplacementCourseInformation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ReplacementCourseInformation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Replacement Course Information</rdfs:label>
        <skos:definition>Information about suitable replacement courses required by the VSL Tuition Protection Director.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#RequiredProviderRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#RequiredProviderRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Required Provider Role</rdfs:label>
        <skos:definition>The role of a provider required to have certain processes and procedures under Australian regulatory provisions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#Resource -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#Resource">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Resource</rdfs:label>
        <skos:definition>A resource as defined within the Australian regulatory context.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ReviewOfDecision -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ReviewOfDecision">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Review of Decision</rdfs:label>
        <skos:definition>A review of a decision conducted by the Administrative Review Tribunal.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ReviewOfficer -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ReviewOfficer">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Review Officer</rdfs:label>
        <skos:definition>A role responsible for reconsidering a decision upon a student&apos;s review request.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ReviewOfficerRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ReviewOfficerRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EligibilityVerificationRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Review Officer Role</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/ca#EligibilitySigningOfficer"/>
        <skos:definition>The role of a review officer who reconsiders decisions and issues written notices to students.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ReviewParty -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ReviewParty">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Review Party</rdfs:label>
        <skos:definition>A party to a review process, as defined under Australian regulatory provisions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ReviewableDecision -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ReviewableDecision">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Reviewable Decision</rdfs:label>
        <skos:definition>A decision that is subject to review under Australian regulatory provisions.</skos:definition>
        <skos:definition>A reviewable decision under the Act – that is, a decision about recrediting a student’s HELP balance for special circumstances</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00532"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ReviewableVETDecision -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ReviewableVETDecision">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Reviewable VET Decision</rdfs:label>
        <skos:definition>A decision made under the VET regulatory framework that is subject to review or reconsideration.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#RightToApplyForARTReview -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#RightToApplyForARTReview">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Right to Apply for ART Review</rdfs:label>
        <skos:definition>The right to apply to the Administrative Review Tribunal to have a decision reviewed.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00539"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#Scenario1RPLDefinition -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#Scenario1RPLDefinition">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Scenario 1 RPL Definition</rdfs:label>
        <skos:definition>Scenario 1: RPL is granted as part of the UoS. It is intended that the student will enrol in a standard UoS (or the majority of it) as negotiated with the provider. Only a small proportion of the UoS will be granted via RPL.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00839"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#Schedule3Course -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#Schedule3Course">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Schedule 3 Course</rdfs:label>
        <skos:definition>A course listed in Schedule 3 of the Determination under &apos;Schedule 3 – Approved courses for specified providers&apos;.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#Secretary -->


