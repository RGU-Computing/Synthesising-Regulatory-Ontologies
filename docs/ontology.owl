    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#DebtReport -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#DebtReport">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Debt Report</rdfs:label>
