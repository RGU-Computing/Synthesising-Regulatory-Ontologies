        </rdfs:subClassOf>
        <rdfs:label>Ministry of Post-Secondary Education and Future Skills</rdfs:label>
        <skos:definition>The Ministry of Post-Secondary Education and Future Skills, a regulatory authority agent in Canada.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ModerateStandardOfLivingAllowance -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ModerateStandardOfLivingAllowance">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Moderate Standard of Living Allowance</rdfs:label>
        <skos:definition>The parent’s Moderate Standard of Living allowance does not include security costs for items such as life and employment insurance payments, retirement and pension fund payments, and RRSP payments, and education tuition fees.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00784"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ModifiedIndependentStudent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ModifiedIndependentStudent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Modified Independent Student</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DependentStudentWithoutParentalSupport"/>
        <skos:definition>A student who may be considered a &apos;modified independent&apos; student on an appeal basis, despite normally being dependent.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#MotorVehicleAct -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#MotorVehicleAct">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Regulation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#specifiesNorm"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://www.w3id.org/cco/cco#Norm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasValidityStart"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasValidityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Motor Vehicle Act</rdfs:label>
        <skos:definition>The Motor Vehicle Act of British Columbia.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00022"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#MutuallyExclusiveCourses -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#MutuallyExclusiveCourses">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Mutually Exclusive Courses</rdfs:label>
        <skos:definition>Courses that have a different course name and number but have the same content as another course. Students who are taking duplicate or mutually exclusive courses will not be granted credit for a second time and the duplicate course will not be counted when determining a student’s course load of study for StudentAid BC purposes.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00844"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#NSLSC -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#NSLSC">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>NSLSC</rdfs:label>
        <rdfs:label>National Student Loans Service Centre</rdfs:label>
        <skos:definition>The National Student Loans Service Centre (NSLSC), responsible for administering and disbursing Canada Student Loans and Grants.</skos:definition>
        <skos:definition>The National Student Loans Service Centre, which administers Canada student loans</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#NationalStudentLoansServiceCentre -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#NationalStudentLoansServiceCentre">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>National Student Loans Service Centre</rdfs:label>
        <skos:definition>The National Student Loans Service Centre (NSLSC) through which borrowers must repay their Canada-B.C. integrated student loans.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#NeedAssessment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#NeedAssessment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Need Assessment</rdfs:label>
        <skos:definition>A calculated assessment of a student&apos;s financial need, which may exclude parental income and assets when the sponsor is an organization.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00431"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#NewApplication -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#NewApplication">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>New Application</rdfs:label>
        <skos:definition>A formal request submitted by a borrower to continue receiving financial support under the RAP program for a subsequent period.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#NonPunitiveWithdrawal -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#NonPunitiveWithdrawal">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Non-punitive Withdrawal</rdfs:label>
        <skos:definition>Non-punitive Withdrawal (withdrawal before classes start) is allowed if the student has repaid the total amount funded within 30 days of deposit of funds. If an application cannot be cancelled for the initial disbursement of the application due to issuance of funding through electronic funds transfer, a non-punitive withdrawal will be allowed if the student has repaid the total amount funded within 30 days of deposit of funds. Non-punitive Withdrawal (due to institution closure) If students are withdrawn due to institution closure as outlined in Chapter 9, Section 4, the withdrawal can be considered non-punitive.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00849"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#NonPunitiveWithdrawalForm -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#NonPunitiveWithdrawalForm">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#AcademicWithdrawalResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Non-Punitive Withdrawal Form</rdfs:label>
        <skos:definition>A form used to report non-punitive withdrawals from a study period to StudentAid BC.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#NonRepayableFinancialAssistance -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#NonRepayableFinancialAssistance">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Non-repayable Financial Assistance</rdfs:label>
        <skos:definition>A category of financial assistance that does not require repayment, including grants, bursaries, and scholarships for eligible students.</skos:definition>
        <skos:definition>Financial assistance that does not require repayment, provided to eligible students.</skos:definition>
        <skos:definition>Financial assistance that does not require repayment, such as grants or bursaries.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#NonTraditionalProgram -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#NonTraditionalProgram">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Non-Traditional Program</rdfs:label>
        <skos:definition>Online programs, blended learning, distance education, or other programs with a non-traditional form of delivery, or a combination of traditional and non-traditional delivery</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#NoticeOfAssessment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#NoticeOfAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RegulatoryDecisionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Notice of Assessment</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#EvidenceOfEligibility"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#StatementOfEducationalPurpose"/>
        <skos:definition>An official document issued to a student confirming their assessed financial need and eligibility for student financial assistance.</skos:definition>
        <skos:definition>An official document issued to a student detailing the results of their financial assistance application assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#NursesEducationBursary -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#NursesEducationBursary">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Nurses Education Bursary</rdfs:label>
        <skos:definition>A bursary of $2,000 per year for nurses education, allocated by SABC.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#NursesEducationBursaryBudget -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#NursesEducationBursaryBudget">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Nurses Education Bursary Budget</rdfs:label>
        <skos:definition>The annual budget for the Nurses Education Bursary (NEB) program, allocated to eligible nursing students in British Columbia.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#OptionalOrientation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#OptionalOrientation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Optional Orientation</rdfs:label>
        <skos:definition>An optional orientation period, not included in the period of study for assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#OtherCostsAndResourceAssessments -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#OtherCostsAndResourceAssessments">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Other Costs and Resource Assessments</rdfs:label>
        <skos:definition>Additional costs and resource assessments that may be included or adjusted by StudentAid BC during an appeal.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Overaward -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Overaward">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Overaward</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#LateDisbursement"/>
        <skos:definition>A student who received more student financial assistance than he or she was eligible to receive.</skos:definition>
        <skos:definition>Excess student financial assistance received beyond eligibility, subject to deduction from future loan entitlement.</skos:definition>
        <skos:definition>Student financial assistance already provided that exceeds the student&apos;s reassessed eligibility.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00852"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PILATFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PILATFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>PILAT Funding</rdfs:label>
        <skos:definition>A funding allocation program that provides adaptive technology loans to institutions to support student access to assistive technology.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ParentLivingOutsideCanada -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ParentLivingOutsideCanada">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Parent Living Outside Canada</rdfs:label>
        <skos:definition>A role held by a parent who resides outside Canada for the purposes of student financial assistance income reporting.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00432"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ParentalExpectedContribution -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ParentalExpectedContribution">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ParentalExpectedContributionFromAssets -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ParentalExpectedContributionFromAssets">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Parental Expected Contribution from Assets</rdfs:label>
        <skos:definition>The calculated amount a parent is expected to contribute from their assets, determined as one percent of the total net value of all eligible assets (excluding RRSPs, motor vehicles, principal residence and business/farm), in excess of a standard exemption of $150,000, divided by the number of the parents’ dependants who are attending post-secondary studies.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00437"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ParentalIncomeReportingCalculation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ParentalIncomeReportingCalculation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Parental Income Reporting Calculation</rdfs:label>
        <skos:definition>A calculation rule defining how parents living outside Canada must report their income and assets on Appendix 1, including conditional logic for unfiled Canadian tax returns.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00432"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ParentalLivingAllowance -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ParentalLivingAllowance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialNeedAssessmentInputPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Parental Living Allowance</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#ParentsAvailableIncome"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#ParentsContribution"/>
        <skos:definition>A moderate standard of living allowance set by the Government of Canada that is a measure of the cost of living that includes shelter, food, miscellaneous expenses and transportation, and takes into account family size. This amount is used in calculating the contribution parents are expected to make towards a dependant student’s education expenses.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00853"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PartTimeCanadaStudentLoan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PartTimeCanadaStudentLoan">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Part-time Canada Student Loan</rdfs:label>
        <skos:definition>A loan available to part-time students in Canada to support their studies.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PartTimeLoan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PartTimeLoan">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Part-Time Loan</rdfs:label>
        <skos:definition>A financial resource representing a loan issued to a student enrolled in part-time studies.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PartTimeLoanOrGrantFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PartTimeLoanOrGrantFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Part-Time Loan or Grant Funding</rdfs:label>
        <skos:definition>Financial resources provided as part-time loans or grants to eligible students.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PartTimeMSFAA -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PartTimeMSFAA">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Part-Time MSFAA</rdfs:label>
        <skos:definition>The Part-Time MSFAA is a legal document comprised of two separate loan contracts with the federal and provincial governments.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00686"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PartTimeStudent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PartTimeStudent">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Part-Time Student</rdfs:label>
        <skos:definition>A student enrolled in a part-time program, maintaining a course load from 20 to 59% of a full-time course load.</skos:definition>
        <skos:definition>A student who is studying on a part-time basis towards the completion of a certificate, diploma or degree.</skos:definition>
        <skos:definition>For part-time, the student must successfully complete all courses for which their Canada Student Financial Assistance Program funding was issued. If the student is studying at 20% of a full-time course load and drops their only course, this is considered a withdrawal.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00868"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PartTimeStudentFinancialAssistanceApplication -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PartTimeStudentFinancialAssistanceApplication">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Part-Time Student Financial Assistance Application</rdfs:label>
        <skos:definition>An application submitted by a student for part-time financial assistance, including loans and grants.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PartTimeStudentFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PartTimeStudentFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Part-Time Student Funding</rdfs:label>
        <skos:definition>Financial assistance funding available to part-time students under the Canada Student Financial Assistance Program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PartTimeStudentLoanApplication -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PartTimeStudentLoanApplication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FundingApplicationPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Part-Time Student Loan Application</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#FAFSAApplication"/>
        <skos:definition>A completed application form for part-time student loans and/or in-study payment-free status, submitted to the Canada Student Financial Assistance Program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PartTimeStudentRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PartTimeStudentRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Part-Time Student Role</rdfs:label>
        <skos:definition>The role held by a student who is enrolled in part-time classes and has received a part-time loan.</skos:definition>
        <skos:definition>The role of a student enrolled in part-time studies in Canada.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PartTimeStudiesExceptionCondition -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PartTimeStudiesExceptionCondition">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Part-Time Studies Exception Condition</rdfs:label>
        <skos:definition>A condition for students who began part-time studies prior to 2015/16, continuing eligibility based on institution location and original residency policy.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PartnershipAgreement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PartnershipAgreement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Partnership Agreement</rdfs:label>
        <skos:definition>A formal partnership agreement between a home post-secondary institution and an international institution.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00097"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PeriodOfStudy -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PeriodOfStudy">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Period of Study</rdfs:label>
        <skos:definition>The total duration of a student&apos;s full-time study program, including exam periods and mandatory orientations, but excluding optional orientations and excessive breaks.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PermanentDisability -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PermanentDisability">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Permanent Disability</rdfs:label>
        <skos:definition>A disability that is permanent, persistent, or prolonged, qualifying a student for a reduced course load requirement.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PersistentOrProlongedDisability -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PersistentOrProlongedDisability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FunctionalImpairmentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Persistent or Prolonged Disability</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#LearningDifficultyOrDisability"/>
        <skos:definition>Any impairment, including a physical, mental, intellectual, cognitive, learning, communication or sensory impairment - or a functional limitation - that restricts the ability of a person to perform the daily activities necessary to pursue studies at a post-secondary school level or to participate in the labour force and has lasted, or is expected to last, for a period of at least 12 months but is not expected to remain with the person for the person&apos;s expected life.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00855"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PostCredentialTrainingPeriod -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PostCredentialTrainingPeriod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#PostCredentialTrainingPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Post-Credential Training Period</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#Learning"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#RepeatedTraining"/>
        <skos:definition>Periods of training required for professional licensing or accreditation after the granting of a formal credential (internship, articling, etc.).</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PostSecondaryInstitution -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PostSecondaryInstitution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EducationalOrganizationPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Post-Secondary Institution</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#AwardingBody"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#School"/>
        <skos:definition>An educational institution providing post-secondary programs, as referenced in Canadian student aid regulations.</skos:definition>
        <skos:definition>An educational institution providing post-secondary programs, required to confirm student enrolment for funding disbursement.</skos:definition>
        <skos:definition>An organisation providing post-secondary education.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PostSecondaryInstitutionOwnerOperatorRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PostSecondaryInstitutionOwnerOperatorRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Post-Secondary Institution Owner/Operator Role</rdfs:label>
        <skos:definition>The role of an owner or operator of a post-secondary institution in Canada.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00694"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PostSecondaryStudent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PostSecondaryStudent">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Post-Secondary Student</rdfs:label>
        <skos:definition>A role held by an individual enrolled in post-secondary studies.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PostSecondaryStudies -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PostSecondaryStudies">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Post-Secondary Studies</rdfs:label>
        <skos:definition>The action of attending post-secondary educational studies.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PrivateAct -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PrivateAct">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Private Act</rdfs:label>
        <skos:definition>A Private Act of the Legislature</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PrivatePostSecondaryInstitution -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PrivatePostSecondaryInstitution">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Private Post-Secondary Institution</rdfs:label>
        <skos:definition>An in-province private post-secondary institution or in-province private academic post-secondary institution in Canada.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PrivateVocationalTradeInstitution -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PrivateVocationalTradeInstitution">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Private Vocational/Trade Institution</rdfs:label>
        <skos:definition>A private post-secondary institution offering vocational or trade programs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ProfessionalThirdParty -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ProfessionalThirdParty">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Professional Third Party</rdfs:label>
        <skos:definition>A professional third party includes, but is not limited to: counselor, psychologist, religious advisor, doctor, teacher, police, and/or staff at a social service agency such as an organization supporting those experiencing abuse or violence.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00383"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Program -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Program">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EducationalProgramPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Program</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#ApprenticeshipProgramme"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#Programme"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#Training"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#TrainingOrAssessment"/>
        <skos:definition>An academic or career training program offered by a post-secondary institution.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ProtectedPerson -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ProtectedPerson">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Protected Person</rdfs:label>
        <skos:definition>Protected Persons include Convention Refugees and Humanitarian-Protected Persons Abroad classes, and persons in need of protection, defined as a person whose removal to their country of nationality or former habitual residence would subject them to the possibility of torture, risk of life, or risk of cruel and unusual treatment or punishment.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00857"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Province -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Province">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EducationalOrganizationPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Province</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#School"/>
        <skos:definition>A provincial government entity responsible for determining and monitoring student eligibility under federal regulations.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ProvinceOfBritishColumbia -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ProvinceOfBritishColumbia">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#Agent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                        <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Province of British Columbia</rdfs:label>
        <skos:definition>The provincial government authority of British Columbia, Canada, which sets policy for adult upgrading grants.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ProvinceOfResidencyCondition -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ProvinceOfResidencyCondition">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Province of Residency Condition</rdfs:label>
        <skos:definition>A condition that eligibility is based on the province of residency.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ProvincialProgram -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ProvincialProgram">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Provincial Program</rdfs:label>
        <skos:definition>A program administered by a provincial government, such as financial assistance or social services.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#PublicPostSecondaryLoanProgram -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#PublicPostSecondaryLoanProgram">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Public Post-Secondary Loan Program</rdfs:label>
        <skos:definition>The Public Post-Secondary Loan Program (PPL) provides for the loan of assistive technology to students with accessibility challenges.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#RAPApplicant -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#RAPApplicant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>RAP Applicant</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#Student"/>
        <skos:definition>An individual who applies for the Repayment Assistance Plan (RAP) benefit</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#RAPApplication -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#RAPApplication">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>RAP Application</rdfs:label>
        <skos:definition>An application submitted under the Repayment Assistance Plan.</skos:definition>
        <skos:definition>The application form, either online or paper, used to apply for the Repayment Assistance Plan</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#RAPDProcessing -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#RAPDProcessing">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>RAP-D Processing</rdfs:label>
        <skos:definition>The action of processing a RAP application under the RAP-D stream for borrowers with disabilities.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#RAPRecoveryObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#RAPRecoveryObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Obligation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>RAP Recovery Obligation</rdfs:label>
        <skos:definition>The obligation for borrowers to fulfill RAP recovery requirements to remove their affordable payment restriction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#RAPStage2 -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#RAPStage2">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>RAP Stage 2</rdfs:label>
        <skos:definition>The second stage of the Repayment Assistance Plan, providing coverage of principal and interest not covered by the borrower&apos;s affordable monthly payment.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00597"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#RAPStage2EligibleBorrower -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#RAPStage2EligibleBorrower">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>RAP Stage 2 Eligible Borrower</rdfs:label>
        <skos:definition>A borrower who has been on RAP Stage 1 for at least 60 months or in repayment for at least 10 years, and is eligible for RAP Stage 2.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00597"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#RAPStage2RestrictedBorrower -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#RAPStage2RestrictedBorrower">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>RAP Stage 2 Restricted Borrower</rdfs:label>
        <skos:definition>A borrower who has received at least one month of RAP Stage 2 and is subject to the RAP Stage 2 restriction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ReceiptVerifyingServiceDelivery -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ReceiptVerifyingServiceDelivery">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Receipt Verifying Service Delivery</rdfs:label>
        <skos:definition>A receipt that verifies the delivery of assistive services</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#RefundPolicy -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#RefundPolicy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentWithdrawalManagementPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Refund Policy</rdfs:label>
        <skos:definition>A policy document governing refunds to students upon withdrawal.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#RegisteredDisabilitySavingsPlan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#RegisteredDisabilitySavingsPlan">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Registered Disability Savings Plan</rdfs:label>
        <skos:definition>Registered Disability Savings Plan (RDSP) is a long-term savings plan to help Canadians with disabilities and their families save for the future. Funds held in an RDSP account are exempt as an asset for the purpose of StudentAid BC.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00858"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#RegulatoryAuthorityAgent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#RegulatoryAuthorityAgent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#JurisdictionalRegulatorPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#Agent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                        <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Regulatory Authority Agent</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#RegulatoryAuthorityAgent"/>
        <skos:definition>An agent that acts as a regulatory authority within the Canadian jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ReimbursementApplicant -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ReimbursementApplicant">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Reimbursement Applicant</rdfs:label>
        <skos:definition>An applicant seeking reimbursement for assessment costs under the Canada Student Financial Assistance Program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ReimbursementApplication -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ReimbursementApplication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RepaymentActionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Reimbursement Application</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#RepayOverPayment"/>
        <skos:definition>The action of applying for reimbursement.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ReimbursementAssessmentCosts -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ReimbursementAssessmentCosts">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Reimbursement of Assessment Costs</rdfs:label>
        <skos:definition>Reimbursement of assessment costs associated with each disability for applicants verified for multiple disabilities.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00318"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ReimbursementForPreviouslyVerifiedCondition -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ReimbursementForPreviouslyVerifiedCondition">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Reimbursement for Previously Verified Condition</rdfs:label>
        <skos:definition>A resource representing reimbursement sought for a condition that has been previously verified.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#RemediationEvidenceOrPlan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#RemediationEvidenceOrPlan">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Remediation Evidence or Plan</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#EvidencePack"/>
        <skos:definition>Evidence of remediation of a compliance issue or a plan outlining how the issue will be addressed.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#RepaymentAssistancePlan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#RepaymentAssistancePlan">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Repayment Assistance Plan</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#StateFinancialAid"/>
        <skos:definition>A program that provides financial relief to eligible borrowers struggling to repay their student loans.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#RepaymentObligation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#RepaymentObligation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Repayment Obligation</rdfs:label>
        <skos:definition>The set of repayment duties owed by a borrower under a student loan.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#RepeatCourse -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#RepeatCourse">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Repeat Course</rdfs:label>
        <skos:definition>A course that a student has previously attempted or completed, for which approval may be sought to repeat.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#RequestForCancellationLetter -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#RequestForCancellationLetter">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Request for Cancellation Letter</rdfs:label>
        <skos:definition>A formal letter requesting cancellation, typically submitted by financial aid officers or institution owners/operators.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00694"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Resources -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Resources">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Resources</rdfs:label>
        <skos:definition>Resources do not include child tax benefits, T1 General Income Tax and Benefit Return refunds, family bonuses or GST rebates.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00817"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Responsibilities -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Responsibilities">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Responsibilities</rdfs:label>
        <skos:definition>A set of duties or obligations that a designated institution must adhere to.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ResponsibleThirdParty -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ResponsibleThirdParty">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Responsible Third Party</rdfs:label>
        <skos:definition>A role held by a person such as a counselor, psychologist, religious advisor, doctor, teacher, or mature relative outside the immediate family or family friend, who provides a letter of support.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ReturnTransportationAllowance -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ReturnTransportationAllowance">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Return Transportation Allowance</rdfs:label>
        <skos:definition>A return transportation allowance covering one return trip to the student&apos;s permanent home</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ReturnTransportationCost -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ReturnTransportationCost">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Return Transportation Cost</rdfs:label>
        <skos:definition>The cost of return transportation indicated by a student on their application form.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ReturnTransportationCostAssessmentPermission -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ReturnTransportationCostAssessmentPermission">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Permission"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Return Transportation Cost Assessment Permission</rdfs:label>
        <skos:definition>A permission for eligible students to have their indicated cost of return transportation assessed subject to limits.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ReturningWithdrawnStudentRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ReturningWithdrawnStudentRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Returning Withdrawn Student Role</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#StudentRole"/>
        <skos:definition>The role of a student who originally applied for a two-semester period, withdrew in the first semester, and wishes to re-enter the same post-secondary institution and program for the start of the second semester.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ReviewByAppealCommittee -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ReviewByAppealCommittee">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Review by Appeal Committee</rdfs:label>
        <skos:definition>The process by which the Appeal Committee re-evaluates a student&apos;s appeal decision.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#RiskSharingLoan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#RiskSharingLoan">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Risk-Sharing Loan</rdfs:label>
        <skos:definition>Risk-Sharing Loans are loans issued by a financial institution between August 1, 1995 and July 31, 2000 where the Province of British Columbia pays a risk premium to the lending institution based on the value of all loans entering repayment status.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00859"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#SameLoanYearCondition -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#SameLoanYearCondition">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Same Loan Year Condition</rdfs:label>
        <skos:definition>A condition specifying that the action occurs within the same loan year.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ScholarshipBursaryResource -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ScholarshipBursaryResource">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Scholarship and Bursary Resource</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#BursaryResource"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#FundingResource"/>
        <skos:definition>Merit-based scholarships and/or needs-based bursaries that students are expected to contribute from as additional resources.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ScholasticStandingRequirement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ScholasticStandingRequirement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#AcademicEligibilityRequirementPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Scholastic Standing Requirement</rdfs:label>
        <skos:definition>A student has met the scholastic standing requirement if the post-secondary institution indicates the student has maintained a satisfactory scholastic standard based on the standards and expectations of that institution and/or if a course credit was granted. This is not dependent on the student meeting the post-secondary institution’s grade point average.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00488"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#SeverePermanentDisabilityBenefit -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#SeverePermanentDisabilityBenefit">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Severe Permanent Disability Benefit</rdfs:label>
        <skos:definition>A benefit for borrowers with a severe permanent disability that prevents substantially gainful labour force participation.</skos:definition>
        <skos:definition>A benefit for borrowers with a severe permanent disability, exempt from certain restrictions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#SeverePermanentDisabilityBenefitAdjudication -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#SeverePermanentDisabilityBenefitAdjudication">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Severe Permanent Disability Benefit Adjudication</rdfs:label>
        <skos:definition>The adjudication process for the Severe Permanent Disability Benefit.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#SeverePermanentDisabilityBorrowerRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#SeverePermanentDisabilityBorrowerRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Severe Permanent Disability Borrower</rdfs:label>
        <skos:definition>A borrower role for individuals with a severe permanent disability, as defined under the Severe Permanent Disability Benefit.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#SingleParentStudentStatus -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#SingleParentStudentStatus">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Single-Parent Student Status</rdfs:label>
        <skos:definition>A status designating a student as a single parent for the purposes of eligibility under Canadian regulations.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#SocialInsuranceNumberCard -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#SocialInsuranceNumberCard">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Social Insurance Number Card</rdfs:label>
        <skos:definition>A card or letter issued by the Government of Canada that displays a person&apos;s Social Insurance Number.</skos:definition>
    </owl:Class>
    


