        <cco:hasActionExpression>Parent(s) living outside Canada are expected to complete Appendix 1 by indicating their income as reported on their previous year’s Canadian T1 General Income Tax and Benefit Return, and all out-of-country income from all sources as well as all Canadian and foreign assets.</cco:hasActionExpression>
        <rdfs:label>Complete Appendix 1 Income Reporting</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00432"/>
