        <skos:definition>Training and assessment services for apprenticeship standards.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipTrainingFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipTrainingFunding">
