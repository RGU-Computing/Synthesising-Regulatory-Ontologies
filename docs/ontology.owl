        <rdfs:label>Course Information Resource</rdfs:label>
        <skos:definition>A resource comprising tuition fees, census days, and procedures for withdrawal and cancellation of enrolment for a course.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#CoursePart -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#CoursePart">
