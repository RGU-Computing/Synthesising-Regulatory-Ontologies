        <rdfs:label>End-Point Assessment Organisation</rdfs:label>
        <skos:definition>An organisation that conducts end-point assessments for apprenticeships.</skos:definition>
        <skos:definition>End-Point Assessment Organisation responsible for assessment in apprenticeships.</skos:definition>
        <skos:definition>End-Point Assessment Organisation responsible for conducting end-point assessment and certification of apprentices</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EPARulesAndGuidance -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EPARulesAndGuidance">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>EPA Rules and Guidance</rdfs:label>
