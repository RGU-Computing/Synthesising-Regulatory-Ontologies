        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Funding Band Difference</rdfs:label>
        <skos:definition>The monetary difference between the funding band maximum for the original standard and the total cost.</skos:definition>
    </owl:Class>
    


