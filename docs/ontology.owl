    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#AGIThreshold -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#AGIThreshold">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>AGI Threshold</rdfs:label>
        <skos:definition>A condition concerning adjusted gross income relative to poverty guidelines</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#Application -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#Application">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FundingApplicationPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Application</rdfs:label>
        <skos:definition>An application form or submission containing information subject to verification.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#AvailableIncome -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#AvailableIncome">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Available Income</rdfs:label>
        <skos:definition>Student&apos;s (and Spouse&apos;s) available income, calculated by subtracting certain allowances from total income.</skos:definition>
        <skos:definition>The student&apos;s (and spouse&apos;s) available income, calculated as the sum of taxable and untaxed income minus amounts reported in the income but excluded from the formula (offsets and allowances).</skos:definition>
        <skos:definition>The student&apos;s (and spouse&apos;s) available income, calculated by subtracting certain allowances from total income. It represents income available for discretionary purposes, including postsecondary education costs.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00193"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00201"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00202"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#ChafeeVoucherEligibilityVerification -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#ChafeeVoucherEligibilityVerification">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Chafee Voucher Eligibility Verification</rdfs:label>
        <skos:definition>Verification of the student&apos;s eligibility for an education and training voucher under the John H. Chafee Foster Care Program under section 477 of the Social Security Act (42 U.S.C. 677) is a documented phone call or written statement from a financial aid administrator who documented the student&apos;s circumstance in the same or a prior award year.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00060"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#ConflictingInformation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#ConflictingInformation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Conflicting Information</rdfs:label>
        <skos:definition>Information from any source that contradicts or is inconsistent with other data affecting a student&apos;s eligibility for federal student aid.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#ConsentAndApproval -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#ConsentAndApproval">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Consent and Approval</rdfs:label>
        <skos:definition>The consent and approval required to obtain tax information from the IRS for the FAFSA application.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#ContributionFromAssets -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#ContributionFromAssets">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialNeedAssessmentInputPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Contribution from Assets</rdfs:label>
        <skos:definition>The calculated financial contribution derived from a student&apos;s (and spouse&apos;s) assets, as determined by the full formula using net worth, discretionary net worth, and asset protection allowance tables.</skos:definition>
        <skos:definition>The student&apos;s contribution from assets, calculated by multiplying the student&apos;s net worth by the conversion rate of 20%, and if the contribution from assets is negative, it is set to zero.</skos:definition>
        <skos:definition>The student&apos;s contribution from assets, determined by calculating net worth, subtracting the asset protection allowance, and multiplying by 20%.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00190"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00198"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00206"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#Contributor -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#Contributor">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Contributor</rdfs:label>
        <skos:definition>Contributor refers to anyone who is required to provide information, consent, and approval, and a signature on the FAFSA form.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00043"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#CostOfAttendanceComponent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#CostOfAttendanceComponent">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Cost of Attendance Component</rdfs:label>
        <skos:definition>Components of a student&apos;s cost of attendance or data determining a student&apos;s student aid index.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#DefinedTerm -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#DefinedTerm">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Employer Education Benefits</rdfs:label>
        <skos:definition>Employer education benefits count as other financial assistance (or reduce the cost of attendance) even if they aren&apos;t received until the end of the class(es) and are contingent on earning a minimum grade.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00092"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#Department -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#Department">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#GovernmentOrganizationPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Department</rdfs:label>
        <skos:definition>The Department referenced as the authority in the provision.</skos:definition>
        <skos:definition>The U.S. Department of Education</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#DependencyOverride -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#DependencyOverride">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Dependency Override</rdfs:label>
        <skos:definition>A determination by a financial aid administrator that a student is independent despite not meeting the standard criteria, based on unusual circumstances.</skos:definition>
        <skos:definition>A determination to override a student&apos;s dependency status from dependent to independent</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#DependentStudent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#DependentStudent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Dependent Student</rdfs:label>
        <skos:definition>A student who is classified as a dependent for financial aid purposes under U.S. regulations.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00293"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#DependentStudentWithoutParentalSupport -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#DependentStudentWithoutParentalSupport">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Dependent Student Without Parental Support</rdfs:label>
        <skos:definition>A role held by dependent students whose parents refuse to support them financially or refuse to complete the FAFSA.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#DirectLoanFunds -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#DirectLoanFunds">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Direct Loan Funds</rdfs:label>
        <skos:definition>Funds provided under the Direct Loan program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#DirectUnsubsidizedAndPLUSLoans -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#DirectUnsubsidizedAndPLUSLoans">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Direct Unsubsidized and PLUS Loans</rdfs:label>
        <skos:definition>Federal student loans including Direct Unsubsidized Loans and Parent PLUS Loans.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#DirectUnsubsidizedLoan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#DirectUnsubsidizedLoan">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Direct Unsubsidized Loan</rdfs:label>
        <skos:definition>A dependent level Direct Unsubsidized Loan available to students whose parents refuse to support them.</skos:definition>
        <skos:definition>A federal student loan for which the borrower is responsible for all interest.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#Document -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#Document">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Document</rdfs:label>
        <skos:definition>A written, printed, or electronic record that provides information or evidence.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#Documentation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#Documentation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Documentation</rdfs:label>
        <skos:definition>Documentation that may include various items such as interviews, court orders, or official documentation.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#DocumentationItem -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#DocumentationItem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Documentation Item</rdfs:label>
        <skos:definition>An item that may be included in documentation, such as an interview record, court order, or official documentation.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#EmploymentExpenseAllowance -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#EmploymentExpenseAllowance">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Employment Expense Allowance</rdfs:label>
        <skos:definition>A financial allowance for employment expenses, calculated as 35% of the student&apos;s (and spouse&apos;s) income earned from work or a maximum allowance, whichever is less, and never less than zero.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00205"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#FAA -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#FAA">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>FAA Role</rdfs:label>
