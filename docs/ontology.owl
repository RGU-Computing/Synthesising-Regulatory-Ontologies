        <rdfs:label>Delivery Responsibility</rdfs:label>
        <skos:definition>The action of carrying full responsibility for all aspects of course delivery, including adherence to regulations, quality, staffing, resources, and student welfare.</skos:definition>
    </owl:Class>
    


