    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FullTimePostSecondaryEnrollment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FullTimePostSecondaryEnrollment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Full-Time Post-Secondary Enrollment</rdfs:label>
        <skos:definition>The condition of being enrolled in full-time post-secondary studies.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FullTimeStudent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FullTimeStudent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Full-time Student</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#Student"/>
        <skos:definition>A student enrolled in full-time post-secondary studies.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FullTimeStudentStatus -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FullTimeStudentStatus">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Full-Time Student Status</rdfs:label>
        <skos:definition>A condition representing the status of being a full-time student.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FundedTermPeriodOfStudy -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FundedTermPeriodOfStudy">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Funded Term/Period of Study</rdfs:label>
        <skos:definition>A period of study during which a student receives student financial assistance and/or payment-free status. Students who are on payment-free status are considered to be in a ‘funded term’ whether or not they have new student loans; withdrawals and unsuccessful terms are counted during this time.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00834"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Funding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Funding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Funding</rdfs:label>
        <skos:definition>Financial resources allocated to support a student&apos;s educational expenses.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FundingAllocationResource -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FundingAllocationResource">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Funding Allocation Resource</rdfs:label>
        <skos:definition>A resource representing a specific funding allocation amount and its associated conditions.</skos:definition>
        <skos:definition>A resource representing a specific funding allocation available under the Accessibility Supports Framework.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FundingAndLoanRehabilitationApplication -->


