        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Aviation Program Funding</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#FundingResource"/>
        <skos:definition>Funding allocated to students enrolled in and attending aviation programs, including commercial pilot, endorsements, and instructor rating programs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#BCAGExcessLoan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#BCAGExcessLoan">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#LoanAdjustmentResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>BCAG Excess Loan</rdfs:label>
        <skos:definition>A provincial loan converted from excess BCAG grant received by a student upon reassessment based on new information.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#BCAGFTAward -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#BCAGFTAward">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>BCAG-FT Award</rdfs:label>
        <skos:definition>The total BCAG-FT award amount, calculated by multiplying the weekly grant amount by the number of weeks in the study period.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00232"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#BCAGFTWeeklyGrantAmount -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#BCAGFTWeeklyGrantAmount">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>BCAG-FT Weekly Grant Amount</rdfs:label>
        <skos:definition>The weekly grant amount a student is eligible for under the BCAG-FT program, calculated based on student characteristics and income.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00232"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#BCAG_FT_Award -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#BCAG_FT_Award">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>BCAG-FT Award</rdfs:label>
        <skos:definition>The BCAG-FT grant award, a financial resource provided to eligible students under the Canada Student Financial Assistance Program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#BCAccessGrant -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#BCAccessGrant">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>B.C. Access Grant</rdfs:label>
        <skos:definition>A grant provided under the British Columbia Access Grant Program.</skos:definition>
        <skos:definition>A non-repayable financial assistance grant provided to low and middle-income learners enrolled in eligible programs at B.C. public post-secondary institutions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#BCPrivatePostSecondaryInstitution -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#BCPrivatePostSecondaryInstitution">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>B.C. Private Post-Secondary Institution</rdfs:label>
        <skos:definition>A private post-secondary institution operating in British Columbia, Canada.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#BCStudentLoan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#BCStudentLoan">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>B.C. Student Loan</rdfs:label>
        <skos:definition>A loan provided under the British Columbia Student Loan Program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#BCStudentLoanFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#BCStudentLoanFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>B.C. Student Loan Funding</rdfs:label>
        <skos:definition>Funding provided under the British Columbia Student Loan program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#BCSupplementalBursaryForStudentsWithDisabilities -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#BCSupplementalBursaryForStudentsWithDisabilities">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>BC Supplemental Bursary for Students with Disabilities</rdfs:label>
        <skos:definition>A funding resource provided by British Columbia as a supplemental bursary for students with disabilities.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#BankruptBorrowerRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#BankruptBorrowerRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Bankrupt Borrower Role</rdfs:label>
        <skos:definition>A role held by a borrower who has entered into bankruptcy or a bankruptcy-related event.</skos:definition>
        <skos:definition>The role of a person who has been declared bankrupt and is subject to the Bankruptcy and Insolvency Act</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#BankruptcyAndInsolvencyAct -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#BankruptcyAndInsolvencyAct">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Regulation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#specifiesNorm"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://www.w3id.org/cco/cco#Norm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasValidityStart"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasValidityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Bankruptcy and Insolvency Act</rdfs:label>
        <skos:definition>The Canadian federal statute governing bankruptcy and insolvency proceedings</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#BankruptcyAppealProcess -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#BankruptcyAppealProcess">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Bankruptcy Appeal Process</rdfs:label>
        <skos:definition>The process by which a borrower appeals a bankruptcy-related restriction on student financial assistance.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#BooksAndSuppliesFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#BooksAndSuppliesFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Books and Supplies Funding</rdfs:label>
        <skos:definition>Maximum funding allocated for books and supplies based on the number of weeks in the study period.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Borrower -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Borrower">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Borrower</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DependentStudent"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#Student"/>
        <skos:definition>A person who has borrowed money and is responsible for repaying it.</skos:definition>
        <skos:definition>A person who has received a Canada-B.C. integrated student loan and is subject to repayment obligations.</skos:definition>
        <skos:definition>A person who has received a student loan and is responsible for its repayment.</skos:definition>
        <skos:definition>A person who has received a student loan and is responsible for repayment.</skos:definition>
        <skos:definition>A role held by an individual who has received a loan and is subject to repayment assistance plan rules.</skos:definition>
        <skos:definition>A role of an agent who borrows funds or resources under a regulatory framework.</skos:definition>
        <skos:definition>An individual who is or was a student and who is receiving, or who has received, British Columbia Student Financial Assistance, Canada Student Financial Assistance, or Student Financial Assistance as outlined in the Master Student Financial Assistance Agreement, to attend studies at a Designated Post-Secondary Institution.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00819"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#BorrowerRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#BorrowerRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Borrower Role</rdfs:label>
        <skos:definition>The role of a borrower under the Canada-B.C. integrated student loan program</skos:definition>
        <skos:definition>The role of an individual who has borrowed funds and is responsible for repayment under the RAP program.</skos:definition>
        <skos:definition>The role of an individual who has borrowed funds under a student loan program.</skos:definition>
        <skos:definition>The role of an individual who has received a loan and is subject to repayment and leave provisions under Canadian regulations.</skos:definition>
        <skos:definition>The role of an individual who has received a student loan and is subject to repayment and eligibility rules.</skos:definition>
        <skos:definition>The role of an individual who has received or is applying for student financial assistance.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#BorrowerSelectedForRAPVerification -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#BorrowerSelectedForRAPVerification">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Break -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Break">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#LearningPausePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Study Break</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#BreakInLearning"/>
        <skos:definition>A break in full-time study, subject to duration limits and exceptions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#BrokeredProgramOfStudy -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#BrokeredProgramOfStudy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EducationalProgramPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Brokered Program of Study</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#Programme"/>
        <skos:definition>A program of study where the institution provides a formal credential while another agency or institution provides the actual program of study.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Bursary -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Bursary">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Bursary</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#BursaryResource"/>
        <skos:definition>A financial award granted to students based on eligibility criteria, typically without requiring repayment.</skos:definition>
        <skos:definition>Non-repayable awards based on financial need and given to students by post-secondary institutions, governments, businesses, societies or other agencies and organizations.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00820"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CRAIncomeVerification -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CRAIncomeVerification">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>CRA Income Verification</rdfs:label>
        <skos:definition>The Canada Revenue Agency Income Verification terms and conditions that must be consented to by the student applicant and parent or spouse.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00173"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CSG_FTDEP -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CSG_FTDEP">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>CSG-FTDEP Grant</rdfs:label>
        <skos:definition>Canada Student Grant for Full-Time Students with Dependants.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Campus -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Campus">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Campus</rdfs:label>
        <skos:definition>A campus has a separate student body, a resident administration, offers a full program leading to a certificate, diploma or degree, and is geographically separate from the main campus such that students may not easily avail themselves of educational and administrative services at the main campus.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00840"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CanadaBCIntegratedStudentLoanAndGrantFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CanadaBCIntegratedStudentLoanAndGrantFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Canada-B.C. Integrated Student Loan and Grant Funding</rdfs:label>
        <skos:definition>The amount of Canada-B.C. integrated student loan and grant funding that students are eligible to receive, based on their assessed financial need.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00354"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CanadaStudentFinancialAssistanceProgram -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CanadaStudentFinancialAssistanceProgram">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Canada Student Financial Assistance Program</rdfs:label>
        <skos:definition>The federal program responsible for administering Canada Student Loans and grants.</skos:definition>
        <skos:definition>The federal program that provides student financial assistance in Canada.</skos:definition>
        <skos:definition>The federal program under the Canada Student Financial Assistance Act and Regulations that provides loans and grants to eligible students.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CanadaStudentFinancialAssistanceProgramFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CanadaStudentFinancialAssistanceProgramFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>CSFA Program Funding</rdfs:label>
        <skos:definition>Funding issued under the Canada Student Financial Assistance Program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CanadaStudentGrant -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CanadaStudentGrant">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Canada Student Grant</rdfs:label>
        <skos:definition>A grant applied to the Government of Canada portion of a student&apos;s assessed need.</skos:definition>
        <skos:definition>A grant provided under the Canada Student Grants Program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CanadaStudentGrantForServicesAndEquipment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CanadaStudentGrantForServicesAndEquipment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Canada Student Grant for Services and Equipment</rdfs:label>
        <skos:definition>A grant for students with disabilities requiring exceptional education-related services or equipment, up to $20,000 per program year.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CanadaStudentGrantFullTime -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CanadaStudentGrantFullTime">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Canada Student Grant for Full-Time Students</rdfs:label>
        <skos:definition>A funding resource providing up to $525 per month of study for full-time students under the Canada Student Grant program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CanadaStudentGrantFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CanadaStudentGrantFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Canada Student Grant Funding</rdfs:label>
        <skos:definition>Funding provided under the Canada Student Grant program, allocated towards federal and provincial assessed need.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CanadaStudentGrantPartTimeDependants -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CanadaStudentGrantPartTimeDependants">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Canada Student Grant for Part-Time Students with Dependants</rdfs:label>
        <skos:definition>A financial grant available to part-time students in Canada who have dependants.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CanadaStudentGrantPartTimeStudies -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CanadaStudentGrantPartTimeStudies">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Canada Student Grant for Part-Time Studies</rdfs:label>
        <skos:definition>A financial grant available to part-time students in Canada to support their studies.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CanadaStudentLoan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CanadaStudentLoan">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Canada Student Loan</rdfs:label>
        <skos:definition>A loan provided under the Canada Student Loans Program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CanadaStudentLoanFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CanadaStudentLoanFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Canada Student Loan Funding</rdfs:label>
        <skos:definition>Funding provided under the Canada Student Loan program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CanadaStudentLoansProgramPartTime -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CanadaStudentLoansProgramPartTime">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Canada Student Loans Program for Part-Time Students</rdfs:label>
        <skos:definition>The Canada Student Loans Program for Part-Time Students, a financial aid program for part-time post-secondary students in Canada.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ChildCareCostReimbursement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ChildCareCostReimbursement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Child Care Cost Reimbursement</rdfs:label>
        <skos:definition>Reimbursement of actual child care costs incurred, up to a maximum of $268 per child per week, less any subsidy received.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CombinedStudentFundingMaximum -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CombinedStudentFundingMaximum">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Combined Student Funding Maximum</rdfs:label>
        <skos:definition>The total combined maximum amount for Canada Student Loan, B.C. Student Loan and Canada Student Grant funding.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CompulsoryFees -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CompulsoryFees">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Compulsory Fees</rdfs:label>
        <skos:definition>Compulsory fees include annual admission fees required when submitting applications, student council fees, student services fees, field trip costs (excluding transportation cost as outlined in Chapter 2, Section 3), examination fees, graduate thesis costs and other amounts payable by the student to the educational institution that are obligatory in connection with their course of study. They may include fees payable for membership in professional or other societies where required.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00822"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CoopEducationPlacement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CoopEducationPlacement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Co-op Education Placement</rdfs:label>
        <skos:definition>A work-integrated learning placement that is part of a co-op education program</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CostAssessmentAction -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CostAssessmentAction">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Cost Assessment Action</rdfs:label>
        <skos:definition>The action of assessing a student&apos;s indicated cost of return transportation subject to specified limits.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CourseApproval -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CourseApproval">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RegulatoryDecisionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Course Approval</rdfs:label>
        <skos:definition>An official authorization or permission granted for a specific course-related action.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CourseCreditTransferability -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CourseCreditTransferability">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Course Credit Transferability</rdfs:label>
        <skos:definition>Transferability of all course credits from an international institution to the home post-secondary institution.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00097"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#CourseLoad -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#CourseLoad">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentEnrollmentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Course Load</rdfs:label>
        <skos:definition>The set of courses or credits a student is enrolled in during a study period.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Court -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Court">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Court</rdfs:label>
        <skos:definition>A judicial body with authority to grant bankruptcy discharge under the Bankruptcy and Insolvency Act</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Default -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Default">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Default</rdfs:label>
        <skos:definition>In relation to a student loan, of which the Borrower is more than 270 days in arrears on payments based on the Borrower&apos;s loan agreement and in respect of which collection action is taken.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00826"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DefaultedBorrowerRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DefaultedBorrowerRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Defaulted Borrower Role</rdfs:label>
        <skos:definition>Role of a borrower who had defaulted (not declared bankruptcy) and whose loans have been sent for collections and subsequently extinguished, written off, designated uncollectable by the Limitation Act, or settled.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DefinedTerm -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DefinedTerm">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Defined Term</rdfs:label>
        <rdfs:label>Dependant</rdfs:label>
        <rdfs:label>Term Definition</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#LegalDependent"/>
        <skos:definition>For a vocational or trade program, ‘term’ means 12 to 26 weeks.</skos:definition>
        <skos:definition>The student’s or spouse/common-law partner’s children are permanently disabled, are 19 years of age or over, are fully supported by the student or spouse/common-law partner and are claimed on the student’s or spouse/common-law partner’s income tax return; or the children are the student’s foster children and foster-parent income is claimed on the application.</skos:definition>
        <skos:definition>a dependant is defined as a wholly dependent person who resides with the borrower (or is in a healthcare facility) and is either under 18 years of age; or 18 and over and dependent by reason of a mental or physical infirmity and has been claimed and approved by the Canada Revenue Agency as wholly dependent for tax purposes.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00413"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00828"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00865"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DependantAllowance -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DependantAllowance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Dependant Allowance</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#TitleIVAid"/>
        <skos:definition>A financial allowance provided to students with dependants, as specified in Table 3 of Chapter 14.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DependentStudent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DependentStudent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Dependent Student</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DependentStudent"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#FAFSAStudentRole"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#GraduateProfessionalStudentRole"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#LegalDependent"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#Student"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#StudentRole"/>
        <skos:definition>A student who would normally be considered a dependent student for financial aid purposes.</skos:definition>
        <skos:narrowMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DependentStudentWithoutParentalSupport"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DependentStudentRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DependentStudentRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Dependent Student Role</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DependentStudentWithoutParentalSupport"/>
        <skos:definition>A role held by dependent students who must leave their home community to attend post-secondary studies</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Dependents -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Dependents">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Dependents</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DependentStudentWithoutParentalSupport"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#LegalDependent"/>
        <skos:definition>The dependents are the student’s or spouse/common-law partner’s elderly relatives who are fully supported by the student and claimed on the student’s or spouse’s income tax.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00829"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DesignatedInstitution -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DesignatedInstitution">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Designated Institution</rdfs:label>
        <skos:definition>An institution that has been formally designated under the applicable regulatory framework.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DesignatedPostSecondaryInstitution -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DesignatedPostSecondaryInstitution">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Designated Post-Secondary Institution</rdfs:label>
        <skos:definition>A post-secondary educational institution designated under Canadian regulations.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Designation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Designation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Designation</rdfs:label>
        <skos:definition>A designation granted by StudentAid BC to institutions, effective for a single program year.</skos:definition>
        <skos:definition>The act of being officially designated or recognized by an authority.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DesignationAgreement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DesignationAgreement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Designation Agreement</rdfs:label>
        <skos:definition>A formal agreement designating an institution for student financial assistance purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DesignationEligibilityCriteria -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DesignationEligibilityCriteria">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Designation Eligibility Criteria</rdfs:label>
        <skos:definition>Criteria set by StudentAid BC that institutions must meet to be designated.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DesignationStatus -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DesignationStatus">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Designation Status</rdfs:label>
        <skos:definition>The designation status of an institution under StudentAid BC.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DisabilityAssessmentReimbursement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DisabilityAssessmentReimbursement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Disability Assessment Reimbursement</rdfs:label>
        <skos:definition>A reimbursement issued for disability assessment costs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DisabilityAssistanceFunds -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DisabilityAssistanceFunds">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Disability Assistance Funds</rdfs:label>
        <skos:definition>Funds provided for living costs under the Employment and Assistance for Persons with Disabilities Act.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DisabilityProofResource -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DisabilityProofResource">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Disability Proof Resource</rdfs:label>
        <skos:definition>Proof of a persistent or prolonged disability, such as the RAP-D Verification of Disability Questionnaire and related documentation</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DisabilityReverification -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DisabilityReverification">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Disability Re-verification</rdfs:label>
        <skos:definition>The action of re-verifying a borrower&apos;s disability status to maintain eligibility for RAP-D.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DisabilityStudentFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DisabilityStudentFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Disability Student Funding</rdfs:label>
        <skos:definition>Funding designed to help people with disabilities and their dependents with basic educational costs, subject to limitations established under inter-ministry policy.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DisabilityVerification -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DisabilityVerification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Disability Verification</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#EvidenceOfEligibility"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#VerificationDocument"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#VerificationDocumentation"/>
        <skos:definition>Documentation submitted by a student to verify a permanent, persistent, or prolonged disability for bursary eligibility.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DiscretionaryIncome -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DiscretionaryIncome">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Discretionary Income</rdfs:label>
        <skos:definition>Discretionary Income is total income for the full taxation year before the student’s study period, less the costs for taxes, CPP/QPP and EI from Appendix 1 and less the estimated costs for a Moderate Standard of Living from Table 5.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00831"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Document -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Document">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Document</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#Document"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#EvidencePack"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#Document"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DocumentationItem"/>
        <skos:definition>A document or set of documents submitted as part of a regulatory process.</skos:definition>
        <skos:definition>A resource that represents a document, such as a T4A form.</skos:definition>
        <skos:definition>A written or printed record that provides information or evidence.</skos:definition>
        <skos:definition>A written, printed, or electronic record that provides information or evidence.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DocumentationFromQualifiedMedicalAssessor -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DocumentationFromQualifiedMedicalAssessor">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Medical Assessor Documentation</rdfs:label>
        <skos:definition>Documentation provided by a qualified medical assessor, signed and dated within the last three years, or a psycho-educational assessment dated within the last five years or conducted after age 18.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#DriverTrainingInstitution -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#DriverTrainingInstitution">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Driver Training Institution</rdfs:label>
        <skos:definition>An institution that offers driver training programs.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00022"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#EarlyCompletionOfStudiesNotificationForm -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#EarlyCompletionOfStudiesNotificationForm">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Early Completion of Studies Notification Form</rdfs:label>
        <skos:definition>A form used by school officials to notify StudentAid BC of a student&apos;s early completion of studies.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#EducationalExpenseConsideration -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#EducationalExpenseConsideration">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Educational Expense Consideration</rdfs:label>
        <skos:definition>The set of educational expenses that StudentAid BC considers when assessing a student&apos;s financial need, including tuition (actual cost of tuition and compulsory fees) and books/supplies (allowable cost as per the Institutional Appendix).</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#EducationalInstitution -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#EducationalInstitution">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Educational Institution</rdfs:label>
        <skos:definition>An institution providing educational programs to students.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#EligibilitySigningOfficer -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#EligibilitySigningOfficer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EligibilityVerificationRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Eligibility Signing Officer</rdfs:label>
        <skos:definition>A role designated to institution officials responsible for confirming student enrolment and attendance, completing the Confirmation of Enrolment, accepting and documenting tuition payments, reporting changes to a student’s scholastic standing, and reporting changes to course load.</skos:definition>
        <skos:definition>A role responsible for signing loan documents.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#EligibleOccupation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#EligibleOccupation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Eligible Occupation</rdfs:label>
        <skos:definition>An occupation that qualifies under the eligibility criteria, involving work with children or in an eligible underserved community.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00241"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#EligiblePartTimeStudentRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#EligiblePartTimeStudentRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Eligible Part-Time Student Role</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DependentStudent"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#FAFSAStudentRole"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#GraduateProfessionalStudentRole"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#Student"/>
        <skos:definition>The role of an eligible part-time student who is attending part-time studies in eligible full-time programs and may receive student financial assistance.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#EligibleStudentRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#EligibleStudentRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Eligible Student Role</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#StudentRole"/>
        <skos:definition>A role held by a student who is married, common-law, independent single, or single-parent, living away from home for full-time study, and meeting the specified living arrangement criteria.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#EligibleUnderservedCommunity -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#EligibleUnderservedCommunity">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Eligible Underserved Community</rdfs:label>
        <skos:definition>A community designated as underserved for the purposes of eligibility criteria.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00241"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#EnglishAdditionalLanguageProgram -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#EnglishAdditionalLanguageProgram">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>English Additional Language Program</rdfs:label>
        <skos:definition>An English as an additional language program, unless taken concurrently with post-secondary studies and representing no more than 20% of program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#EnrolmentConfirmation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#EnrolmentConfirmation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EnrolmentActionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Enrolment Confirmation</rdfs:label>
        <skos:definition>The act of a post-secondary institution verifying a student&apos;s enrolment in an eligible program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#EnrolmentSigningOfficer -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#EnrolmentSigningOfficer">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Enrolment Signing Officer</rdfs:label>
        <skos:definition>A role responsible for confirming enrolment or attendance.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ExamPeriod -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ExamPeriod">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Exam Period</rdfs:label>
        <skos:definition>A period designated for examinations, included in the period of study for assessment purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ExceptionalCircumstance -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ExceptionalCircumstance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#CircumstanceConditionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Exceptional Circumstance</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#SpecialCircumstances"/>
        <skos:definition>A condition representing exceptional circumstances that may be considered for eligibility.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ExceptionalExpense -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ExceptionalExpense">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Exceptional Expense</rdfs:label>
        <skos:definition>Exceptional expenses are those that are not normally associated with attending school but are required for certain programs.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00111"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ExecutiveProgram -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ExecutiveProgram">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EducationalProgramPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Executive Program</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#Programme"/>
        <skos:definition>Programs of study such as executive programs that are designed specifically to meet the needs of full-time members of the labour force</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ExpectedContribution -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ExpectedContribution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialNeedAssessmentInputPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Expected Contribution</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#ContributionFromAssets"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#ParentsContribution"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#ParentsContributionFromAssets"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#StudentContributionFromIncome"/>
        <skos:definition>A financial contribution from a student, parent, step-parent, sponsor, legal guardian or spouse to assist with the cost of the student’s program of study. The contribution is automatically assessed during the student need assessment process.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00832"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ExpectedContributionFromNeedBasedBursaries -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ExpectedContributionFromNeedBasedBursaries">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Expected Contribution from Need-Based Bursaries</rdfs:label>
        <skos:definition>The expected contribution from need-based bursaries, where the eligibility criteria are based on need, but the funding is not targeted for a specific element of the costs of living or education. The expected contribution is equivalent to the assessed actual amount, less an exemption of $1,800 per program year for both merit-based scholarships and need-based bursaries combined. Any amount of scholarship/bursary funding above $1,800 is considered income and is assessed at 100%.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FamilyIncome -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FamilyIncome">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialNeedAssessmentInputPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Family Income</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#FamilySize"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#IncomeAllowanceCalculation"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#ParentsAvailableIncome"/>
        <skos:definition>family income is defined as the student’s parent(s)/guardian(s)/sponsor(s) income (as reported on line 15000 [total income] of each parent(s)/guardian(s)/sponsor(s) previous year’s T1 General Income Tax and Benefit Return), or international equivalent.</skos:definition>
        <skos:definition>family income is defined as the sum of student’s income and spouse’s/common-law partner’s income (as reported on both the student’s and spouse’s/common-law partner’s line 15000 [total income] of their respective previous year’s T1 General Income Tax and Benefit Return), or international equivalent.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00410"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00411"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FamilySize -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FamilySize">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Family Size</rdfs:label>
        <skos:definition>Family size includes all children 18 years of age and under, all children aged 19 and over who are full-time dependent students, children with disabilities aged 19 and over, elderly relatives who are fully supported by the parent(s) and declared on the T1 General Income Tax and Benefit Return, and foster children where foster parent income is claimed on Appendix 1.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00434"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FederalFixedStudentContribution -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FederalFixedStudentContribution">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Federal Fixed Student Contribution</rdfs:label>
        <skos:definition>The federal fixed student contribution, a calculated amount based on study weeks and capped at 34 2/3 weeks per loan year.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00408"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FieldPlacement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FieldPlacement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Field Placement</rdfs:label>
        <skos:definition>A field placement provides students with an intensive part-time/short term intensive hands-on practical experience in a setting relevant to their subject of study. Field placements may not require supervision of a registered or licensed professional and the completed work experience hours are not required for professional certification. Field placements account for work-integrated educational experiences not encompassed by other forms, such as co-op, clinic, practicum, and internship.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00833"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FieldTripPracticumClinicalPlacementFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FieldTripPracticumClinicalPlacementFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Field Trip and Placement Funding</rdfs:label>
        <skos:definition>Funding allocated for actual costs of field trips, practicums, and clinical placements that are essential elements of an educational program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FinancialAidOfficerRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FinancialAidOfficerRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidAdministratorRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Financial Aid Officer Role</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#FinancialAidAdministrator"/>
        <skos:definition>The role of a financial aid officer at a participating B.C. public post-secondary institution, responsible for determining student eligibility for adult upgrading grants.</skos:definition>
        <skos:definition>The role of a financial aid officer in the context of Canadian post-secondary education regulations.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00694"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FinancialAssistance -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FinancialAssistance">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Financial Assistance</rdfs:label>
        <skos:definition>Financial assistance determined through the StudentAid BC application process, considering allowable costs and resources.</skos:definition>
        <skos:definition>Monetary support provided to students, such as loans or grants.</skos:definition>
        <skos:definition>Non-repayable financial assistance and repayable student loans available to students in British Columbia, Canada.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00168"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FinancialAssistanceDocument -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FinancialAssistanceDocument">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Financial Assistance Document</rdfs:label>
        <skos:definition>Documents required for student financial assistance.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FinancialAssistanceInformation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FinancialAssistanceInformation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Financial Assistance Information</rdfs:label>
        <skos:definition>Information used in providing financial assistance and counselling to students.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FinancialAssistanceProgram -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FinancialAssistanceProgram">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Financial Assistance Program</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#StateFinancialAid"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#TitleIVAid"/>
        <skos:definition>Financial assistance programs intended to provide students with accessibility challenges with additional financial resources to address related costs associated with post-secondary education including education and living-related expenses.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FinancialNeedAssessment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FinancialNeedAssessment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Financial Need Assessment</rdfs:label>
        <skos:definition>Financial need for part-time studies is determined based on an assessment of allowable educational costs, including tuition, books/supplies, miscellaneous allowance, transportation allowance, and child care costs.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00670"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FinancialResource -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FinancialResource">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Financial Resource</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#FinancialResource"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#FundingResource"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#FinancialResource"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#StateFinancialAid"/>
        <skos:definition>A resource representing financial assistance or monetary support.</skos:definition>
        <skos:definition>A resource representing financial assistance, such as grants, bursaries, or scholarships.</skos:definition>
        <skos:definition>A resource representing monetary amounts or financial instruments.</skos:definition>
        <skos:definition>A resource representing monetary amounts, costs, or financial data.</skos:definition>
        <skos:definition>A resource representing monetary funds or financial support.</skos:definition>
        <skos:definition>A resource representing monetary funds, including loans, grants, and payment-free status.</skos:definition>
        <skos:definition>A resource representing monetary value or financial instruments.</skos:definition>
        <skos:definition>A resource representing student financial assistance or other monetary allocations.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FlightRules -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FlightRules">
