        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#FundingResource"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DirectLoanFunds"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#FinancialResource"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#PellGrantMoney"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#StateFinancialAid"/>
        <skos:definition>A program that provides financial assistance, bursaries, grants, or waivers to eligible recipients.</skos:definition>
        <skos:definition>A program that provides financial support to eligible recipients, such as grants, bursaries, or loan repayment assistance.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FundingType -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FundingType">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Funding Type</rdfs:label>
        <skos:definition>A category of financial assistance for which a student may be eligible.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#GovernmentBody -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#GovernmentBody">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#GovernmentOrganizationPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Government Body</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#GovernmentBody"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#GovernmentDepartment"/>
        <skos:definition>A body or department of government exercising regulatory or administrative authority.</skos:definition>
        <skos:definition>A body that is part of or designated by a government, exercising governmental authority.</skos:definition>
        <skos:definition>A government body or agency within the Canadian jurisdiction.</skos:definition>
        <skos:definition>A government body or ministry as defined in Canadian regulatory context.</skos:definition>
        <skos:definition>An organisation that is part of the government structure, such as a ministry or department.</skos:definition>
        <skos:definition>An organisation that is part of the government structure.</skos:definition>
        <skos:definition>An organization established by a government to carry out specific functions or services.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#GovernmentIssuedIdentification -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#GovernmentIssuedIdentification">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Government-Issued Identification</rdfs:label>
        <skos:definition>An official document issued by a government authority that confirms a person&apos;s identity, including name and date of birth.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#GovernmentOfCanadaPortion -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#GovernmentOfCanadaPortion">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Government of Canada Portion</rdfs:label>
        <skos:definition>The portion of a student&apos;s assessed need funded by the Government of Canada.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#GrantFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#GrantFunding">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Grant Funding</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DirectLoanFunds"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#PellGrantMoney"/>
        <skos:definition>Financial assistance provided to a student that does not require repayment.</skos:definition>
        <skos:definition>Financial resource representing grant funding awarded under the BCAG-DS program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#GrantOveraward -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#GrantOveraward">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Grant Overaward</rdfs:label>
        <skos:definition>A grant overaward resulting from a change in assessed financial need, which may be converted to a loan under specified conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Guardian -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Guardian">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Guardian</rdfs:label>
        <skos:definition>A person who is charged with the legal right and duty of care for a ward due to the ward’s inability (due to age, or mental or physical inability) to care for himself or herself.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00835"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ICBCRegulations -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ICBCRegulations">
