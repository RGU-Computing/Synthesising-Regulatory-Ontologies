        <cco:hasConditionExpression>Net worth is calculated by adding cash, savings, checking, time deposits, money market funds, net worth of investments, and adjusted net worth of business/farm.</cco:hasConditionExpression>
        <rdfs:label>Net Worth Calculation Step</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00206"/>
    </owl:Thing>
    


