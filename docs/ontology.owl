    <!-- https://w3id.org/cco-gro/onto/au#GapFee -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#GapFee">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Gap Fee</rdfs:label>
        <skos:definition>A fee representing the gap between tuition fees and other funding</skos:definition>
        <skos:definition>A tuition fee for a course includes the maximum amount covered by a VET Student Loan and the remaining tuition cost not covered by the loan – the ‘gap fee’. As it’s part of the tuition fee, the gap fee can’t include fees for non-tuition services such as items and equipment that become the student’s physical property and are not consumed in the course (for example, maps, charts or textbooks).</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00165"/>
    </owl:Class>
    


