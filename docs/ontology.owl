    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#IndividualisedLearnerRecord -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#IndividualisedLearnerRecord">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#LearnerInformationRecordPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Individualised Learner Record</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#ISIR"/>
        <skos:definition>A data record containing learner-specific information, including the selected assessment organisation.</skos:definition>
        <skos:definition>A record containing individual learner information, including training hours and progress.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Inducement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Inducement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Inducement</rdfs:label>
        <skos:definition>Something that persuades or influences someone to do something. For example, if a provider offered extra training, not required for the apprenticeship, to an employer and included this in the total negotiated price. This is not allowed.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01206"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#IndustryProfessionalBody -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#IndustryProfessionalBody">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Industry Professional Body</rdfs:label>
        <skos:definition>A relevant industry or professional body that can provide further advice on accreditation requirements.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#IneligibleCost -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#IneligibleCost">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#ExcludedCostPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Ineligible Cost</rdfs:label>
        <skos:definition>A cost that is explicitly excluded from being claimed or included under a regulatory scheme.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Information -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Information">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Information</rdfs:label>
        <skos:definition>Facts provided or learned about something or someone.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#InitialAssessment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#InitialAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EligibilityAssessmentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Initial Assessment</rdfs:label>
        <skos:definition>A tool or process used to evaluate an apprentice&apos;s prior learning and support needs.</skos:definition>
        <skos:definition>An evaluation process conducted to determine the eligibility of a learner and a programme for funding.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#InitialAssessmentOutcome -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#InitialAssessmentOutcome">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Initial Assessment Outcome</rdfs:label>
        <skos:definition>The documented results of an initial assessment, including evidence of an individual&apos;s need for new knowledge, skills, and behaviours, and confirmation that the training meets funding rules.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#IntegratedDegreeStandard -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#IntegratedDegreeStandard">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Integrated Degree Standard</rdfs:label>
        <skos:definition>An apprenticeship standard that integrates a degree qualification with on-the-job training and end-point assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#IntegratedStandard -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#IntegratedStandard">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Integrated Standard</rdfs:label>
        <skos:definition>A standard where training and assessment are integrated, forming an exception to the prohibition on training providers assessing their own learners.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#IntegratedStandardsException -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#IntegratedStandardsException">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Exception"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasCondition"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#modifiesNorm"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://www.w3id.org/cco/cco#Norm"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasCondition"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#modifiesNorm"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://www.w3id.org/cco/cco#Norm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Integrated Standards Exception</rdfs:label>
        <skos:definition>Exception for integrated standards where the provider may assess all elements or provide quality assurance.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#IrregularFinancialOrDeliveryIssue -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#IrregularFinancialOrDeliveryIssue">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Irregular Financial or Delivery Issue</rdfs:label>
        <skos:definition>A condition where evidence of irregular financial or delivery issues arises, including non-delivery of training when funds have been paid, sanctions by an awarding organisation, or allegations of fraud.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Judgement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Judgement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RegulatoryDecisionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Judgement</rdfs:label>
        <skos:definition>A formal and structured judgement as referenced in the regulatory provision.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00208"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#KITDay -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#KITDay">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>KIT Day</rdfs:label>
        <skos:definition>A keeping in touch day designated for an apprentice to continue with apprenticeship training, assessment, or end-point assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#KITSPLITDay -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#KITSPLITDay">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>KIT/SPLIT Day</rdfs:label>
        <skos:definition>A Keeping in Touch (KIT) or Shared Parental Leave in Touch (SPLIT) day during a leave period.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#KITSPLITDayTimingAgreement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#KITSPLITDayTimingAgreement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>KIT/SPLIT Day Timing Agreement</rdfs:label>
        <skos:definition>An agreement by the employer and provider in relation to the timing of KIT / SPLIT days relative to the monthly payments that the provider will continue to receive if a break in learning is not utilised.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00952"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LastDateOfLearning -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LastDateOfLearning">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Last Date of Learning</rdfs:label>
        <skos:definition>If an apprentice leaves without completing their apprenticeship, the last date of learning, including the apprenticeship programme learning aim, is the date that providers have evidence the apprentice was still in learning for any learning that was part of their apprenticeship.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00889"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LastILRCollectionDeadline -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LastILRCollectionDeadline">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Last ILR Collection Deadline</rdfs:label>
        <skos:definition>The temporal condition that the deadline for claiming is the last ILR collection for each funding year.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LawfulWage -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LawfulWage">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Lawful Wage</rdfs:label>
        <skos:definition>A wage that complies with applicable legal requirements.</skos:definition>
        <skos:definition>A wage that complies with national minimum wage regulations.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Learner -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Learner">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Person"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Learner</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#GraduateProfessionalStudentRole"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#Student"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#StudentRole"/>
        <skos:definition>A person who is enrolled in an education or training program.</skos:definition>
        <skos:definition>A person who receives training from a training provider.</skos:definition>
        <skos:definition>A role held by an individual who is receiving education or training.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Learning -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Learning">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#PostCredentialTrainingPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Learning</rdfs:label>
        <skos:definition>The learning content that must be delivered during the practical period of the apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LearningActivity -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LearningActivity">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Learning Activity</rdfs:label>
        <skos:definition>An educational or training activity related to an apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LearningDifficultyOrDisability -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LearningDifficultyOrDisability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FunctionalImpairmentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Learning Difficulty or Disability</rdfs:label>
        <skos:definition>A learning difficulty or disability that has been identified and evidenced as a barrier to achieving standard requirements.</skos:definition>
        <skos:definition>A learning difficulty or disability that may impact an apprentice&apos;s ability to complete their apprenticeship.</skos:definition>
        <skos:definition>An apprentice having a learning difficulty or disability may form part of a need’s assessment and if it directly impacts on their apprenticeship learning, they could be eligible for learning support.</skos:definition>
        <skos:definition>For the purposes of this section, and as defined in Section 15ZA(6) of the Education Act 1996, a person has a learning difficulty (or disability) if (a) the person has a significantly greater difficulty in learning than the majority of persons of the same age, or (b) the person has a disability which either prevents or hinders the person from making use of facilities of a kind generally provided by institutions providing education or training for persons who are over compulsory school age.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00124"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00133"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01207"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LearningEndDate -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LearningEndDate">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Learning End Date</rdfs:label>
        <skos:definition>The date when the last piece of learning has been delivered.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LearningMaterials -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LearningMaterials">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Learning Materials</rdfs:label>
        <skos:definition>Learning materials used in the delivery of the apprenticeship (e.g. printed, audio / visual and electronic / interactive materials), including any relevant software licences to access these materials where the licence cost is at apprentice level. Learning materials can be developed in-house or bought from a third party and can be refreshed periodically (e.g. to respond to revisions in the standard, learner and employer feedback).</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00439"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LearningSupport -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LearningSupport">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Learning Support</rdfs:label>
        <skos:definition>Financial support that providers can claim to help with the cost of any reasonable adjustments directly related to an apprenticeship, currently a fixed monthly amount of £150.</skos:definition>
        <skos:definition>Support provided to learners during an apprenticeship</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01208"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LearningSupportClaim -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LearningSupportClaim">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Learning Support Claim</rdfs:label>
        <skos:definition>A claim for learning support made during an apprenticeship</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LearningSupportFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LearningSupportFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Learning Support Funding</rdfs:label>
        <skos:definition>A fixed monthly funding allocation for learning support, set at £150 per month.</skos:definition>
        <skos:definition>Financial resources allocated to support learners with additional needs, claimed through ILR and EAS systems.</skos:definition>
        <skos:definition>Funding allocated to providers for delivering reasonable adjustments to learners, claimed monthly and subject to evidence requirements.</skos:definition>
        <skos:definition>Funding allocated to support apprentices with learning difficulties or disabilities.</skos:definition>
        <skos:definition>Funding available to meet the costs incurred by a provider of putting in place reasonable adjustments for an apprentice, as set out in section 20 of the Equality Act 2010.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00133"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LearningSupportRequirement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LearningSupportRequirement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Learning Support Requirement</rdfs:label>
        <skos:definition>A requirement for additional support in learning, which an apprentice may disclose to their employer.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LearningSupportReview -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LearningSupportReview">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Learning Support Review</rdfs:label>
        <skos:definition>A periodic review of learning support arrangements, required at least every 3 calendar months.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LearningSupportSubcontractingDefinition -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LearningSupportSubcontractingDefinition">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Learning Support Subcontracting Definition</rdfs:label>
        <skos:definition>Learning support would only be considered to be subcontracting if the separate legal entity delivering the learning support was also the party delivering the programme of learning.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01224"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LegacyEquivalent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LegacyEquivalent">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Legacy Equivalent Plan</rdfs:label>
        <skos:definition>A statement of special educational need or a learning difficulty assessment</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LegalAdvice -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LegalAdvice">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Legal Advice</rdfs:label>
        <skos:definition>Professional legal guidance regarding the incorporation of provisions and terms in subcontracting agreements.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LegislativeRequirements -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LegislativeRequirements">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Legislative Requirements</rdfs:label>
        <skos:definition>The requirements of the legislation that must be met when forming an apprenticeship agreement using an alternative template.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Level6TeacherApprenticeshipStandard -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Level6TeacherApprenticeshipStandard">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Level 6 Teacher Apprenticeship Standard</rdfs:label>
        <skos:definition>The Level 6 Teacher apprenticeship standard.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Level7Apprenticeship -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Level7Apprenticeship">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Level 7 Apprenticeship</rdfs:label>
        <skos:definition>A Level 7 apprenticeship program as defined by UK government funding rules.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Level7ApprenticeshipStandard -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Level7ApprenticeshipStandard">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Level 7 Apprenticeship Standard</rdfs:label>
        <skos:definition>A Level 7 apprenticeship standard as referenced in the regulatory provision.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LevySendingEmployer -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LevySendingEmployer">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Levy Sending Employer</rdfs:label>
        <skos:definition>An employer that pays the apprenticeship levy and agrees to fund an apprenticeship through a transfer of levy funds.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ListedPoints -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ListedPoints">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Listed Points</rdfs:label>
        <skos:definition>The specific points listed in paragraphs 60 to 62 of the relevant regulatory instrument.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LiteracyNumeracyDevelopment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LiteracyNumeracyDevelopment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Literacy and Numeracy Development</rdfs:label>
        <skos:definition>Further literacy and numeracy development, including level 1 and level 2 courses, provided as part of overall training provision.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#LocalAuthority -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#LocalAuthority">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Local Authority</rdfs:label>
        <skos:definition>A local authority organisation to which this section does not apply</skos:definition>
        <skos:definition>A local government body responsible for statutory duties including NEET prevention.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#MainProvider -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#MainProvider">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Main Provider</rdfs:label>
        <skos:definition>An organisation responsible for the completion of apprenticeship training.</skos:definition>
        <skos:definition>An organisation that acts as a main provider in the context of UK regulatory provisions.</skos:definition>
        <skos:definition>An organisation that acts as a main provider in the context of apprenticeship co-investment collection and reporting.</skos:definition>
        <skos:definition>An organisation that acts as a main provider in the context of apprenticeship funding and ILR submissions.</skos:definition>
        <skos:definition>An organisation that acts as a main provider in the context of apprenticeships.</skos:definition>
        <skos:definition>An organisation that acts as a main provider in the context of subcontracting, responsible for publishing specific information on their website.</skos:definition>
        <skos:definition>An organisation that acts as a main provider of apprenticeship training under UK funding rules.</skos:definition>
        <skos:definition>An organisation that acts as a main provider of training and end-point assessment services.</skos:definition>
        <skos:definition>An organisation that acts as the main provider in the context of apprenticeship funding and administration.</skos:definition>
        <skos:definition>An organisation that is a main provider of education or training services.</skos:definition>
        <skos:definition>The main provider responsible for ensuring apprentice preparation for end-point assessment.</skos:definition>
        <skos:definition>We use the term ‘main provider’ where the funding rule only applies to an organisation that is listed on the main provider route of the Apprenticeship Provider and Assessment Register (APAR).</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00022"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#MainProviderAndEmployer -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#MainProviderAndEmployer">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Main Provider and Employer</rdfs:label>
        <skos:definition>The main provider and employer as referenced in the regulatory provision.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#MainProviderOrEmployerRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#MainProviderOrEmployerRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Main Provider or Employer Role</rdfs:label>
        <skos:definition>The role of the main provider or the employer if they have chosen to undertake this role in the context of an apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#MainProviderRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#MainProviderRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Main Provider Role</rdfs:label>
        <skos:definition>A role held by an organisation responsible for the completion of apprenticeship training.</skos:definition>
        <skos:definition>The role of the main provider in the context of UK apprenticeship funding</skos:definition>
        <skos:definition>The role of the main provider responsible for ensuring apprentice preparation and understanding of the apprenticeship assessment process, in consultation with the employer.</skos:definition>
        <skos:definition>The role of the main provider responsible for ensuring subcontractor cost evidence</skos:definition>
        <skos:definition>The role of the primary training provider to whom co-investment payments are made.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#MandatoryQualificationApprenticeship -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#MandatoryQualificationApprenticeship">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Mandatory Qualification Apprenticeship</rdfs:label>
        <skos:definition>A condition that applies when an apprenticeship includes mandatory qualifications.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#MandatoryQualificationTrainingFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#MandatoryQualificationTrainingFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Mandatory Qualification Training Funding</rdfs:label>
        <skos:definition>Funding allocated for all training content and peripheral costs (registration, on-programme assessment, examination, certification) associated with a mandatory qualification, provided the qualifications comply with the mandatory qualifications policy.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#MaternityAdoptionSharedParentalLeave -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#MaternityAdoptionSharedParentalLeave">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Maternity/Adoption/Shared Parental Leave</rdfs:label>
        <skos:definition>A period of maternity, adoption, or shared parental leave taken by an apprentice.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#MaximumFundingAmount -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#MaximumFundingAmount">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Maximum Funding Amount</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#FinancialResource"/>
        <skos:definition>A resource representing the maximum funding amount allocated for a specific purpose, such as apprenticeship funding.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#MemorandumOfUnderstanding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#MemorandumOfUnderstanding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Memorandum of Understanding</rdfs:label>
        <skos:definition>A completed and signed Memorandum of Understanding (MoU) document.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#MinimalFinancialAssistanceExemption -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#MinimalFinancialAssistanceExemption">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Minimal Financial Assistance Exemption</rdfs:label>
        <skos:definition>A financial exemption threshold of £315,000 over a rolling 3-year period.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#MinimumDuration -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#MinimumDuration">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Minimum Duration</rdfs:label>
        <skos:definition>Minimum duration is the minimum length of time an apprentice must spend on training.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01210"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#MinimumOffTheJobTrainingRequirement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#MinimumOffTheJobTrainingRequirement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Minimum Off-the-Job Training Requirement</rdfs:label>
        <skos:definition>The regulatory minimum amount of off-the-job training that must be delivered to an apprentice.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#MinimumOffTheJobTrainingVolume -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#MinimumOffTheJobTrainingVolume">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Minimum Off-the-Job Training Volume</rdfs:label>
        <skos:definition>The minimum volume of off-the-job training for all apprentices (full-time, part-time, term-time), as published on the front of each apprenticeship standard.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00334"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#MonitoringArrangement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#MonitoringArrangement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Monitoring Arrangement</rdfs:label>
        <skos:definition>Arrangements established by a provider to monitor the apprenticeship training and on-programme assessment delivered by subcontractors.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#NEETRiskNotification -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#NEETRiskNotification">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>NEET Risk Notification</rdfs:label>
        <skos:definition>Statutory duty to notify the relevant local authority when an apprentice is at risk of becoming NEET.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#NewApprenticeStart -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#NewApprenticeStart">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>New Apprentice Start</rdfs:label>
        <skos:definition>A new instance of an individual commencing an apprenticeship programme.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#NewEmployer -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#NewEmployer">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>New Employer</rdfs:label>
        <skos:definition>An employer that takes on an apprentice to complete their apprenticeship after a change of employer.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#NewPrice -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#NewPrice">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>New Price</rdfs:label>
        <skos:definition>A newly negotiated price for apprenticeship training between the main provider and the new employer.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#NewSubcontractor -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#NewSubcontractor">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>New Subcontractor</rdfs:label>
        <skos:definition>A subcontractor identified as new according to the relevant glossary definition.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#NewerVersionOfStandard -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#NewerVersionOfStandard">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Newer Version of Standard</rdfs:label>
        <skos:definition>A revised version of an apprenticeship standard, potentially with new version costs assigned under Skills England&apos;s revisions, adjustments and dispensations process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#NoPlannedOTJTActiveLearning -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#NoPlannedOTJTActiveLearning">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>No Planned OTJT Active Learning</rdfs:label>
        <skos:definition>A condition where there is no plan for any off-the-job training active learning to take place within a 3 calendar month period.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#NonLevyPayingEmployerRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#NonLevyPayingEmployerRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Non-Levy Paying Employer Role</rdfs:label>
        <skos:definition>The role of an employer who does not pay the apprenticeship levy.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#OTJTActiveLearning -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#OTJTActiveLearning">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>OTJT Active Learning</rdfs:label>
        <skos:definition>OTJT active learning does not need to be delivered by the provider; it can include any activity that has been agreed and documented as part of the agreed training plan. When the training documented on the training plan is complete, the practical period is complete.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00364"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#OTJTActiveLearningPlan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#OTJTActiveLearningPlan">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>OTJT Active Learning Plan</rdfs:label>
        <skos:definition>A plan for off-the-job training active learning to take place at least every 3 calendar months of the practical period.</skos:definition>
        <skos:definition>A plan for off-the-job training active learning to take place at least in every calendar month of the practical period.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#OTJTMinimumRequirement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#OTJTMinimumRequirement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>OTJT Minimum Requirement</rdfs:label>
        <skos:definition>The published minimum off-the-job training hours required for the apprenticeship standard.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#OccupationPractitioner -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#OccupationPractitioner">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Person"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Occupation Practitioner</rdfs:label>
        <skos:definition>A person from the relevant occupation involved in assessment delivery and grading decisions.</skos:definition>
        <skos:definition>A person from the relevant occupation who participates in the delivery and grading decision of an end-point assessment.</skos:definition>
        <skos:definition>Someone from the occupation who participates in the delivery and grading decision of an apprenticeship assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#OffTheJobTraining -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#OffTheJobTraining">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Off-the-Job Training</rdfs:label>
        <rdfs:label>Off-the-job Training (OTJT)</rdfs:label>
        <skos:definition>All required off-the-job training that enables an apprentice to reach full occupational competence against the standard.</skos:definition>
        <skos:definition>Off-the-job training (OTJT) is defined as training which a) is delivering new knowledge, skills and behaviours, b) is directly relevant to the apprenticeship, c) is delivered in the apprentice’s normal working hours (but outside of their productive job role) and d) excludes ineligible activities such as standalone English and maths qualifications. The volume delivered must be based on the published minimum requirement for the standard, adjusted to account for evidenced prior learning that has been identified in the initial assessment of the apprentice.</skos:definition>
        <skos:definition>Training delivered outside the apprentice&apos;s normal working duties to achieve occupational competence.</skos:definition>
        <skos:definition>Training delivered outside the normal work environment as part of an apprenticeship.</skos:definition>
        <skos:definition>Training delivered to an apprentice that is not part of their normal work duties, as defined by statutory requirements.</skos:definition>
        <skos:definition>Training delivered to an apprentice that is not part of their normal working duties.</skos:definition>
        <skos:definition>Training undertaken outside of normal working duties, delivering new skills relevant to an apprenticeship standard.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01211"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#OffTheJobTrainingArrangement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#OffTheJobTrainingArrangement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Off-the-Job Training Arrangement</rdfs:label>
        <skos:definition>An arrangement for off-the-job training that, by exception, takes place outside of normal hours.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#OffTheJobTrainingHours -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#OffTheJobTrainingHours">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Off-the-Job Training Hours</rdfs:label>
        <skos:definition>Actual hours spent by an apprentice on off-the-job training activities.</skos:definition>
        <skos:definition>The calculated entity representing the planned and delivered off-the-job training hours for an apprenticeship programme, including adjustments for prior learning.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00338"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#OffTheJobTrainingParameters -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#OffTheJobTrainingParameters">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Off-the-Job Training Parameters</rdfs:label>
        <skos:definition>The volume of off-the-job training hours, timeframe, and delivery model to be agreed upon.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Ofsted -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Ofsted">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#Agent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                        <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Ofsted</rdfs:label>
        <skos:definition>The Office for Standards in Education, Children&apos;s Services and Skills, a non-ministerial department of the UK government responsible for inspecting educational institutions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#OnboardingOfTheApprentice -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#OnboardingOfTheApprentice">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Onboarding of the Apprentice</rdfs:label>
        <skos:definition>Onboarding of the apprentice will include agreeing a price with the employer and developing, agreeing and signing any relevant paperwork to support the apprenticeship, such as the training plan. Onboarding does not include training delivery and therefore does not count towards the off-the-job training policy.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01212"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#OriginalTeachingMaterialDevelopment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#OriginalTeachingMaterialDevelopment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Original Teaching Material Development</rdfs:label>
        <skos:definition>Development of original teaching materials related to a new apprenticeship offer means the first time a provider chooses to deliver a new apprenticeship standard.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00470"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#OtherRulesDocument -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#OtherRulesDocument">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Other Rules Document</rdfs:label>
        <skos:definition>The document containing all other rules that must be complied with, as referenced in the regulatory provision.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#OverPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#OverPayment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Over-payment</rdfs:label>
        <skos:definition>Funds paid in excess of the amount due from an employer&apos;s apprenticeship service account or government-employer co-investment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#PartTimeApprentice -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#PartTimeApprentice">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Part Time Apprentice</rdfs:label>
        <skos:definition>An individual engaged on an apprenticeship who works less than 30 hours per week.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01213"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Payment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Payment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Payment</rdfs:label>
        <skos:definition>A financial payment made in the context of apprenticeship funding.</skos:definition>
        <skos:definition>A financial resource representing a transfer of funds.</skos:definition>
        <skos:definition>A monetary payment transferred as part of apprenticeship funding.</skos:definition>
        <skos:definition>Monetary funds transferred as part of apprenticeship funding.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#PaymentDelay -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#PaymentDelay">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Payment Delay</rdfs:label>
        <skos:definition>The action of delaying a payment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#PeripheralCosts -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#PeripheralCosts">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Peripheral Costs</rdfs:label>
        <skos:definition>Peripheral costs associated with a mandatory qualification. These include registration, formative on-programme assessment costs, examination and certification costs, plus the cost of one re-sit (per mandatory qualification) where needed.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00448"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#PlacementDocumentation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#PlacementDocumentation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Placement Documentation</rdfs:label>
        <skos:definition>Documented details of an apprentice&apos;s placement, including host employer name and placement duration.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#PlannedHours -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#PlannedHours">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Planned Hours</rdfs:label>
        <skos:definition>The scheduled training hours agreed between the provider and the employer.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#PlannedOffTheJobTrainingHours -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#PlannedOffTheJobTrainingHours">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Planned Off-the-Job Training Hours</rdfs:label>
        <skos:definition>The number of planned off-the-job training hours for the full apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#PracticalPeriod -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#PracticalPeriod">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Practical Period</rdfs:label>
        <skos:definition>The practical period of the apprenticeship during which all learning must be delivered.</skos:definition>
        <skos:definition>The start and end date of the practical period (this is the part of the apprenticeship where evidenced learning is delivered; this does not include the end-point assessment)</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00269"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#PracticalPeriodEnd -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#PracticalPeriodEnd">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Practical Period End</rdfs:label>
        <skos:definition>The temporal condition marking the end of the practical training period.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#PracticalPeriodEndDate -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#PracticalPeriodEndDate">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Practical Period End Date</rdfs:label>
        <skos:definition>The practical period end date aligns with the planned learning end date in the ILR.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00272"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#PracticalPeriodStartDate -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#PracticalPeriodStartDate">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Practical Period Start Date</rdfs:label>
        <skos:definition>The date on which the practical period for an apprenticeship begins.</skos:definition>
        <skos:definition>The practical period start date aligns with the learning start date in the ILR.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00270"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00272"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Price -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Price">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Price</rdfs:label>
        <skos:definition>A monetary amount representing the cost of a good or service.</skos:definition>
        <skos:definition>The negotiated price with the main provider and end-point assessment organisation.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00977"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#PriceDifference -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#PriceDifference">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Price Difference</rdfs:label>
        <skos:definition>The difference between the band maximum and the total negotiated price.</skos:definition>
        <skos:definition>The difference between the funding band maximum and the total negotiated price for an apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#PriorLearningAndExperience -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#PriorLearningAndExperience">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Prior Learning and Experience</rdfs:label>
        <skos:definition>An individual&apos;s previously attained knowledge, skills, and behaviours relevant to an apprenticeship standard.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#PriorLearningPercentage -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#PriorLearningPercentage">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Prior Learning Percentage</rdfs:label>
        <skos:definition>The percentage of prior learning that an individual has, calculated as a percentage of the off-the-job training hours that would be delivered to an individual with no relevant prior learning for the same standard.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00111"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#PrisonerApprenticeRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#PrisonerApprenticeRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Prisoner Apprentice Role</rdfs:label>
        <skos:definition>The role of a prisoner who is also an apprentice, as referenced in UK regulatory provisions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ProfessionalBody -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ProfessionalBody">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Professional Body</rdfs:label>
        <skos:definition>A professional body that may act as an end-point assessment organisation for an integrated degree standard.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Programme -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Programme">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EducationalProgramPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Programme</rdfs:label>
        <skos:definition>A structured course of study or training for which funding eligibility must be assessed.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ProgressReview -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ProgressReview">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Progress Review</rdfs:label>
        <skos:definition>A review of progress undertaken and documented by the provider.</skos:definition>
        <skos:definition>An action to discuss the progress to date of the apprentice against their training plan</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ProgressReviewDiscussion -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ProgressReviewDiscussion">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Progress Review Discussion</rdfs:label>
        <skos:definition>A discussion held as part of a progress review, typically involving the apprentice and employer.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ProgressionProfile -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ProgressionProfile">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Progression Profile</rdfs:label>
        <skos:definition>A published document that identifies whether a subsequent apprenticeship in the same occupational area can be funded, and if so, whether that apprenticeship must be an accelerated apprenticeship with an adjustment in content and price.</skos:definition>
    </owl:Class>
    


