        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Executive Officer</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#GovernanceLeadRole"/>
        <skos:definition>A role held by an individual who is an executive officer of an organisation, as defined in the Act.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#Explanation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#Explanation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Explanation</rdfs:label>
        <skos:definition>A resource that provides an explanation or clarification of a requirement or process.</skos:definition>
        <skos:definition>A statement or account that makes something clear, such as an explanation of tuition fee apportionment and census days.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ExpressConsent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ExpressConsent">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Express Consent</rdfs:label>
        <skos:definition>A student is also taken to have provided express consent if they initiate contact with a third party for the purposes of giving information to you, or getting information from you, relating to education and training.</skos:definition>
        <skos:definition>Consent given by a student or prospective student for contact, where information was presented clearly with specific purpose.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00647"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ExternalLLNTool -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ExternalLLNTool">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>External LLN Tool</rdfs:label>
        <skos:definition>An external Language, Literacy and Numeracy tool used for assessment purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#FamilyOrPersonalCircumstances -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#FamilyOrPersonalCircumstances">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Family or Personal Circumstances</rdfs:label>
        <skos:definition>family or personal circumstances – for example, death or severe medical problems in the student’s family, or unforeseen financial difficulties which affect the student so much that it’s unreasonable to expect them to continue studying</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00528"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#FeeInformation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#FeeInformation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Fee Information</rdfs:label>
        <skos:definition>Information about fees that must be provided to students before enrollment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#FeeLimit -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#FeeLimit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Fee Limit</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#AdditionalCosts"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#FundingBandMaximum"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#FundingResource"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#StudentLoan"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#TransferAmount"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#FinancialResource"/>
        <skos:definition>A financial resource representing the maximum loan amount available to cover course fees.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#FeeList -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#FeeList">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Fee List</rdfs:label>
        <skos:definition>A list of fees charged for an approved course, including tuition fees for each part of the course.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#FeeNotice -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#FeeNotice">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FeePolicyDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Fee Notice</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/ca#TuitionFeePolicy"/>
        <skos:definition>A document issued to students detailing fees and census days for a fee period of a course.</skos:definition>
        <skos:definition>A document providing details of fees payable by a student, as required under Australian education regulations.</skos:definition>
        <skos:definition>A document that informs students of the fees being charged, including those covered by a VET Student Loan.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#FeePeriod -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#FeePeriod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EducationalPeriodPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Fee Period</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/ca#StudyPeriod"/>
        <skos:definition>A defined period over which tuition fees for a course are allocated.</skos:definition>
        <skos:definition>A designated period within an approved course for which tuition fees are charged, ensuring even debt accrual for students.</skos:definition>
        <skos:definition>A period over which fees are structured and payable</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#FeePeriodLength -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#FeePeriodLength">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Fee Period Length</rdfs:label>
        <skos:definition>The duration of a fee period associated with a course, which may be subject to change.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#Fees -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#Fees">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Fees</rdfs:label>
        <skos:definition>Monetary charges levied for educational services.</skos:definition>
