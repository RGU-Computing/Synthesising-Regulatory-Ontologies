        <rdfs:label>Course Delivery</rdfs:label>
        <skos:definition>The delivery of courses or parts of courses that may be outsourced by an approved course provider.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#CourseDeliveryOutsourcing -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#CourseDeliveryOutsourcing">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Course Delivery Outsourcing</rdfs:label>
        <skos:definition>The action of outsourcing the delivery of courses or parts of courses to a third party.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#CourseFeeLoan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#CourseFeeLoan">
