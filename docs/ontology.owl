        <rdfs:label>Course Provider Requirements</rdfs:label>
        <skos:definition>The set of requirements that an approved course provider must meet.</skos:definition>
        <skos:definition>The set of requirements that providers must continue to meet after their approval under the VET Student Loans program.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00011"/>
    </owl:Class>
    


