    <!-- https://w3id.org/cco-gro/data#USA_UNIT_00186_subject_f18612 -->


    <owl:Thing rdf:about="https://w3id.org/cco-gro/data#USA_UNIT_00186_subject_f18612">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://w3id.org/cco-gro/onto/us#StudentAvailableIncome"/>
        <rdf:type rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Available Income</rdfs:label>
        <skos:definition>The student&apos;s available income is calculated by subtracting certain allowances from the student&apos;s total income. These allowances account for certain nondiscretionary expenses, such as taxes and basic living expenses. Once a minimum level of support has been offset for those expenses, the formula assumes that the remaining income is available for discretionary purposes, including paying for a postsecondary education. The student&apos;s available income is the sum of the taxable and untaxed income, minus amounts reported in the income but excluded from the formula (offsets and allowances).</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00186"/>
    </owl:Thing>
    


    <!-- https://w3id.org/cco-gro/data#USA_UNIT_00188 -->


    <owl:NamedIndividual rdf:about="https://w3id.org/cco-gro/data#USA_UNIT_00188">
        <rdf:type rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:label>Source: USA-UNIT-00188</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/cco-gro/data#USA_UNIT_00188_calculation_rule -->


    <owl:Thing rdf:about="https://w3id.org/cco-gro/data#USA_UNIT_00188_calculation_rule">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <cco:hasConditionExpression>Student&apos;s total income = Student&apos;s total income - (Student&apos;s taxable college grant and scholarship aid + Student&apos;s education credits + Student&apos;s Federal Work-Study) - (U.S. income tax paid + Student&apos;s payroll tax allowance + Income protection allowance + Allowance for parents&apos; negative adjusted available income)</cco:hasConditionExpression>
        <rdfs:label>Student Income Calculation Rule</rdfs:label>
        <skos:definition>The student&apos;s total income is decreased by the sum of income offsets (taxable college grant and scholarship aid, education credits, Federal Work-Study) and reduced by the sum of income allowances (U.S. income tax paid, payroll tax allowance, income protection allowance, allowance for parents&apos; negative adjusted available income).</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00188"/>
    </owl:Thing>
    


    <!-- https://w3id.org/cco-gro/data#USA_UNIT_00188_income_allowances_condition -->


    <owl:Thing rdf:about="https://w3id.org/cco-gro/data#USA_UNIT_00188_income_allowances_condition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <cco:hasConditionExpression>The sum of the following allowances reduces the student&apos;s total income: U.S. income tax paid, Student&apos;s payroll tax allowance, Income protection allowance, Allowance for parents&apos; negative adjusted available income.</cco:hasConditionExpression>
        <rdfs:label>Income Allowances Condition</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00188"/>
    </owl:Thing>
    


    <!-- https://w3id.org/cco-gro/data#USA_UNIT_00188_income_offsets_condition -->


    <owl:Thing rdf:about="https://w3id.org/cco-gro/data#USA_UNIT_00188_income_offsets_condition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <cco:hasConditionExpression>The sum of the following items decreases the student&apos;s total income: Student&apos;s taxable college grant and scholarship aid, Student&apos;s education credits, Student&apos;s Federal Work-Study (FWS).</cco:hasConditionExpression>
        <rdfs:label>Income Offsets Condition</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00188"/>
    </owl:Thing>
    


    <!-- https://w3id.org/cco-gro/data#USA_UNIT_00188_subject_851b3d -->


    <owl:Thing rdf:about="https://w3id.org/cco-gro/data#USA_UNIT_00188_subject_851b3d">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://w3id.org/cco-gro/onto/us#StudentTotalIncome"/>
        <rdf:type rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Total Income</rdfs:label>
        <skos:definition>The total income of a student, which is decreased by the sum of income offsets and reduced by the sum of income allowances as specified in the calculation rule.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00188"/>
    </owl:Thing>
    


    <!-- https://w3id.org/cco-gro/data#USA_UNIT_00189 -->


