                                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                        <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Ministry</rdfs:label>
        <skos:definition>The Ministry responsible for post-secondary education and student financial assistance in British Columbia, Canada.</skos:definition>
        <skos:definition>The government ministry responsible for student financial assistance.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#MinistryOfPostSecondaryEducationAndFutureSkills -->


