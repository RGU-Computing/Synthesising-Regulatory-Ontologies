        <skos:definition>A loan available to eligible students undertaking approved vocational education and training courses.</skos:definition>
        <skos:definition>A loan available to eligible students undertaking vocational education and training courses.</skos:definition>
        <skos:definition>A loan provided under the VET Student Loans program in Australia.</skos:definition>
        <skos:definition>A loan provided under the VET Student Loans program to cover tuition fees.</skos:definition>
        <skos:definition>A loan provided under the VET Student Loans program to eligible students for approved courses.</skos:definition>
        <skos:definition>A loan provided under the VET Student Loans program.</skos:definition>
