    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprovedLevel2Qualification">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Approved Level 2 Qualification</rdfs:label>
        <skos:definition>An approved level 2 qualification in both English and maths subjects</skos:definition>
        <skos:definition>An approved qualification at level 2 in English and/or maths.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Assessment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Assessment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
