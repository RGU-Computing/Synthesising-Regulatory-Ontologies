    <!-- https://w3id.org/cco-gro/data#CAN_UNIT_00378_condition_b51717 -->


    <owl:Thing rdf:about="https://w3id.org/cco-gro/data#CAN_UNIT_00378_condition_b51717">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <cco:hasConditionExpression>To be eligible for modified independent status, the student must provide satisfactory evidence of a severe and permanent breakdown in the relationship with the parent(s). The student will normally be expected to have maintained an independent residence outside the parent(s)&apos; home for at least one year before the start of the study period.</cco:hasConditionExpression>
        <rdfs:label>Modified Independent Eligibility Criteria</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00378"/>
    </owl:Thing>
    


    <!-- https://w3id.org/cco-gro/data#CAN_UNIT_00378_exception_condition -->


    <owl:Thing rdf:about="https://w3id.org/cco-gro/data#CAN_UNIT_00378_exception_condition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <cco:hasConditionExpression>Exceptions will be considered when it can be documented that a recent incident with the parent(s) was sudden and violent, placing the student in physical jeopardy or causing extreme mental stress, resulting in the need to move out of the family home. Students who usually live with their parents during the summer months cannot be considered for modified independent status.</cco:hasConditionExpression>
        <rdfs:label>Exception Criteria</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00378"/>
    </owl:Thing>
    


