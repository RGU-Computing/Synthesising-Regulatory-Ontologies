        <skos:definition>A body that provides students with a fair and unbiased opportunity to have their appeal decision reconsidered.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#AppealDecision -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#AppealDecision">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RegulatoryDecisionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Appeal Decision</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#Judgement"/>
        <skos:definition>A decision rendered on an appeal, communicated in writing to the institution.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#AppealDeniedAndEligible -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#AppealDeniedAndEligible">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Appeal Denied and Eligible</rdfs:label>
        <skos:definition>The condition where a student&apos;s appeal is denied and the appealed issue was included in the list of policy and criteria eligible for appeal.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#AppealProcess -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#AppealProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentAidModificationConditionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Appeal Process</rdfs:label>
        <skos:definition>The condition during which an appeal is underway, triggering discretionary adjustments to student financial assistance.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#AppealRequestForm -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#AppealRequestForm">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentGrievanceMechanismPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Appeal Request Form</rdfs:label>
        <skos:definition>The appropriate form used by students to initiate an appeal.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#AppealStudent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#AppealStudent">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Appeal (Student)</rdfs:label>
        <skos:definition>An appeal is a formal request for a review of a student’s application assessment to take into account exceptional circumstances demonstrated or proven by the applicant, which may result in StudentAid BC setting aside standard program policy.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00816"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Appendix1 -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Appendix1">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Appendix 1</rdfs:label>
        <skos:definition>A form used to report parental income and assets when parents live outside Canada.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00432"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Appendix3Form -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Appendix3Form">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Appendix 3 Form</rdfs:label>
        <skos:definition>A form indicating the cost of tuition, books, and fees for a post-secondary institution.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Appendix7 -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Appendix7">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Appendix 7</rdfs:label>
        <skos:definition>A required documentation form for certain circumstance changes in Canadian student funding programs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Appendix8 -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Appendix8">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Appendix 8</rdfs:label>
        <skos:definition>A form with supporting medical documentation.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Appendix8DisabilityProgramsApplication -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Appendix8DisabilityProgramsApplication">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Appendix 8 - Disability Programs Application</rdfs:label>
        <skos:definition>The Appendix 8 form required for students applying for ASF disability programs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Applicant -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Applicant">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Applicant</rdfs:label>
        <skos:definition>A role representing an individual or entity that applies for something, such as reimbursement.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ApplicantMultipleDisabilities -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ApplicantMultipleDisabilities">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Applicant with Multiple Disabilities</rdfs:label>
        <skos:definition>An applicant being verified for multiple disabilities under Canadian regulations.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00318"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#Application -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#Application">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FundingApplicationPattern"/>
