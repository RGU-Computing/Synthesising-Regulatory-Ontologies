        <skos:definition>An evaluation or test taken by an apprentice as part of their apprenticeship program</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AssessmentAction -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AssessmentAction">
