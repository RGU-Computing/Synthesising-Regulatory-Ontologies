        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#StudentLoan"/>
        <skos:definition>Loan amounts for course fees paid directly to the provider</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#CourseInformation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#CourseInformation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Course Information</rdfs:label>
        <skos:definition>A collection of information items that must be provided to students, including course name, part name, identifying code, census day, tuition fees, VSL coverage, and VSL debt amount.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#CourseInformationResource -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#CourseInformationResource">
