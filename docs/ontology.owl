    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#ThirdPartyContactList -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#ThirdPartyContactList">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Third Party Contact List</rdfs:label>
        <rdfs:label>Third-Party Contact List</rdfs:label>
        <skos:definition>A contact list owned or controlled by a third party, used for marketing, advertising, or promoting courses.</skos:definition>
        <skos:definition>A contact list owned or controlled by a third party, used for marketing, advertising, or promotional purposes.</skos:definition>
        <skos:definition>Contact details received from another person for marketing or enrolment purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#TransferringStudentLoanCap -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#TransferringStudentLoanCap">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Transferring Student Loan Cap</rdfs:label>
        <skos:definition>The remaining loan cap available to a student who transfers to another provider and continues to study the same course. The loan cap does not reset; the student can only access a VET Student Loan up to the remainder of the total loan cap.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00342"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#TuitionAssuranceArrangement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#TuitionAssuranceArrangement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Tuition Assurance Arrangement</rdfs:label>
        <skos:definition>An arrangement that protects students if a course provided by an approved course provider is not delivered to completion, such as through the Tuition Protection Service.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#AUS_UNIT_00035"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#TuitionFee -->


