    <!-- https://w3id.org/cco-gro/data#UK_UNIT_00545_condition_cef982 -->


    <owl:Thing rdf:about="https://w3id.org/cco-gro/data#UK_UNIT_00545_condition_cef982">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <cco:hasConditionExpression>Before any payment is claimed for and paid there is confirmation of eligibility for any additional payment and / or care leaver bursary. This includes (1) confirmation of age; (2) a signed letter or email confirmation from a local authority confirming the individual’s care leaver status (this does not require a particular format); or (3) evidence of an education, health and care (EHC) plan where the apprentice is aged between 19 and 24 years old (Local Authority confirmation does not require a particular format; main providers should assist the apprentice in obtaining confirmation where necessary).</cco:hasConditionExpression>
        <rdfs:label>Pre-Payment Condition</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00545"/>
    </owl:Thing>
    


