        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Funding and Loan Rehabilitation Application</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#FundingResource"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#Programme"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#FAFSAApplication"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#VerificationDocumentation"/>
        <skos:definition>An application submitted by a student for funding and loan rehabilitation, subject to review under specified conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FundingAuthority -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FundingAuthority">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Funding Authority</rdfs:label>
        <skos:definition>An organisation responsible for administering and disbursing student disability funding.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FundingProgram -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FundingProgram">
