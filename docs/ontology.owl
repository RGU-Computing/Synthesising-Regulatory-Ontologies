        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Person"/>
        <rdfs:label>Appropriate Professional</rdfs:label>
        <skos:definition>A professional with suitable knowledge and expertise to assess learning difficulties or disabilities</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AppropriateProfessionalRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AppropriateProfessionalRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Appropriate Professional Role</rdfs:label>
        <skos:definition>A role held by an appropriate professional associated with the provider or subcontractor, such as the head of SEN or student support, or an equivalent individual with suitable knowledge and expertise.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00208"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Approval -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Approval">
