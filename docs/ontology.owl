        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Financial Assistance Information</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#FAFSAApplication"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#StateFinancialAid"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#TitleIVAid"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#VerificationDocumentation"/>
        <skos:definition>Information pertaining to the student financial assistance application, related documents, and repayment of loans.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#StudentFinancialAssistanceProgram -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#StudentFinancialAssistanceProgram">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Financial Assistance Program</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#FundingResource"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#Programme"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#StateFinancialAid"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#TitleIVAid"/>
        <skos:definition>A program providing financial assistance to students, as described in the relevant regulatory chapter.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#StudentFinancialAssistanceRecipient -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#StudentFinancialAssistanceRecipient">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Student Financial Assistance Recipient</rdfs:label>
        <skos:definition>A role representing the recipient of student financial assistance, including loans, grants, and bursaries.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#StudentFundingRecipient -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#StudentFundingRecipient">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Student Funding Recipient</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#Learner"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DependentStudent"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#Student"/>
        <skos:definition>A student who obtains funding for assistive services or reimbursement for previously purchased assistive services</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#StudentGrant -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#StudentGrant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto/ca#FinancialAssistance"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Grant</rdfs:label>
        <skos:definition>A non-repayable grant provided to students based on eligibility criteria such as income level or disability status.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#StudentLivingAllowance -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#StudentLivingAllowance">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Living Allowance</rdfs:label>
        <skos:definition>Student living allowances are standard allowances established by the Government of Canada to cover the costs of shelter, food, local transportation and miscellaneous expenses and used by StudentAid BC to assess financial need for full-time students.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00862"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#StudentLoan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#StudentLoan">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto/ca#FinancialAssistance"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Loan</rdfs:label>
        <skos:definition>A loan made to a student to finance educational expenses.</skos:definition>
        <skos:definition>A repayable loan provided to students to fund their education.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#StudentLoanDebt -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#StudentLoanDebt">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EducationalLoanDebtPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Loan Debt</rdfs:label>
        <skos:definition>A financial obligation arising from a student loan.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#StudentLoanGrantFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#StudentLoanGrantFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Loan and Grant Funding</rdfs:label>
        <skos:definition>Financial resources comprising student loans and grants allocated under the Canada Student Financial Assistance Program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#StudentRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#StudentRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#StudentSupportServices -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#StudentSupportServices">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Support Services</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#TitleIVAid"/>
        <skos:definition>Assistive services (tutors, interpreters, academic planning), accommodation services (exam writing), and access to and administration of student financial assistance (grants, bursaries) provided under a centralized institution support program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#StudentWithAccessibilityChallenges -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#StudentWithAccessibilityChallenges">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Student with Accessibility Challenges</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#Student"/>
        <skos:definition>A student who has accessibility challenges and may be eligible for assistive technology loans.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#StudentWithDependentsRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#StudentWithDependentsRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Student with Dependents Role</rdfs:label>
        <skos:definition>A role held by a student who has dependents, qualifying them for additional funding considerations.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#StudentWithDisabilityRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#StudentWithDisabilityRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Student with Disability Role</rdfs:label>
        <skos:definition>A role held by a student with a permanent, persistent, or prolonged disability who requires exceptional education-related services or equipment.</skos:definition>
        <skos:definition>The role of a student who has a disability, qualifying them for specific funding allocations.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#StudyPeriod -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#StudyPeriod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EducationalPeriodPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Study Period</rdfs:label>
        <skos:definition>The study period is the time between the start date and end date specified in the application for student financial assistance.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00863"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#StudyPeriodWeeks -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#StudyPeriodWeeks">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Study Period Weeks</rdfs:label>
        <skos:definition>The number of weeks in a student&apos;s study period, used as a multiplier in BCAG-FT award calculation.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00232"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#SuccessfulCompletion -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#SuccessfulCompletion">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#CourseCompletionConditionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Successful Completion</rdfs:label>
        <skos:definition>Identifies a student who has fully completed a study period/semester/term and has also written and passed course exams for the same study period/semester/term.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00864"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#SuccessfulReinstatementStudent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#SuccessfulReinstatementStudent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Successful Reinstatement Student</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DependentStudent"/>
        <skos:definition>A student who has successfully completed reinstatement or appeal to StudentAid BC.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#TargetedResource -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#TargetedResource">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Targeted Resource</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#FundingResource"/>
        <skos:definition>Targeted resources are those provided to help with specific educational costs, and may include funds received from municipal, provincial or federal governments, and/or the private sector.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00416"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#ThirdPartyLetter -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#ThirdPartyLetter">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Third Party Letter</rdfs:label>
        <skos:definition>A letter from a responsible third party testifying as to the truthfulness of the student’s explanation and providing an independent assessment of the situation.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#TransportationMiscellaneousAllowance -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#TransportationMiscellaneousAllowance">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Transportation and Miscellaneous Allowance</rdfs:label>
        <skos:definition>A fixed weekly allowance of $23 per week of study for transportation and/or miscellaneous education-related costs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#TravelExpense -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#TravelExpense">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Travel Expense</rdfs:label>
        <skos:definition>Expenses incurred for travel under StudentAid BC programs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#TravelExpenseFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#TravelExpenseFunding">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Travel Expense Funding</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#FundingResource"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#CostOfAttendanceComponent"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#StateFinancialAid"/>
        <skos:definition>Funding allocated for travel expenses incurred by students required to travel to a different location as a mandatory part of their program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#TuitionFeePolicy -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#TuitionFeePolicy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FeePolicyDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Tuition and Fee Policy</rdfs:label>
        <skos:definition>A policy document governing tuition and fees charged by an institution.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#UnmetNeed -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#UnmetNeed">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Unmet Need</rdfs:label>
        <skos:definition>The amount by which a student’s assessed financial need (Government of Canada or Province of British Columbia) exceeds the total award.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00866"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#UnusedGrant -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#UnusedGrant">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Unused Grant</rdfs:label>
        <skos:definition>A grant amount remaining after the Government of Canada portion of a student&apos;s assessed need has been satisfied</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#UnverifiedBorrowerRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#UnverifiedBorrowerRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Unverified Borrower Role</rdfs:label>
        <skos:definition>A role held by borrowers who have not had their persistent or prolonged disability previously verified with the StudentAid BC or CSFA Program prior to their RAP-D application</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#VoluntaryContribution -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#VoluntaryContribution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialNeedAssessmentInputPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Voluntary Contribution</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#ParentsContributionFromAssets"/>
        <skos:definition>Voluntary contributions include all sources of funding for the specific purpose of helping with the costs of post-secondary study that are provided to a student by their parent(s), step-parent, sponsor, or legal guardian.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00421"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#WeeklyGrantMaximum -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#WeeklyGrantMaximum">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Weekly Grant Maximum</rdfs:label>
        <skos:definition>A weekly grant maximum determined based on the length of the program the student is attending.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#WhollyDependentPerson -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#WhollyDependentPerson">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Wholly Dependent Person</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#LegalDependent"/>
        <skos:definition>Wholly dependent persons may include: a child or a grandchild of the student or of the student’s spouse; or the parent, step-parent, grandparent, brother, sister, uncle, aunt, niece or nephew of the student or the student’s spouse, if resident in Canada.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00867"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#WithdrawalDate -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#WithdrawalDate">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Withdrawal Date</rdfs:label>
        <skos:definition>The withdrawal date is dependent on missed deadlines. The withdrawal date is the start of classes if the first assignment or exam deadline was missed or the first assignment deadline date if the second assignment or exam was missed, etc.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#WithdrawnStudent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#WithdrawnStudent">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Withdrawn Student</rdfs:label>
        <skos:definition>Students are considered to have withdrawn if they transfer to a new post-secondary institution and there is a gap of more than two weeks between the last date of attendance at the first post-secondary institution and the first date of attendance at the second post-secondary institution.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00498"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#WorkBCESFullCostAndDALivingCostStudent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#WorkBCESFullCostAndDALivingCostStudent">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>WorkBC ES and DA Student</rdfs:label>
        <skos:definition>A student who is receiving WorkBC Employment Services funds for full educational costs and Disability Assistance funds for living costs under the Employment and Assistance for Persons with Disabilities Act.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#WorkBCEmploymentServicesFunds -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#WorkBCEmploymentServicesFunds">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>WorkBC Employment Services Funds</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#FundingResource"/>
        <skos:definition>Funds provided by the WorkBC Employment Services Program for educational costs, training allowance, or transportation allowance.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#YearEndBreak -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#YearEndBreak">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#LearningPausePattern"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto/ca#Break"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Year-End Break</rdfs:label>
        <skos:definition>An extended break at the end of the academic year, permitted up to three consecutive weeks.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#APAR -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#APAR">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>APAR</rdfs:label>
        <skos:definition>The published Approved Provider and Apprenticeship Register.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AcceleratedApprenticeship -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AcceleratedApprenticeship">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Accelerated Apprenticeship</rdfs:label>
        <skos:definition>An accelerated apprenticeship is where the apprentice’s planned duration is shorter (by at least 3 months) than the typical duration of the standard, based on prior learning.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01187"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ActiveLearning -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ActiveLearning">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Active Learning</rdfs:label>
        <skos:definition>Active learning for English and/or maths as part of an apprenticeship programme.</skos:definition>
        <skos:definition>Learning activities carried out by an apprentice in line with a signed training plan, distinct from off-the-job training active learning.</skos:definition>
        <skos:definition>The delivery of active learning for English and/or maths as described in the training plan.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ActiveLearningRequirement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ActiveLearningRequirement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Active Learning Requirement</rdfs:label>
        <skos:definition>The requirement that delivery of English and maths must be in line with the active learning requirement.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ActualCosts -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ActualCosts">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Actual Costs</rdfs:label>
        <skos:definition>The actual costs incurred for delivery of apprenticeship services.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AdditionalCosts -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AdditionalCosts">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Additional Costs</rdfs:label>
        <skos:definition>Costs exceeding the funding band maximum for an apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AdditionalLearningForResitExam -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AdditionalLearningForResitExam">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Additional Learning for Resit Exam</rdfs:label>
        <skos:definition>Additional learning required to re-sit an exam linked to either a mandatory qualification or an end-point assessment.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00443"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AdditionalPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AdditionalPayment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Additional Payment</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#LateDisbursement"/>
        <skos:definition>A funding payment that is due to be paid to an apprentice, but may be delayed under certain conditions.</skos:definition>
        <skos:definition>A supplementary payment made to an employer beyond standard amounts.</skos:definition>
        <skos:definition>An additional payment received as part of the two-year growth pilot.</skos:definition>
        <skos:definition>Any additional payment and/or care leaver bursary claimed under the provision.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AdvancedLearnerLoan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AdvancedLearnerLoan">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Advanced Learner Loan</rdfs:label>
        <skos:definition>Loans for individuals aged 19+ to provide financial support towards tuition costs. These loans are paid directly to the college or training organisation. These are not applicable to apprenticeships.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01188"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Age16To18Role -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Age16To18Role">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>16 to 18-year-old Role</rdfs:label>
        <skos:definition>A role held by individuals aged between 16 and 18 years</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AgreedPrice -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AgreedPrice">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Agreed Price</rdfs:label>
        <skos:definition>The agreed price that is entered into the ILR and the apprenticeship service</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Agreement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Agreement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Agreement</rdfs:label>
        <skos:definition>A contractual agreement between the provider and the regulatory authority for the provision of apprenticeship funded delivery.</skos:definition>
        <skos:definition>A formal agreement document to be completed and signed by the provider, employer, and apprentice regarding KIT/SPLIT days for apprenticeship off-the-job training and/or assessment.</skos:definition>
        <skos:definition>A formal arrangement or contract between parties, subject to revision or creation under changing circumstances.</skos:definition>
        <skos:definition>A mutual arrangement between parties, such as an agreement to continue an apprenticeship with a new employer via a transfer of levy funds.</skos:definition>
        <skos:definition>A written agreement entered into between a provider and an employer.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AllParties -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AllParties">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:label>All Parties</rdfs:label>
        <skos:altLabel>All parties</skos:altLabel>
        <skos:definition>The collective group of all parties involved in the apprenticeship service price confirmation process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AlternativeDeliveryArrangement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AlternativeDeliveryArrangement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Alternative Delivery Arrangement</rdfs:label>
        <skos:definition>Alternative delivery arrangements made for each apprentice affected by a subcontractor&apos;s change of circumstances</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AlternativeEnglishApprentice -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AlternativeEnglishApprentice">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Alternative English Apprentice</rdfs:label>
        <skos:definition>An apprentice participating in an alternative English apprenticeship program, as referenced in the regulatory provision.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AlternativeEnglishApprenticeship -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AlternativeEnglishApprenticeship">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Alternative English Apprenticeship</rdfs:label>
        <skos:definition>A condition where the apprentice is enrolled on an alternative English apprenticeship programme.</skos:definition>
        <skos:definition>An apprenticeship programme in England that provides an alternative funding route for individuals not directly employed by an employer.</skos:definition>
        <skos:definition>An apprenticeship that is an alternative English apprenticeship</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AlternativeFrequency -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AlternativeFrequency">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Alternative Frequency</rdfs:label>
        <skos:definition>A review frequency that differs from the standard schedule, justified by an evidenced delivery reason.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AnnexCResource -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AnnexCResource">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Annex C Resource</rdfs:label>
        <rdfs:label>Annex C: Off-the-job Training</rdfs:label>
        <skos:definition>Annex C: Off-the-job training: minimum requirement for each apprenticeship standard, a regulatory document on GOV.UK.</skos:definition>
        <skos:definition>Annex C: off-the-job training: minimum requirement for each apprenticeship standard</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApplicationAndSupportingEvidence -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApplicationAndSupportingEvidence">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FundingApplicationPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Application and Supporting Evidence</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#VerificationDocumentation"/>
        <skos:definition>Documentation comprising the application and supporting evidence for an exceptional learning support claim.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Apprentice -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Apprentice">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Person"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeBursary -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeBursary">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprentice Bursary</rdfs:label>
        <skos:definition>A bursary of £3,000 available to eligible apprentices across apprenticeships.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeCertificate -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeCertificate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RegulatoryDecisionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprentice Certificate</rdfs:label>
        <skos:definition>A certificate awarded to an apprentice upon achieving a mandatory qualification.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeDetails -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeDetails">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeDevelopmentSummary -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeDevelopmentSummary">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprentice Development Summary</rdfs:label>
        <skos:definition>A summary of the knowledge, skills and behaviours that the apprentice has developed and evidenced during their time on their foundation apprenticeship.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00643"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeEnrolmentAdministration -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeEnrolmentAdministration">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprentice Enrolment Administration</rdfs:label>
        <skos:definition>Administration related to the subsequent enrolment (onboarding) of the apprentice. This can include the collection of evidence to support the initial assessment, supporting the employer with their apprenticeship service account and completing the apprenticeship agreement; and developing and agreeing the training plan with the employer and apprentice.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00435"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeInformation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeInformation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprentice Information</rdfs:label>
        <skos:definition>Relevant information about the apprentice required for end-point assessment and certification</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeRate -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeRate">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprentice Rate</rdfs:label>
        <skos:definition>The apprentice rate of pay as referenced in UK apprenticeship regulations.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeRateResource -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeRateResource">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprentice Rate Resource</rdfs:label>
        <skos:definition>The apprentice rate of the national minimum wage as a financial resource.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeRequiringSubstantialReasonableAdjustments -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeRequiringSubstantialReasonableAdjustments">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Apprentice Requiring Substantial Adjustments</rdfs:label>
        <skos:definition>An apprentice who requires substantial reasonable adjustments to start or continue learning.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Apprentice Role</rdfs:label>
        <skos:definition>The role of an apprentice aged 16-18 undertaking a level 3 or higher apprenticeship</skos:definition>
        <skos:definition>The role of an apprentice eligible to receive a bursary.</skos:definition>
        <skos:definition>The role of an apprentice in the UK apprenticeship system.</skos:definition>
        <skos:definition>The role of an apprentice in the UK regulatory context.</skos:definition>
        <skos:definition>The role of an apprentice in the context of UK regulatory provisions.</skos:definition>
        <skos:definition>The role of an apprentice undergoing training within the UK regulatory context.</skos:definition>
        <skos:definition>The role of an apprentice who meets the definition referenced in the provision</skos:definition>
        <skos:definition>The role of an individual undertaking an apprenticeship program.</skos:definition>
        <skos:definition>The role of an individual undertaking an apprenticeship programme.</skos:definition>
        <skos:definition>The role of an individual undertaking an apprenticeship under UK funding rules.</skos:definition>
        <skos:definition>The role of an individual undertaking an apprenticeship under a PAYE scheme employer.</skos:definition>
        <skos:definition>The role of an individual undertaking an apprenticeship, involving training and employment.</skos:definition>
        <skos:definition>The role of an individual undertaking an apprenticeship, typically aged 16-24.</skos:definition>
        <skos:definition>The role of an individual undertaking an apprenticeship.</skos:definition>
        <skos:definition>The role of an individual who is learning a trade or profession under an apprenticeship agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeTrainingAdditionalPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeTrainingAdditionalPayment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprentice Training Additional Payment</rdfs:label>
        <skos:definition>An additional £1,000 payment towards the additional cost associated with training for eligible apprentices.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeWageRate -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeWageRate">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprentice Wage Rate</rdfs:label>
        <skos:definition>The apprentice rate of the national minimum wage as specified in UK regulations.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeWagesBenefits -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeWagesBenefits">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprentice Wages and Benefits</rdfs:label>
        <skos:definition>Apprentice wages / benefits (including wages / costs of backfill arrangements).</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeWithNewlyIdentifiedLDD -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeWithNewlyIdentifiedLDD">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Apprentice with Newly Identified LDD</rdfs:label>
        <skos:definition>this can include an apprentice who has not previously had a learning difficulty or disability identified, but in relation to whom the provider has identified a learning difficulty or disability (as defined in Section 15ZA(6) of the Education Act 1996) that would directly affect the apprentice’s ability to complete their apprenticeship.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00125"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeWithNoPriorLearning -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeWithNoPriorLearning">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Apprentice with No Prior Learning</rdfs:label>
        <skos:definition>An apprentice who has no relevant prior learning for the standard.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeWorkingHoursCondition -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeWorkingHoursCondition">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Apprentice Working Hours Condition</rdfs:label>
        <skos:definition>A condition where the apprentice works fewer than 30 hours a week or has a zero-hours contract at the beginning of the apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticesNeedingLearningSupport -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticesNeedingLearningSupport">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Apprentices Needing Learning Support</rdfs:label>
        <skos:definition>Has a learning difficulty or disability as defined in Section 15ZA(6) of the Education Act 1996 (as amended by section 41 of the Apprenticeships, Skills, Children and Learning Act 2009), who, as a result of this learning difficulty or disability, requires reasonable adjustments in order to be able to complete their apprenticeship, including any reasonable adjustments to complete English and / or maths requirements (this includes where apprentices have opted-in – see paragraph 46) and end-point assessment.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00123"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Apprenticeship -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Apprenticeship">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship</rdfs:label>
        <skos:definition>A DfE funded apprenticeship program.</skos:definition>
        <skos:definition>A structured training program combining work and study, leading to a recognized qualification.</skos:definition>
        <skos:definition>A structured training program combining work and study, regulated under UK apprenticeship rules.</skos:definition>
        <skos:definition>A structured training programme combining work and study, leading to a recognised qualification.</skos:definition>
        <skos:definition>A system of training a new generation of practitioners of a trade or profession with on-the-job training and often some accompanying study.</skos:definition>
        <skos:definition>Accelerated Note added / amended definitions of the following terms: apprenticeship, Active learning, Adult Skills Fund, Apprenticeship service record, Apprenticeship Technical Funding Guide, Care leavers’ bursary, Complete early, Employer incentive payments, End-point assessment, Final day, Foundation apprenticeship, Gateway requirements, (The) Institute, New provider status (APAR), Off-the-job training, On-programme End-point Assessment, Person of significant control, Prior learning, Prison leaver, Published typical duration, Summary of training document, Total negotiated price (TNP).</skos:definition>
        <skos:definition>An apprenticeship is a job with training. Through an apprenticeship, an apprentice will gain the technical knowledge, practical experience and wider skills and behaviours that they need to be competent in their immediate job and future career.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00008"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00241"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01186"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipAgreement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipAgreement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RegulatoryAgreementPattern"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto/uk#Contract"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Agreement</rdfs:label>
        <skos:definition>A complete apprenticeship agreement as defined in the regulatory provision</skos:definition>
        <skos:definition>A contract between an apprentice and their employer for an apprenticeship</skos:definition>
        <skos:definition>A contract of apprenticeship under which an apprentice is employed to learn a trade or profession.</skos:definition>
        <skos:definition>A contract of employment or a written statement of particulars under the Employment Rights Act 1996, which takes the form of an apprenticeship agreement.</skos:definition>
        <skos:definition>A document constituting the apprenticeship agreement</skos:definition>
        <skos:definition>A formal agreement between an employer and an apprentice governing the terms of the apprenticeship</skos:definition>
        <skos:definition>A formal agreement between an employer and an apprentice outlining the terms of the apprenticeship</skos:definition>
        <skos:definition>A formal agreement between the apprentice and the employer outlining the terms of the apprenticeship.</skos:definition>
        <skos:definition>A formal agreement governing an apprenticeship programme.</skos:definition>
        <skos:definition>This is defined in section A1(3) of the Apprenticeships, Skills, Children and Learning Act 2009 (as amended by the Enterprise Act 2016) and the Apprenticeships (Miscellaneous Provisions) Regulations 2017.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00260"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipAgreementAndTrainingPlan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipAgreementAndTrainingPlan">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Agreement and Training Plan</rdfs:label>
        <skos:definition>The apprenticeship agreement and training plan documents that must be updated.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipAgreementCopy -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipAgreementCopy">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Agreement Copy</rdfs:label>
        <skos:definition>A copy of the completed apprenticeship agreement document.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipAgreementFormation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipAgreementFormation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Apprenticeship Agreement Formation</rdfs:label>
        <skos:definition>The act of forming an apprenticeship agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipAgreementTermination -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipAgreementTermination">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Apprenticeship Agreement Termination</rdfs:label>
        <skos:definition>The termination of an apprenticeship agreement</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipAssessment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipAssessment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Assessment</rdfs:label>
        <skos:definition>The assessment process for an apprenticeship, particularly for an integrated degree standard.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipAssessmentCost -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipAssessmentCost">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Assessment Cost</rdfs:label>
        <skos:definition>The cost of the apprenticeship assessment, which must not exceed 20% of the funding band maximum.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipAssessmentDeliveryArrangements -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipAssessmentDeliveryArrangements">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Assessment Delivery Arrangements</rdfs:label>
        <skos:definition>The arrangements for the delivery of ALL elements of apprenticeship assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipAssessmentElement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipAssessmentElement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Assessment Element</rdfs:label>
        <skos:definition>The remaining elements of the apprenticeship assessment as outlined in the assessment plan.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipAssessmentOrganisation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipAssessmentOrganisation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Apprenticeship Assessment Organisation</rdfs:label>
        <skos:definition>The role of an organisation that acts as the assessment organisation for an apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipAssessmentPrice -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipAssessmentPrice">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Assessment Price</rdfs:label>
        <skos:definition>The price that has been agreed for apprenticeship assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipAssessmentProcess -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipAssessmentProcess">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Assessment Process</rdfs:label>
        <skos:definition>The process by which an apprentice is assessed as part of their apprenticeship programme.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipCosts -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipCosts">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Training Costs</rdfs:label>
        <skos:definition>Actual costs of delivery of apprenticeship training and on-programme assessment</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipDelivery -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipDelivery">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Apprenticeship Delivery</rdfs:label>
        <skos:definition>The act of delivering apprenticeship training or services.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipDetails -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipDetails">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Details</rdfs:label>
        <skos:definition>Details of the apprenticeship include the name of the apprenticeship standard, the level, the start and end dates for both the apprenticeship and the practical period of training.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00394"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipDuration -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipDuration">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Duration</rdfs:label>
        <skos:definition>The combined duration of an apprentice&apos;s time on legacy and new apprenticeship versions.</skos:definition>
        <skos:definition>The expected duration of an apprenticeship programme.</skos:definition>
        <skos:definition>The total time period of an apprenticeship, used as a resource for calculating the 50% threshold.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipEmployerAgreement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipEmployerAgreement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Employer Agreement</rdfs:label>
        <skos:definition>The apprenticeship employer agreement between employers and the Secretary of State for Education, which includes the rules governing access to funding through the apprenticeship service.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipFinalPrice -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipFinalPrice">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Final Price</rdfs:label>
        <skos:definition>The final price of the apprenticeship, representing the total cost before any further employer discount is applied.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01184"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Funding</rdfs:label>
        <skos:definition>A monetary resource allocated as part of apprenticeship funding arrangements.</skos:definition>
        <skos:definition>A monetary resource allocated as part of apprenticeship funding provisions.</skos:definition>
        <skos:definition>Financial resources allocated for apprenticeship programs.</skos:definition>
        <skos:definition>Financial resources allocated for apprenticeship training and assessment.</skos:definition>
        <skos:definition>Financial resources allocated for the delivery of apprenticeship training.</skos:definition>
        <skos:definition>Financial resources allocated to fund apprenticeship programs</skos:definition>
        <skos:definition>Financial resources allocated to support apprenticeship training.</skos:definition>
        <skos:definition>Funding for all elements of each apprenticeship, including English and maths.</skos:definition>
        <skos:definition>Funding for an apprenticeship, determined by the availability of levy funds in an employer&apos;s apprenticeship service account each month.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipFundingEvidence -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipFundingEvidence">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Funding Evidence</rdfs:label>
        <skos:definition>Documentation or records that demonstrate appropriate use of apprenticeship funding.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipFundingPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipFundingPayment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Funding Payment</rdfs:label>
        <skos:definition>A 50% payment of apprenticeship funding allocated 90 days after the apprentice&apos;s learning start date, conditional on the apprentice still undertaking their apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipFundingRules -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipFundingRules">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Regulation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#specifiesNorm"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://www.w3id.org/cco/cco#Norm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasValidityStart"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasValidityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Apprenticeship Funding Rules</rdfs:label>
        <skos:definition>The set of regulatory rules governing the funding of apprenticeship delivery.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipHelplineContact -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipHelplineContact">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Helpline Contact</rdfs:label>
        <skos:definition>Contact details for the apprenticeship helpline, including phone number and website.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipLevy -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipLevy">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Levy</rdfs:label>
        <skos:definition>Apprenticeship levy is a levy on UK employers to raise funds to pay for apprenticeship training and assessment, charged at 0.5% of an employer’s pay bill, with each employer receiving an allowance of £15,000 to offset against their levy payment.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01189"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipPayment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Payment</rdfs:label>
        <skos:definition>A payment generated for an apprentice under specific apprenticeship conditions, such as shorter or foundation apprenticeships.</skos:definition>
        <skos:definition>A payment generated for an apprenticeship, subject to calculation rules based on apprenticeship duration and type.</skos:definition>
        <skos:definition>A payment made in relation to an apprenticeship, such as a funding disbursement.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00532"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipPeriod -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipPeriod">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Apprenticeship Period</rdfs:label>
        <skos:definition>The period during which an apprentice is actively on an apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipPracticalPeriod -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipPracticalPeriod">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Practical Period</rdfs:label>
        <skos:definition>A period of practical training required for an apprenticeship, with a minimum duration of 8 months after recognition of prior learning.</skos:definition>
        <skos:definition>The practical period of an apprenticeship, which must meet minimum duration requirements.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipPrice -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipPrice">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Price</rdfs:label>
        <skos:definition>The price agreed or costs claimed for an apprenticeship, including negotiated assessment costs.</skos:definition>
        <skos:definition>The price of the apprenticeship as referenced in the regulatory provision.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipPriceDifference -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipPriceDifference">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Price Difference</rdfs:label>
        <skos:definition>The monetary difference between the total negotiated price of an apprenticeship and the funding band maximum for the standard.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipPriceReduction -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipPriceReduction">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Price Reduction</rdfs:label>
        <skos:definition>A calculated entity representing the mandatory reduction in the total price of apprenticeship funding when an apprentice has 30% prior learning, requiring at least a 15% reduction from the funding band maximum.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00113"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipProgramme -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipProgramme">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EducationalProgramPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Programme</rdfs:label>
        <skos:definition>A structured training programme for apprentices.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipProvider -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipProvider">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Apprenticeship Provider</rdfs:label>
        <skos:definition>An organisation that delivers apprenticeship training and holds apprenticeship funding.</skos:definition>
        <skos:definition>An organisation that provides apprenticeship training and support.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipProviderAndAssessmentRegister -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipProviderAndAssessmentRegister">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Provider and Assessment Register</rdfs:label>
        <skos:definition>Apprenticeship Provider and Assessment Register (APAR) is a record of organisations that:</skos:definition>
        <skos:definition>The Apprenticeship Provider and Assessment Register (APAR) as referenced in UK apprenticeship funding regulations.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01190"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipRecord -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipRecord">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Record</rdfs:label>
        <skos:definition>A record that must include specific minimum details about an apprentice and their apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipRemainingPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipRemainingPayment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Remaining Payment</rdfs:label>
        <skos:definition>A funding resource representing the remaining 50% of an apprenticeship payment, allocated 365 days after the apprentice&apos;s learning start date, conditional on the apprentice still undertaking their apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipRestartReservation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipRestartReservation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Restart Reservation</rdfs:label>
        <skos:definition>A reservation that funds an apprenticeship restart where the apprenticeship was previously funded via contracted provision and following redundancy or provider failure.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipReturnEligibilityCondition -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipReturnEligibilityCondition">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Apprenticeship Return Eligibility Condition</rdfs:label>
        <skos:definition>Condition specifying eligibility criteria for returning to the same apprenticeship after a break in learning or withdrawal, including part-time employment hours (&lt;30 hours per week) and zero-hours employment contracts.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipService -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipService">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Service</rdfs:label>
        <skos:definition>The UK government digital service for managing apprenticeships.</skos:definition>
        <skos:definition>The digital service through which apprenticeship funding is managed and allocated in the UK.</skos:definition>
        <skos:definition>The digital service used to access apprenticeship funding and manage apprenticeships.</skos:definition>
        <skos:definition>The digital service used to manage apprenticeship funding and details.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipServiceAccount -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipServiceAccount">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Service Account</rdfs:label>
        <skos:definition>An account within the apprenticeship service used to manage apprenticeship funding and payments</skos:definition>
        <skos:definition>An employer&apos;s digital account used to manage apprenticeship funding and training.</skos:definition>
        <skos:definition>The area on the apprenticeship service where employers can manage their funding and apprentices, view their account balance and plan their spending.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01191"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipServiceAccountData -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipServiceAccountData">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Service Account Data</rdfs:label>
        <skos:definition>Data entered into the apprenticeship service account as referenced in UK regulatory provisions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipServiceFunds -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipServiceFunds">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Service Funds</rdfs:label>
        <skos:definition>Funds received by providers from an employer&apos;s apprenticeship service account (including government top-ups to funds), government-employer co-investment and additional payments</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipServiceSupport -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipServiceSupport">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Service Support</rdfs:label>
        <skos:definition>The apprenticeship service support authority that providers must contact for approval and technical details.</skos:definition>
        <skos:definition>The support service for the apprenticeship service.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipSoftwareSystemCosts -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipSoftwareSystemCosts">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Software System Costs</rdfs:label>
        <skos:definition>The costs of using an apprenticeship software system to return management information (e.g. salary and on-costs of management information staff and the software licences to operate the MI system).</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00454"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipStandardVersion -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipStandardVersion">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Standard Version</rdfs:label>
        <skos:definition>A specific version of an apprenticeship standard, including its demands and end-point assessment plan requirements.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipStartDate -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipStartDate">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Start Date</rdfs:label>
        <skos:definition>The date on which an apprenticeship formally begins.</skos:definition>
        <skos:definition>The date shown on the apprenticeship agreement marking the start of the apprenticeship.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00270"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipState -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipState">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Apprenticeship State</rdfs:label>
        <skos:definition>A condition representing the state of an apprenticeship, such as being on a shorter or foundation apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipTraining -->


