        <rdf:type rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <cco:hasConditionExpression>A letter from a responsible third party testifying as to the truthfulness of the student’s explanation and providing an independent assessment of the situation. The ‘third party’ could be any of the following: counselor, psychologist, religious advisor, doctor, teacher, and/or mature relative outside the immediate family or family friend (the status of the third party and their relationship to the student must be identified in the letter).</cco:hasConditionExpression>
        <rdfs:label>Eligibility Criteria</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#CAN_UNIT_00380"/>
    </owl:Thing>
    


