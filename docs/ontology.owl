    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AssessmentElement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AssessmentElement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Assessment Element</rdfs:label>
        <skos:definition>Elements of an apprenticeship assessment, including external quality assurance, that must remain independent.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AssessmentOrganisation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AssessmentOrganisation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Assessment Organisation</rdfs:label>
        <skos:definition>An organisation responsible for conducting assessments within the apprenticeship framework.</skos:definition>
        <skos:definition>An organisation responsible for conducting assessments.</skos:definition>
        <skos:definition>An organisation responsible for end-point assessment of apprenticeships.</skos:definition>
        <skos:definition>An organisation selected to conduct assessments for apprentices.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AssessmentOrganisationRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AssessmentOrganisationRole">
