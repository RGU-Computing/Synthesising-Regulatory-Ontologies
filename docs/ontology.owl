    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AssessmentOutcome -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AssessmentOutcome">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Assessment Outcome</rdfs:label>
        <skos:definition>The outcome of an assessment used to determine the starting level for an apprentice.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AwardingBody -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AwardingBody">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EducationalOrganizationPattern"/>
