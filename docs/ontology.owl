    <rdf:Description rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeDetails">
        <rdfs:label>Apprentice Details</rdfs:label>
        <skos:definition>The details of an apprentice that are entered into the apprenticeship service account.</skos:definition>
        <skos:definition>The personal and programme details of an apprentice recorded in the apprenticeship service.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cco-gro/onto/uk#Employer">
        <rdfs:label>Employer</rdfs:label>
        <skos:definition>A person or organization that employs people, in this context the employer of an apprentice.</skos:definition>
        <skos:definition>A person or organization that employs people.</skos:definition>
        <skos:definition>A role for entities that employ individuals and may receive financial assistance.</skos:definition>
        <skos:definition>A role for entities that employ individuals and may receive payments or confirmations.</skos:definition>
        <skos:definition>An employer of an apprentice.</skos:definition>
        <skos:definition>An employer organisation responsible for making a new reservation if the original expires before the apprentice starts.</skos:definition>
        <skos:definition>An organisation that employs an apprentice and is party to an apprenticeship agreement.</skos:definition>
        <skos:definition>An organisation that employs an apprentice and is party to the training plan.</skos:definition>
        <skos:definition>An organisation that employs an apprentice and participates in the apprenticeship programme.</skos:definition>
        <skos:definition>An organisation that employs an apprentice and supports their training.</skos:definition>
        <skos:definition>An organisation that employs an apprentice.</skos:definition>
        <skos:definition>An organisation that employs apprentices and is responsible for ensuring apprenticeship compliance.</skos:definition>
        <skos:definition>An organisation that employs apprentices and is responsible for paying their wages.</skos:definition>
        <skos:definition>An organisation that employs apprentices.</skos:definition>
        <skos:definition>An organisation that employs individuals and enters into agreements with providers.</skos:definition>
        <skos:definition>An organisation that employs individuals and enters into contracts for services.</skos:definition>
        <skos:definition>An organisation that employs individuals and participates in training arrangements.</skos:definition>
        <skos:definition>An organisation that employs individuals, including as an apprenticeship employer.</skos:definition>
        <skos:definition>The employer responsible for the apprenticeship, who must pay the difference when the overall price exceeds the funding band maximum.</skos:definition>
        <skos:definition>The role of an organisation or person employing an apprentice.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerProviderRole">
        <rdfs:label>Employer-Provider Role</rdfs:label>
        <skos:definition>The role of a subcontractor acting as an employer-provider for apprenticeship training</skos:definition>
        <skos:definition>The role of an entity that operates as both an employer and a training provider.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/cco-gro/onto/uk#EmployerRole">
