        <rdfs:label>Event</rdfs:label>
        <skos:definition>An occurrence or happening, especially one of significance, that triggers a normative response.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#Evidence -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#Evidence">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
