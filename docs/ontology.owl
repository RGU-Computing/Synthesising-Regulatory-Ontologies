    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#AwardingOrganisation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#AwardingOrganisation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Awarding Organisation</rdfs:label>
        <skos:definition>An organisation authorised to issue qualifications and certificates.</skos:definition>
        <skos:definition>An organisation that awards qualifications.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#BreakInLearning -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#BreakInLearning">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#LearningPausePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Break in Learning</rdfs:label>
        <skos:definition>A formal pause in a learner&apos;s training programme, recorded by the provider when no off-the-job training active learning is planned within a specified period.</skos:definition>
        <skos:definition>A formal pause in a learner&apos;s training programme, recorded by the provider.</skos:definition>
        <skos:definition>A period during which active learning is suspended.</skos:definition>
        <skos:definition>A period during which an apprentice is on a break from their learning.</skos:definition>
        <skos:definition>A period during which an apprentice&apos;s learning is formally paused, typically used when no off-the-job training active learning is planned within a calendar month.</skos:definition>
        <skos:definition>A status indicating that an apprentice&apos;s learning has been temporarily paused.</skos:definition>
        <skos:definition>When an individual takes a break of at least a clear calendar month from their apprenticeship but plans to return to it in the future.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01192"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#BroadAgreement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#BroadAgreement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Broad Agreement</rdfs:label>
        <skos:definition>An initial agreement of broad content, such as an email from the employer, evidencing consent to a training plan.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#BursaryResource -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#BursaryResource">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Bursary Resource</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#FinancialResource"/>
        <skos:definition>A financial bursary resource allocated to eligible apprentices.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#CareLeaverBursary -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#CareLeaverBursary">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Care Leaver Bursary</rdfs:label>
        <skos:definition>A care leaver bursary claimed under the provision.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#CareLeaversBursary -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#CareLeaversBursary">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Care Leavers Bursary</rdfs:label>
        <rdfs:label>Care Leavers&apos; Bursary</rdfs:label>
        <rdfs:label>Care Leavers’ Bursary</rdfs:label>
        <skos:definition>A bursary available to learners who have been in care.</skos:definition>
        <skos:definition>A bursary provided to care leaver apprentices to support their training costs.</skos:definition>
        <skos:definition>A bursary provided to care leavers to support their apprenticeship.</skos:definition>
        <skos:definition>A bursary provided to eligible apprentices who are care leavers, as defined in paragraphs 108 and 110 of the relevant regulation.</skos:definition>
        <skos:definition>A bursary specifically for care leavers participating in apprenticeships.</skos:definition>
        <skos:definition>A one-off financial bursary provided to eligible care leaver apprentices.</skos:definition>
        <skos:definition>A tax-free payment to acknowledge the additional financial burden that care leavers encounter when living in, or leaving, care, and not treated as income in Universal Credit calculations.</skos:definition>
        <skos:definition>Care leavers’ bursary is an additional £3,000 payment (paid in 3 instalments) that we pay to apprentices who are in care or are care leavers, and who started their apprenticeship training on or after 1</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01193"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#CareLeaversBursaryPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#CareLeaversBursaryPayment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Care Leavers Bursary Payment</rdfs:label>
        <rdfs:label>Care Leavers’ Bursary Payment</rdfs:label>
        <skos:definition>A bursary payment made to care leavers who are apprentices.</skos:definition>
        <skos:definition>A final bursary payment for care leavers on apprenticeship standards with a published typical duration of less than 12 months, and for foundation apprenticeships.</skos:definition>
        <skos:definition>A final bursary payment for care leavers, confirmed for apprenticeship standards with a published typical duration of less than 12 months and for foundation apprenticeships.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ChangeOfCircumstanceOverPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ChangeOfCircumstanceOverPayment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Change of Circumstance Over-payment</rdfs:label>
        <skos:definition>A condition where a change of circumstance results in over-payment of funds from an employer&apos;s apprenticeship service account or government-employer co-investment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ChangingToNewVersionRules -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ChangingToNewVersionRules">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Changing to New Version Rules</rdfs:label>
        <skos:definition>The set of rules titled &apos;Changing to a new version of a standard&apos; referenced in paragraphs 294 to 308.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#CoInvestment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#CoInvestment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Co-Investment</rdfs:label>
        <rdfs:label>Co-investment</rdfs:label>
        <rdfs:label>Mandatory Co-investment</rdfs:label>
        <skos:definition>A financial contribution paid by the receiving employer to the main provider for apprenticeship training costs when levy funds are insufficient or exhausted.</skos:definition>
        <skos:definition>Any mandatory co-investment due for training or end-point assessment already delivered.</skos:definition>
        <skos:definition>Co-investment is where the government shares the cost of training and assessing apprentices with employers. For apprenticeship training that started on or after 1 April 2019, employers (who either do not pay the levy or levy payers who have run out of levy funds) pay 5% towards the cost of apprenticeship training. The government will pay the rest (95%) up to the funding band maximum.</skos:definition>
        <skos:definition>The matching co-investment amount collected from employers by main providers for apprenticeships.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01194"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#CoInvestmentAmount -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#CoInvestmentAmount">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Co-Investment Amount</rdfs:label>
        <skos:definition>The relevant amount of the total negotiated price, up to the funding band maximum, towards the cost of apprenticeship training and assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#CoInvestmentPercentage -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#CoInvestmentPercentage">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Co-investment Percentage</rdfs:label>
        <skos:definition>This percentage represents the amount of co-investment the employer would have otherwise had to contribute towards the apprenticeship, if funds had not been transferred.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00728"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#CoInvestmentWaiver -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#CoInvestmentWaiver">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Co-investment Waiver</rdfs:label>
        <skos:definition>A waiver of the co-investment contribution required from an employer for apprenticeship funding.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#CompletionPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#CompletionPayment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Completion Payment</rdfs:label>
        <skos:definition>A payment made to a main provider upon completion of apprenticeship training, as described in paragraph 161.</skos:definition>
        <skos:definition>Completion payment is a payment we make to providers when an apprentice completes all their learning and undertakes the end-point assessment (the apprentice does not need to pass). This payment is 20% of either the total negotiated price or the funding band maximum, whichever is lower.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01195"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ConfirmationOfPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ConfirmationOfPayment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Confirmation of Payment</rdfs:label>
        <skos:definition>A statement or document confirming that a payment has been sent or received.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ConnectedCompanyOrCharity -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ConnectedCompanyOrCharity">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Connected Company or Charity</rdfs:label>
        <skos:definition>Companies or charities whose PAYE scheme the employer has connected to their apprenticeship service account in accordance with HMRC&apos;s definition of connected companies and charities.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00034"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ContinuedFundingEligibility -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ContinuedFundingEligibility">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Continued Funding Eligibility</rdfs:label>
        <skos:definition>The state of being eligible for continued funding for apprentices made redundant near the end of their apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Contract -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Contract">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RegulatoryAgreementPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Contract</rdfs:label>
        <skos:definition>A formal agreement between parties, such as a provider and an assessment organisation.</skos:definition>
        <skos:definition>A formal agreement between parties, such as between a provider and an assessment organisation.</skos:definition>
        <skos:definition>A legally binding agreement between two or more parties, including apprenticeship agreements.</skos:definition>
        <skos:definition>A legally binding agreement between two or more parties, such as a contract for services between a provider and an employer.</skos:definition>
        <skos:definition>A legally binding agreement between two or more parties.</skos:definition>
        <skos:definition>A signed and dated contract for services between a provider and an employer, including details of price reduction, negotiation, employer contribution, and co-investment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ContractForServices -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ContractForServices">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Contract for Services</rdfs:label>
        <skos:definition>A contract between a contractor and a client (e.g. a provider and an employer).</skos:definition>
        <skos:definition>A contract for services related to an apprenticeship.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01196"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ContractingAuthority -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ContractingAuthority">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Contracting Authority</rdfs:label>
        <skos:definition>An organisation subject to public procurement regulations, such as the Public Contracts Regulations 2015.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ContractualAgreementInPlace -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ContractualAgreementInPlace">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Contractual Agreement In Place</rdfs:label>
        <skos:definition>A state where a contractual agreement has been established between relevant parties.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#CorporateEntity -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#CorporateEntity">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Corporate Entity</rdfs:label>
        <skos:definition>A limited company, public services company, partnership, or limited liability partnership created to act as a separate legal entity.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#CostPriceChange -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#CostPriceChange">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Cost and Price Change</rdfs:label>
        <skos:definition>The cost and/or price associated with an end-point assessment that may be changed or re-negotiated.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#DaysInLearningAggregate -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#DaysInLearningAggregate">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Days in Learning Aggregate</rdfs:label>
        <skos:definition>A calculated resource representing the sum of days in learning with a first employer and days in learning with a new employer, used to determine when subsequent payments are due.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00625"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#DefinedTerm -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#DefinedTerm">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Costs Definition</rdfs:label>
        <rdfs:label>Defined Term</rdfs:label>
        <rdfs:label>Fees Retained and Charges Definition</rdfs:label>
        <rdfs:label>Main providers and employer-providers</rdfs:label>
        <rdfs:label>Mentoring</rdfs:label>
        <skos:definition>Costs include any co-investment or additional training and assessment costs above the funding band, that the employer has paid directly to the provider, where this is part of the agreed apprenticeship.</skos:definition>
        <skos:definition>Main providers and employer-providers receiving funding for delivering apprenticeship training and on-programme assessment in England</skos:definition>
        <skos:definition>Mentoring must meet the definition of off-the-job training (new learning, relevant to the apprenticeship, not English and maths, delivered within normal working hours) and be documented in the training plan. The mentor must be a more senior or experienced member of staff. This does not include general line management. The apprentice must not be doing productive work.</skos:definition>
        <skos:definition>The full range of fees retained by the provider and charges (which must be eligible costs) that apply, including funding retained for managing quality assurance / oversight and for administrative functions such as data returns.</skos:definition>
        <skos:definition>These rules form part of the terms and conditions for the use of funds in an employer’s apprenticeship service account or for government-employer co-investment.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00005"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00013"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00715"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00777"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01209"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#DfEFundedCourse -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#DfEFundedCourse">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EducationalProgramPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>DfE Funded Course</rdfs:label>
        <skos:definition>An existing course funded by the Department for Education.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#DiscussShareAction -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#DiscussShareAction">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Discuss or Share Action</rdfs:label>
        <skos:definition>The act of discussing or sharing information with relevant parties to ensure mutual understanding.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#DiscussionSummary -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#DiscussionSummary">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Discussion Summary</rdfs:label>
        <skos:definition>A document summarizing the discussion between parties in an apprenticeship context.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Document -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Document">
