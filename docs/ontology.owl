        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Document</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#Document"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DocumentationItem"/>
        <skos:definition>A written or electronic record of information.</skos:definition>
        <skos:definition>A written or printed record that provides evidence or information.</skos:definition>
        <skos:definition>A written or recorded piece of information that serves as evidence or a record.</skos:definition>
        <skos:definition>A written, printed, or electronic record that provides information or evidence.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#DocumentExchange -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#DocumentExchange">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Document Exchange</rdfs:label>
        <skos:definition>The action of sending a document via a document exchange system.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#DoubleFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#DoubleFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Double Funding</rdfs:label>
        <skos:definition>Double funding is where multiple funding sources are used for the same activity.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01198"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Duration -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Duration">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Duration</rdfs:label>
        <skos:definition>The length of time set for an apprenticeship programme.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EASAdditionalCosts -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EASAdditionalCosts">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>EAS Additional Costs</rdfs:label>
        <skos:definition>Additional costs claimable via the earnings adjustment statement (EAS) when the cost exceeds £150 per month but is less than £19,000 per annum.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EHCP -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EHCP">
