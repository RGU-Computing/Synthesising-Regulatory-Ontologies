    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Withdrawal -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Withdrawal">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Withdrawal</rdfs:label>
        <skos:definition>Withdrawal is when an apprentice leaves or stops taking part in their apprenticeship before they have completed it.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01219"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#WorkingHours -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#WorkingHours">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Working Hours</rdfs:label>
        <skos:definition>The hours worked by an apprentice that may be counted toward the 50% limit.</skos:definition>
        <skos:definition>The hours worked by an apprentice, which must be considered when setting the duration of off-the-job training.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#WrittenAgreement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#WrittenAgreement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Written Agreement</rdfs:label>
        <skos:definition>A written agreement between the main provider and the employer setting out and confirming the delivery of their apprenticeship programme.</skos:definition>
        <skos:definition>The employer&apos;s written agreement document.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#WrittenEvidence -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#WrittenEvidence">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Written Evidence</rdfs:label>
