    <rdf:Description rdf:about="https://w3id.org/cco-gro/onto/uk#Apprentice">
        <rdfs:label>Apprentice</rdfs:label>
        <skos:definition>A person undertaking an apprenticeship programme.</skos:definition>
        <skos:definition>A person undertaking an apprenticeship who may be eligible for funding claims.</skos:definition>
        <skos:definition>A person undertaking an apprenticeship.</skos:definition>
        <skos:definition>A person who is learning a trade from a skilled employer, having agreed to work for a fixed period at low wages.</skos:definition>
        <skos:definition>A person who is learning a trade from a skilled employer.</skos:definition>
        <skos:definition>A person who is undertaking an apprenticeship programme.</skos:definition>
        <skos:definition>A role of an individual who is learning a trade under an apprenticeship program.</skos:definition>
        <skos:definition>An individual engaged in apprenticeship training, assessment, or end-point assessment.</skos:definition>
        <skos:definition>An individual undertaking an apprenticeship program</skos:definition>
        <skos:definition>An individual undertaking an apprenticeship programme, including study of English and/or maths.</skos:definition>
        <skos:definition>An individual undertaking an apprenticeship programme.</skos:definition>
        <skos:definition>An individual undertaking an apprenticeship, combining work with study under a formal training agreement.</skos:definition>
        <skos:definition>An individual undertaking an apprenticeship.</skos:definition>
        <skos:definition>The role of an individual undertaking an apprenticeship.</skos:definition>
