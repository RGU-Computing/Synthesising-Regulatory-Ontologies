        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Institution</rdfs:label>
        <skos:definition>An educational institution participating in federal student aid programs.</skos:definition>
        <skos:definition>An educational institution role as referenced in regulatory provisions.</skos:definition>
        <skos:definition>An educational institution subject to FAFSA Simplification Act obligations.</skos:definition>
        <skos:definition>An educational institution subject to regulatory provisions.</skos:definition>
        <skos:definition>An educational institution subject to the FAFSA Simplification Act provisions.</skos:definition>
        <skos:definition>An educational institution subject to the regulatory provision.</skos:definition>
        <skos:definition>An educational institution that administers federal student aid programs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#InstitutionRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#InstitutionRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Institution Role</rdfs:label>
        <skos:definition>The role of an educational institution responsible for administering financial aid and complying with regulatory obligations.</skos:definition>
        <skos:definition>The role of an educational institution responsible for administering financial aid and making professional judgment decisions.</skos:definition>
        <skos:definition>The role of an educational institution responsible for administering financial aid programs.</skos:definition>
        <skos:definition>The role of an educational institution responsible for verifying FAFSA applications under Title IV regulations.</skos:definition>
        <skos:definition>The role of an educational institution responsible for verifying student applications.</skos:definition>
        <skos:definition>The role of an institution in the context of Title IV financial aid administration.</skos:definition>
        <skos:definition>The role of an institution in the context of federal student aid verification.</skos:definition>
        <skos:definition>The role of an institution that uses a verification document and is subject to the obligation to ensure its completeness and signature.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#InterimDisbursement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#InterimDisbursement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Interim Disbursement</rdfs:label>
        <skos:definition>A disbursement of Title IV funds made on an interim basis before final determination of student eligibility, including completion of verification.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#LateDisbursement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#LateDisbursement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Late Disbursement</rdfs:label>
        <skos:definition>A disbursement of financial aid made after the student&apos;s eligibility period has ended</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#LegalDependent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#LegalDependent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Legal Dependent</rdfs:label>
        <skos:definition>A person who qualifies as a legal dependent for purposes such as financial aid or tax benefits.</skos:definition>
        <skos:definition>Students who have legal dependents are independent. Legal dependents include children or other people (except a spouse) who meet all the following criteria: They live with the student (or, in the case of children, live apart from the student due to a qualifying temporary absence under IRS code, such as living apart due to college enrollment). They currently receive more than half of their support from the student. They will continue to receive more than half of their support from the student between July 1, 2025, and June 30, 2026.</skos:definition>
        <skos:definition>When a student completes a FAFSA form after the award year has begun and indicates they have a legal dependent who is not the student&apos;s child, the support already given by the student during the award year plus the future support for the remainder of the award year must total more than 50% for the whole award year for the individual to meet the definition of a legal dependent.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00057"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00379"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#MeansTestedBenefitProgram -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#MeansTestedBenefitProgram">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Means-Tested Benefit Program</rdfs:label>
        <skos:definition>A Federal benefit program that uses means testing to determine eligibility</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#MeansTestedFederalBenefit -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#MeansTestedFederalBenefit">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Means-Tested Federal Benefit</rdfs:label>
        <skos:definition>A federal benefit program that is means-tested, as listed in Chapter 2.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#MinimumPellGrant -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#MinimumPellGrant">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Minimum Pell Grant</rdfs:label>
        <skos:definition>A grant resource representing the Minimum Pell Grant under HEA Sec. 474-479.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#NotSingleParent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#NotSingleParent">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Not Single Parent</rdfs:label>
        <skos:definition>A condition of not being a single parent</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#NotaryCertification -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#NotaryCertification">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Notary Certification</rdfs:label>
        <skos:definition>A certification from a notary public that the student appeared before the notary and presented a government-issued photo ID confirming their identity.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#NotaryPublic -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#NotaryPublic">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Notary Public</rdfs:label>
        <skos:definition>A role of a person authorized to perform certain legal formalities, especially to witness signatures on documents.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#ParentsAvailableIncome -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#ParentsAvailableIncome">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialNeedAssessmentInputPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Parents&apos; Available Income</rdfs:label>
        <skos:definition>Parents&apos; available income is calculated by subtracting certain allowances from the parents&apos; total income. These allowances account for certain nondiscretionary expenses, such as taxes and basic living expenses. Once a minimum level of support has been offset for those expenses, the formula assumes that the remaining income is available for discretionary purposes, including paying for a postsecondary education. The available income can be a negative number.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00179"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#ParentsContribution -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#ParentsContribution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialNeedAssessmentInputPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Parents&apos; Contribution</rdfs:label>
        <skos:definition>The calculated amount representing the portion of parental income and assets considered available to help pay for the student&apos;s college education, as determined under the 2025-26 Student Aid Index (SAI) and Pell Grant Eligibility Guide.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00184"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#ParentsContributionFromAssets -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#ParentsContributionFromAssets">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialNeedAssessmentInputPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Parents Contribution from Assets</rdfs:label>
        <skos:definition>A calculated amount representing the contribution from the assets of parents of a dependent student, determined by adding cash, savings, checking, time deposits, money market funds, net worth of investments, and adjusted net worth of business and/or investment farm.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#ParentsTotalIncome -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#ParentsTotalIncome">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Parents Total Income</rdfs:label>
        <skos:definition>The total income of parents as calculated for student aid purposes, subject to offsets and allowances defined in regulation.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00181"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#PellGrant -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#PellGrant">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Pell Grant</rdfs:label>
        <skos:definition>A Pell Grant, a form of undergraduate federal student aid.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#PellGrantEligibility -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#PellGrantEligibility">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Pell Grant Eligibility</rdfs:label>
        <skos:definition>The state of being eligible to receive a Pell Grant for a given award year.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#PellGrantMoney -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#PellGrantMoney">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Pell Grant Money</rdfs:label>
        <skos:definition>Financial resources disbursed under the Pell Grant program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#PellGrantRecalculation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#PellGrantRecalculation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Pell Grant Recalculation</rdfs:label>
        <skos:definition>A structural rule defining the recalculation of a Pell Grant when FAFSA data changes, using the corrected valid FAFSA Submission Summary or ISIR.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00300"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#PertinentFinancialInformation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#PertinentFinancialInformation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Pertinent Financial Information</rdfs:label>
        <skos:definition>Financial information such as spousal income and taxes paid that must be updated to reflect marital status changes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#PrepaidTuitionPlan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#PrepaidTuitionPlan">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Prepaid Tuition Plan</rdfs:label>
        <skos:definition>Prepaid tuition plans allow a person to buy tuition credits or certificates, which count as units of attendance. They are an asset of the plan owner, and their worth is the refund value of the credits or certificates.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00097"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#ProfessionalJudgmentDecisionReason -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#ProfessionalJudgmentDecisionReason">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Professional Judgment Decision Reason</rdfs:label>
        <skos:definition>The documented rationale for an institution&apos;s decision to approve or deny a request for professional judgment and any subsequent adjustments.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#ProvisionalIndependentStatus -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#ProvisionalIndependentStatus">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Provisional Independent Status</rdfs:label>
        <skos:definition>A temporary status assigned to a student who claims unusual circumstances and does not provide parental data on the FAFSA, pending further review.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#ProvisionalSAICalculation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#ProvisionalSAICalculation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Provisional SAI Calculation</rdfs:label>
        <skos:definition>A provisional Student Aid Index calculation generated when a student applies without parental data under unusual circumstances.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#RegulatoryAuthorityAgent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#RegulatoryAuthorityAgent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#JurisdictionalRegulatorPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#Agent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                        <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Regulatory Authority Agent</rdfs:label>
        <skos:definition>An agent acting as a regulatory authority within the US jurisdiction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#RequiredContributor -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#RequiredContributor">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Required Contributor</rdfs:label>
        <skos:definition>A person, such as a parent or spouse, who is required to provide information on a student&apos;s FAFSA application.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#SAIResource -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#SAIResource">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Aid Index</rdfs:label>
        <skos:definition>The Student Aid Index (SAI) resulting from professional judgment adjustments, used for Title IV aid eligibility.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#School -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#School">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EducationalOrganizationPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>School</rdfs:label>
        <skos:definition>An educational institution authorized to participate in federal student aid programs.</skos:definition>
        <skos:definition>An educational institution subject to Title IV verification requirements.</skos:definition>
        <skos:definition>An educational institution that administers financial aid programs.</skos:definition>
        <skos:definition>An educational institution that participates in Title IV federal student aid programs.</skos:definition>
        <skos:definition>An educational institution that provides instruction and may administer federal student aid programs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#SchoolOrDepartmentAuthority -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#SchoolOrDepartmentAuthority">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>School or Department Authority</rdfs:label>
        <skos:definition>The authority held by a school or the Department of Education to specify deadlines for documentation submission.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#Signature -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#Signature">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Signature</rdfs:label>
        <skos:definition>A required signature on worksheets or copies of tax returns that must be collected at the time of verification.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00311"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#SignedStatement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#SignedStatement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Signed Statement</rdfs:label>
        <skos:definition>A signed statement listing sources of income and amounts, including estimated AGI and tax paid if self-employed.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#SingleParent -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#SingleParent">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Single Parent</rdfs:label>
        <skos:definition>A condition of being a single parent</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#SpecialCircumstances -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#SpecialCircumstances">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#CircumstanceConditionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Special Circumstances</rdfs:label>
        <skos:definition>Special Circumstances refer to the financial situations (loss of a job, etc.) that justify an aid administrator adjusting data elements in the COA or in the SAI calculation.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00322"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#StateFinancialAid -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#StateFinancialAid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>State Financial Aid</rdfs:label>
        <skos:definition>Financial aid provided by a U.S. state to eligible students, including grants and other assistance programs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#StatementOfEducationalPurpose -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#StatementOfEducationalPurpose">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Statement of Educational Purpose</rdfs:label>
        <skos:definition>A document certifying the student&apos;s identity and that federal student aid will only be used for educational purposes and the cost of attending the school for the 2025-26 year.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#StepparentIncomeAndAssets -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#StepparentIncomeAndAssets">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Stepparent Income and Assets</rdfs:label>
        <skos:definition>The income and assets of a new stepparent that are excluded from the student&apos;s financial aid calculation under this exception.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00293"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#Student -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#Student">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Student</rdfs:label>
        <skos:definition>A person enrolled in an educational institution who is eligible to apply for federal student aid.</skos:definition>
        <skos:definition>A person enrolled in an educational institution who may apply for financial aid.</skos:definition>
        <skos:definition>A person enrolled in an educational institution, eligible for Title IV aid programs.</skos:definition>
        <skos:definition>A person enrolled in an educational institution.</skos:definition>
        <skos:definition>A person enrolled in an educational program</skos:definition>
        <skos:definition>A role of an individual enrolled in an educational program</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#StudentAidIndex -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#StudentAidIndex">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Aid Index</rdfs:label>
        <skos:definition>The Student Aid Index (SAI) is a calculated value representing a student&apos;s financial need for postsecondary education, determined by adding available income and contribution from assets, then applying progressive rates from Table C6 (22% to 47%) as adjusted available income increases.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00208"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#StudentApplication -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#StudentApplication">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Application</rdfs:label>
        <skos:definition>An application submitted by a student for financial aid or other educational benefits.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#StudentAvailableIncome -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#StudentAvailableIncome">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Available Income</rdfs:label>
        <skos:definition>The student&apos;s available income used as the basis for calculating the student&apos;s contribution from income.</skos:definition>
        <skos:definition>The student&apos;s available income, calculated by subtracting certain allowances from the student&apos;s total income.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00186"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00189"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#StudentContributionFromIncome -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#StudentContributionFromIncome">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialNeedAssessmentInputPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Contribution from Income</rdfs:label>
        <skos:definition>The calculated amount representing a student&apos;s contribution from income, determined by multiplying the student&apos;s available income by the assessment rate of 50%, which may be a negative number as low as -1,500.</skos:definition>
        <skos:definition>The student&apos;s contribution from income, calculated by multiplying the student&apos;s (and spouse&apos;s) available income by the assessment rate of 50%, which may be a negative number.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00189"/>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00197"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#StudentNotQualifyingForMaxOrCalcPell -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#StudentNotQualifyingForMaxOrCalcPell">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Student Not Qualifying for Max/Calc Pell</rdfs:label>
        <skos:definition>A student role for individuals who do not qualify for a Maximum Pell Grant or a calculated Pell Grant because their SAI is too high.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#StudentRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#StudentRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentRolePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Student Role</rdfs:label>
        <skos:definition>The role of a student enrolled in an educational institution.</skos:definition>
        <skos:definition>The role of a student enrolled in an educational program</skos:definition>
        <skos:definition>The role of a student required to submit documentation for income verification purposes.</skos:definition>
        <skos:definition>The role of an individual enrolled in an educational institution, eligible for financial aid programs.</skos:definition>
        <skos:definition>The role of an individual enrolled in an educational program, subject to verification requirements for Pell Grant eligibility.</skos:definition>
        <skos:definition>The role of an individual enrolled in an educational program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#StudentTotalIncome -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#StudentTotalIncome">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Total Income</rdfs:label>
        <skos:definition>The total income of a student, which is decreased by the sum of income offsets and reduced by the sum of income allowances as specified in the calculation rule.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00188"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#SubsidizedTitleIVAid -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#SubsidizedTitleIVAid">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Subsidized Title IV Aid</rdfs:label>
        <skos:definition>Federal student aid under Title IV that is subsidized, including Federal Work-Study, for which verification is required.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#TitleIVAid -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#TitleIVAid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Title IV Aid</rdfs:label>
        <skos:definition>Federal student financial assistance provided under Title IV of the Higher Education Act.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#TotalIncome -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#TotalIncome">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Total Income</rdfs:label>
        <skos:definition>The student&apos;s (and spouse&apos;s) total income, which is decreased by the sum of specified offsets and allowances.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00204"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#USDepartmentOfAgriculture -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#USDepartmentOfAgriculture">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>U.S. Department of Agriculture</rdfs:label>
        <skos:definition>The United States Department of Agriculture, a federal executive department responsible for developing and executing federal laws related to farming, forestry, rural economic development, and food.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#UndergraduateAid -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#UndergraduateAid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Undergraduate Aid</rdfs:label>
        <skos:definition>Other forms of undergraduate federal student aid, excluding Pell Grants.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#UnemploymentBenefitsDocumentation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#UnemploymentBenefitsDocumentation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Unemployment Benefits Documentation</rdfs:label>
        <skos:definition>Paper or electronic documentation of receipt of unemployment benefits or confirmation of application submission.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#UnsubsidizedTitleIVAid -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#UnsubsidizedTitleIVAid">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Unsubsidized Title IV Aid</rdfs:label>
        <skos:definition>Federal student aid under Title IV that is unsubsidized, for which verification is not required except as noted.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#VerificationDeadline -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#VerificationDeadline">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Verification Deadline</rdfs:label>
        <skos:definition>The deadline for verification for a given award year, after which signatures cannot be collected.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00311"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#VerificationDocument -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#VerificationDocument">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Verification Document</rdfs:label>
        <skos:definition>A document used for verification purposes, which must be signed, completed, and accompanied by relevant tax or alternative documents.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#VerificationDocumentation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#VerificationDocumentation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Verification Documentation</rdfs:label>
        <skos:definition>Documentation submitted by a student to verify eligibility for aid</skos:definition>
        <skos:definition>Documents required to verify a student&apos;s FAFSA information.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#VerificationInformation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#VerificationInformation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#StudentProceduralResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Verification Information</rdfs:label>
        <skos:definition>Information provided to students selected for verification, including role explanation, deadlines, consequences, notification methods, and procedures.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#VerificationSelectionCondition -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#VerificationSelectionCondition">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Verification Selection Condition</rdfs:label>
        <skos:definition>A condition where students are selected for verification of their financial aid application information.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/us#W2FormCopy -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/us#W2FormCopy">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>W-2 Form Copy</rdfs:label>
        <skos:definition>A copy of IRS Form W-2 for each source of employment income.</skos:definition>
    </owl:Class>
    


    <!-- https://www.w3id.org/cco/cco#Action -->


    <owl:Class rdf:about="https://www.w3id.org/cco/cco#Action">
        <rdfs:label>Action</rdfs:label>
        <skos:definition xml:lang="en">An action is an activity or behaviour that a norm requires, permits, or prohibits.</skos:definition>
    </owl:Class>
    


    <!-- https://www.w3id.org/cco/cco#Agent -->


    <owl:Class rdf:about="https://www.w3id.org/cco/cco#Agent">
        <rdfs:label xml:lang="en">Agent</rdfs:label>
        <skos:definition xml:lang="en">An agent is an entity that can perform actions, hold roles, and be subject to regulatory or compliance requirements.</skos:definition>
    </owl:Class>
    


    <!-- https://www.w3id.org/cco/cco#Condition -->


    <owl:Class rdf:about="https://www.w3id.org/cco/cco#Condition">
        <rdfs:label xml:lang="en">Condition</rdfs:label>
        <skos:definition xml:lang="en">A condition is a criterion that determines the applicability of a norm or exception.</skos:definition>
    </owl:Class>
    


    <!-- https://www.w3id.org/cco/cco#Exception -->


    <owl:Class rdf:about="https://www.w3id.org/cco/cco#Exception">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasCondition"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#modifiesNorm"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://www.w3id.org/cco/cco#Norm"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasCondition"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#modifiesNorm"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://www.w3id.org/cco/cco#Norm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://www.w3id.org/cco/cco#Norm"/>
        <rdfs:label xml:lang="en">Exception</rdfs:label>
        <skos:definition xml:lang="en">An exception is a normative statement that modifies the applicability or force of a norm in a particular case.</skos:definition>
    </owl:Class>
    


    <!-- https://www.w3id.org/cco/cco#Norm -->


    <owl:Class rdf:about="https://www.w3id.org/cco/cco#Norm">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasApplicabilityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
