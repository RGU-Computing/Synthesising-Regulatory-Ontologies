        <rdfs:label>Assistive Technology</rdfs:label>
        <skos:definition>Assistive technology equipment loaned under the PPL program.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#AviationProgramFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#AviationProgramFunding">
