    <!-- https://w3id.org/cco-gro/onto/uk#ProviderAdditionalPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ProviderAdditionalPayment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Provider Additional Payment</rdfs:label>
        <skos:definition>A payment made to a training provider in addition to standard funding, based on eligibility criteria.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ProviderEmployeeOrAgentRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ProviderEmployeeOrAgentRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Provider Employee or Agent Role</rdfs:label>
        <skos:definition>The role of an individual who is employed by or acting on behalf of the provider.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ProviderEmployer -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ProviderEmployer">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Provider and Employer</rdfs:label>
        <skos:definition>An organisation that acts as both a provider and an employer in the context of regulated agreements.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ProviderEmployerRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ProviderEmployerRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Provider and Employer Role</rdfs:label>
        <skos:definition>The combined role of providers and employers who must refer to Annex C for apprenticeship standards.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ProviderManagementControlEntitlement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ProviderManagementControlEntitlement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Provider Management Control Entitlement</rdfs:label>
        <skos:definition>An entitlement by the provider to exercise management controls over the subcontractor’s activity, including access by auditors appointed by either the provider or by us.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00812"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ProviderOrEmployer -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ProviderOrEmployer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#TrainingProviderOrEmployerPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Provider or Employer</rdfs:label>
        <skos:definition>An organisation that is either a training provider or an employer, as referenced in the regulatory provision.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ProviderOrganisation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ProviderOrganisation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Provider Organisation</rdfs:label>
        <skos:definition>The provider&apos;s organisation that provides services to the subcontractor.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ProviderRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ProviderRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ProviderSubcontractorInductionActivities -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ProviderSubcontractorInductionActivities">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Provider / Subcontractor Induction Activities</rdfs:label>
        <skos:definition>Provider / subcontractor induction activities may include outlining behaviour expectations and issuing the apprentice with any workbooks, contact details, logins and passwords.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00471"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ProxyEmployerRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ProxyEmployerRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Proxy Employer Role</rdfs:label>
        <skos:definition>A role allowing a main provider to act as a proxy employer for providing employer competency statements.</skos:definition>
        <skos:definition>A role allowing a main provider to act as a proxy employer for the purposes of providing an employer competency statement.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#PublicContractsRegulations2015 -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#PublicContractsRegulations2015">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Regulation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#specifiesNorm"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://www.w3id.org/cco/cco#Norm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasValidityStart"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasValidityEnd"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Public Contracts Regulations 2015</rdfs:label>
        <skos:definition>The UK statutory instrument that regulates public procurement by contracting authorities.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#PublishedMinimumRequiredHours -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#PublishedMinimumRequiredHours">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Published Minimum Required Hours</rdfs:label>
        <skos:definition>The published minimum required hours of training or education that must be delivered.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#QualificationDetails -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#QualificationDetails">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Qualification Details</rdfs:label>
        <skos:definition>Details of a qualification, or units thereof, achieved in the context of a foundation apprenticeship having a mandatory qualification.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#QualifyingDayPeriod -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#QualifyingDayPeriod">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Qualifying Day Period</rdfs:label>
        <skos:definition>The 42-day qualifying day period by which the signed training plan must be in place.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#QualityFrameworkForFlexiJobApprenticeshipAgencies -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#QualityFrameworkForFlexiJobApprenticeshipAgencies">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Quality Framework for Flexi-Job Apprenticeship Agencies</rdfs:label>
        <skos:definition>Quality Framework for Flexi-Job Apprenticeship Agencies is the framework set out by the Department that includes Quality Indicators to which the Flexi-Job Apprenticeship Agency must adhere, as updated and amended from time to time.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01217"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ReasonableAdjustmentFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ReasonableAdjustmentFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Reasonable Adjustment Funding</rdfs:label>
        <skos:definition>Funding allocated to a provider for reasonable adjustments that are necessary, delivered, evidenced, and reported in the ILR.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ReasonableAdjustmentPlan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ReasonableAdjustmentPlan">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto/uk#Document"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Reasonable Adjustment Plan</rdfs:label>
        <skos:definition>A documented plan outlining how necessary reasonable adjustments will be delivered throughout an apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ReceivingEmployer -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ReceivingEmployer">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Receiving Employer</rdfs:label>
        <skos:definition>An employer who receives a transfer of levy funds and assumes responsibility for the apprenticeship.</skos:definition>
        <skos:definition>An employer who receives apprenticeship services and is subject to funding rules.</skos:definition>
        <skos:definition>Employers (levy or non-levy paying) who receive a transfer of apprenticeship funds from a levy-paying employer.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01221"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ReceivingEmployerRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ReceivingEmployerRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Receiving Employer Role</rdfs:label>
        <skos:definition>The role of an employer who receives an apprentice and is obligated to pay co-investment under certain conditions.</skos:definition>
        <skos:definition>The role of an employer who receives transfer funds in the context of apprenticeship funding.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#RecordOfApprenticeshipPartCompletion -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#RecordOfApprenticeshipPartCompletion">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Record of Apprenticeship Part-Completion</rdfs:label>
        <skos:definition>A document issued to an apprentice upon withdrawal by reason of redundancy, to support them in finding new employment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#RedundancyEvidence -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#RedundancyEvidence">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Redundancy Evidence</rdfs:label>
        <skos:definition>Documentation or information demonstrating that an apprentice has been made redundant, such as a dismissal notice or business closure email.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#RedundantApprentice -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#RedundantApprentice">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Person"/>
        <rdfs:label>Redundant Apprentice</rdfs:label>
        <skos:definition>An apprentice whose apprenticeship agreement has been terminated by reason of redundancy, who on the day of dismissal has completed less than 75% of the apprenticeship practical period and whose remaining training represents a duration of six months or more.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00927"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#RedundantApprenticeRole -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#RedundantApprenticeRole">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Redundant Apprentice Role</rdfs:label>
        <skos:definition>The role of an apprentice whose apprenticeship agreement has been terminated by reason of redundancy.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Regulator -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Regulator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RegulatoryOfficialPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Regulator</rdfs:label>
        <skos:definition>The regulatory authority to be contacted by providers.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#RegulatoryAuthority -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#RegulatoryAuthority">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#GovernmentOrganizationPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#Agent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                        <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Regulatory Authority</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#Department"/>
        <skos:definition>The authority referred to as &apos;us&apos; in the provision, responsible for receiving reports of inconsistencies.</skos:definition>
        <skos:definition>The government body responsible for enforcing apprenticeship funding rules, referred to as &apos;we&apos;.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#RegulatoryBody -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#RegulatoryBody">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#Agent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                        <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#holdsRole"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://www.w3id.org/cco/cco#RoleHolding"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://www.w3id.org/cco/cco#hasRole"/>
                                <owl:someValuesFrom rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Regulatory Body</rdfs:label>
        <skos:definition>A body responsible for approving apprenticeship training delivery.</skos:definition>
        <skos:definition>An organisation responsible for approving providers to deliver apprenticeship training</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#RelevantTutorCosts -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#RelevantTutorCosts">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Relevant Tutor Costs</rdfs:label>
        <skos:definition>Relevant tutor costs include salary, on-costs, travel and subsistence claims. On-costs mean employer pension contributions and national insurance. Travel and subsistence costs must relate to apprenticeship delivery.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00437"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#RepayOverPayment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#RepayOverPayment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RepaymentActionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Repay Over-payment</rdfs:label>
        <skos:definition>The act of returning over-paid funds to the relevant funding source.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#RepeatedTraining -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#RepeatedTraining">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#PostCredentialTrainingPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Repeated Training</rdfs:label>
        <skos:definition>Training that needs to be repeated to meet the accreditation requirements of a regulated profession.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Reservation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Reservation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Reservation</rdfs:label>
        <skos:definition>A reservation for an apprenticeship, which expires if not used within 3 months of its start date.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ReservedFunds -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ReservedFunds">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Reserved Funds</rdfs:label>
        <skos:definition>Funds reserved by an employer for the purpose of funding an apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Review -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Review">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RegulatoryDecisionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Review</rdfs:label>
        <skos:definition>A formal assessment or examination of something with the possibility or intention of instituting change if necessary.</skos:definition>
        <skos:definition>A formal assessment or examination of something, in this context a review of an apprentice&apos;s progress.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ReviewFacility -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ReviewFacility">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Review Facility</rdfs:label>
        <skos:definition>A facility enabling an apprentice to request a second opinion on a judgement outcome.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#RevisedAssessmentPlan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#RevisedAssessmentPlan">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Revised Assessment Plan</rdfs:label>
        <skos:definition>The revised assessment plan for apprenticeship assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#RulesParagraphs -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#RulesParagraphs">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Rules Paragraphs</rdfs:label>
        <skos:definition>A set of regulatory rules referenced by paragraph numbers, such as paragraphs 33.2 to 33.4.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SENProfessional -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SENProfessional">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Person"/>
        <rdfs:label>SEN Professional</rdfs:label>
        <skos:definition>A professional specialising in Special Educational Needs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SafeguardingEnforcement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SafeguardingEnforcement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Safeguarding Enforcement</rdfs:label>
        <skos:definition>A state where safeguarding measures are rigorously enforced by the provider.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SecretaryOfStateForEducation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SecretaryOfStateForEducation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Secretary of State for Education</rdfs:label>
        <skos:definition>The Secretary of State for Education, acting as the regulatory authority for education funding agreements in the UK.</skos:definition>
        <skos:definition>The role of the Secretary of State for Education as the regulatory authority responsible for the apprenticeship employer agreement.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SelfAssessmentReport -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SelfAssessmentReport">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Self-Assessment Report</rdfs:label>
        <skos:definition>A report produced by a provider evaluating its own performance, incorporating evidence and guiding judgements and grades.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SelfDeclaration -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SelfDeclaration">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#SignedDeclarationPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Self-Declaration</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#Application"/>
        <skos:definition>A document in which an apprentice or employer provides details and confirms certain information.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ServiceList -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ServiceList">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Service List</rdfs:label>
        <skos:definition>A list of all services the provider&apos;s organisation will provide to the subcontractor and the associated costs for doing so.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ShorterApprenticeship -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ShorterApprenticeship">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Shorter Apprenticeship</rdfs:label>
        <skos:definition>An apprenticeship where the published typical duration of the standard is less than 12 months.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SignedDeclaration -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SignedDeclaration">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#SignedDeclarationPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Signed Declaration</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#VerificationDocumentation"/>
        <skos:definition>A signed document confirming the apprentice&apos;s eligibility and consent for the care leavers bursary.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SignedStatement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SignedStatement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#SignedDeclarationPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Signed Statement</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#Document"/>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#VerificationDocument"/>
        <skos:definition>A document that has been completed and signed, required as part of an evidence pack.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SignedTrainingPlan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SignedTrainingPlan">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Signed Training Plan</rdfs:label>
        <skos:definition>A formal document outlining the training and assessment plan for an apprentice, signed by relevant parties.</skos:definition>
        <skos:definition>A fully signed version of the training plan required by the end of the qualifying day period.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SignificantFrontLoading -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SignificantFrontLoading">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Significant Front Loading</rdfs:label>
        <skos:definition>Significant front loading is defined as 50% of the planned OTJ hours being delivered in the first 25% of the planned duration.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01203"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SingleProvider -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SingleProvider">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Single Provider</rdfs:label>
        <skos:definition>A single provider that the employer has chosen to route all apprenticeship funding through.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SixteenToEighteenYearOldLearner -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SixteenToEighteenYearOldLearner">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>16-18 Year-Old Learner</rdfs:label>
        <skos:definition>A condition that applies when the apprentice is aged between 16 and 18 years old.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SkillsCompetitionCost -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SkillsCompetitionCost">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Skills Competition Cost</rdfs:label>
        <skos:definition>Costs incurred by an apprentice taking part in any skills competition.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SkillsEngland -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SkillsEngland">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:label>Skills England</rdfs:label>
        <skos:definition>The regulatory authority responsible for revisions, adjustments and dispensations to apprenticeship standards and funding rules.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SpecialEducationalNeedsPerson -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SpecialEducationalNeedsPerson">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Person"/>
        <rdfs:label>Special Educational Needs Person</rdfs:label>
        <skos:definition>A person with special educational needs, learning difficulties or disabilities</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#StaffSalaryAndOnCosts -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#StaffSalaryAndOnCosts">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Staff Salary and On-Costs</rdfs:label>
        <skos:definition>Proportionate salary and on-costs of staff who are directly involved in the programme governance, management and administration of the apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#StandaloneQualification -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#StandaloneQualification">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Standalone Qualification</rdfs:label>
        <skos:definition>A standalone English and/or maths qualification studied by a 19+ apprentice</skos:definition>
        <skos:definition>A standalone English and/or maths qualification that may be studied as part of an apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#StandaloneQualificationFundingCondition -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#StandaloneQualificationFundingCondition">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Standalone Qualification Funding Condition</rdfs:label>
        <skos:definition>A condition where a standalone English and/or maths qualification is being funded as part of the programme, and the apprentice lacks acceptable evidence of previous attainment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#StartingLevel -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#StartingLevel">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Starting Level</rdfs:label>
        <skos:definition>The level an apprentice must start working towards as determined by the assessment outcome.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Statement -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Statement">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Statement</rdfs:label>
        <skos:definition>A formal document summarising specified information.</skos:definition>
        <skos:definition>A formal statement to be signed by the employer and apprentice confirming satisfaction with training delivered.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#StatutoryPaternalLeave -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#StatutoryPaternalLeave">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Statutory Paternal Leave</rdfs:label>
        <skos:definition>Statutory paternal leave is a maximum period of 2 weeks.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00946"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#StudentLoan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#StudentLoan">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Loan</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/us#DirectUnsubsidizedLoan"/>
        <skos:definition>A loan provided to students to fund their education, which is prohibited from being used to pay for an apprenticeship under certain conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#StudentMembershipFee -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#StudentMembershipFee">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#AncillaryFeePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Student Membership Fee</rdfs:label>
        <skos:definition>Student membership fees that are required by professional bodies, even where linked to a mandatory qualification.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00483"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Subcontract -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Subcontract">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Subcontract</rdfs:label>
        <skos:definition>A written agreement between a provider and a subcontractor for the delivery of apprenticeship training and on-programme assessment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SubcontractEnding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SubcontractEnding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Subcontract Ending</rdfs:label>
        <skos:definition>The condition that a subcontract has ended for any reason.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SubcontractingInformation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SubcontractingInformation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Subcontracting Information</rdfs:label>
        <skos:definition>Information including the rationale for subcontracting, the services to be provided, and the associated costs, as referred to in paragraphs 224 and 225.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SubcontractingPolicy -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SubcontractingPolicy">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Subcontracting Policy</rdfs:label>
        <skos:definition>A policy detailing the rationale for subcontracting, services, and costs.</skos:definition>
        <skos:definition>A policy document outlining the provider&apos;s approach and rationale for subcontracting.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SubcontractingRationale -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SubcontractingRationale">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Subcontracting Rationale</rdfs:label>
        <skos:definition>A rationale for subcontracting in the delivery of apprenticeships.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Subcontractor -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Subcontractor">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Subcontractor</rdfs:label>
        <skos:definition>A role for a party that enters into a subcontract with a primary provider to deliver part of the services.</skos:definition>
        <skos:definition>A role for entities engaged by a provider to assist in the delivery of apprenticeship funded training.</skos:definition>
        <skos:definition>A role held by an entity that performs work or provides services under a contract with a primary provider.</skos:definition>
        <skos:definition>A role of a party that has entered into a subcontract with a provider.</skos:definition>
        <skos:definition>An organisation acting as a subcontractor in the delivery of services.</skos:definition>
        <skos:definition>An organisation contracted by a provider to deliver part of the apprenticeship training or assessment.</skos:definition>
        <skos:definition>An organisation engaged by a provider to deliver part of the provision.</skos:definition>
        <skos:definition>An organisation or an individual (not an employee) that is contracted by a provider for the delivery of training and on-programme assessment, as part of the employer’s agreed apprenticeship programme.</skos:definition>
        <skos:definition>An organisation that delivers apprenticeship training under a subcontracting arrangement with a main provider.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00030"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SubcontractorChangeOfCircumstances -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SubcontractorChangeOfCircumstances">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Subcontractor Change of Circumstances</rdfs:label>
        <skos:definition>A change of circumstances affecting a subcontractor&apos;s ability to continue to deliver under a subcontract, including liquidation, administration, key staff leaving, or removal from APAR</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SubcontractorDeclaration -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SubcontractorDeclaration">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Subcontractor Declaration</rdfs:label>
        <skos:definition>A fully completed subcontractor declaration submitted by a provider as part of ILR data returns.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SubcontractorDocument -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SubcontractorDocument">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Subcontractor Document</rdfs:label>
        <skos:definition>A document related to a subcontractor&apos;s subcontracted delivery.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SubcontractorFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SubcontractorFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Subcontractor Funding</rdfs:label>
        <skos:definition>The amount of funding that the main provider will pay each subcontractor for their apprenticeship training and/or on-programme assessment contribution.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SubcontractorPremises -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SubcontractorPremises">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Subcontractor Premises</rdfs:label>
        <skos:definition>The physical premises of a subcontractor involved in subcontracted delivery.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SubcontractorServiceList -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SubcontractorServiceList">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Subcontractor Service List</rdfs:label>
        <skos:definition>A list of the services a provider will provide when subcontracting and how they will determine the associated costs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SufficientEvidence -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SufficientEvidence">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#RegulatoryDecisionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Sufficient Evidence</rdfs:label>
        <skos:definition>Evidence that is adequate in quantity and quality to allow a provider to assess performance against Ofsted&apos;s framework.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SummaryOfImpact -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SummaryOfImpact">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Summary of Impact</rdfs:label>
        <skos:definition>A summary of the impact of prior learning and experience on apprenticeship content and price, including whether and by how much content and price have been reduced, and confirmation that the resulting apprenticeship meets funding rules regarding minimum duration and off-the-job training.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SummaryOfTrainingDocument -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SummaryOfTrainingDocument">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Summary of Training Document</rdfs:label>
        <skos:definition>A document which evidences the training that the apprentice has undertaken to the point of changing providers.</skos:definition>
        <skos:definition>A document which evidences the training that the apprentice has undertaken to the point of withdrawal.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SupplementalFundingRulesAndGuidance -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SupplementalFundingRulesAndGuidance">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Supplemental Funding Rules and Guidance</rdfs:label>
        <skos:definition>Supplemental funding rules and guidance for the two-year growth pilot.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SupportingProvider -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SupportingProvider">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Supporting Provider</rdfs:label>
        <skos:definition>A supporting provider is an organisation that is on the ‘supporting provider’ route of the Apprenticeship Provider and Assessment Register (APAR). They may only act as a ‘subcontractor’.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01225"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#SystemsAndProcesses -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#SystemsAndProcesses">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Systems and Processes</rdfs:label>
        <skos:definition>Wider systems and processes required to assure apprentice existence and eligibility.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TLevel -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TLevel">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>T-Level</rdfs:label>
        <skos:definition>A technical qualification completed by an individual, serving as a condition for considering progression profiles.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TNP2 -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TNP2">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>TNP2 Record</rdfs:label>
        <skos:definition>A TNP2 record in the ILR system where end-point assessment organisation details are entered</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TNP2ILR -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TNP2ILR">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>TNP2 on the ILR</rdfs:label>
        <skos:definition>The TNP2 field on the Individualised Learner Record (ILR) where the end-point assessment price is entered.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TNPChange -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TNPChange">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>TNP Change</rdfs:label>
        <skos:definition>A change in either TNP1 or TNP2, requiring a reason and evidence of prior agreement with the employer.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TermTimeOnlyContract -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TermTimeOnlyContract">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Term-Time Only Contract</rdfs:label>
        <skos:definition>An employment contract for apprentices who work only during school term times, excluding holiday periods such as the summer break.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TotalNegotiatedPrice -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TotalNegotiatedPrice">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Total Negotiated Price</rdfs:label>
        <skos:definition>Total negotiated price (TNP) is the price negotiated between an employer and main provider for all the eligible costs of an apprentice’s training and assessment, after relevant prior learning has been taken into account.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_01218"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TotalPrice -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TotalPrice">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Total Price</rdfs:label>
        <skos:definition>The total price for an apprenticeship, subject to reduction based on prior learning percentage and funding band maximum.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00112"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#Training -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#Training">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Training</rdfs:label>
        <skos:definition>A resource representing the necessary amount of training needed in readiness for assessments.</skos:definition>
        <skos:definition>Instructional content delivered to apprentices as part of a funded programme.</skos:definition>
        <skos:definition>The training delivered as part of an apprenticeship programme.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TrainingActivity -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TrainingActivity">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Training Activity</rdfs:label>
        <skos:definition>An off-the-job training activity that is planned and eligible.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TrainingAndAssessment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TrainingAndAssessment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Training and Assessment</rdfs:label>
        <skos:definition>The training and assessment activities delivered across an apprenticeship.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TrainingCost -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TrainingCost">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#TotalProgramCostPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Training Cost</rdfs:label>
        <skos:definition>The cost of training and, where applicable, end-point assessment delivered to date.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TrainingOrAssessment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TrainingOrAssessment">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Training or On-Programme Assessment</rdfs:label>
        <skos:definition>Training or on-programme assessment that must be directly delivered by the provider</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TrainingOrAssessmentSupply -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TrainingOrAssessmentSupply">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Training or Assessment Supply</rdfs:label>
        <skos:definition>Supplies of training or end-point assessment as referenced in UK regulatory provisions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TrainingPlan -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TrainingPlan">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto/uk#Document"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Training Plan</rdfs:label>
        <skos:definition>A document detailing how English and maths will be delivered within the apprenticeship programme.</skos:definition>
        <skos:definition>A document detailing the planned training activities and schedule for an apprenticeship.</skos:definition>
        <skos:definition>A document outlining the broad content of a training program that must be agreed before delivery.</skos:definition>
        <skos:definition>A document outlining the training objectives, content, and schedule for an individual.</skos:definition>
        <skos:definition>A document outlining the training plan for an apprenticeship</skos:definition>
        <skos:definition>A document outlining the training plan for an apprenticeship, signed by the provider, employer, and apprentice.</skos:definition>
        <skos:definition>A document outlining the training plan for an apprenticeship.</skos:definition>
        <skos:definition>A document outlining the training plan, signed and dated by all parties, meeting specified criteria and kept up to date with material changes.</skos:definition>
        <skos:definition>A document outlining the training program, signed by the provider, employer, and apprentice</skos:definition>
        <skos:definition>A documented plan outlining the learning activities for an apprenticeship.</skos:definition>
        <skos:definition>A documented plan outlining the training activities and schedule for an apprenticeship.</skos:definition>
        <skos:definition>A documented plan outlining the training delivery model and schedule.</skos:definition>
        <skos:definition>A documented plan outlining the training requirements and activities for a learner.</skos:definition>
        <skos:definition>A signed document that describes the delivery schedule for English and/or maths active learning.</skos:definition>
        <skos:definition>An agreed plan documenting training activities.</skos:definition>
        <skos:definition>For standards with a mandatory qualification this must be, as a minimum, a list of the units, along with a description of any additional activities that the apprentice will undertake to develop occupational competency.</skos:definition>
        <skos:definition>The apprentice&apos;s training plan document.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00398"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TrainingProvider -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TrainingProvider">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Agent"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Organisation"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Role"/>
        <rdfs:label>Training Provider</rdfs:label>
        <skos:definition>An organisation providing apprenticeship training.</skos:definition>
        <skos:definition>An organisation that delivers training to learners.</skos:definition>
        <skos:definition>An organisation that provides training for apprenticeships.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TrainingResource -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TrainingResource">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Training Resource</rdfs:label>
        <skos:definition>A resource representing training activities or programmes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TrainingVolumeShortfall -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TrainingVolumeShortfall">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Training Volume Shortfall</rdfs:label>
        <skos:definition>A condition where actual off-the-job training volume is less than the planned and agreed volume.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TransferAmount -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TransferAmount">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#FinancialAidResourcePattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Transfer Amount</rdfs:label>
        <skos:definition>A funding allocation resource representing the transfer amount that covers eligible training and assessment costs for an apprenticeship standard.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TransferFundedApprenticeship -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TransferFundedApprenticeship">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Transfer Funded Apprenticeship</rdfs:label>
        <skos:definition>An apprenticeship funded through a levy transfer, encompassing its quality and employment aspects.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TransferFunding -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TransferFunding">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <rdfs:label>Transfer Funding</rdfs:label>
        <skos:definition>A funding arrangement where apprenticeship funds are transferred from one employer to another</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TransferFunds -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TransferFunds">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Transfer Funds</rdfs:label>
        <skos:definition>Funds transferred between employers for apprenticeship purposes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TransferOfLevyFunds -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TransferOfLevyFunds">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Transfer of Levy Funds</rdfs:label>
        <skos:definition>The transfer of apprenticeship levy funds from one employer to another to support an apprentice&apos;s continued training.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TransferredFunds -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TransferredFunds">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Transferred Funds</rdfs:label>
        <skos:definition>Funds transferred for apprenticeship training and assessment payments.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TwoYearGrowthPilot -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TwoYearGrowthPilot">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Two-Year Growth Pilot</rdfs:label>
        <skos:definition>A two-year growth pilot programme involving additional payments.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#TypicalPlannedHours -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#TypicalPlannedHours">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Typical Planned Hours</rdfs:label>
        <skos:definition>The typical planned hours for a standard, as used by providers, which must be at least equal to the off-the-job training minimum requirement published on the standard or in Annex C.</skos:definition>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00349"/>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#UKPRN -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#UKPRN">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>UKPRN</rdfs:label>
        <skos:definition>A UK Provider Reference Number.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#UniqueLearnerNumberInformation -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#UniqueLearnerNumberInformation">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Unique Learner Number Information</rdfs:label>
        <skos:definition>Accurate unique learner number (ULN) information required for apprenticeship registration.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#VAT -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#VAT">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>VAT</rdfs:label>
