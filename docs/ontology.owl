        <cco:hasActionExpression>the student&apos;s available income is multiplied by the assessment rate of 50% to determine the student&apos;s contribution from income</cco:hasActionExpression>
        <rdfs:label>Multiply by Assessment Rate</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00189"/>
    </owl:Thing>
    


