        <rdf:type rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <cco:hasConditionExpression>The rates in Table C6 increase from 22% to 47% as the adjusted available income increases.</cco:hasConditionExpression>
        <rdfs:label>Table C6 Rate Range</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00208"/>
    </owl:Thing>
    


