        <skos:closeMatch rdf:resource="https://w3id.org/cco-gro/onto/uk#Training"/>
        <skos:definition>A program of study offered by an educational provider.</skos:definition>
        <skos:definition>An educational course with a defined duration.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/au#CourseCompletionData -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/au#CourseCompletionData">
