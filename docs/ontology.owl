        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>Apprenticeship Training</rdfs:label>
        <skos:definition>The delivery of apprenticeship training and on-programme assessment.</skos:definition>
        <skos:definition>The delivery of apprenticeship training, which may be subcontracted.</skos:definition>
        <skos:definition>The structured training program undertaken by an apprentice as part of their apprenticeship.</skos:definition>
        <skos:definition>The training programme undertaken by apprentices</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ApprenticeshipTrainingAndAssessment -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ApprenticeshipTrainingAndAssessment">
