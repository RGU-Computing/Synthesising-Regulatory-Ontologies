        <rdf:type rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <cco:hasConditionExpression>For the care leavers bursary, a signed declaration by the apprentice is required to confirm that they: (1) understand that they are eligible for and would like to receive a bursary as a care leaver; (2) have not previously received the care leavers bursary (noting paragraph 111.1); and (3) when claiming the employer additional payment, signed consent from the apprentice that they have provided permission to share their care leaver status (or EHC plan) with their employer on their behalf.</cco:hasConditionExpression>
        <rdfs:label>Care Leavers Bursary Eligibility</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#UK_UNIT_00546"/>
    </owl:Thing>
    


