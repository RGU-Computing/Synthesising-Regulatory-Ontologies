        <rdfs:label>Education Health and Care Plan</rdfs:label>
        <skos:definition>An education, health and care plan issued for an individual</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#ELSClaimForm -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#ELSClaimForm">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Resource"/>
        <rdfs:label>ELS Claim Form</rdfs:label>
        <skos:definition>The exceptional learning support cost form that can be accessed on GOV.UK.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/uk#EPAO -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/uk#EPAO">
