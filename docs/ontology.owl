    </owl:Class>
    


    <!-- https://w3id.org/cco-gro/onto/ca#FormalWithdrawalFromStudies -->


    <owl:Class rdf:about="https://w3id.org/cco-gro/onto/ca#FormalWithdrawalFromStudies">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cco-gro/onto#EnrollmentActionPattern"/>
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/cco/cco#Action"/>
        <rdfs:label>Formal Withdrawal from Studies</rdfs:label>
