        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://www.w3id.org/cco/cco#Condition"/>
        <cco:hasConditionExpression>Discretionary net worth is calculated by subtracting the asset protection allowance (Table C5) from the net worth.</cco:hasConditionExpression>
        <rdfs:label>Discretionary Net Worth Step</rdfs:label>
        <prov:wasDerivedFrom rdf:resource="https://w3id.org/cco-gro/data#USA_UNIT_00206"/>
    </owl:Thing>
    


