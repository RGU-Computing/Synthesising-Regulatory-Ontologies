  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Employers who do not pay the apprenticeship levy, and levy paying employers with insufficient funds, as defined in UK apprenticeship funding regulations."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmployerOrProviderRole",
