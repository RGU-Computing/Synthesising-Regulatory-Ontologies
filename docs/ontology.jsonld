    "@value" : "Negative Contribution from Assets"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00184"
  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "If the contribution from assets is negative, it is set to zero."
  } ]
}, {
