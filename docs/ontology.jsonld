  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Calculate Parents' Contribution"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00184"
  } ],
  "https://www.w3id.org/cco/cco#hasActionExpression" : [ {
    "@value" : "The parents' contribution from assets is calculated by multiplying discretionary net worth by the conversion rate of 12%, and if negative, it is set to zero. The parents' available income and contribution from assets are added together to determine the parents' adjusted available income. The total parents' contribution from adjusted available income is calculated from the amounts and rates in Table A5, where rates increase from 22% to 47% as adjusted available income increases."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00184_condition_71eba7",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
