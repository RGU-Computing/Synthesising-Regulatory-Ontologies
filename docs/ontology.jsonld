  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Modified Independent Eligibility Criteria"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00378"
  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "To be eligible for modified independent status, the student must provide satisfactory evidence of a severe and permanent breakdown in the relationship with the parent(s). The student will normally be expected to have maintained an independent residence outside the parent(s)' home for at least one year before the start of the study period."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00378_exception_condition",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Exception Criteria"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00378"
  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "Exceptions will be considered when it can be documented that a recent incident with the parent(s) was sudden and violent, placing the student in physical jeopardy or causing extreme mental stress, resulting in the need to move out of the family home. Students who usually live with their parents during the summer months cannot be considered for modified independent status."
  } ]
