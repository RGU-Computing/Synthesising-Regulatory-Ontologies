    "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00206"
  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "Discretionary net worth is calculated by subtracting the asset protection allowance (Table C5) from the net worth."
  } ]
}, {
