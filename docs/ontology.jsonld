}, {
  "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00072_condition_eligibility",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Full-Time Program Eligibility Criteria"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00072"
  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "The full-time program may have breaks in study so long as they do not exceed 10% of the total study period for the program. In addition, no break can be longer than two consecutive weeks. Full-time course load criteria: a. For academic programs, the program must have sufficient required credits per quarter/semester/term/academic year to meet the definition of a full-time course load as defined by the institution. Note that not all institutions use the same credit system. b. Full-time status for non-credit career training programs of study is determined by the number of instructional hours per week as established by the institution. The absolute minimum number of hours of study for a full-time program in a post-secondary institution is 20 instructional hours per week and 15 instructional hours per week for aviation programs."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00072_condition_exception",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Exception Conditions for Breaks"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00072"
  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "with the following exceptions: 4. a. Calendar year-end break, which can be up to three weeks in length; and b. Breaks immediately before or after a period of work-integrated learning during academic credit-based programs (funding will only be provided for the period the student is in work-integrated learning plus up to two weeks of break)"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00072_exception_033309",
