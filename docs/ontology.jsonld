  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An employment relationship between an employer and an employee"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmploymentEvidence",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Employment Evidence"
