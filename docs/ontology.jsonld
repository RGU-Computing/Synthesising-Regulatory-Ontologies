  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Action"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A periodic review of learning support arrangements, required at least every 3 calendar months."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#LearningSupportSubcontractingDefinition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
