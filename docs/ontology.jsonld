  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A calculated amount representing a spouse's expected contribution, determined as 10% of the total family income above the CSFA Program income threshold, pro-rated weekly and applied for each week of the student's study period, capped at 34 2/3 weeks if enrolled in more than 34 2/3 weeks."
  } ],
