  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "All of the apprentices that a provider has been contracted to deliver training to, at that employer, irrespective of the occupational area, standard or level."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmployerApprenticeshipServiceAccount",
