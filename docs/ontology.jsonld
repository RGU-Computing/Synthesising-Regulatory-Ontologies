  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/us#ParentsAvailableIncome",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Parents' Available Income"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/cco-gro/onto#FinancialNeedAssessmentInputPattern"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Parents' available income is calculated by subtracting certain allowances from the parents' total income. These allowances account for certain nondiscretionary expenses, such as taxes and basic living expenses. Once a minimum level of support has been offset for those expenses, the formula assumes that the remaining income is available for discretionary purposes, including paying for a postsecondary education. The available income can be a negative number."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00179"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/us#ParentsContribution",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Parents' Contribution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/cco-gro/onto#FinancialNeedAssessmentInputPattern"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The calculated amount representing the portion of parental income and assets considered available to help pay for the student's college education, as determined under the 2025-26 Student Aid Index (SAI) and Pell Grant Eligibility Guide."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00184"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/us#ParentsContributionFromAssets",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Parents Contribution from Assets"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/cco-gro/onto#FinancialNeedAssessmentInputPattern"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A calculated amount representing the contribution from the assets of parents of a dependent student, determined by adding cash, savings, checking, time deposits, money market funds, net worth of investments, and adjusted net worth of business and/or investment farm."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/us#ParentsTotalIncome",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
