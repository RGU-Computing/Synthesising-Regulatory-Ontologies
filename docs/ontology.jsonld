}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#OTJTActiveLearning",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "OTJT Active Learning"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "OTJT active learning does not need to be delivered by the provider; it can include any activity that has been agreed and documented as part of the agreed training plan. When the training documented on the training plan is complete, the practical period is complete."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_00364"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#OTJTActiveLearningPlan",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "OTJT Active Learning Plan"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A plan for off-the-job training active learning to take place at least every 3 calendar months of the practical period."
  }, {
    "@value" : "A plan for off-the-job training active learning to take place at least in every calendar month of the practical period."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#OTJTMinimumRequirement",
