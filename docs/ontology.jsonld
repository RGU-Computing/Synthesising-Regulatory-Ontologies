  } ],
  "https://www.w3id.org/cco/cco#hasActionExpression" : [ {
    "@value" : "The student does not attend any instructional hours for two consecutive calendar weeks; attends less than 12 hours per week (or less than 8 hours per week for students with a disability) for three consecutive calendar weeks; and/or is absent for sufficient hours/days that the post-secondary institution determines that the student cannot successfully complete the program."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00502_condition_1",
