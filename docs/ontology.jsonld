    "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00186"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00186_subject_f18612",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  }, {
    "@id" : "https://w3id.org/cco-gro/onto/us#StudentAvailableIncome"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Student Available Income"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The student's available income is calculated by subtracting certain allowances from the student's total income. These allowances account for certain nondiscretionary expenses, such as taxes and basic living expenses. Once a minimum level of support has been offset for those expenses, the formula assumes that the remaining income is available for discretionary purposes, including paying for a postsecondary education. The student's available income is the sum of the taxable and untaxed income, minus amounts reported in the income but excluded from the formula (offsets and allowances)."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00186"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00188",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/ns/prov#Entity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Source: USA-UNIT-00188"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00188_calculation_rule",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Student Income Calculation Rule"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The student's total income is decreased by the sum of income offsets (taxable college grant and scholarship aid, education credits, Federal Work-Study) and reduced by the sum of income allowances (U.S. income tax paid, payroll tax allowance, income protection allowance, allowance for parents' negative adjusted available income)."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00188"
  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "Student's total income = Student's total income - (Student's taxable college grant and scholarship aid + Student's education credits + Student's Federal Work-Study) - (U.S. income tax paid + Student's payroll tax allowance + Income protection allowance + Allowance for parents' negative adjusted available income)"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00188_income_allowances_condition",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Income Allowances Condition"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00188"
  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "The sum of the following allowances reduces the student's total income: U.S. income tax paid, Student's payroll tax allowance, Income protection allowance, Allowance for parents' negative adjusted available income."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00188_income_offsets_condition",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  }, {
