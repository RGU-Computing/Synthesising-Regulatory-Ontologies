  } ],
  "https://www.w3id.org/cco/cco#hasActionExpression" : [ {
    "@value" : "provide a signed declaration confirming understanding of eligibility, no prior receipt, and consent to share care leaver status"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_00546_condition_4b73e9",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Care Leavers Bursary Eligibility"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_00546"
  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "For the care leavers bursary, a signed declaration by the apprentice is required to confirm that they: (1) understand that they are eligible for and would like to receive a bursary as a care leaver; (2) have not previously received the care leavers bursary (noting paragraph 111.1); and (3) when claiming the employer additional payment, signed consent from the apprentice that they have provided permission to share their care leaver status (or EHC plan) with their employer on their behalf."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_00546_norm_ad222b",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
