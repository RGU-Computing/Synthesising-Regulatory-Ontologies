    "@id" : "https://www.w3id.org/cco/cco#Organisation"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An organisation responsible for the completion of apprenticeship training."
  }, {
    "@value" : "An organisation that acts as a main provider in the context of UK regulatory provisions."
  }, {
    "@value" : "An organisation that acts as a main provider in the context of apprenticeship co-investment collection and reporting."
  }, {
    "@value" : "An organisation that acts as a main provider in the context of apprenticeship funding and ILR submissions."
  }, {
    "@value" : "An organisation that acts as a main provider in the context of apprenticeships."
  }, {
    "@value" : "An organisation that acts as a main provider in the context of subcontracting, responsible for publishing specific information on their website."
  }, {
    "@value" : "An organisation that acts as a main provider of apprenticeship training under UK funding rules."
  }, {
    "@value" : "An organisation that acts as a main provider of training and end-point assessment services."
  }, {
    "@value" : "An organisation that acts as the main provider in the context of apprenticeship funding and administration."
  }, {
    "@value" : "An organisation that is a main provider of education or training services."
  }, {
    "@value" : "The main provider responsible for ensuring apprentice preparation for end-point assessment."
  }, {
    "@value" : "We use the term ‘main provider’ where the funding rule only applies to an organisation that is listed on the main provider route of the Apprenticeship Provider and Assessment Register (APAR)."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
