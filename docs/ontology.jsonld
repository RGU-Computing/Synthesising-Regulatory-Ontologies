  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Student Total Income"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The total income of a student, which is decreased by the sum of income offsets and reduced by the sum of income allowances as specified in the calculation rule."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
