}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#CoInvestment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Co-Investment"
  }, {
    "@value" : "Co-investment"
  }, {
    "@value" : "Mandatory Co-investment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A financial contribution paid by the receiving employer to the main provider for apprenticeship training costs when levy funds are insufficient or exhausted."
  }, {
    "@value" : "Any mandatory co-investment due for training or end-point assessment already delivered."
  }, {
    "@value" : "Co-investment is where the government shares the cost of training and assessing apprentices with employers. For apprenticeship training that started on or after 1 April 2019, employers (who either do not pay the levy or levy payers who have run out of levy funds) pay 5% towards the cost of apprenticeship training. The government will pay the rest (95%) up to the funding band maximum."
  }, {
    "@value" : "The matching co-investment amount collected from employers by main providers for apprenticeships."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_01194"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#CoInvestmentAmount",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Co-Investment Amount"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The relevant amount of the total negotiated price, up to the funding band maximum, towards the cost of apprenticeship training and assessment."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#CoInvestmentPercentage",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Co-investment Percentage"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "This percentage represents the amount of co-investment the employer would have otherwise had to contribute towards the apprenticeship, if funds had not been transferred."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_00728"
  } ]
