}, {
  "@id" : "https://w3id.org/cco-gro/onto/us#LegalDependent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Legal Dependent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/cco-gro/onto#StudentRolePattern"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A person who qualifies as a legal dependent for purposes such as financial aid or tax benefits."
  }, {
    "@value" : "Students who have legal dependents are independent. Legal dependents include children or other people (except a spouse) who meet all the following criteria: They live with the student (or, in the case of children, live apart from the student due to a qualifying temporary absence under IRS code, such as living apart due to college enrollment). They currently receive more than half of their support from the student. They will continue to receive more than half of their support from the student between July 1, 2025, and June 30, 2026."
  }, {
    "@value" : "When a student completes a FAFSA form after the award year has begun and indicates they have a legal dependent who is not the student's child, the support already given by the student during the award year plus the future support for the remainder of the award year must total more than 50% for the whole award year for the individual to meet the definition of a legal dependent."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00057"
  }, {
    "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00379"
  } ]
