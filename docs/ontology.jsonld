    "@value" : "Meet Eligibility Criteria"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00016"
  } ],
  "https://www.w3id.org/cco/cco#hasActionExpression" : [ {
    "@value" : "must meet the following three criteria: 1. offer and deliver at least one program that fully meets the program eligibility requirements; 2. grant a formal citation, certificate, diploma, or degree recognizing successful completion of a post-secondary program of study at the institution; 3. be in continuous operation for a minimum of two years immediately prior to designation, or 10 years for a medical institution located outside of North America and be in good standing with the appropriate educational accrediting, regulatory, or government body in the jurisdiction where it is located."
  } ]
