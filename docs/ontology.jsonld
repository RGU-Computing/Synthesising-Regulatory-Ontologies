  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A statement required from an employer attesting to the apprentice's competency."
  }, {
    "@value" : "A statement required from an employer confirming the competency of an apprentice."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmployerDefinedTerm",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Employer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "This can include a Flexi-Job Apprenticeship Agency (FJAA). This may also include a company or charity whose PAYE scheme the employer has connected to their apprenticeship service account. References to an ‘employer’ describe the whole organisation, not individual sites, locations, groups, or companies linked by directors."
  }, {
    "@value" : "We use the term ‘employer’ to mean an organisation that has a contract of service and an apprenticeship agreement with an apprentice."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_00032"
  }, {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_01199"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmployerIncentivePayment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Employer Incentive Payment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A payment generated when a foundation apprenticeship attracts an employer incentive, as identified on the Skills England website."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmployerMentoringCost",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Employer Mentoring Cost"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Costs of an employer supporting or mentoring an apprentice, where this is required by the standard and part of the agreed training plan."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmployerNonLevyPayer",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Non-Levy Paying Employer"
  } ],
