  } ],
  "https://www.w3id.org/cco/cco#hasActionExpression" : [ {
    "@value" : "The sum of the following allowances reduces the student's (and spouse's) total income: U.S. income tax paid, payroll tax allowance, income protection allowance, and employment expense allowance."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00196_condition_employment_expense",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Employment Expense Allowance"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00196"
  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "If the student is not married (single, separated, divorced, or widowed) this allowance is $0. If the student is married (or remarried), this allowance is 35% of the student and spouse's combined earned income or maximum allowance, whichever is less. The allowance is updated annually. See the 2025-26 Student Aid Index (SAI) and Pell Grant Eligibility Guide for the current year allowance amount. The employment expense allowance is never less than zero."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00196_condition_income_protection",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  }, {
