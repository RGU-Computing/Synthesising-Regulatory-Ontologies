  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Eligibility Criteria"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00585"
  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "A borrower must be at least 30 calendar days into a new confirmed period of study following any previous medical or parental leave to be eligible for medical or parental leave. There is no requirement for a borrower’s loans to be in good standing. The eligibility window begins on the medical event date or parental event date and ends 12 months later. The application window starts on the last day of the month in which they withdrew from post-secondary studies and ends 6 months later."
  } ]
