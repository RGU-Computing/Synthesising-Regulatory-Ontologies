    "@value" : "Family Income"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/cco-gro/onto#FinancialNeedAssessmentInputPattern"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "https://w3id.org/cco-gro/onto/us#FamilySize"
  }, {
    "@id" : "https://w3id.org/cco-gro/onto/us#IncomeAllowanceCalculation"
  }, {
    "@id" : "https://w3id.org/cco-gro/onto/us#ParentsAvailableIncome"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "family income is defined as the student’s parent(s)/guardian(s)/sponsor(s) income (as reported on line 15000 [total income] of each parent(s)/guardian(s)/sponsor(s) previous year’s T1 General Income Tax and Benefit Return), or international equivalent."
  }, {
    "@value" : "family income is defined as the sum of student’s income and spouse’s/common-law partner’s income (as reported on both the student’s and spouse’s/common-law partner’s line 15000 [total income] of their respective previous year’s T1 General Income Tax and Benefit Return), or international equivalent."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00410"
  }, {
    "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00411"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/ca#FamilySize",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Family Size"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Family size includes all children 18 years of age and under, all children aged 19 and over who are full-time dependent students, children with disabilities aged 19 and over, elderly relatives who are fully supported by the parent(s) and declared on the T1 General Income Tax and Benefit Return, and foster children where foster parent income is claimed on Appendix 1."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00434"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/ca#FederalFixedStudentContribution",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Federal Fixed Student Contribution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The federal fixed student contribution, a calculated amount based on study weeks and capped at 34 2/3 weeks per loan year."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00408"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/ca#FieldPlacement",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Field Placement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A field placement provides students with an intensive part-time/short term intensive hands-on practical experience in a setting relevant to their subject of study. Field placements may not require supervision of a registered or licensed professional and the completed work experience hours are not required for professional certification. Field placements account for work-integrated educational experiences not encompassed by other forms, such as co-op, clinic, practicum, and internship."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00833"
  } ]
}, {
