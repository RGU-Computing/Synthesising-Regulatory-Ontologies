  }, {
    "@id" : "https://w3id.org/cco-gro/onto/uk#Contract"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A complete apprenticeship agreement as defined in the regulatory provision"
  }, {
    "@value" : "A contract between an apprentice and their employer for an apprenticeship"
  }, {
    "@value" : "A contract of apprenticeship under which an apprentice is employed to learn a trade or profession."
  }, {
    "@value" : "A contract of employment or a written statement of particulars under the Employment Rights Act 1996, which takes the form of an apprenticeship agreement."
  }, {
    "@value" : "A document constituting the apprenticeship agreement"
  }, {
    "@value" : "A formal agreement between an employer and an apprentice governing the terms of the apprenticeship"
  }, {
    "@value" : "A formal agreement between an employer and an apprentice outlining the terms of the apprenticeship"
  }, {
    "@value" : "A formal agreement between the apprentice and the employer outlining the terms of the apprenticeship."
  }, {
    "@value" : "A formal agreement governing an apprenticeship programme."
  }, {
    "@value" : "This is defined in section A1(3) of the Apprenticeships, Skills, Children and Learning Act 2009 (as amended by the Enterprise Act 2016) and the Apprenticeships (Miscellaneous Provisions) Regulations 2017."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_00260"
  } ]
