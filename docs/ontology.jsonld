  }, {
    "@id" : "https://www.w3id.org/cco/cco#Organisation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An organisation that acts as both employer and training provider for apprentices."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmployerProviderPayment",
