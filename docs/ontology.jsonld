  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A person from the relevant occupation involved in assessment delivery and grading decisions."
  }, {
    "@value" : "A person from the relevant occupation who participates in the delivery and grading decision of an end-point assessment."
  }, {
    "@value" : "Someone from the occupation who participates in the delivery and grading decision of an apprenticeship assessment."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#OffTheJobTraining",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Off-the-Job Training"
  }, {
    "@value" : "Off-the-job Training (OTJT)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Action"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "All required off-the-job training that enables an apprentice to reach full occupational competence against the standard."
  }, {
    "@value" : "Off-the-job training (OTJT) is defined as training which a) is delivering new knowledge, skills and behaviours, b) is directly relevant to the apprenticeship, c) is delivered in the apprentice’s normal working hours (but outside of their productive job role) and d) excludes ineligible activities such as standalone English and maths qualifications. The volume delivered must be based on the published minimum requirement for the standard, adjusted to account for evidenced prior learning that has been identified in the initial assessment of the apprentice."
  }, {
    "@value" : "Training delivered outside the apprentice's normal working duties to achieve occupational competence."
  }, {
    "@value" : "Training delivered outside the normal work environment as part of an apprenticeship."
  }, {
    "@value" : "Training delivered to an apprentice that is not part of their normal work duties, as defined by statutory requirements."
  }, {
    "@value" : "Training delivered to an apprentice that is not part of their normal working duties."
  }, {
    "@value" : "Training undertaken outside of normal working duties, delivering new skills relevant to an apprenticeship standard."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_01211"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#OffTheJobTrainingArrangement",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Off-the-Job Training Arrangement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An arrangement for off-the-job training that, by exception, takes place outside of normal hours."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#OffTheJobTrainingHours",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Off-the-Job Training Hours"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Actual hours spent by an apprentice on off-the-job training activities."
  }, {
    "@value" : "The calculated entity representing the planned and delivered off-the-job training hours for an apprenticeship programme, including adjustments for prior learning."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_00338"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#OffTheJobTrainingParameters",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Off-the-Job Training Parameters"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The volume of off-the-job training hours, timeframe, and delivery model to be agreed upon."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#Ofsted",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Ofsted"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Agent"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"
  }, {
    "@id" : "_:genid391"
  }, {
    "@id" : "_:genid399"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The Office for Standards in Education, Children's Services and Skills, a non-ministerial department of the UK government responsible for inspecting educational institutions."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#OnboardingOfTheApprentice",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Onboarding of the Apprentice"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Action"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Onboarding of the apprentice will include agreeing a price with the employer and developing, agreeing and signing any relevant paperwork to support the apprenticeship, such as the training plan. Onboarding does not include training delivery and therefore does not count towards the off-the-job training policy."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_01212"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#OriginalTeachingMaterialDevelopment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
