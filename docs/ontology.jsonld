    "@id" : "https://www.w3id.org/cco/cco#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A role held by an organisation responsible for the completion of apprenticeship training."
  }, {
    "@value" : "The role of the main provider in the context of UK apprenticeship funding"
  }, {
    "@value" : "The role of the main provider responsible for ensuring apprentice preparation and understanding of the apprenticeship assessment process, in consultation with the employer."
  }, {
    "@value" : "The role of the main provider responsible for ensuring subcontractor cost evidence"
  }, {
    "@value" : "The role of the primary training provider to whom co-investment payments are made."
  } ]
}, {
