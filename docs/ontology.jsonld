  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Evidence to confirm that the apprentice is employed by that employer, or a connected company or charity and this employment covers the full period of the apprenticeship, including the end-point assessment."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmploymentStatusChange",
