    "@id" : "_:genid5245"
  }, {
    "@id" : "_:genid5246"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Employer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Agent"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Organisation"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A person or organization that employs people, in this context the employer of an apprentice."
  }, {
    "@value" : "A person or organization that employs people."
  }, {
    "@value" : "A role for entities that employ individuals and may receive financial assistance."
  }, {
    "@value" : "A role for entities that employ individuals and may receive payments or confirmations."
  }, {
    "@value" : "An employer of an apprentice."
  }, {
    "@value" : "An employer organisation responsible for making a new reservation if the original expires before the apprentice starts."
  }, {
    "@value" : "An organisation that employs an apprentice and is party to an apprenticeship agreement."
  }, {
    "@value" : "An organisation that employs an apprentice and is party to the training plan."
  }, {
    "@value" : "An organisation that employs an apprentice and participates in the apprenticeship programme."
  }, {
    "@value" : "An organisation that employs an apprentice and supports their training."
  }, {
    "@value" : "An organisation that employs an apprentice."
  }, {
    "@value" : "An organisation that employs apprentices and is responsible for ensuring apprenticeship compliance."
  }, {
    "@value" : "An organisation that employs apprentices and is responsible for paying their wages."
  }, {
    "@value" : "An organisation that employs apprentices."
  }, {
    "@value" : "An organisation that employs individuals and enters into agreements with providers."
  }, {
    "@value" : "An organisation that employs individuals and enters into contracts for services."
  }, {
    "@value" : "An organisation that employs individuals and participates in training arrangements."
  }, {
    "@value" : "An organisation that employs individuals, including as an apprenticeship employer."
  }, {
    "@value" : "The employer responsible for the apprenticeship, who must pay the difference when the overall price exceeds the funding band maximum."
  }, {
    "@value" : "The role of an organisation or person employing an apprentice."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmployerAdditionalPayment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Employer Additional Payment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/cco-gro/onto/uk#Payment"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An additional payment made to an employer, specifically applicable when an apprentice is employed by a Flexi-Job Apprenticeship Agency."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmployerAgreement",
