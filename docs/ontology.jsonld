  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The role of the main provider or the employer if they have chosen to undertake this role in the context of an apprenticeship."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#MainProviderRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
