}, {
  "@id" : "https://w3id.org/cco-gro/onto/ca#ExpectedContributionFromNeedBasedBursaries",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Expected Contribution from Need-Based Bursaries"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The expected contribution from need-based bursaries, where the eligibility criteria are based on need, but the funding is not targeted for a specific element of the costs of living or education. The expected contribution is equivalent to the assessed actual amount, less an exemption of $1,800 per program year for both merit-based scholarships and need-based bursaries combined. Any amount of scholarship/bursary funding above $1,800 is considered income and is assessed at 100%."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/ca#FamilyIncome",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
