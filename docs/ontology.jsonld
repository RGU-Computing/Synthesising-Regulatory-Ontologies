  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The combined role of employer and provider as referenced in UK regulatory provision UK-UNIT-01185."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmployerApprenticeshipProgramme",
