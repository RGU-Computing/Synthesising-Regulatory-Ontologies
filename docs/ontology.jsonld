  } ],
  "https://www.w3id.org/cco/cco#hasActionExpression" : [ {
    "@value" : "Financial need for part-time studies is determined based on an assessment of allowable educational costs: Tuition (actual cost of eligible tuition and compulsory fees; for B.C. public post-secondary institutions, if actual tuition is not reported, use 40% or course load percentage if greater than 40% of actual cost), Books/Supplies (allowable cost as per Institutional Appendix or actual cost), Miscellaneous Allowance ($10 per week for 20%-34% course load, $20 per week for 35%-59% course load, not to exceed $340 per application period), Transportation Allowance ($13 per week, not to exceed StudentAid BC extra transportation allowances, maximum $94 per week on appeal), Child Care Costs (allowed for children aged 11 and under, or age 12 and older with permanent disability as claimed on tax form)."
  } ]
