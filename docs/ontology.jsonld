  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Unfiled Canadian Tax Return Condition"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00432"
  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "If the student’s parent(s) are living outside Canada and have not filed a Canadian T1 General Income Tax and Benefit Return for the previous year, the parents are expected to indicate their total income from all sources both inside and outside Canada. Total income includes, but is not limited to employment, pension investment, rental, RRSP, foster parent, net professional income, workers’ compensation, employment insurance and disability assistance as well as all Canadian and foreign assets. Income may be verified by the income tax returns and assessments issued for the same period by the jurisdiction in which the parent(s) is a deemed resident for tax purposes."
  } ]
