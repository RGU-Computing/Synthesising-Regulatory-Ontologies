    "@id" : "https://www.w3id.org/cco/cco#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The role of an employer as defined by UK apprenticeship funding rules."
  }, {
    "@value" : "The role of an employer as defined in UK employment regulations."
  }, {
    "@value" : "The role of an employer as defined in the UK apprenticeship funding context."
  }, {
    "@value" : "The role of an employer as defined in the UK apprenticeship regulatory context."
  }, {
    "@value" : "The role of an employer as defined in the context of UK apprenticeship regulations."
  }, {
    "@value" : "The role of an employer as referenced in UK regulatory provisions."
  }, {
    "@value" : "The role of an employer in the context of UK apprenticeship funding regulations."
  }, {
    "@value" : "The role of an employer in the context of apprenticeship funding contributions."
  }, {
    "@value" : "The role of an employer in the context of apprenticeship funding."
  }, {
    "@value" : "The role of an employer in the context of apprenticeship progress reviews."
  }, {
    "@value" : "The role of an employer in the context of apprenticeship service accounts."
  }, {
    "@value" : "The role of an individual or entity that employs an apprentice under an apprenticeship agreement."
  }, {
    "@value" : "The role of an organization that employs an apprentice and supports their on-the-job training."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
