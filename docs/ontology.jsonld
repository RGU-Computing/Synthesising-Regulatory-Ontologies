    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A payment made to a main provider upon completion of apprenticeship training, as described in paragraph 161."
  }, {
    "@value" : "Completion payment is a payment we make to providers when an apprentice completes all their learning and undertakes the end-point assessment (the apprentice does not need to pass). This payment is 20% of either the total negotiated price or the funding band maximum, whichever is lower."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
