  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "A letter from the parent(s) confirming the irreconcilable breakdown in family relations and their refusal to support the student may be submitted. If the family rift is so serious that a parental letter cannot be obtained, a letter from a professional third party having first-hand knowledge of the situation may be substituted. If the student was a youth under the guardianship or in an agreement with a provincial or territorial child welfare agency on their 19th birthday, relevant documentation confirming their status is required."
  } ]
