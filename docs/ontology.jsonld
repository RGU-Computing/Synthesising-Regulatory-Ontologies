  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The total income of parents as calculated for student aid purposes, subject to offsets and allowances defined in regulation."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00181"
  } ]
