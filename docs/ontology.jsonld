  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A financial contribution from a student, parent, step-parent, sponsor, legal guardian or spouse to assist with the cost of the student’s program of study. The contribution is automatically assessed during the student need assessment process."
