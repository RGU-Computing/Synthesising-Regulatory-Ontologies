  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/cco-gro/onto#PostCredentialTrainingPattern"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The learning content that must be delivered during the practical period of the apprenticeship."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#LearningActivity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Learning Activity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Action"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An educational or training activity related to an apprenticeship."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#LearningDifficultyOrDisability",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Learning Difficulty or Disability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/cco-gro/onto#FunctionalImpairmentPattern"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A learning difficulty or disability that has been identified and evidenced as a barrier to achieving standard requirements."
  }, {
    "@value" : "A learning difficulty or disability that may impact an apprentice's ability to complete their apprenticeship."
  }, {
    "@value" : "An apprentice having a learning difficulty or disability may form part of a need’s assessment and if it directly impacts on their apprenticeship learning, they could be eligible for learning support."
  }, {
    "@value" : "For the purposes of this section, and as defined in Section 15ZA(6) of the Education Act 1996, a person has a learning difficulty (or disability) if (a) the person has a significantly greater difficulty in learning than the majority of persons of the same age, or (b) the person has a disability which either prevents or hinders the person from making use of facilities of a kind generally provided by institutions providing education or training for persons who are over compulsory school age."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_00124"
  }, {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_00133"
  }, {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_01207"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#LearningEndDate",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Learning End Date"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The date when the last piece of learning has been delivered."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#LearningMaterials",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Learning Materials"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Learning materials used in the delivery of the apprenticeship (e.g. printed, audio / visual and electronic / interactive materials), including any relevant software licences to access these materials where the licence cost is at apprentice level. Learning materials can be developed in-house or bought from a third party and can be refreshed periodically (e.g. to respond to revisions in the standard, learner and employer feedback)."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_00439"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#LearningSupport",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Learning Support"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Financial support that providers can claim to help with the cost of any reasonable adjustments directly related to an apprenticeship, currently a fixed monthly amount of £150."
  }, {
    "@value" : "Support provided to learners during an apprenticeship"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_01208"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#LearningSupportClaim",
