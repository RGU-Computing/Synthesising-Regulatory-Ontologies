  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Student Total Income"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The sum of the student's taxed and untaxed income, as reported on a U.S. tax return."
  } ],
