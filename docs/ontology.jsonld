  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00871_action_5b05d2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Action"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Meet Program Eligibility Criteria"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00871"
  } ],
  "https://www.w3id.org/cco/cco#hasActionExpression" : [ {
    "@value" : "The institution must meet program eligibility criteria including leading to a formal credential, being recognized by the appropriate authority, complying with regulating body requirements, offering and delivering the program on a full-time basis at 100% of a full course load, being at least 12 weeks in duration within a time frame of 15 weeks, having breaks in study not exceeding 10% of the total study period with no break longer than two consecutive weeks (with exceptions for calendar year-end break up to three weeks and breaks around work-integrated learning), and establishing entrance requirements"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00871_condition_eligibility",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Eligibility Criteria Condition"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00871"
  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "The following program eligibility criteria must be met by all institutions: The program must lead to a formal credential (degree, diploma, certificate or citation) issued by the governing body of the institution and be recognized by the appropriate authority that designated the institution. Institutions must also comply with all requirements of their regulating body. The institution must offer and deliver the program on a full-time basis at 100% of a full course load. The program must be at least 12 weeks in duration within a time frame of 15 weeks. The full-time program may have breaks in study so long as they do not exceed 10% of the total study period for the program. In addition, no break can be longer than two consecutive weeks, with the following exceptions: a. Calendar year-end break, which can be up to three weeks in length; and b. Breaks immediately before or after a period of work-integrated learning during academic credit-based programs (funding will only be provided for the period the student is in work-integrated learning plus up to two weeks of break). The institution must establish entrance requirements for the program."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00871_condition_exception",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Exception Conditions for Breaks"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#CAN_UNIT_00871"
  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "Calendar year-end break, which can be up to three weeks in length; and breaks immediately before or after a period of work-integrated learning during academic credit-based programs (funding will only be provided for the period the student is in work-integrated learning plus up to two weeks of break)"
  } ]
}, {
