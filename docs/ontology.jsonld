  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "Net worth is calculated by adding cash, savings, checking, time deposits, money market funds, net worth of investments, and adjusted net worth of business/farm."
  } ]
