  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "EHC Plan or Formal Assessment"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_00202"
  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "The apprentice has either an existing or previously issued education, health and care (EHC) plan (or one of the legacy equivalents: a statement of special educational need (SEN) or a learning difficulty assessment (LDA)), or the provider ensures that a thorough and evidence-based assessment of the individual apprentices’ learning difficulty or disability has been completed in a formal and structured manner by an appropriate professional and a barrier has been identified. Self-declaration of a learning difficulty or a disability is insufficient."
  } ]
