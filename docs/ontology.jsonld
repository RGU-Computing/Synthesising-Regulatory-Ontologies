  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The employer's apprenticeship service account, a digital resource for managing apprenticeships."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmployerCoInvestment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Employer Co-Investment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
