    "@value" : "Employer or Provider Role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The role of an employer or provider in the context of the apprenticeship service."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmployerProvider",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Employer Provider"
  }, {
    "@value" : "Employer-Provider"
  }, {
    "@value" : "Employer-provider"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Agent"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Organisation"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An employer-provider is a levy-paying organisation that is on the ‘employer-provider’ route of the Apprenticeship Provider and Assessment Register (APAR)."
  }, {
    "@value" : "An organisation that acts as an employer-provider, required to hold but not publish subcontracting information."
  }, {
    "@value" : "An organisation that acts as both an employer and a training provider for apprentices."
  }, {
    "@value" : "An organisation that acts as both the employer of an apprentice and the provider of their training."
  }, {
    "@value" : "An organisation that both employs an apprentice and provides their training."
  }, {
    "@value" : "An organisation that provides apprenticeship training and employs the apprentice."
  }, {
    "@value" : "We use the term ‘employer-provider’ where the funding rule only applies to a levy-paying organisation that is listed on the employer-provider route of the APAR. Employer-providers can only deliver apprenticeship training to their own staff or those of a connected company or charity and must do so on an actual cost basis (see paragraph 102)."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_00023"
  }, {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_01200"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmployerProviderAgreement",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Employer-Provider Agreement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An agreement between the employer and provider that participation in a skills competition directly contributes to helping the apprentice achieve the apprenticeship."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmployerProviderOrganisation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Employer-Provider Organisation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
