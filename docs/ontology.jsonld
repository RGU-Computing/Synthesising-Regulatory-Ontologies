  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A claim for learning support made during an apprenticeship"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#LearningSupportFunding",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Learning Support Funding"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A fixed monthly funding allocation for learning support, set at £150 per month."
  }, {
    "@value" : "Financial resources allocated to support learners with additional needs, claimed through ILR and EAS systems."
  }, {
    "@value" : "Funding allocated to providers for delivering reasonable adjustments to learners, claimed monthly and subject to evidence requirements."
  }, {
    "@value" : "Funding allocated to support apprentices with learning difficulties or disabilities."
  }, {
    "@value" : "Funding available to meet the costs incurred by a provider of putting in place reasonable adjustments for an apprentice, as set out in section 20 of the Equality Act 2010."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#UK_UNIT_00133"
  } ]
}, {
