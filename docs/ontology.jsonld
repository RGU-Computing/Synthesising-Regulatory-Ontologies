  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Field Trip and Placement Funding"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Funding allocated for actual costs of field trips, practicums, and clinical placements that are essential elements of an educational program."
  } ]
}, {
