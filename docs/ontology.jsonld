  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A requirement for additional support in learning, which an apprentice may disclose to their employer."
  } ]
}, {
