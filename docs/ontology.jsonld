    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A financial contribution from an employer towards the cost of an apprenticeship, as part of government-employer co-investment"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmployerCompetencyStatement",
