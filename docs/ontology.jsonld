  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Income Offsets Condition"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00188"
  } ],
  "https://www.w3id.org/cco/cco#hasConditionExpression" : [ {
    "@value" : "The sum of the following items decreases the student's total income: Student's taxable college grant and scholarship aid, Student's education credits, Student's Federal Work-Study (FWS)."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/data#USA_UNIT_00188_subject_851b3d",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
