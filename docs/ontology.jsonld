  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A contractual or formal agreement between a main provider and an employer."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/uk#EmployerAndProviderRole",
