}, {
  "@id" : "https://w3id.org/cco-gro/onto",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "Umair Arshad"
  } ],
  "http://purl.org/dc/elements/1.1/description" : [ {
    "@language" : "en",
    "@value" : "A unified regulatory ontology covering education funding regulations from four jurisdictions (UK, US, Canada, Australia), layered over the Core Compliance Ontology (CCO). Contains 1,295 named classes with 362 cross-jurisdiction \nSKOS alignments."
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@language" : "en",
    "@value" : "Unified Legislation Regulatory Ontology: Education Funding Regulations Across Four Jurisdictions (United Kingdom, United States, Canada, Australia)"
  } ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@value" : "Ontology engineering is a complex, time-consuming, and error-prone process, and is particularly demanding in regulatory domains, where knowledge is expressed through obligations, permissions, prohibitions, conditions, and exceptions that require disciplined representation. Existing LLM-based extraction approaches improve scalability, but often struggle to maintain structural consistency in the generated ontology. We present a schema- and pattern-guided approach for regulatory ontology synthesis, in which LLM extraction is constrained directly within a target ontology rather than mapped to it afterward. The method incorporates human expertise through iterative prompt refinement, SHACL shape authoring, and repair-function design. It operates in two steps: structured decomposition of source text into typed components, followed by ontology generation guided by (i) a foundational schema that provides class and property whitelists, and (ii) ontology design patterns retrieved through embedding similarity to support structural alignment. A layered validation architecture combines SHACL conformance checking with SHACL-informed deterministic repair to address property-domain and type-discipline errors introduced during generation. We evaluate the approach through a multi-stage framework covering quality metrics, ontology correctness, and source-text faithfulness. The method is demonstrated on education funding regulations across four jurisdictions, showing that schema- and pattern-constrained generation supports the synthesis of structurally consistent regulatory ontologies."
  } ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@value" : "Arshad, U., Corsar, D., Nkisi-Orji, I. (2026). Synthesising Regulatory Ontologies: A Schema and Pattern-Guided Approach"
  } ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@value" : "David Corsar"
  }, {
    "@value" : "Ikechukwu Nkisi-Orji"
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@value" : "2026-05-23"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/rights" : [ {
    "@language" : "en",
    "@value" : "CC-BY 4.0"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@value" : "https://github.com/RGU-Computing/Synthesising-Regulatory-Ontologies"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/cco-gro/onto/v1.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "1.0"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#AcademicEligibilityRequirementPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'AcademicEligibilityRequirement' captures the universal concept of academic suitability/standing requirements without jurisdiction-specific terms. It is a subclass of cco:Condition and retains only axioms applicable to both aligned classes, satisfying the pattern's constraints on neutrality and universal applicability."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Academic Eligibility Requirement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A condition that must be satisfied by a student to demonstrate they meet the academic criteria required for enrollment or continuation in an educational program, as determined by the institution."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#AcademicWithdrawalResourcePattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'AcademicWithdrawalResource' is jurisdiction-neutral, avoids program-specific terminology, and reflects the universal purpose of the classes as resources for recording withdrawal details. It satisfies the pattern's constraints by being a subclass of cco:Resource and ensuring all axioms apply universally across aligned jurisdictions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Academic Withdrawal Resource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A resource used to document or confirm a student's withdrawal from a study period, including details such as the date, time, and specific units of study affected by the withdrawal."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#AgreementGovernanceObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Agreement Governance Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid86"
  }, {
    "@id" : "_:genid87"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An obligation to establish, maintain, and comply with formal agreements, including documentation, signing, and adherence to agreed terms."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#AncillaryFeePattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The term 'AncillaryFee' captures the supplementary nature of these charges across jurisdictions. It avoids jurisdiction-specific terms while encompassing mandatory fees, non-tuition fees, and membership fees as subclasses. The name satisfies the pattern's constraints by being jurisdiction-neutral and a subclass of cco:Resource."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Ancillary Fee"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A fee or charge associated with educational services or institutional requirements that is not directly related to tuition, academic assessments, or qualification awards."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#ApprenticeshipComplianceObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Apprenticeship Compliance Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid88"
  }, {
    "@id" : "_:genid89"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An obligation to comply with procedural, financial, and documentation requirements related to the establishment, execution, and funding of apprenticeship programs."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#ApprenticeshipFundingMisuseProhibition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Prohibition on Misuse of Apprenticeship Funding"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Prohibition"
  }, {
    "@id" : "_:genid90"
  }, {
    "@id" : "_:genid91"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A regulatory norm that prohibits the improper use of funds, rates, or incentives designated for apprenticeship programs."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#ApprenticeshipSupportAndProgressionPermission",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Apprenticeship Support and Progression Permission"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Permission"
  }, {
    "@id" : "_:genid92"
  }, {
    "@id" : "_:genid93"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A permission that allows for the funding, support, training, and progression of apprentices through various stages of their apprenticeship journey."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#AssessmentActionPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'AssessmentAction' is derived from the common functional purpose of evaluating competence across all jurisdictions. It maintains jurisdiction neutrality by avoiding program-specific terms and correctly positions as a subclass of cco:Action, satisfying the pattern's requirement to retain CCO hierarchy constraints."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Assessment Action"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Action"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An action taken to evaluate an individual's knowledge, skills, or competence in an educational or training context."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#AssessmentProcessObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Assessment Process Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid94"
  }, {
    "@id" : "_:genid95"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An obligation to carry out, manage, and maintain various stages and components of an assessment process, including development, execution, independence, documentation, and alignment."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#AssessmentProcessPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'AssessmentProcess' is jurisdiction-neutral, avoiding any region-specific terminology while capturing the core concept of procedural evaluation shared by both aligned classes. It maintains compatibility with the cco:Resource supertype and satisfies all pattern constraints by focusing on the universal aspect of assessment procedures across jurisdictions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Assessment Process"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A structured procedure for conducting and documenting the evaluation of knowledge, skills, or competencies through standardized methods."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#CircumstanceConditionPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'CircumstanceCondition' captures the common element of 'circumstances' across all aligned classes while maintaining jurisdiction neutrality. It is a subclass of cco:Condition as required, and the label/definition avoid jurisdiction-specific terms while reflecting the universal concept of conditions tied to exceptional or changing situations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Circumstance Condition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A condition arising from specific circumstances that may affect eligibility or require adjustment in program requirements."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#ConfirmationAndComplianceObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Confirmation and Compliance Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid96"
  }, {
    "@id" : "_:genid97"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An obligation to confirm approvals, complete required declarations, and comply with post-approval or statutory requirements."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#CourseCompletionConditionPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'CourseCompletionCondition' combines the universal concepts of 'course completion' (from gro-au:CourseRequirement) and 'condition' (from the CCO supertype). It avoids jurisdiction-specific terms while capturing the shared purpose of both classes as requirements for academic completion. The definition explicitly covers both requirement fulfillment and completion verification across jurisdictions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Course Completion Condition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A condition that must be satisfied for the successful completion of an educational program or study period, encompassing both requirements to be met and verification of completion criteria."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#DiscretionaryAuthorityPermission",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Discretionary Authority Permission"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Permission"
  }, {
    "@id" : "_:genid98"
  }, {
    "@id" : "_:genid99"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A permission norm that grants entities the authority to exercise judgment in considering factors, making determinations, or taking actions within a regulatory framework."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#EducationalLoanDebtPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'EducationalLoanDebt' avoids jurisdiction-specific terms while clearly indicating the universal concept of debt from education-related loans. It satisfies the pattern by being a subclass of cco:Resource and ensuring all axioms apply universally across aligned jurisdictions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Educational Loan Debt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A financial obligation arising from a loan specifically designated to fund educational pursuits, representing the amount owed by a borrower to a lending institution or government program."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#EducationalOrganizationPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'EducationalOrganization' is jurisdiction-neutral, CamelCase, and accurately reflects the universal role of entities in the cluster across education systems. It satisfies the CCO superclass constraint and avoids domain-specific properties not universally applicable."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Educational Organization"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Agent"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Organisation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An organization involved in providing educational programs, qualifications, or training, and may be responsible for administrative functions related to student enrollment, funding, or eligibility."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#EducationalPeriodPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'EducationalPeriod' combines the core concepts of 'fee period' and 'study period' while remaining jurisdiction-neutral. It satisfies the pattern by being a subclass of cco:Resource, avoiding jurisdiction-specific terms, and capturing the universal concept of a time-bound educational financial framework."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Educational Period"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A designated time period associated with an educational program, used for determining financial obligations or support."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#EducationalProgramPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Manually identified theme from decomposition of 120-member transitive cluster into 7 semantically coherent sub-themes after manual review."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Educational Program"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A structured course of study or training program offered by an educational provider."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#EligibilityAndRequirementsObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Eligibility and Requirements Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid100"
  }, {
    "@id" : "_:genid101"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An obligation to meet, verify, or maintain eligibility criteria and regulatory or programmatic requirements."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#EligibilityAssessmentPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'EligibilityAssessment' is jurisdiction-neutral, reflecting the universal purpose of evaluating eligibility across all aligned classes. It avoids jurisdiction-specific terms while capturing the core function shared by Assessment, Formal Assessment, and Initial Assessment under the cco:Action hierarchy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Eligibility Assessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Action"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A structured evaluation process used to determine an individual's eligibility for a program, service, or funding based on predefined criteria."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#EligibilityBasedFinancialAndEnrollmentPermission",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Eligibility-Based Financial and Enrollment Permission"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Permission"
  }, {
    "@id" : "_:genid102"
  }, {
    "@id" : "_:genid103"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A permission that grants students access to financial assistance, enrollment benefits, or academic status changes based on demonstrated eligibility criteria."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#EligibilityVerificationRolePattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'EligibilityVerificationRole' avoids jurisdiction-specific terms while capturing the universal function of verifying student status across aligned jurisdictions. It maintains compatibility with the cco:Role supertype and ensures all axioms apply consistently to both subclasses."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Eligibility Verification Role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A role responsible for verifying a student's eligibility or enrollment status to ensure compliance with institutional or program requirements."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#EnrollmentActionPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'EnrollmentAction' is jurisdiction-neutral, CamelCase, and captures the universal concept of actions impacting student enrollment status. It satisfies the pattern by avoiding jurisdiction-specific terms and ensuring all subclasses are functionally equivalent under the shared CCO supertype 'Action'."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Enrollment Action"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Action"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An action that affects a student's enrollment status in an educational institution, including processes such as enrolling, withdrawing, or applying for leave."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#EnrolmentActionPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'EnrolmentAction' captures the common functional purpose of both aligned classes while avoiding jurisdiction-specific terminology. It maintains compatibility with the cco:Action supertype and satisfies the requirement that all axioms hold universally across jurisdictions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Enrolment Action"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Action"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An action involving the confirmation or reporting of a student's participation in an educational program, regardless of jurisdiction-specific implementation details."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#EvidenceManagementObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Evidence Management Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid104"
  }, {
    "@id" : "_:genid105"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An obligation to manage, retain, provide, document, or possess evidence in accordance with regulatory requirements."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Manually identified theme from decomposition of 120-member transitive cluster into 7 semantically coherent sub-themes after manual review."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Evidentiary Document"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A document, record, or information resource serving as evidence or documentation in regulatory or eligibility contexts."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#ExcludedCostPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'ExcludedCost' is jurisdiction-neutral, captures the universal concept of costs barred from claims, and maintains the CCO hierarchy by subclassing cco:Resource. It avoids domain-specific terms while satisfying cross-jurisdictional applicability."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Excluded Cost"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A cost that is explicitly excluded from being claimed or included under a regulatory scheme due to lack of necessity, relevance, or explicit exclusion criteria."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#FeeManagementObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Fee Management Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid106"
  }, {
    "@id" : "_:genid107"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An obligation to manage, disclose, structure, and apply fees in a transparent, reasonable, and systematic manner."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#FeePolicyDocumentPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'FeePolicyDocument' avoids jurisdiction-specific terms while capturing the core function of both aligned classes as structured documents governing fee-related obligations. It satisfies the pattern by being a subclass of cco:Resource and maintaining jurisdiction-neutral semantics across all aligned instances."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Fee Policy Document"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A formal document outlining the structure, calculation, and payment requirements for educational fees charged by an institution."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#FinancialAidAdministratorRolePattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'FinancialAidAdministratorRole' combines the common functional domain ('FinancialAid') with the role type ('AdministratorRole'), avoiding jurisdiction-specific terms while maintaining alignment with the CCO:Role supertype. It satisfies the pattern by ensuring universal applicability across jurisdictions and adheres to the constraint of not introducing new root classes above CCO."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Financial Aid Administrator Role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A role responsible for administering financial aid programs, including making eligibility determinations and ensuring compliance with relevant regulations."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#FinancialAidResourcePattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Manually identified theme from decomposition of 120-member transitive cluster into 7 semantically coherent sub-themes after manual review."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Financial Aid Resource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A monetary or financial resource representing aid, funding, loans, grants, bursaries, or scholarships allocated to support students or educational programs."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#FinancialNeedAssessmentInputPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Manually named — large transitive cluster (13 members) identified as semantically coherent shared concept after manual review."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Financial Need Assessment Input"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A financial resource or computed value used as input to assess a student's eligibility for financial aid, encompassing income, contributions, expected contributions, and family financial circumstances."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#FunctionalImpairmentPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The term 'FunctionalImpairment' captures the common essence of both aligned classes while avoiding jurisdiction-specific terminology. It satisfies the pattern requirements by maintaining compatibility with the cco:Role supertype and ensuring all axioms apply universally across jurisdictions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Functional Impairment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A condition involving physical, mental, intellectual, cognitive, or sensory limitations that substantially affects an individual's ability to perform everyday activities or engage in learning processes."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#FundingAccessAndAllocationPermission",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Funding Access and Allocation Permission"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Permission"
  }, {
    "@id" : "_:genid108"
  }, {
    "@id" : "_:genid109"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A permission that authorizes access to, allocation of, or claims against funding resources for educational, assistive, or support purposes."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#FundingApplicationPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Manually identified theme from decomposition of 120-member transitive cluster into 7 semantically coherent sub-themes after manual review."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Funding Application"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A formal application or submission for student financial assistance, loan rehabilitation, or other funding programs."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#FundingEligibilityAndDisbursementObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Funding Eligibility and Disbursement Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid110"
  }, {
    "@id" : "_:genid111"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An obligation to assess, confirm, and manage eligibility for funding, followed by the proper disbursement or claiming of funds, including direct retention or payment to providers and subcontractors."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#GovernmentOrganizationPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'GovernmentOrganization' is jurisdiction-neutral, avoids specific program references, and aligns with the confirmed CCO supertype 'Organisation'. It universally captures the shared concept of governmental entities across jurisdictions while adhering to the pattern's constraints."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Government Organization"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Agent"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Organisation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An organization that is part of the government structure, such as a department, agency, or regulatory authority."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#InformationDisclosureObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Information Disclosure Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid112"
  }, {
    "@id" : "_:genid113"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An obligation to provide specified educational information to students or stakeholders before or during enrolment and throughout the course lifecycle."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#JurisdictionalRegulatorPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Manually named due to persistent LLM empty responses across multiple retries."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Jurisdictional Regulator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Agent"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"
  }, {
    "@id" : "_:genid114"
  }, {
    "@id" : "_:genid122"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An agent representing a regulatory authority at the jurisdiction level, responsible for overseeing compliance with regulatory frameworks."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#LearnerInformationRecordPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'LearnerInformationRecord' avoids jurisdiction-specific terms while capturing the core purpose of storing structured learner data across contexts. It satisfies the pattern by aligning with the cco:Resource hierarchy and ensuring all axioms apply universally to the cluster members' shared functionality."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Learner Information Record"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A data record containing learner-specific information used by educational institutions for administrative, assessment, or protection-related purposes."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#LearningPausePattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'LearningPause' is jurisdiction-neutral, combining the universal concepts of 'learning' and 'pause' present in both aligned classes. It avoids jurisdiction-specific terms while accurately reflecting the shared functional equivalence of temporary interruptions in educational engagement across systems."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Learning Pause"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A period during which an individual's learning or study activities are formally paused, typically subject to specific duration limits and exceptions."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#LoanAdjustmentResourcePattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'LoanAdjustmentResource' is CamelCase, jurisdiction-neutral, and reflects the universal concept of loan amount modifications across aligned classes. It satisfies CCO hierarchy constraints by subclassing cco:Resource and avoids domain/range violations by focusing on shared adjustment mechanics rather than jurisdiction-specific programs."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Loan Adjustment Resource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A resource representing an adjustment to a loan amount based on eligibility reassessment or changes in funding parameters, converted from grant excess or increased caps."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#LoanAndEnrolmentMisconductProhibition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Prohibition of Misconduct in Loan and Enrolment Practices"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Prohibition"
  }, {
    "@id" : "_:genid127"
  }, {
    "@id" : "_:genid128"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A prohibition on actions involving improper financial demands, loan misrepresentation, unauthorized payment or borrowing, and misleading suggestions related to enrolment or assistance eligibility."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#NoticeAndProcedureObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Notice and Procedure Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid129"
  }, {
    "@id" : "_:genid130"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An obligation to provide formal notices and maintain established procedures in regulatory or administrative processes."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#OrganizationalExecutiveRolePattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'OrganizationalExecutiveRole' combines jurisdiction-neutral terms ('Organizational' and 'Executive') to reflect the universal concept of a high-level role responsible for organizational governance or management. It satisfies the pattern's constraints by avoiding jurisdiction-specific vocabulary, maintaining subclassing under cco:Role, and ensuring axioms on the shared class apply universally across aligned jurisdictions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Organizational Executive Role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A role held by an individual who is responsible for the overall governance or executive management of an organization, as defined by applicable legal or regulatory frameworks."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#PaymentObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Payment Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid131"
  }, {
    "@id" : "_:genid132"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An obligation to make, manage, or arrange payments or repayments under specified conditions."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#PostCredentialTrainingPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'PostCredentialTraining' combines the concept of training occurring after initial credentialing (from gro-ca:PostCredentialTrainingPeriod) with the general training purpose (from gro-uk:RepeatedTraining and gro-uk:Learning). It avoids jurisdiction-specific terms, maintains compatibility with the cco:Resource hierarchy, and satisfies universal applicability across all aligned classes."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Post-Credential Training"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Training required after obtaining a formal credential to meet the accreditation or licensing requirements of a regulated profession, including repeated training, apprenticeship learning, or structured post-credential development periods."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#ProviderComplianceObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Provider Compliance Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid133"
  }, {
    "@id" : "_:genid134"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Obligations requiring entities to meet eligibility, maintain status, comply with regulations, and uphold transparency and procedural standards as approved providers."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#RecreditAndReborrowPermission",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Recredit and Re-borrow Permission"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Permission"
  }, {
    "@id" : "_:genid135"
  }, {
    "@id" : "_:genid136"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Permission to recredit a HELP balance or re-borrow repaid amounts under specified conditions."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#RegulatoryAgreementPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Manually identified theme from decomposition of 120-member transitive cluster into 7 semantically coherent sub-themes after manual review."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Regulatory Agreement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A contractual or formal agreement between regulated parties such as providers, employers, or institutions."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#RegulatoryComplianceObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Regulatory Compliance Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid137"
  }, {
    "@id" : "_:genid138"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An obligation to adhere to specified legal, regulatory, or standard-based requirements, including ongoing adherence, information management, and rule referencing."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#RegulatoryDecisionPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Manually identified theme from decomposition of 120-member transitive cluster into 7 semantically coherent sub-themes after manual review."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Regulatory Decision"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A formal determination, approval, assessment, or decision issued by a regulatory authority or process."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#RegulatoryOfficialPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Manually named due to persistent LLM empty responses across multiple retries."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Regulatory Official"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#RegulatoryAuthorityRole"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A role held by an individual or organisation exercising regulatory authority, encompassing regulators, secretaries, and other officials with oversight responsibilities."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#RepaymentActionPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'RepaymentAction' is jurisdiction-neutral, capturing the universal concept of returning funds across all aligned classes. It satisfies the pattern's criteria by avoiding jurisdiction-specific terms, maintaining compatibility with the cco:Action supertype, and ensuring all axioms apply universally to repayment scenarios regardless of context."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Repayment Action"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Action"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An action involving the return of funds that were overpaid, borrowed, or received in error, encompassing scenarios such as loan repayments, overpayment corrections, and reimbursement requests."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#SignedDeclarationPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Manually identified theme from decomposition of 120-member transitive cluster into 7 semantically coherent sub-themes after manual review."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Signed Declaration"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A signed document or statement attesting to facts or confirming information for regulatory purposes."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#StudentAcademicAndFinancialComplianceObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Student Academic and Financial Compliance Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid139"
  }, {
    "@id" : "_:genid140"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An obligation requiring students to meet academic progress, enrollment, and financial responsibilities to maintain eligibility and compliance with educational funding and institutional requirements."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#StudentAidModificationConditionPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'StudentAidModificationCondition' avoids jurisdiction-specific terms while capturing the universal concept of a condition affecting financial aid. It satisfies the pattern by maintaining compatibility with the cco:Condition supertype and ensuring all axioms apply universally to both withdrawal/deferral and appeal scenarios."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Student Aid Modification Condition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A condition that triggers a change in a student's financial aid status due to enrollment adjustments or administrative review processes."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#StudentEnrollmentPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'StudentEnrollment' is jurisdiction-neutral, combining the core concepts of 'Course Load' and 'Student Enrolment' while avoiding region-specific terminology. It maintains compatibility with the cco:Resource supertype and ensures all axioms apply universally across aligned jurisdictions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Student Enrollment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The formal registration of a student in one or more academic courses or programs during a specified period, representing their participation status and course commitments."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#StudentGrievanceMechanismPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'StudentGrievanceMechanism' combines the universal concept of student-initiated dispute resolution ('Grievance') with the neutral term 'Mechanism' to encompass both procedural and form-based implementations. It avoids jurisdiction-specific terms while maintaining alignment with the CCO:Resource hierarchy and satisfying cross-jurisdictional axiom constraints."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Student Grievance Mechanism"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A formal process or form used by students to initiate or resolve complaints or appeals regarding academic or administrative matters within an educational institution."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#StudentProceduralResourcePattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'StudentProceduralResource' combines the universal scope ('Student'), the functional purpose ('Procedural'), and the CCO hierarchy ('Resource'). It avoids jurisdiction-specific terms while capturing the common theme of structured processes or information required of students, satisfying all pattern constraints and review criteria."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Student Procedural Resource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A resource representing processes, procedures, or information required for student compliance with enrollment, verification, or documentation requirements across educational contexts."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#StudentRolePattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Manually named — large transitive cluster (41 members) identified as semantically coherent shared concept after manual review."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Student Role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A role held by an individual enrolled in or applying for an educational program, encompassing variations in dependency status, enrollment status, and program-specific eligibility across jurisdictions."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#StudentWithdrawalManagementPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'StudentWithdrawalManagement' is jurisdiction-neutral, combining the core concepts of withdrawal processes (gro-au) and refund policies (gro-ca). It satisfies the pattern by avoiding jurisdiction-specific terms, maintaining compatibility with the cco:Resource supertype, and ensuring all axioms apply universally to both aligned classes."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Student Withdrawal Management"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A framework or set of procedures established by educational institutions to manage student withdrawals, including processes for deferral and refund policies."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#TaxRegulatoryAuthorityAgentPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'TaxRegulatoryAuthorityAgent' reflects the universal function of tax administration and enforcement shared by the aligned classes (IRS, ATO) while maintaining jurisdiction neutrality. It directly extends the confirmed CCO supertype 'RegulatoryAuthorityAgent' and avoids any jurisdiction-specific terminology."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Tax Regulatory Authority Agent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Agent"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"
  }, {
    "@id" : "_:genid141"
  }, {
    "@id" : "_:genid149"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A regulatory authority agent responsible for tax collection, administration, and enforcement of tax-related laws within a jurisdiction."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#TotalProgramCostPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'TotalProgramCost' is jurisdiction-neutral, avoiding specific terms like 'tuition' or 'training' while capturing the universal concept of aggregated program expenses. It satisfies the pattern by being a subclass of cco:Resource and ensuring all axioms apply universally across aligned jurisdictions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Total Program Cost"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The total cost of an educational or training program, including tuition, training, and any associated assessments or fees incurred to date."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#TrainingAndDeliveryObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Training and Delivery Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid154"
  }, {
    "@id" : "_:genid155"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An obligation requiring providers to deliver, manage, and be accountable for training and learning activities, including assessment and off-the-job components."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#TrainingDeliveryAndDocumentationObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Training Delivery and Documentation Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid156"
  }, {
    "@id" : "_:genid157"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An obligation to deliver, document, and maintain records of training activities, including off-the-job training, skill relevance, and planned parameters."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#TrainingProviderOrEmployerPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The name 'TrainingProviderOrEmployer' captures the dual role of entities across jurisdictions as either training service providers or employers involved in training partnerships. It avoids jurisdiction-specific terms and aligns with the confirmed CCO supertype 'Organisation', satisfying all pattern constraints."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Training Provider or Employer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Agent"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Organisation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An organization that either provides training services or is an employer engaged in training arrangements with educational institutions or training providers."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#TuitionFeeChargingAndInclusionProhibition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Prohibition on Charging and Including Tuition Fees and Associated Costs"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Prohibition"
  }, {
    "@id" : "_:genid158"
  }, {
    "@id" : "_:genid159"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A prohibition on charging excessive, unnecessary, or unauthorized tuition fees and on including non-essential goods, services, or costs within tuition fees."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#TuitionFeeManagementObligation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Tuition Fee Management Obligation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Obligation"
  }, {
    "@id" : "_:genid160"
  }, {
    "@id" : "_:genid161"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An obligation to manage tuition fees through setting, publishing, explaining, refunding, and disclosing related financial information."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto#hasSubject",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/au#ACCC",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACCC"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Agent"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"
  }, {
    "@id" : "_:genid162"
  }, {
    "@id" : "_:genid170"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The Australian Competition and Consumer Commission, an independent Commonwealth statutory authority."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/au#ACTACMember",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ACTAC Member"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A member of the Australasian Conference of Tertiary Admission Centres."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/au#AQFQualification",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "AQF Qualification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A qualification issued under the Australian Qualifications Framework or a predecessor framework."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/au#ASQA",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ASQA"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Agent"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"
  }, {
    "@id" : "_:genid175"
  }, {
    "@id" : "_:genid183"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The Australian Skills Quality Authority, the national regulator for Australia's vocational education and training sector."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/au#ATO",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ATO"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/cco-gro/onto#TaxRegulatoryAuthorityAgentPattern"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Agent"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent"
  }, {
    "@id" : "_:genid188"
  }, {
    "@id" : "_:genid196"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "https://w3id.org/cco-gro/onto/us#IRS"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The Australian Taxation Office, the principal revenue collection agency of the Australian Government."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/au#AcademicSuitabilityAssessment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Academic Suitability Assessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/cco-gro/onto#AssessmentActionPattern"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Action"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "https://w3id.org/cco-gro/onto/uk#AssessmentAction"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An assessment required to show that a student is academically suited to undertake a course."
  }, {
    "@value" : "The process of determining whether a student is academically suited to undertake an approved course, including any tasks the student is required to complete for that purpose."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/au#AcademicSuitabilityEvidence",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Academic Suitability Evidence"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/cco-gro/onto#EvidentiaryDocumentPattern"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "https://w3id.org/cco-gro/onto/uk#ApplicationAndSupportingEvidence"
  }, {
    "@id" : "https://w3id.org/cco-gro/onto/uk#SufficientEvidence"
  }, {
    "@id" : "https://w3id.org/cco-gro/onto/uk#WrittenEvidence"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Evidence required to show academic suitability, including qualifications, assessments, or overseas qualification letters."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/au#AcademicallySuitable",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Academically Suitable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/cco-gro/onto#AcademicEligibilityRequirementPattern"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "https://w3id.org/cco-gro/onto/ca#ScholasticStandingRequirement"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Determining whether the student is academically suitable The course provider decides whether the student is academically suited to the course they're applying for. A student is academically suited to a course when:"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#AUS_UNIT_00289"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/au#AccessibleDefinedTerm",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Accessible Defined Term"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "accessible means you have informed the student the information or document is to be given using the system, and have authorised the student to use the system"
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#AUS_UNIT_00458"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/au#AccompanyingPerson",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Accompanying Person"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Agent"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Person"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Another person who accompanies or assists a party"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/au#AccreditedCourse",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Accredited Course"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A course that has been accredited by the relevant Australian higher education authority."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/au#AccumulatedDebtForCourse",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Accumulated Debt for Course"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Accumulated debt for course is an indicative cumulative debt amount accrued by the student for the VET course code, as reported by providers in TCSI. This amount may be adjusted when payment claims are validated. It may include both VET FEE-HELP and VSL accrued from 1 January 2017."
  } ],
  "http://www.w3.org/ns/prov#wasDerivedFrom" : [ {
    "@id" : "https://w3id.org/cco-gro/data#AUS_UNIT_00846"
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/au#ActualTotalTuitionFee",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Actual Total Tuition Fee"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/cco-gro/onto#TotalProgramCostPattern"
  }, {
    "@id" : "https://www.w3id.org/cco/cco#Resource"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "https://w3id.org/cco-gro/onto/uk#TrainingCost"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The actual total of the tuition fees for a course, which may exceed the estimate under certain conditions."
  } ]
}, {
  "@id" : "https://w3id.org/cco-gro/onto/au#AdministrativeErrorCorrection",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Administrative Error Correction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://www.w3id.org/cco/cco#Condition"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A condition where a change is made to correct an administrative error."
