###  https://w3id.org/cco-gro/onto/uk#RegulatoryAuthority
<https://w3id.org/cco-gro/onto/uk#RegulatoryAuthority> rdf:type owl:Class ;
                                                       rdfs:subClassOf :GovernmentOrganizationPattern ,
                                                                       <https://www.w3id.org/cco/cco#Agent> ,
                                                                       <https://www.w3id.org/cco/cco#Organisation> ,
                                                                       <https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent> ,
                                                                       [ owl:intersectionOf ( <https://www.w3id.org/cco/cco#Agent>
                                                                                              [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty <https://www.w3id.org/cco/cco#holdsRole> ;
                                                                                                owl:someValuesFrom [ owl:intersectionOf ( <https://www.w3id.org/cco/cco#RoleHolding>
                                                                                                                                          [ rdf:type owl:Restriction ;
                                                                                                                                            owl:onProperty <https://www.w3id.org/cco/cco#hasRole> ;
                                                                                                                                            owl:someValuesFrom <https://www.w3id.org/cco/cco#RegulatoryAuthorityRole>
                                                                                                                                          ]
                                                                                                                                        ) ;
                                                                                                                     rdf:type owl:Class
                                                                                                                   ]
                                                                                              ]
                                                                                            ) ;
                                                                         rdf:type owl:Class
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://www.w3id.org/cco/cco#holdsRole> ;
                                                                         owl:someValuesFrom [ owl:intersectionOf ( <https://www.w3id.org/cco/cco#RoleHolding>
                                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                                     owl:onProperty <https://www.w3id.org/cco/cco#hasRole> ;
                                                                                                                     owl:someValuesFrom <https://www.w3id.org/cco/cco#RegulatoryAuthorityRole>
                                                                                                                   ]
                                                                                                                 ) ;
                                                                                              rdf:type owl:Class
                                                                                            ]
                                                                       ] ;
                                                       rdfs:label "Regulatory Authority" ;
                                                       <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/cco-gro/onto/us#Department> ;
                                                       <http://www.w3.org/2004/02/skos/core#definition> "The authority referred to as 'us' in the provision, responsible for receiving reports of inconsistencies." ,
                                                                                                        "The government body responsible for enforcing apprenticeship funding rules, referred to as 'we'." .


###  https://w3id.org/cco-gro/onto/uk#RegulatoryBody
<https://w3id.org/cco-gro/onto/uk#RegulatoryBody> rdf:type owl:Class ;
