#################################################################
#    Object Properties
#################################################################

###  https://www.w3id.org/cco/cco#allocatedTo
<https://www.w3id.org/cco/cco#allocatedTo> rdf:type owl:ObjectProperty ;
                                           rdfs:subPropertyOf <https://www.w3id.org/cco/cco#allocatedTo> ;
                                           rdfs:domain owl:Thing ,
                                                       <https://www.w3id.org/cco/cco#Resource> ;
                                           rdfs:range owl:Thing ,
                                                      <https://www.w3id.org/cco/cco#Agent> ;
                                           rdfs:label "allocated to"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "Relates a resource to the agent to whom that resource is allocated."@en .


###  https://www.w3id.org/cco/cco#appliesToRole
<https://www.w3id.org/cco/cco#appliesToRole> rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf <https://www.w3id.org/cco/cco#appliesToRole> ;
                                             rdfs:domain owl:Thing ,
                                                         <https://www.w3id.org/cco/cco#Norm> ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://www.w3id.org/cco/cco#hasApplicabilityEnd> ;
                                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                           owl:onDataRange xsd:date
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://www.w3id.org/cco/cco#hasApplicabilityStart> ;
                                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                           owl:onDataRange xsd:date
                                                         ] ;
                                             rdfs:range owl:Thing ,
                                                        <https://www.w3id.org/cco/cco#Role> ;
                                             rdfs:label "applies to role"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "Relates a norm to the role to which that norm applies."@en .


###  https://www.w3id.org/cco/cco#appliesUnder
<https://www.w3id.org/cco/cco#appliesUnder> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <https://www.w3id.org/cco/cco#appliesUnder> ;
                                            rdfs:domain owl:Thing ,
                                                        <https://www.w3id.org/cco/cco#Norm> ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://www.w3id.org/cco/cco#hasApplicabilityEnd> ;
                                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onDataRange xsd:date
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://www.w3id.org/cco/cco#hasApplicabilityStart> ;
                                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onDataRange xsd:date
                                                        ] ;
                                            rdfs:range owl:Thing ,
                                                       <https://www.w3id.org/cco/cco#Condition> ;
                                            rdfs:label "applies under"@en ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "Relates a norm to a condition under which that norm becomes applicable."@en .


###  https://www.w3id.org/cco/cco#hasAction
<https://www.w3id.org/cco/cco#hasAction> rdf:type owl:ObjectProperty ;
                                         rdfs:subPropertyOf <https://www.w3id.org/cco/cco#hasAction> ;
                                         rdfs:domain owl:Thing ,
                                                     <https://www.w3id.org/cco/cco#Norm> ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://www.w3id.org/cco/cco#hasApplicabilityEnd> ;
                                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                       owl:onDataRange xsd:date
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://www.w3id.org/cco/cco#hasApplicabilityStart> ;
                                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                       owl:onDataRange xsd:date
                                                     ] ;
                                         rdfs:range owl:Thing ,
                                                    <https://www.w3id.org/cco/cco#Action> ;
                                         rdfs:label "has action"@en ;
                                         <http://www.w3.org/2004/02/skos/core#definition> "Relates a norm to the action that the norm requires, permits, or prohibit."@en .


###  https://www.w3id.org/cco/cco#hasCondition
<https://www.w3id.org/cco/cco#hasCondition> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <https://www.w3id.org/cco/cco#hasCondition> ;
                                            rdfs:domain owl:Thing ,
                                                        <https://www.w3id.org/cco/cco#Exception> ,
                                                        [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://www.w3id.org/cco/cco#hasCondition> ;
                                                                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                 owl:onClass <https://www.w3id.org/cco/cco#Condition>
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://www.w3id.org/cco/cco#modifiesNorm> ;
                                                                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                 owl:onClass <https://www.w3id.org/cco/cco#Norm>
                                                                               ]
                                                                             ) ;
                                                          rdf:type owl:Class
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://www.w3id.org/cco/cco#hasCondition> ;
                                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onClass <https://www.w3id.org/cco/cco#Condition>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://www.w3id.org/cco/cco#modifiesNorm> ;
                                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onClass <https://www.w3id.org/cco/cco#Norm>
                                                        ] ;
                                            rdfs:range owl:Thing ,
                                                       <https://www.w3id.org/cco/cco#Condition> ;
                                            rdfs:label "has condition"@en ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "Relates an exception to a condition under which that exception applies to modify a norm."@en .


###  https://www.w3id.org/cco/cco#hasException
<https://www.w3id.org/cco/cco#hasException> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <https://www.w3id.org/cco/cco#hasException> ;
                                            rdfs:domain owl:Thing ,
                                                        <https://www.w3id.org/cco/cco#Norm> ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://www.w3id.org/cco/cco#hasApplicabilityEnd> ;
                                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onDataRange xsd:date
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://www.w3id.org/cco/cco#hasApplicabilityStart> ;
                                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onDataRange xsd:date
                                                        ] ;
                                            rdfs:range owl:Thing ,
                                                       <https://www.w3id.org/cco/cco#Exception> ,
                                                       [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <https://www.w3id.org/cco/cco#hasCondition> ;
                                                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                owl:onClass <https://www.w3id.org/cco/cco#Condition>
                                                                              ]
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <https://www.w3id.org/cco/cco#modifiesNorm> ;
                                                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                owl:onClass <https://www.w3id.org/cco/cco#Norm>
                                                                              ]
                                                                            ) ;
                                                         rdf:type owl:Class
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://www.w3id.org/cco/cco#hasCondition> ;
                                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass <https://www.w3id.org/cco/cco#Condition>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://www.w3id.org/cco/cco#modifiesNorm> ;
                                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass <https://www.w3id.org/cco/cco#Norm>
                                                       ] ;
                                            rdfs:label "has exception"@en ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "Relates a norm to an exception that modifies the applicability or force of that norm in a particular case."@en .


###  https://www.w3id.org/cco/cco#hasObject
<https://www.w3id.org/cco/cco#hasObject> rdf:type owl:ObjectProperty ;
                                         rdfs:subPropertyOf <https://www.w3id.org/cco/cco#hasObject> ;
                                         rdfs:domain owl:Thing ,
                                                     <https://www.w3id.org/cco/cco#Norm> ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://www.w3id.org/cco/cco#hasApplicabilityEnd> ;
                                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                       owl:onDataRange xsd:date
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <https://www.w3id.org/cco/cco#hasApplicabilityStart> ;
                                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                       owl:onDataRange xsd:date
                                                     ] ;
                                         rdfs:range owl:Thing ,
                                                    <https://www.w3id.org/cco/cco#Resource> ;
                                         rdfs:label "has object"@en ;
                                         <http://www.w3.org/2004/02/skos/core#definition> "Relates a norm to the resource that the norm’s action affects or targets."@en .


###  https://www.w3id.org/cco/cco#hasRole
<https://www.w3id.org/cco/cco#hasRole> rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf <https://www.w3id.org/cco/cco#hasRole> ;
                                       rdf:type owl:FunctionalProperty ;
                                       rdfs:domain owl:Thing ,
                                                   <https://www.w3id.org/cco/cco#RoleHolding> ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://www.w3id.org/cco/cco#hasRole> ;
                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass <https://www.w3id.org/cco/cco#Role>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://www.w3id.org/cco/cco#hasStartTime> ;
                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:date
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://www.w3id.org/cco/cco#hasEndTime> ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:date
                                                   ] ;
                                       rdfs:range owl:Thing ,
                                                  <https://www.w3id.org/cco/cco#Role> ;
                                       rdfs:label "has role"@en ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "Relates a Role Holding association to the role held by the agent."@en .


###  https://www.w3id.org/cco/cco#holdsRole
<https://www.w3id.org/cco/cco#holdsRole> rdf:type owl:ObjectProperty ;
                                         rdfs:subPropertyOf <https://www.w3id.org/cco/cco#holdsRole> ;
                                         rdfs:domain owl:Thing ,
                                                     <https://www.w3id.org/cco/cco#Agent> ;
                                         rdfs:range owl:Thing ,
                                                    <https://www.w3id.org/cco/cco#RoleHolding> ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://www.w3id.org/cco/cco#hasRole> ;
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onClass <https://www.w3id.org/cco/cco#Role>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://www.w3id.org/cco/cco#hasStartTime> ;
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:date
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://www.w3id.org/cco/cco#hasEndTime> ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:date
                                                    ] ;
                                         rdfs:label "holds role"@en ;
                                         <http://www.w3.org/2004/02/skos/core#definition> "Relates an agent to the time-bounded association through which that agent holds a role."@en .


###  https://www.w3id.org/cco/cco#issues
<https://www.w3id.org/cco/cco#issues> rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf <https://www.w3id.org/cco/cco#issues> ;
                                      rdfs:domain owl:Thing ,
                                                  <https://www.w3id.org/cco/cco#Agent> ,
                                                  <https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent> ,
                                                  [ owl:intersectionOf ( <https://www.w3id.org/cco/cco#Agent>
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <https://www.w3id.org/cco/cco#holdsRole> ;
                                                                           owl:someValuesFrom [ owl:intersectionOf ( <https://www.w3id.org/cco/cco#RoleHolding>
                                                                                                                     [ rdf:type owl:Restriction ;
                                                                                                                       owl:onProperty <https://www.w3id.org/cco/cco#hasRole> ;
                                                                                                                       owl:someValuesFrom <https://www.w3id.org/cco/cco#RegulatoryAuthorityRole>
                                                                                                                     ]
                                                                                                                   ) ;
                                                                                                rdf:type owl:Class
                                                                                              ]
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://www.w3id.org/cco/cco#holdsRole> ;
                                                    owl:someValuesFrom [ owl:intersectionOf ( <https://www.w3id.org/cco/cco#RoleHolding>
                                                                                              [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty <https://www.w3id.org/cco/cco#hasRole> ;
                                                                                                owl:someValuesFrom <https://www.w3id.org/cco/cco#RegulatoryAuthorityRole>
                                                                                              ]
                                                                                            ) ;
                                                                         rdf:type owl:Class
                                                                       ]
                                                  ] ;
                                      rdfs:range owl:Thing ,
                                                 <https://www.w3id.org/cco/cco#Regulation> ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty <https://www.w3id.org/cco/cco#specifiesNorm> ;
                                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass <https://www.w3id.org/cco/cco#Norm>
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty <https://www.w3id.org/cco/cco#hasValidityStart> ;
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:date
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty <https://www.w3id.org/cco/cco#hasValidityEnd> ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:date
                                                 ] ;
                                      rdfs:label "issues"@en ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Relates a regulatory authority agent to a regulation that the agent issues."@en .


###  https://www.w3id.org/cco/cco#modifiesNorm
