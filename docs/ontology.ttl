                                                            <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#UK_UNIT_00597> .


<https://w3id.org/cco-gro/onto/au#AdministrativeReviewTribunalAct2024Part10> rdfs:label "Administrative Review Tribunal Act 2024 Part 10" ;
                                                                             <http://www.w3.org/2004/02/skos/core#definition> "The Administrative Review Tribunal Act 2024 Part 10, which establishes the right to apply for review of decisions." ;
                                                                             <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#AUS_UNIT_00539> .


<https://w3id.org/cco-gro/onto/au#SpecifiedProvider> rdfs:label "Specified Provider" ;
                                                     <http://www.w3.org/2004/02/skos/core#definition> "A provider specified in Schedule 3 of the Determination as eligible to offer approved courses." .


<https://w3id.org/cco-gro/onto/ca#AdultUpgradingGrantPolicyManual> rdfs:label "Adult Upgrading Grant Policy Manual" ;
                                                                   <http://www.w3.org/2004/02/skos/core#definition> "The Adult Upgrading Grant Policy and Procedures Manual, which contains the policy set out by the Province of British Columbia for determining student eligibility." .


<https://w3id.org/cco-gro/onto/ca#ApplicationAndLoanPayments> rdfs:label "Application and Loan Payments" ;
                                                              <http://www.w3.org/2004/02/skos/core#definition> "The borrower's application and associated loan payments that are subject to hold and suspension." .


<https://w3id.org/cco-gro/onto/ca#BorrowerSelectedForRAPVerification> rdfs:label "Borrower Selected for RAP Verification" ;
                                                                      <http://www.w3.org/2004/02/skos/core#definition> "A borrower who has been selected for Repayment Assistance Plan (RAP) application verification." .


<https://w3id.org/cco-gro/onto/ca#ParentalExpectedContribution> rdfs:label "Parental Expected Contribution" ;
                                                                <http://www.w3.org/2004/02/skos/core#definition> "A calculated financial resource representing the expected parental contribution for a single dependent student, based on the sponsor's income and assets when the sponsor is a parent." ,
                                                                                                                 "The expected financial contribution from parents, step-parents, sponsors, or legal guardians of single dependent students toward the student's education, calculated based on assessed financial ability." ;
                                                                <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#CAN_UNIT_00425> .


<https://w3id.org/cco-gro/onto/ca#SpousalExpectedContribution> rdfs:label "Spousal Expected Contribution" ;
                                                               <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/cco-gro/onto/us#ContributionFromAssets> ,
                                                                                                                <https://w3id.org/cco-gro/onto/us#IncomeAllowanceCalculation> ,
                                                                                                                <https://w3id.org/cco-gro/onto/us#ParentsContribution> ,
                                                                                                                <https://w3id.org/cco-gro/onto/us#ParentsContributionFromAssets> ,
                                                                                                                <https://w3id.org/cco-gro/onto/us#StudentContributionFromIncome> ;
                                                               <http://www.w3.org/2004/02/skos/core#definition> "A calculated amount representing the expected financial contribution from a spouse, based on spousal income, used in student assessment." ;
                                                               <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#CAN_UNIT_00429> .


<https://w3id.org/cco-gro/onto/ca#StudentRole> rdfs:label "Student Role" ;
                                               <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/cco-gro/onto/uk#Learner> ,
                                                                                                <https://w3id.org/cco-gro/onto/us#DependentStudent> ,
                                                                                                <https://w3id.org/cco-gro/onto/us#FAFSAStudentRole> ,
                                                                                                <https://w3id.org/cco-gro/onto/us#Student> ,
                                                                                                <https://w3id.org/cco-gro/onto/us#StudentRole> ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "A role held by an individual enrolled in an educational program, eligible for APSD funding." ,
                                                                                                "A role held by an individual enrolled in an educational program, making them subject to student financial assistance rules." ,
                                                                                                "The role of a student attending an educational program." ,
                                                                                                "The role of a student eligible for funding under Canadian regulations." ,
                                                                                                "The role of a student in the context of Canadian regulatory provisions." ,
                                                                                                "The role of a student receiving Canada Student Grant for Part-Time Studies." ,
                                                                                                "The role of a student receiving financial assistance." ,
                                                                                                "The role of an individual enrolled as a student in a post-secondary institution." ,
                                                                                                "The role of an individual enrolled in an educational program seeking financial assistance." ,
                                                                                                "The role of an individual enrolled in an educational program who may be eligible for financial assistance." ,
                                                                                                "The role of an individual enrolled in an educational program, eligible for student financial assistance." ,
                                                                                                "The role of an individual enrolled in an educational program, eligible to request funding and loan rehabilitation application reviews." ,
                                                                                                "The role of an individual enrolled in an educational program." ,
                                                                                                "The role of an individual enrolled in part-time or full-time studies at a designated educational institution." ,
                                                                                                "The role of an individual enrolled in post-secondary education." ,
                                                                                                "The role of an individual enrolled in post-secondary study." .


<https://w3id.org/cco-gro/onto/uk#Apprentice> rdfs:label "Apprentice" ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "A person undertaking an apprenticeship programme." ,
                                                                                               "A person undertaking an apprenticeship who may be eligible for funding claims." ,
                                                                                               "A person undertaking an apprenticeship." ,
                                                                                               "A person who is learning a trade from a skilled employer, having agreed to work for a fixed period at low wages." ,
                                                                                               "A person who is learning a trade from a skilled employer." ,
                                                                                               "A person who is undertaking an apprenticeship programme." ,
                                                                                               "A role of an individual who is learning a trade under an apprenticeship program." ,
                                                                                               "An individual engaged in apprenticeship training, assessment, or end-point assessment." ,
                                                                                               "An individual undertaking an apprenticeship program" ,
                                                                                               "An individual undertaking an apprenticeship programme, including study of English and/or maths." ,
                                                                                               "An individual undertaking an apprenticeship programme." ,
                                                                                               "An individual undertaking an apprenticeship, combining work with study under a formal training agreement." ,
                                                                                               "An individual undertaking an apprenticeship." ,
                                                                                               "The role of an individual undertaking an apprenticeship." .


<https://w3id.org/cco-gro/onto/uk#ApprenticeDetails> rdfs:label "Apprentice Details" ;
                                                     <http://www.w3.org/2004/02/skos/core#definition> "The details of an apprentice that are entered into the apprenticeship service account." ,
                                                                                                      "The personal and programme details of an apprentice recorded in the apprenticeship service." .


<https://w3id.org/cco-gro/onto/uk#Employer> rdfs:label "Employer" ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "A person or organization that employs people, in this context the employer of an apprentice." ,
                                                                                             "A person or organization that employs people." ,
                                                                                             "A role for entities that employ individuals and may receive financial assistance." ,
                                                                                             "A role for entities that employ individuals and may receive payments or confirmations." ,
                                                                                             "An employer of an apprentice." ,
                                                                                             "An employer organisation responsible for making a new reservation if the original expires before the apprentice starts." ,
                                                                                             "An organisation that employs an apprentice and is party to an apprenticeship agreement." ,
                                                                                             "An organisation that employs an apprentice and is party to the training plan." ,
                                                                                             "An organisation that employs an apprentice and participates in the apprenticeship programme." ,
                                                                                             "An organisation that employs an apprentice and supports their training." ,
                                                                                             "An organisation that employs an apprentice." ,
                                                                                             "An organisation that employs apprentices and is responsible for ensuring apprenticeship compliance." ,
                                                                                             "An organisation that employs apprentices and is responsible for paying their wages." ,
                                                                                             "An organisation that employs apprentices." ,
                                                                                             "An organisation that employs individuals and enters into agreements with providers." ,
                                                                                             "An organisation that employs individuals and enters into contracts for services." ,
                                                                                             "An organisation that employs individuals and participates in training arrangements." ,
                                                                                             "An organisation that employs individuals, including as an apprenticeship employer." ,
                                                                                             "The employer responsible for the apprenticeship, who must pay the difference when the overall price exceeds the funding band maximum." ,
                                                                                             "The role of an organisation or person employing an apprentice." .


<https://w3id.org/cco-gro/onto/uk#EmployerProviderRole> rdfs:label "Employer-Provider Role" ;
                                                        <http://www.w3.org/2004/02/skos/core#definition> "The role of a subcontractor acting as an employer-provider for apprenticeship training" ,
                                                                                                         "The role of an entity that operates as both an employer and a training provider." .


<https://w3id.org/cco-gro/onto/uk#EmployerRole> rdfs:label "Employer Role" ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "The role of an employer as defined by UK apprenticeship funding rules." ,
                                                                                                 "The role of an employer as defined in UK employment regulations." ,
                                                                                                 "The role of an employer as defined in the UK apprenticeship funding context." ,
                                                                                                 "The role of an employer as defined in the UK apprenticeship regulatory context." ,
                                                                                                 "The role of an employer as defined in the context of UK apprenticeship regulations." ,
                                                                                                 "The role of an employer as referenced in UK regulatory provisions." ,
                                                                                                 "The role of an employer in the context of UK apprenticeship funding regulations." ,
                                                                                                 "The role of an employer in the context of apprenticeship funding contributions." ,
                                                                                                 "The role of an employer in the context of apprenticeship funding." ,
                                                                                                 "The role of an employer in the context of apprenticeship progress reviews." ,
                                                                                                 "The role of an employer in the context of apprenticeship service accounts." ,
                                                                                                 "The role of an individual or entity that employs an apprentice under an apprenticeship agreement." ,
                                                                                                 "The role of an organization that employs an apprentice and supports their on-the-job training." ;
                                                <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#UK_UNIT_00977> .


<https://w3id.org/cco-gro/onto/uk#ProviderRole> rdfs:label "Provider Role" ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "The role of a training provider in the context of apprenticeship service accounts." ,
                                                                                                 "The role of a training provider in the context of apprenticeship standards." ,
                                                                                                 "The role of an entity that provides apprenticeship programmes." ,
                                                                                                 "The role of an organization responsible for delivering apprenticeship training." .


<https://w3id.org/cco-gro/onto/us#FinancialAidAdministrator> rdfs:label "Financial Aid Administrator" ;
                                                             <http://www.w3.org/2004/02/skos/core#definition> "A role held by an FAA who may use professional judgment to count a benefit." ,
                                                                                                              "A role responsible for administering financial aid at an institution, including making dependency override determinations." ,
                                                                                                              "A role responsible for administering financial aid programs, including making professional judgment decisions." ,
                                                                                                              "A role responsible for processing student financial aid requests and determinations." .


