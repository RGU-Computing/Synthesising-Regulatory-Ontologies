###  https://w3id.org/cco-gro/onto/uk#TrainingPlan
<https://w3id.org/cco-gro/onto/uk#TrainingPlan> rdf:type owl:Class ;
                                                rdfs:subClassOf :EvidentiaryDocumentPattern ,
                                                                <https://w3id.org/cco-gro/onto/uk#Document> ,
                                                                <https://www.w3id.org/cco/cco#Resource> ;
                                                rdfs:label "Training Plan" ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A document detailing how English and maths will be delivered within the apprenticeship programme." ,
                                                                                                 "A document detailing the planned training activities and schedule for an apprenticeship." ,
                                                                                                 "A document outlining the broad content of a training program that must be agreed before delivery." ,
                                                                                                 "A document outlining the training objectives, content, and schedule for an individual." ,
                                                                                                 "A document outlining the training plan for an apprenticeship" ,
                                                                                                 "A document outlining the training plan for an apprenticeship, signed by the provider, employer, and apprentice." ,
                                                                                                 "A document outlining the training plan for an apprenticeship." ,
                                                                                                 "A document outlining the training plan, signed and dated by all parties, meeting specified criteria and kept up to date with material changes." ,
                                                                                                 "A document outlining the training program, signed by the provider, employer, and apprentice" ,
                                                                                                 "A documented plan outlining the learning activities for an apprenticeship." ,
                                                                                                 "A documented plan outlining the training activities and schedule for an apprenticeship." ,
                                                                                                 "A documented plan outlining the training delivery model and schedule." ,
                                                                                                 "A documented plan outlining the training requirements and activities for a learner." ,
                                                                                                 "A signed document that describes the delivery schedule for English and/or maths active learning." ,
                                                                                                 "An agreed plan documenting training activities." ,
