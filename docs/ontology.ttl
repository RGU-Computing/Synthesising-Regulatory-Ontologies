[ owl:intersectionOf ( <https://www.w3id.org/cco/cco#Agent>
                       [ rdf:type owl:Restriction ;
                         owl:onProperty <https://www.w3id.org/cco/cco#holdsRole> ;
                         owl:someValuesFrom [ owl:intersectionOf ( <https://www.w3id.org/cco/cco#RoleHolding>
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <https://www.w3id.org/cco/cco#hasRole> ;
                                                                     owl:someValuesFrom <https://www.w3id.org/cco/cco#RegulatoryAuthorityRole>
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ]
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf <https://www.w3id.org/cco/cco#Agent>
] .


[ owl:intersectionOf ( <https://www.w3id.org/cco/cco#Agent>
                       [ rdf:type owl:Restriction ;
                         owl:onProperty <https://www.w3id.org/cco/cco#holdsRole> ;
                         owl:someValuesFrom [ owl:intersectionOf ( <https://www.w3id.org/cco/cco#RoleHolding>
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <https://www.w3id.org/cco/cco#hasRole> ;
                                                                     owl:someValuesFrom <https://www.w3id.org/cco/cco#RegulatoryAuthorityRole>
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ]
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf [ rdf:type owl:Restriction ;
                    owl:onProperty <https://www.w3id.org/cco/cco#holdsRole> ;
                    owl:someValuesFrom [ owl:intersectionOf ( <https://www.w3id.org/cco/cco#RoleHolding>
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://www.w3id.org/cco/cco#hasRole> ;
                                                                owl:someValuesFrom <https://www.w3id.org/cco/cco#RegulatoryAuthorityRole>
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ]
                  ]
] .


[ owl:intersectionOf ( <https://www.w3id.org/cco/cco#RoleHolding>
                       [ rdf:type owl:Restriction ;
                         owl:onProperty <https://www.w3id.org/cco/cco#hasRole> ;
                         owl:someValuesFrom <https://www.w3id.org/cco/cco#RegulatoryAuthorityRole>
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf <https://www.w3id.org/cco/cco#RoleHolding>
] .


[ owl:intersectionOf ( <https://www.w3id.org/cco/cco#RoleHolding>
                       [ rdf:type owl:Restriction ;
                         owl:onProperty <https://www.w3id.org/cco/cco#hasRole> ;
                         owl:someValuesFrom <https://www.w3id.org/cco/cco#RegulatoryAuthorityRole>
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf [ rdf:type owl:Restriction ;
                    owl:onProperty <https://www.w3id.org/cco/cco#hasRole> ;
                    owl:someValuesFrom <https://www.w3id.org/cco/cco#RegulatoryAuthorityRole>
                  ]
