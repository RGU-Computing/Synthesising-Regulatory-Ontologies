###  https://www.w3id.org/cco/cco#hasActionExpression
<https://www.w3id.org/cco/cco#hasActionExpression> rdf:type owl:DatatypeProperty ;
                                                   rdfs:subPropertyOf <https://www.w3id.org/cco/cco#hasActionExpression> ;
                                                   rdfs:domain owl:Thing ,
                                                               <https://www.w3id.org/cco/cco#Action> ;
                                                   rdfs:range xsd:string ;
                                                   rdfs:label "has action expression"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "Relates an action to a plain text string that records the action description, preserving the wording of the regulatory source text."@en .


###  https://www.w3id.org/cco/cco#hasApplicabilityEnd
<https://www.w3id.org/cco/cco#hasApplicabilityEnd> rdf:type owl:DatatypeProperty ;
                                                   rdfs:subPropertyOf <https://www.w3id.org/cco/cco#hasApplicabilityEnd> ;
                                                   rdf:type owl:FunctionalProperty ;
