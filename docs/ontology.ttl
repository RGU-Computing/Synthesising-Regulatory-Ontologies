<https://w3id.org/cco-gro/onto/us#PellGrantRecalculation> rdf:type owl:Class ;
                                                          rdfs:subClassOf <https://www.w3id.org/cco/cco#Resource> ;
                                                          rdfs:label "Pell Grant Recalculation" ;
