                                                                                 rdfs:subClassOf <https://www.w3id.org/cco/cco#Resource> ;
                                                                                 rdfs:label "Part-Time Student Financial Assistance Application" ;
                                                                                 <http://www.w3.org/2004/02/skos/core#definition> "An application submitted by a student for part-time financial assistance, including loans and grants." .


###  https://w3id.org/cco-gro/onto/ca#PartTimeStudentFunding
<https://w3id.org/cco-gro/onto/ca#PartTimeStudentFunding> rdf:type owl:Class ;
