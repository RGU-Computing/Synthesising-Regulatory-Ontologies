                                                                                 owl:onClass <https://www.w3id.org/cco/cco#Condition>
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://www.w3id.org/cco/cco#modifiesNorm> ;
                                                                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                 owl:onClass <https://www.w3id.org/cco/cco#Norm>
                                                                               ]
                                                                             ) ;
                                                          rdf:type owl:Class
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://www.w3id.org/cco/cco#hasCondition> ;
                                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onClass <https://www.w3id.org/cco/cco#Condition>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://www.w3id.org/cco/cco#modifiesNorm> ;
                                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onClass <https://www.w3id.org/cco/cco#Norm>
                                                        ] ;
                                            rdfs:range owl:Thing ,
