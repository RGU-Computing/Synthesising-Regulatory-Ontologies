                                                   rdfs:label "Practical Period" ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "The practical period of the apprenticeship during which all learning must be delivered." ,
                                                                                                    "The start and end date of the practical period (this is the part of the apprenticeship where evidenced learning is delivered; this does not include the end-point assessment)" ;
                                                   <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#UK_UNIT_00269> .


