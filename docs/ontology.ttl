                                                                           owl:Thing ,
                                                                           <https://www.w3id.org/cco/cco#Condition> ;
                                                                  <https://www.w3id.org/cco/cco#hasConditionExpression> "Net worth is calculated by adding cash, savings, checking, time deposits, money market funds, net worth of investments, and adjusted net worth of business/farm." ;
                                                                  rdfs:label "Net Worth Calculation Step" ;
                                                                  <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#USA_UNIT_00206> .


