                                                   rdfs:label "Learning Support" ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "Financial support that providers can claim to help with the cost of any reasonable adjustments directly related to an apprenticeship, currently a fixed monthly amount of £150." ,
                                                                                                    "Support provided to learners during an apprenticeship" ;
                                                   <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#UK_UNIT_01208> .


