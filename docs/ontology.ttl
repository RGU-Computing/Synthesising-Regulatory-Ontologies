###  https://w3id.org/cco-gro/onto/ca#BankruptcyAndInsolvencyAct
<https://w3id.org/cco-gro/onto/ca#BankruptcyAndInsolvencyAct> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://www.w3id.org/cco/cco#Regulation> ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <https://www.w3id.org/cco/cco#specifiesNorm> ;
                                                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                owl:onClass <https://www.w3id.org/cco/cco#Norm>
                                                                              ] ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <https://www.w3id.org/cco/cco#hasValidityStart> ;
                                                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                owl:onDataRange xsd:date
                                                                              ] ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <https://www.w3id.org/cco/cco#hasValidityEnd> ;
                                                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                owl:onDataRange xsd:date
                                                                              ] ;
                                                              rdfs:label "Bankruptcy and Insolvency Act" ;
                                                              <http://www.w3.org/2004/02/skos/core#definition> "The Canadian federal statute governing bankruptcy and insolvency proceedings" .


