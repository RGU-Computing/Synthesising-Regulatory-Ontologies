<https://w3id.org/cco-gro/onto/uk#Ofsted> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://www.w3id.org/cco/cco#Agent> ,
                                                          <https://www.w3id.org/cco/cco#RegulatoryAuthorityAgent> ,
                                                          [ owl:intersectionOf ( <https://www.w3id.org/cco/cco#Agent>
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty <https://www.w3id.org/cco/cco#holdsRole> ;
                                                                                   owl:someValuesFrom [ owl:intersectionOf ( <https://www.w3id.org/cco/cco#RoleHolding>
                                                                                                                             [ rdf:type owl:Restriction ;
                                                                                                                               owl:onProperty <https://www.w3id.org/cco/cco#hasRole> ;
                                                                                                                               owl:someValuesFrom <https://www.w3id.org/cco/cco#RegulatoryAuthorityRole>
                                                                                                                             ]
                                                                                                                           ) ;
                                                                                                        rdf:type owl:Class
                                                                                                      ]
                                                                                 ]
                                                                               ) ;
                                                            rdf:type owl:Class
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <https://www.w3id.org/cco/cco#holdsRole> ;
                                                            owl:someValuesFrom [ owl:intersectionOf ( <https://www.w3id.org/cco/cco#RoleHolding>
                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                        owl:onProperty <https://www.w3id.org/cco/cco#hasRole> ;
                                                                                                        owl:someValuesFrom <https://www.w3id.org/cco/cco#RegulatoryAuthorityRole>
                                                                                                      ]
                                                                                                    ) ;
                                                                                 rdf:type owl:Class
                                                                               ]
                                                          ] ;
                                          rdfs:label "Ofsted" ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "The Office for Standards in Education, Children's Services and Skills, a non-ministerial department of the UK government responsible for inspecting educational institutions." .


###  https://w3id.org/cco-gro/onto/uk#OnboardingOfTheApprentice
<https://w3id.org/cco-gro/onto/uk#OnboardingOfTheApprentice> rdf:type owl:Class ;
                                                             rdfs:subClassOf <https://www.w3id.org/cco/cco#Action> ;
                                                             rdfs:label "Onboarding of the Apprentice" ;
                                                             <http://www.w3.org/2004/02/skos/core#definition> "Onboarding of the apprentice will include agreeing a price with the employer and developing, agreeing and signing any relevant paperwork to support the apprenticeship, such as the training plan. Onboarding does not include training delivery and therefore does not count towards the off-the-job training policy." ;
                                                             <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#UK_UNIT_01212> .


###  https://w3id.org/cco-gro/onto/uk#OriginalTeachingMaterialDevelopment
<https://w3id.org/cco-gro/onto/uk#OriginalTeachingMaterialDevelopment> rdf:type owl:Class ;
                                                                       rdfs:subClassOf <https://www.w3id.org/cco/cco#Resource> ;
                                                                       rdfs:label "Original Teaching Material Development" ;
                                                                       <http://www.w3.org/2004/02/skos/core#definition> "Development of original teaching materials related to a new apprenticeship offer means the first time a provider chooses to deliver a new apprenticeship standard." ;
                                                                       <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#UK_UNIT_00470> .


###  https://w3id.org/cco-gro/onto/uk#OtherRulesDocument
