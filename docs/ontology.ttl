                                                                         owl:Thing ,
                                                                         <https://www.w3id.org/cco/cco#Condition> ;
                                                                <https://www.w3id.org/cco/cco#hasConditionExpression> "If the contribution from assets is negative, it is set to zero." ;
                                                                rdfs:label "Negative Contribution from Assets" ;
                                                                <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#USA_UNIT_00184> .


