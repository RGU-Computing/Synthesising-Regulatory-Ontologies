                                                             rdfs:subClassOf <https://www.w3id.org/cco/cco#Condition> ;
                                                             rdfs:label "Employer-Provider Agreement" ;
                                                             <http://www.w3.org/2004/02/skos/core#definition> "An agreement between the employer and provider that participation in a skills competition directly contributes to helping the apprentice achieve the apprenticeship." .


