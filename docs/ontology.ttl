<https://w3id.org/cco-gro/onto/uk#NoPlannedOTJTActiveLearning> rdf:type owl:Class ;
                                                               rdfs:subClassOf <https://www.w3id.org/cco/cco#Condition> ;
                                                               rdfs:label "No Planned OTJT Active Learning" ;
