                                                                                                                owl:someValuesFrom <https://www.w3id.org/cco/cco#RegulatoryAuthorityRole>
                                                                                                              ]
                                                                                                            ) ;
                                                                                         rdf:type owl:Class
                                                                                       ]
                                                                  ] ;
                                                  rdfs:label "Regulatory Body" ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "A body responsible for approving apprenticeship training delivery." ,
                                                                                                   "An organisation responsible for approving providers to deliver apprenticeship training" .


