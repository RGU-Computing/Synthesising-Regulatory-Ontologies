                                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onDataRange xsd:date
                                                          ] ;
                                              rdfs:range xsd:date ;
                                              rdfs:label "has validity end"@en ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "Relates a regulation to the date on which its validity ends."@en .


###  https://www.w3id.org/cco/cco#hasValidityStart
<https://www.w3id.org/cco/cco#hasValidityStart> rdf:type owl:DatatypeProperty ;
                                                rdfs:subPropertyOf <https://www.w3id.org/cco/cco#hasValidityStart> ;
                                                rdf:type owl:FunctionalProperty ;
                                                rdfs:domain owl:Thing ,
                                                            <https://www.w3id.org/cco/cco#Regulation> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://www.w3id.org/cco/cco#specifiesNorm> ;
