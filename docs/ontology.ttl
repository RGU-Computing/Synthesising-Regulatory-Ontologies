<https://w3id.org/cco-gro/data#AUS_UNIT_01043_action_f6adef> rdf:type owl:NamedIndividual ,
                                                                      owl:Thing ,
                                                                      <https://www.w3id.org/cco/cco#Action> ;
                                                             <https://www.w3id.org/cco/cco#hasActionExpression> "commits an offence if the person uses or discloses personal information" ;
