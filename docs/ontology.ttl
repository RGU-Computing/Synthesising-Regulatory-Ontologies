###  https://w3id.org/cco-gro/data#USA_UNIT_00186_object_9900ec
<https://w3id.org/cco-gro/data#USA_UNIT_00186_object_9900ec> rdf:type owl:NamedIndividual ,
                                                                      owl:Thing ,
                                                                      <https://www.w3id.org/cco/cco#Resource> ;
                                                             rdfs:label "Student Total Income" ;
                                                             <http://www.w3.org/2004/02/skos/core#definition> "The sum of the student's taxed and untaxed income, as reported on a U.S. tax return." ;
                                                             <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#USA_UNIT_00186> .


###  https://w3id.org/cco-gro/data#USA_UNIT_00186_subject_f18612
<https://w3id.org/cco-gro/data#USA_UNIT_00186_subject_f18612> rdf:type owl:NamedIndividual ,
                                                                       owl:Thing ,
                                                                       <https://w3id.org/cco-gro/onto/us#StudentAvailableIncome> ,
                                                                       <https://www.w3id.org/cco/cco#Resource> ;
                                                              rdfs:label "Student Available Income" ;
                                                              <http://www.w3.org/2004/02/skos/core#definition> "The student's available income is calculated by subtracting certain allowances from the student's total income. These allowances account for certain nondiscretionary expenses, such as taxes and basic living expenses. Once a minimum level of support has been offset for those expenses, the formula assumes that the remaining income is available for discretionary purposes, including paying for a postsecondary education. The student's available income is the sum of the taxable and untaxed income, minus amounts reported in the income but excluded from the formula (offsets and allowances)." ;
                                                              <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#USA_UNIT_00186> .


###  https://w3id.org/cco-gro/data#USA_UNIT_00188
<https://w3id.org/cco-gro/data#USA_UNIT_00188> rdf:type owl:NamedIndividual ,
                                                        <http://www.w3.org/ns/prov#Entity> ;
                                               rdfs:label "Source: USA-UNIT-00188" .


###  https://w3id.org/cco-gro/data#USA_UNIT_00188_calculation_rule
<https://w3id.org/cco-gro/data#USA_UNIT_00188_calculation_rule> rdf:type owl:NamedIndividual ,
                                                                         owl:Thing ,
                                                                         <https://www.w3id.org/cco/cco#Condition> ;
                                                                <https://www.w3id.org/cco/cco#hasConditionExpression> "Student's total income = Student's total income - (Student's taxable college grant and scholarship aid + Student's education credits + Student's Federal Work-Study) - (U.S. income tax paid + Student's payroll tax allowance + Income protection allowance + Allowance for parents' negative adjusted available income)" ;
                                                                rdfs:label "Student Income Calculation Rule" ;
                                                                <http://www.w3.org/2004/02/skos/core#definition> "The student's total income is decreased by the sum of income offsets (taxable college grant and scholarship aid, education credits, Federal Work-Study) and reduced by the sum of income allowances (U.S. income tax paid, payroll tax allowance, income protection allowance, allowance for parents' negative adjusted available income)." ;
                                                                <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#USA_UNIT_00188> .


###  https://w3id.org/cco-gro/data#USA_UNIT_00188_income_allowances_condition
<https://w3id.org/cco-gro/data#USA_UNIT_00188_income_allowances_condition> rdf:type owl:NamedIndividual ,
                                                                                    owl:Thing ,
                                                                                    <https://www.w3id.org/cco/cco#Condition> ;
                                                                           <https://www.w3id.org/cco/cco#hasConditionExpression> "The sum of the following allowances reduces the student's total income: U.S. income tax paid, Student's payroll tax allowance, Income protection allowance, Allowance for parents' negative adjusted available income." ;
                                                                           rdfs:label "Income Allowances Condition" ;
                                                                           <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#USA_UNIT_00188> .


###  https://w3id.org/cco-gro/data#USA_UNIT_00188_income_offsets_condition
<https://w3id.org/cco-gro/data#USA_UNIT_00188_income_offsets_condition> rdf:type owl:NamedIndividual ,
                                                                                 owl:Thing ,
                                                                                 <https://www.w3id.org/cco/cco#Condition> ;
                                                                        <https://www.w3id.org/cco/cco#hasConditionExpression> "The sum of the following items decreases the student's total income: Student's taxable college grant and scholarship aid, Student's education credits, Student's Federal Work-Study (FWS)." ;
                                                                        rdfs:label "Income Offsets Condition" ;
                                                                        <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#USA_UNIT_00188> .


###  https://w3id.org/cco-gro/data#USA_UNIT_00188_subject_851b3d
<https://w3id.org/cco-gro/data#USA_UNIT_00188_subject_851b3d> rdf:type owl:NamedIndividual ,
                                                                       owl:Thing ,
                                                                       <https://w3id.org/cco-gro/onto/us#StudentTotalIncome> ,
                                                                       <https://www.w3id.org/cco/cco#Resource> ;
                                                              rdfs:label "Student Total Income" ;
                                                              <http://www.w3.org/2004/02/skos/core#definition> "The total income of a student, which is decreased by the sum of income offsets and reduced by the sum of income allowances as specified in the calculation rule." ;
                                                              <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#USA_UNIT_00188> .


