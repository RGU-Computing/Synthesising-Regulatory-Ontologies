                                                                         ] ;
                                                                <https://www.w3id.org/cco/cco#hasCondition> <https://w3id.org/cco-gro/data#CAN_UNIT_00072_condition_exception> ;
                                                                <https://www.w3id.org/cco/cco#modifiesNorm> <https://w3id.org/cco-gro/data#CAN_UNIT_00072_norm_97b317> ;
