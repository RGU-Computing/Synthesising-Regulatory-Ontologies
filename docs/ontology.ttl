                                                            <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#UK_UNIT_00568> .


<https://w3id.org/cco-gro/data#UK_UNIT_00597_object_a8b8ea> rdfs:label "Foundation Apprenticeship" ;
