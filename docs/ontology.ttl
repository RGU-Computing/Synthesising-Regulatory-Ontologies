                                                        owl:onClass <https://www.w3id.org/cco/cco#Role>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <https://www.w3id.org/cco/cco#hasStartTime> ;
                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onDataRange xsd:date
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <https://www.w3id.org/cco/cco#hasEndTime> ;
                                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onDataRange xsd:date
                                                      ] ;
                                          rdfs:range xsd:date ;
                                          rdfs:label "has end time"@en ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "Relates a Role Holding association to the date on which it ends."@en .


###  https://www.w3id.org/cco/cco#hasStartTime
