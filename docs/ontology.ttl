                                           rdfs:subClassOf <https://www.w3id.org/cco/cco#Condition> ;
                                           rdfs:label "Default" ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "In relation to a student loan, of which the Borrower is more than 270 days in arrears on payments based on the Borrower's loan agreement and in respect of which collection action is taken." ;
                                           <http://www.w3.org/ns/prov#wasDerivedFrom> <https://w3id.org/cco-gro/data#CAN_UNIT_00826> .


