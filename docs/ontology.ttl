<https://w3id.org/cco-gro/onto/us#NotaryCertification> rdf:type owl:Class ;
                                                       rdfs:subClassOf <https://www.w3id.org/cco/cco#Resource> ;
                                                       rdfs:label "Notary Certification" ;
