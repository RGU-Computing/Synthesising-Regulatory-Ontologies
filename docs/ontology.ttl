                                                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                           owl:onClass <https://www.w3id.org/cco/cco#Norm>
                                                                         ] ;
                                                                <https://www.w3id.org/cco/cco#hasCondition> <https://w3id.org/cco-gro/data#CAN_UNIT_00871_condition_exception> ;
                                                                <https://www.w3id.org/cco/cco#modifiesNorm> <https://w3id.org/cco-gro/data#CAN_UNIT_00871_norm_138a6b> ;
