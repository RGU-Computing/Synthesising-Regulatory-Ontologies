                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://www.w3id.org/cco/cco#hasStartTime> ;
                                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onDataRange xsd:date
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://www.w3id.org/cco/cco#hasEndTime> ;
